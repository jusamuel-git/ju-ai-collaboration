 "_comment_expect": "expect: 응답 판정 규칙(EXPECT_RULE). java/dotnet = 각 쪽 통과 여부. 둘이 다른 항목은 문법 차이 기록용(note). match: 같은 regex·입력의 일치 결과가 양쪽 같아야 함.",
 "expect": [
  {
   "rule": "{\"startsWith\":\"{OK\"}",
   "java": true,
   "dotnet": true
  },
  {
   "rule": "{\"regex\":\"^[{][A-Za-z]\"}",
   "java": true,
   "dotnet": true
  },
  {
   "rule": "{\"regex\":\"^[{][0-9]{3},[0-9]{3},[0-9]{3},[0-9]{3}[}]$\"}",
   "java": true,
   "dotnet": true
  },
  {
   "rule": "{\"regex\":\"^\\\\{\\\\d{3}\\\\}$\"}",
   "java": true,
   "dotnet": true
  },
  {
   "rule": "{\"regex\":\"(?i)^ok\"}",
   "java": true,
   "dotnet": true
  },
  {
   "rule": "{\"regex\":\"^\\\\p{L}+$\"}",
   "java": true,
   "dotnet": true
  },
  {
   "rule": "{\"regex\":\"^(?<v>[0-9]+)$\"}",
   "java": true,
   "dotnet": true
  },
  {
   "rule": "{\"regex\":\"[\"}",
   "java": false,
   "dotnet": false
  },
  {
   "rule": "{\"regex\":\"(\"}",
   "java": false,
   "dotnet": false
  },
  {
   "rule": "{\"regex\":\"a{2,1}\"}",
   "java": false,
   "dotnet": false
  },
  {
   "rule": "{\"regex\":\"\\\\\"}",
   "java": false,
   "dotnet": false
  },
  {
   "rule": "{\"regex\":\"\"}",
   "java": false,
   "dotnet": false
  },
  {
   "rule": "{\"contains\":\"a\"}",
   "java": false,
   "dotnet": false
  },
  {
   "rule": "{\"startsWith\":\"a\",\"regex\":\"b\"}",
   "java": false,
   "dotnet": false
  },
  {
   "rule": "not json",
   "java": false,
   "dotnet": false
  },
  {
   "rule": "{\"regex\":\"a++\"}",
   "java": true,
   "dotnet": false,
