+    public bool ApplyPlan(DevicePlanSyncMessage input)
+    {
+        string devCd = input.DevCd.Trim().ToUpperInvariant();
+        input.DevCd = devCd;
+        try
+        {
+            CollectionPlan plan = CollectionPlanReader.Build(devCd, input.GroupJson, input.DataTagsJson, input.DataMapJson);
