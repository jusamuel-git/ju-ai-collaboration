+namespace JuProvider.Lib.Ipc.Messages;
+
+/*
+ * C6a 수집 IPC. 원칙: 인증·서버 통신은 Client, 수집은 Terminal.
+ * Terminal 은 Client Key 를 받지 않는다. Client 가 서버에서 받은 응답 원문(JSON)만 넘긴다.
+ * 측정값 서버 업로드는 C7 (여기서는 Client 로 보내기까지).
+ */
+
+/// <summary>
+/// Client -> Terminal: 장치 1개 수집 계획 입력.
+/// 다음 DEVICE_CONNECT 때 적용된다 (이미 연결 중이면 연결을 다시 맺을 때 적용).
+/// </summary>
+public sealed class DevicePlanSyncMessage
+{
+    public string DevCd { get; set; } = string.Empty;
+
+    public string PtlGrpCd { get; set; } = string.Empty;
+
+    /// <summary>"server"(방금 받음) 또는 "cache"(오프라인, 마지막으로 받은 값)</summary>
+    public string Source { get; set; } = "server";
+
+    public string? Revision { get; set; }
+
+    /// <summary>GET /api/core/sync/protocols/{ptlGrpCd} 응답 원문</summary>
+    public string GroupJson { get; set; } = string.Empty;
+
+    /// <summary>GET /api/core/sync/data-tags?devCd= 응답 원문</summary>
+    public string? DataTagsJson { get; set; }
+
+    /// <summary>GET /api/core/sync/data-map?devCd= 응답 원문</summary>
+    public string? DataMapJson { get; set; }
+
+    /// <summary>PC별 연결 설정 (로컬 덮어쓰기, 예: COM 번호). 없으면 장치 DEV_CONFIG</summary>
+    public string? ConnectionJson { get; set; }
+}
+
+/// <summary>Client -> Terminal: 실험 동작 (START·STOP·PAUSE). PtlCd 를 주면 그 프로토콜을 실행</summary>
+public sealed class DeviceActionMessage
+{
+    public string DevCd { get; set; } = string.Empty;
+
+    public string Action { get; set; } = string.Empty;
+
+    public string? PtlCd { get; set; }
+}
+
+/// <summary>Terminal -> Client: 동작 결과</summary>
+public sealed class DeviceActionResultMessage
+{
+    public string DevCd { get; set; } = string.Empty;
+
+    public string Action { get; set; } = string.Empty;
+
+    public string? PtlCd { get; set; }
+
+    public bool Ok { get; set; }
+
+    /// <summary>Completed · Timeout · Cancelled · LinkDown · Rejected …</summary>
+    public string Status { get; set; } = string.Empty;
+
+    public string? Message { get; set; }
+}
+
+/// <summary>Terminal -> Client: 수신 값 (data-map 기준 논리 Data)</summary>
+public sealed class DataValuesMessage
+{
+    public string DevCd { get; set; } = string.Empty;
+
+    public string PtlCd { get; set; } = string.Empty;
+
+    public List<DataValueItem> Values { get; set; } = [];
+}
+
+public sealed class DataValueItem
+{
+    public string ChannelKey { get; set; } = string.Empty;
+
+    public int SampleIndex { get; set; }
+
+    /// <summary>DAT_GR_CD/DAT_CD/DAT_IDX. 매핑 없는 채널이면 null</summary>
+    public string? DataKey { get; set; }
+
+    public string? DatGrCd { get; set; }
+
+    public string? DatCd { get; set; }
+
+    public int? DatIdx { get; set; }
+
+    public double? Value { get; set; }
+
+    public string? Text { get; set; }
+
+    public string? Unit { get; set; }
+
+    /// <summary>Good · Range · ParseErr · Stale · Unmapped</summary>
+    public string Quality { get; set; } = string.Empty;
+
+    public DateTimeOffset ReceivedAt { get; set; }
+}
+
+/// <summary>Terminal -> Client: 수집 런타임 상태 (세션·연결·초기화 루틴·계획 출처/경고)</summary>
+public sealed class DeviceRuntimeStateMessage
+{
+    public string DevCd { get; set; } = string.Empty;
+
+    /// <summary>PLAN · SESSION · LINK · INIT · STOPPED · ERROR (무엇 때문에 보냈는지)</summary>
+    public string Event { get; set; } = string.Empty;
+
+    /// <summary>Created · Initializing · Ready · Degraded · Suspended · Stopped</summary>
+    public string? Session { get; set; }
+
+    /// <summary>마지막 연결 이벤트: Connected · Faulted · Reconnecting · Recovered · Stopped</summary>
+    public string? Link { get; set; }
+
+    public bool Measuring { get; set; }
+
+    public string? PtlGrpCd { get; set; }
+
+    public string? PlanSource { get; set; }
+
+    public string? PlanRevision { get; set; }
+
+    /// <summary>연결 설정 출처: local · server</summary>
+    public string? ConnectionSource { get; set; }
+
+    public bool? InitOk { get; set; }
+
+    /// <summary>"GTEC0301:Completed" 형식</summary>
+    public List<string> InitSteps { get; set; } = [];
+
+    /// <summary>계획 항목 중 서버 값 개수 / 전체 (CollectionPlan.Sources)</summary>
+    public int ServerItems { get; set; }
+
+    public int TotalItems { get; set; }
+
+    public List<string> Warnings { get; set; } = [];
+
+    public string? Message { get; set; }
+}
