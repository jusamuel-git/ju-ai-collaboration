+                _connectionSources.GetValueOrDefault(devCd), includeWarnings: true,
+                connected ? "연결 중: 다음 연결 때 적용" : null));
+            Debug.WriteLine($"[PLAN] {devCd} {plan.PtlGrpCd} 프로토콜 {plan.Protocols.Count}, 경고 {plan.Warnings.Count}");
+            return true;
+        }
+        catch (Exception ex) when (ex is FormatException or ArgumentException)
+        {
+            RaiseState(new DeviceRuntimeStateMessage { DevCd = devCd, Event = "ERROR", PtlGrpCd = input.PtlGrpCd, Message = "수집 계획 오류: " + ex.Message });
+            return false;
+        }
+    }
+
+    public bool HasPlan(string devCd) => _plans.ContainsKey(devCd.Trim().ToUpperInvariant());
+
+    public CollectionRuntime? GetCollection(string devCd) =>
+        _collections.GetValueOrDefault(devCd.Trim().ToUpperInvariant());
+
+    private async Task<bool> ConnectCollectionAsync(DeviceSyncModel device, CancellationToken cancellationToken)
+    {
+        string devCd = device.DevCd;
+        if (_collections.ContainsKey(devCd)) return true;
+
+        DevicePlanSyncMessage input = _plans[devCd];
+        CollectionPlan plan = CollectionPlanReader.Build(devCd, input.GroupJson, input.DataTagsJson, input.DataMapJson);
+        (string json, string source) = ConnectionResolver.Resolve(device.DevType, input.ConnectionJson, device.DevConfig);
+        ITransport transport = TransportFactory.FromLocalConfig(json);
+
+        CollectionRuntime runtime = new(plan, transport, ReconnectPolicy);
+        if (!_collections.TryAdd(devCd, runtime))
+        {
+            await runtime.DisposeAsync();
+            return true;
+        }
+        _connectionSources[devCd] = source;
+
+        runtime.Values += (_, e) => ValuesReceived?.Invoke(new DataValuesMessage
+        {
+            DevCd = devCd,
+            PtlCd = e.PtlCd,
+            Values = e.Values.Select(CollectionIpcMapper.ToItem).ToList()
+        });
+        runtime.StateChanged += (_, _) => RaiseRuntime(devCd, "SESSION");
+        runtime.LinkChanged += (_, e) => { if (e.Kind != LinkEventKind.Reconnecting) RaiseRuntime(devCd, "LINK", e.Error?.Message); };
+        runtime.InitCompleted += (_, _) => RaiseRuntime(devCd, "INIT");
+        runtime.Warning += (_, w) => Debug.WriteLine($"[COLLECT WARN] {w}");
+
+        Debug.WriteLine($"[COLLECT] {devCd} 연결 시작 ({transport.Name}, 설정 출처 {source})");
+        await runtime.StartAsync(cancellationToken);
+        return true;
+    }
+
+    /// <summary>실험 동작 (START·STOP·PAUSE). 수집 엔진으로 연결된 장치만</summary>
+    public async Task<DeviceActionResultMessage> ExecuteActionAsync(DeviceActionMessage request, CancellationToken cancellationToken = default)
+    {
+        string devCd = request.DevCd.Trim().ToUpperInvariant();
+        DeviceActionResultMessage result = new() { DevCd = devCd, Action = request.Action, PtlCd = request.PtlCd };
+
+        if (!_collections.TryGetValue(devCd, out CollectionRuntime? runtime))
+        {
+            result.Status = "Rejected";
+            result.Message = "수집 엔진으로 연결되지 않은 장치입니다.";
+            return result;
+        }
+        if (!Enum.TryParse(request.Action?.Trim(), ignoreCase: true, out CommandAction action) || action == CommandAction.None)
+        {
+            result.Status = "Rejected";
+            result.Message = $"알 수 없는 동작: {request.Action}";
+            return result;
+        }
+
+        var (ptlCd, r) = await runtime.ExecuteActionAsync(action, request.PtlCd, cancellationToken);
+        result.PtlCd = ptlCd;
+        result.Ok = r.Ok;
+        result.Status = r.Status.ToString();
+        result.Message = r.Reason;
+        RaiseRuntime(devCd, "SESSION");
+        return result;
+    }
+
+    private async Task StopCollectionAsync(string devCd)
+    {
+        if (!_collections.TryRemove(devCd, out CollectionRuntime? runtime)) return;
+        try
+        {
+            await runtime.StopAsync();
+        }
+        catch (Exception ex)
+        {
+            Debug.WriteLine($"[COLLECT STOP ERROR] {devCd} / {ex.Message}");
+        }
+        RaiseState(CollectionIpcMapper.State(devCd, "STOPPED", runtime, _plans.GetValueOrDefault(devCd), null,
+            _connectionSources.GetValueOrDefault(devCd), includeWarnings: false));
+    }
+
+    private void RaiseRuntime(string devCd, string evt, string? message = null)
+    {
+        if (!_collections.TryGetValue(devCd, out CollectionRuntime? runtime)) return;
+        RaiseState(CollectionIpcMapper.State(devCd, evt, runtime, _plans.GetValueOrDefault(devCd), null,
+            _connectionSources.GetValueOrDefault(devCd), includeWarnings: false, message));
+    }
+
+    private void RaiseState(DeviceRuntimeStateMessage state)
+    {
+        try
+        {
+            RuntimeStateChanged?.Invoke(state);
+        }
+        catch (Exception ex)
+        {
+            Debug.WriteLine($"[RUNTIME STATE ERROR] {ex.Message}");
+        }
+    }
