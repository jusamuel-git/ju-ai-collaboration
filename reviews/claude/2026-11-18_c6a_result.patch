diff --git a/desktop/lib/juprovider.lib.protocol/Runtime/CollectionRuntime.cs b/desktop/lib/juprovider.lib.protocol/Runtime/CollectionRuntime.cs
new file mode 100644
index 0000000..a5db139
--- /dev/null
+++ b/desktop/lib/juprovider.lib.protocol/Runtime/CollectionRuntime.cs
@@ -0,0 +1,188 @@
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using JuProvider.Lib.Protocol.Model;
+using JuProvider.Lib.Protocol.Scheduling;
+using JuProvider.Lib.Protocol.Session;
+using JuProvider.Lib.Protocol.Sync;
+using JuProvider.Lib.Protocol.Transport;
+
+namespace JuProvider.Lib.Protocol.Runtime;
+
+/// <summary>
+/// C6a: 서버 내려받기 응답 원문(JSON) → CollectionPlan.
+/// Client 가 받은 응답을 그대로 Terminal 로 넘기므로 Terminal 은 서버·Client Key 를 모른다.
+/// 우선순위는 C5d 그대로 (서버 → 내장 → 기본, <see cref="CollectionPlanBuilder"/>).
+/// </summary>
+public static class CollectionPlanReader
+{
+    private static readonly JsonSerializerOptions Web = new(JsonSerializerDefaults.Web);
+
+    /// <param name="groupJson">GET /api/core/sync/protocols/{grp} 응답</param>
+    /// <param name="dataTagsJson">GET /api/core/sync/data-tags?devCd= 응답 (없으면 태그 없음)</param>
+    /// <param name="dataMapJson">GET /api/core/sync/data-map?devCd= 응답 (없으면 TAG_ID=CH&lt;n&gt; 임시 변환)</param>
+    /// <param name="profile">null 이면 내장 수집 설정을 대체값으로 쓴다</param>
+    public static CollectionPlan Build(string devCd, string groupJson, string? dataTagsJson, string? dataMapJson, CollectionProfile? profile = null)
+    {
+        ArgumentException.ThrowIfNullOrEmpty(devCd);
+        if (string.IsNullOrWhiteSpace(groupJson)) throw new FormatException("프로토콜 그룹 응답이 없습니다.");
+
+        ProtocolGroupSync group = Read<ProtocolGroupSync>(groupJson, "프로토콜 그룹").FirstOrDefault()
+            ?? throw new FormatException("프로토콜 그룹 응답에 항목이 없습니다.");
+        IReadOnlyList<DataTagSync> tags = string.IsNullOrWhiteSpace(dataTagsJson) ? [] : Read<DataTagSync>(dataTagsJson, "데이터 태그");
+        IReadOnlyList<DataChannelMapSync>? map = string.IsNullOrWhiteSpace(dataMapJson) ? null : Read<DataChannelMapSync>(dataMapJson, "data-map");
+        return CollectionPlanBuilder.Build(devCd, group, tags, profile, map);
+    }
+
+    private static IReadOnlyList<T> Read<T>(string json, string what)
+    {
+        try
+        {
+            return JsonSerializer.Deserialize<SyncResult<T>>(json, Web)?.Items ?? [];
+        }
+        catch (JsonException ex)
+        {
+            throw new FormatException($"{what} 응답 형식 오류: {ex.Message}", ex);
+        }
+    }
+}
+
+/// <summary>
+/// 장치 연결 설정 결정 (C6 결정 2): <b>로컬 덮어쓰기(PC별) → 서버 DEV_CONFIG</b>.
+/// COM 번호처럼 PC마다 다른 값은 로컬에서 덮어쓴다. 결과는 <see cref="TransportFactory.FromLocalConfig"/> 형식.
+/// transport 키가 없으면 장치유형(DEVI)으로 채운다: DEVI0000 VIRTUAL · DEVI0001 SERIAL · DEVI0002/0003 TCP.
+/// </summary>
+public static class ConnectionResolver
+{
+    public const string SourceLocal = "local";
+    public const string SourceServer = "server";
+
+    public static (string Json, string Source) Resolve(string? devType, string? localJson, string? devConfig)
+    {
+        if (!string.IsNullOrWhiteSpace(localJson)) return (Normalize(localJson, devType), SourceLocal);
+        if (!string.IsNullOrWhiteSpace(devConfig) && devConfig.TrimStart().StartsWith('{')) return (Normalize(devConfig, devType), SourceServer);
+        throw new TransportConfigException("연결 설정이 없습니다 (로컬 덮어쓰기·장치 DEV_CONFIG 모두 없음).");
+    }
+
+    private static string Normalize(string json, string? devType)
+    {
+        JsonObject obj;
+        try
+        {
+            obj = JsonNode.Parse(json) as JsonObject ?? throw new TransportConfigException("연결 설정은 JSON 객체입니다.");
+        }
+        catch (JsonException ex)
+        {
+            throw new TransportConfigException("연결 설정 JSON 형식 오류: " + ex.Message);
+        }
+        if (!obj.ContainsKey("transport"))
+        {
+            string kind = devType switch
+            {
+                "DEVI0000" => "VIRTUAL",
+                "DEVI0001" => "SERIAL",
+                "DEVI0002" or "DEVI0003" => "TCP",
+                _ => throw new TransportConfigException($"transport 가 없고 장치유형({devType ?? "-"})으로 정할 수 없습니다.")
+            };
+            obj["transport"] = kind;
+        }
+        return obj.ToJsonString();
+    }
+}
+
+/// <summary>
+/// C6a Terminal 수집 엔진 1개 장치분: CollectionPlan + LinkSupervisor(재연결) + DeviceSession(초기화 루틴·명령·수신·매핑).
+/// C5d 실장비 검증(COM3) 도구와 같은 조합을 제품 코드로 옮긴 것. 측정값 업로드는 하지 않는다(C7).
+/// </summary>
+public sealed class CollectionRuntime : IAsyncDisposable
+{
+    private readonly LinkSupervisor _link;
+    private readonly DeviceSession _session;
+    private int _stopped;
+
+    public CollectionRuntime(CollectionPlan plan, ITransport transport, ReconnectPolicy? policy = null)
+    {
+        Plan = plan ?? throw new ArgumentNullException(nameof(plan));
+        Transport = transport ?? throw new ArgumentNullException(nameof(transport));
+        _link = new LinkSupervisor(transport, policy);
+        _session = plan.CreateSession(transport);
+        _link.Event += (_, e) => { LastLink = e.Kind; LinkChanged?.Invoke(this, e); };
+        _session.Values += (_, e) => Values?.Invoke(this, e);
+        _session.Warning += (_, w) => Warning?.Invoke(this, w);
+        _session.StateChanged += (_, s) => StateChanged?.Invoke(this, s);
+        _session.InitCompleted += (_, r) =>
+        {
+            // 초기화 루틴(장치 기준 STOP 먼저)이 돌았으면 장치는 측정 중이 아니다
+            Measuring = false;
+            LastInit = r;
+            InitCompleted?.Invoke(this, r);
+        };
+    }
+
+    public CollectionPlan Plan { get; }
+
+    public ITransport Transport { get; }
+
+    public string DevCd => Plan.DevCd;
+
+    public DeviceSessionState State => _session.State;
+
+    public LinkEventKind? LastLink { get; private set; }
+
+    public InitRoutineResult? LastInit { get; private set; }
+
+    /// <summary>START 성공 후 true, STOP·PAUSE 성공 또는 초기화 루틴 뒤 false</summary>
+    public bool Measuring { get; private set; }
+
+    public event EventHandler<ValuesEventArgs>? Values;
+    public event EventHandler<DeviceSessionState>? StateChanged;
+    public event EventHandler<InitRoutineResult>? InitCompleted;
+    public event EventHandler<LinkEvent>? LinkChanged;
+    public event EventHandler<string>? Warning;
+
+    /// <summary>연결 시작. 첫 연결이 실패해도 예외 없이 재연결을 이어간다 (상태는 이벤트로)</summary>
+    public async Task StartAsync(CancellationToken cancellationToken = default)
+    {
+        await _link.StartAsync(cancellationToken).ConfigureAwait(false);
+        await _session.StartAsync().ConfigureAwait(false);
+    }
+
+    /// <summary>
+    /// 실험 동작 실행. ptlCd 를 주지 않으면 계획에서 해당 동작(START/STOP/PAUSE)이 지정된 프로토콜을 쓴다 (서버 PTL_ACTION → 내장).
+    /// </summary>
+    public async Task<(string? PtlCd, CommandResult Result)> ExecuteActionAsync(
+        CommandAction action, string? ptlCd = null, CancellationToken cancellationToken = default)
+    {
+        string? cd = string.IsNullOrWhiteSpace(ptlCd)
+            ? Plan.Protocols.FirstOrDefault(p => p.Action == action)?.PtlCd
+            : Plan.Protocols.FirstOrDefault(p => string.Equals(p.PtlCd, ptlCd.Trim(), StringComparison.OrdinalIgnoreCase))?.PtlCd;
+        if (cd is null)
+        {
+            string why = string.IsNullOrWhiteSpace(ptlCd) ? $"{action} 동작 프로토콜이 계획에 없습니다." : $"계획에 없는 프로토콜: {ptlCd}";
+            return (null, new CommandResult(CommandStatus.Rejected, null, 0, why));
+        }
+
+        CommandResult result = await _session.ExecuteAsync(cd, cancellationToken).ConfigureAwait(false);
+        if (result.Ok)
+        {
+            if (action == CommandAction.Start) Measuring = true;
+            else if (action is CommandAction.Stop or CommandAction.Pause) Measuring = false;
+        }
+        return (cd, result);
+    }
+
+    /// <summary>측정 중이면 STOP 을 먼저 보내고(최대 3초) 세션·연결을 닫는다</summary>
+    public async Task StopAsync()
+    {
+        if (Interlocked.Exchange(ref _stopped, 1) == 1) return;
+        if (Measuring && Transport.State == TransportState.Open)
+        {
+            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(3));
+            try { await ExecuteActionAsync(CommandAction.Stop, null, cts.Token).ConfigureAwait(false); }
+            catch { /* 종료 중 STOP 실패는 무시 (재연결 시 초기화 루틴이 STOP 을 먼저 보낸다) */ }
+        }
+        await _session.StopAsync().ConfigureAwait(false);
+        await _link.DisposeAsync().ConfigureAwait(false);
+    }
+
+    public ValueTask DisposeAsync() => new(StopAsync());
+}
diff --git a/desktop/tests/juprovider.tests.protocol/C6aTerminalTests.cs b/desktop/tests/juprovider.tests.protocol/C6aTerminalTests.cs
new file mode 100644
index 0000000..3b5bed6
--- /dev/null
+++ b/desktop/tests/juprovider.tests.protocol/C6aTerminalTests.cs
@@ -0,0 +1,275 @@
+using System.Collections.Concurrent;
+using System.Text.Json;
+using JuProvider.Lib.Device.Models;
+using JuProvider.Lib.Ipc.Messages;
+using JuProvider.Lib.Ipc.Pipe;
+using JuProvider.Lib.Protocol.Mapping;
+using JuProvider.Lib.Protocol.Model;
+using JuProvider.Lib.Protocol.Runtime;
+using JuProvider.Lib.Protocol.Scheduling;
+using JuProvider.Lib.Protocol.Session;
+using JuProvider.Lib.Protocol.Sync;
+using JuProvider.Lib.Protocol.Transport;
+using JuProvider.Terminal.Runtime;
+
+namespace JuProvider.Tests.Protocol;
+
+/// <summary>
+/// C6a Terminal 수집 엔진: CollectionPlan + LinkSupervisor + DeviceSession, IPC(DevicePlanSync·DeviceAction·DataValues),
+/// 가상 GTEC(내장 ProfileSimulator, 서버 값만) 전체 수집·중지·재연결 E2E, 기존 가상 장치 회귀.
+/// </summary>
+public class C6aTerminalTests
+{
+    private const string Dev = "SDEV_GTEC01";
+    private const string VirtualConn = """{"transport":"VIRTUAL","profile":"GTEC_SCIENCE_CUBE"}""";
+    private static readonly string[] MappedKeys = ["DG_GTEC01/GTEC-DATA-01/1", "DG_GTEC01/GTEC-DATA-02/2", "DG_GTEC01/GTEC-DATA-03/3"];
+    private static readonly ReconnectPolicy FastPolicy = new([TimeSpan.FromMilliseconds(100)], TimeSpan.FromMilliseconds(200), TimeSpan.FromMilliseconds(400));
+
+    /// <summary>서버 응답(C5c 형태) 그대로. 초기화 대기만 줄인다</summary>
+    private static string GroupJson() => ServerPlanTests.ServerProtocolsJson.Replace("\"initDelayMs\": 500", "\"initDelayMs\": 50");
+
+    private static DevicePlanSyncMessage PlanInput(string? connection = VirtualConn) => new()
+    {
+        DevCd = Dev, PtlGrpCd = "GTEC", Source = "server", Revision = "r2",
+        GroupJson = GroupJson(), DataTagsJson = CollectionTests.TagsJson, DataMapJson = ServerPlanTests.DataMapJson,
+        ConnectionJson = connection
+    };
+
+    private static DeviceSyncModel SerialDevice() => new()
+    {
+        DevCd = Dev, DevType = "DEVI0001", DevComm = "DEVC0003", PtlGrpCd = "GTEC", DevCh = 4, DevDatCnt = 4, UseYn = "YENO0001", DevNm = "GTEC"
+    };
+
+    private static DeviceSyncModel LegacyVirtual() => new()
+    {
+        DevCd = "VDEV_LEGACY01", DevType = "DEVI0000", DevComm = "DEVC0000", DevCh = 3, DevDatCnt = 3, UseYn = "YENO0001", DevNm = "가상"
+    };
+
+    // ---------- 계획·연결 설정 ----------
+
+    [Fact] // 서버 응답 원문 → 계획: 서버 값 우선 (C5d 와 같음)
+    public void PlanReader_Builds_Server_First_Plan_From_Raw_Responses()
+    {
+        CollectionPlan plan = CollectionPlanReader.Build(Dev, GroupJson(), CollectionTests.TagsJson, ServerPlanTests.DataMapJson, CollectionProfile.Empty("GTEC"));
+        Assert.Equal("GTEC", plan.PtlGrpCd);
+        Assert.Equal(new[] { "GTEC0301", "GTEC0001", "GTEC0002", "GTEC0100" }, plan.Session.InitRoutine);
+        Assert.Equal(200, plan.Scheduler.InterCommandGapMs);
+        Assert.Equal(4, plan.MapEntries.Count);
+        Assert.All(new[] { "frame", "cmdGapMs", "initRoutine", "map" }, k => Assert.Equal(PlanSource.Server, plan.Sources[k]));
+        Assert.Throws<FormatException>(() => CollectionPlanReader.Build(Dev, "{\"revision\":\"x\",\"items\":[]}", null, null));
+        Assert.Throws<FormatException>(() => CollectionPlanReader.Build(Dev, "not json", null, null));
+    }
+
+    [Fact] // 로컬 덮어쓰기 → DEV_CONFIG, transport 없으면 장치유형으로
+    public void ConnectionResolver_Local_Overrides_Server_And_Fills_Transport()
+    {
+        var (json, src) = ConnectionResolver.Resolve("DEVI0001", """{"portName":"COM3","baudRate":115200}""", """{"portName":"COM6"}""");
+        Assert.Equal(ConnectionResolver.SourceLocal, src);
+        Assert.Contains("\"transport\":\"SERIAL\"", json);
+        Assert.Contains("COM3", json);
+        (json, src) = ConnectionResolver.Resolve("DEVI0001", null, """{"serialPort":"COM6","baudRate":115200}""");
+        Assert.Equal(ConnectionResolver.SourceServer, src);
+        Assert.IsType<SerialTransport>(TransportFactory.FromLocalConfig(json));
+        Assert.Throws<TransportConfigException>(() => ConnectionResolver.Resolve("DEVI0001", null, null));
+        Assert.Throws<TransportConfigException>(() => ConnectionResolver.Resolve("DEVI9999", "{}", null));
+    }
+
+    [Fact] // IPC 메시지 직렬화 왕복 (키는 메시지에 없다)
+    public void Ipc_Messages_Round_Trip()
+    {
+        var plan = IpcMessage.Create(IpcMessageTypes.DevicePlanSync, PlanInput()).GetPayload<DevicePlanSyncMessage>()!;
+        Assert.Equal(Dev, plan.DevCd);
+        Assert.Equal(GroupJson(), plan.GroupJson);
+        Assert.DoesNotContain("clientKey", JsonSerializer.Serialize(plan), StringComparison.OrdinalIgnoreCase);
+        var act = IpcMessage.Create(IpcMessageTypes.DeviceAction, new DeviceActionMessage { DevCd = Dev, Action = "START" }).GetPayload<DeviceActionMessage>()!;
+        Assert.Equal("START", act.Action);
+        var t0 = DateTimeOffset.Now;
+        var vals = IpcMessage.Create(IpcMessageTypes.DataValues, new DataValuesMessage
+        {
+            DevCd = Dev, PtlCd = "GTEC0400",
+            Values = [new DataValueItem { ChannelKey = "1", DataKey = MappedKeys[0], DatGrCd = "DG_GTEC01", DatCd = "GTEC-DATA-01", DatIdx = 1, Value = 1.5, Quality = "Good", ReceivedAt = t0 }]
+        }).GetPayload<DataValuesMessage>()!;
+        Assert.Equal(1.5, vals.Values.Single().Value);
+        Assert.Equal(t0, vals.Values.Single().ReceivedAt);
+    }
+
+    // ---------- 수집 엔진 단독 ----------
+
+    [Fact] // 가상 GTEC(내장 시뮬레이터) + 서버 값: 초기화 → START → 수집·매핑 → STOP → 분리 → 자동 재연결·루틴 재실행 → 수집 → STOP
+    public async Task CollectionRuntime_Virtual_Gtec_Full_Cycle_With_Reconnect()
+    {
+        CollectionPlan plan = CollectionPlanReader.Build(Dev, GroupJson(), CollectionTests.TagsJson, ServerPlanTests.DataMapJson);
+        var transport = (VirtualTransport)TransportFactory.FromLocalConfig(VirtualConn);
+        await using var rt = new CollectionRuntime(plan, transport, FastPolicy);
+        var values = new ConcurrentQueue<LogicalValue>();
+        var inits = new ConcurrentQueue<InitRoutineResult>();
+        var links = new ConcurrentQueue<LinkEventKind>();
+        rt.Values += (_, e) => { foreach (var v in e.Values) values.Enqueue(v); };
+        rt.InitCompleted += (_, r) => inits.Enqueue(r);
+        rt.LinkChanged += (_, e) => links.Enqueue(e.Kind);
+
+        await rt.StartAsync();
+        Assert.True(await Wait.UntilAsync(() => inits.Count == 1, 5000), "초기화 루틴");
+        Assert.True(inits.Single().AllOk, string.Join(",", inits.Single().Steps.Select(s => $"{s.Key}:{s.Value.Status}")));
+        Assert.Equal(DeviceSessionState.Ready, rt.State);
+
+        var (startCd, start) = await rt.ExecuteActionAsync(CommandAction.Start);
+        Assert.Equal("GTEC0300", startCd);
+        Assert.True(start.Ok);
+        Assert.True(rt.Measuring);
+        Assert.True(await Wait.UntilAsync(() => values.Count >= 9, 3000), $"values {values.Count}");
+        Assert.Equal(MappedKeys, values.Select(v => v.Data!.Key).Distinct().OrderBy(x => x, StringComparer.Ordinal));
+        Assert.All(values, v => Assert.Equal(DataQuality.Good, v.Quality));
+
+        var (stopCd, stop) = await rt.ExecuteActionAsync(CommandAction.Stop);
+        Assert.Equal("GTEC0301", stopCd);
+        Assert.True(stop.Ok);
+        Assert.False(rt.Measuring);
+        await Task.Delay(300);
+        int n = values.Count;
+        await Task.Delay(400);
+        Assert.Equal(n, values.Count);
+
+        // 측정 중 분리 → 감독자가 다시 열고 세션이 루틴(STOP 먼저)을 다시 돈다
+        Assert.True((await rt.ExecuteActionAsync(CommandAction.Start)).Result.Ok);
+        Assert.True(await Wait.UntilAsync(() => values.Count > n, 3000));
+        transport.ForceDisconnect();
+        Assert.True(await Wait.UntilAsync(() => inits.Count == 2, 8000), "재연결 후 루틴 재실행");
+        Assert.True(inits.Last().AllOk);
+        Assert.False(rt.Measuring);
+        Assert.Contains(LinkEventKind.Faulted, links);
+        Assert.Contains(LinkEventKind.Recovered, links);
+
+        while (values.TryDequeue(out _)) { }
+        Assert.True((await rt.ExecuteActionAsync(CommandAction.Start)).Result.Ok);
+        Assert.True(await Wait.UntilAsync(() => values.Count >= 6, 3000), "재연결 후 데이터");
+        Assert.True((await rt.ExecuteActionAsync(CommandAction.Stop)).Result.Ok);
+
+        var (none, rej) = await rt.ExecuteActionAsync(CommandAction.Pause);
+        Assert.Null(none);
+        Assert.Equal(CommandStatus.Rejected, rej.Status);
+    }
+
+    // ---------- Terminal 런타임 관리자 ----------
+
+    [Fact] // 계획 → 연결 → START → 값(IPC 형식, data-map TAG) → STOP → 해제. 상태·경고 전달
+    public async Task Manager_Plan_Connect_Action_Values_Disconnect()
+    {
+        var mgr = new DeviceRuntimeManager { ReconnectPolicy = FastPolicy };
+        var values = new ConcurrentQueue<DataValuesMessage>();
+        var states = new ConcurrentQueue<DeviceRuntimeStateMessage>();
+        mgr.ValuesReceived += values.Enqueue;
+        mgr.RuntimeStateChanged += states.Enqueue;
+
+        mgr.SyncDevices([SerialDevice()]);
+        await Assert.ThrowsAsync<NotSupportedException>(() => mgr.ConnectAsync(Dev)); // 계획 전: 기존처럼 미지원
+
+        Assert.False(mgr.ApplyPlan(new DevicePlanSyncMessage { DevCd = Dev, PtlGrpCd = "GTEC", GroupJson = "x" }));
+        Assert.Contains(states, s => s.Event == "ERROR" && s.Message!.Contains("수집 계획 오류"));
+        Assert.True(mgr.ApplyPlan(PlanInput()));
+        DeviceRuntimeStateMessage planState = states.Last(s => s.Event == "PLAN");
+        Assert.True(planState.ServerItems > 0 && planState.ServerItems <= planState.TotalItems, $"{planState.ServerItems}/{planState.TotalItems}");
+        Assert.NotEmpty(planState.Warnings); // GTEC0101·0401 역할 없음 등
+
+        Assert.True(await mgr.ConnectAsync(Dev));
+        Assert.True(await Wait.UntilAsync(() => states.Any(s => s.Event == "INIT" && s.InitOk == true), 5000));
+        Assert.Equal("local", states.Last(s => s.Event == "INIT").ConnectionSource);
+
+        DeviceActionResultMessage r = await mgr.ExecuteActionAsync(new DeviceActionMessage { DevCd = Dev, Action = "start" });
+        Assert.True(r.Ok, r.Message);
+        Assert.Equal("GTEC0300", r.PtlCd);
+        Assert.True(await Wait.UntilAsync(() => values.Sum(v => v.Values.Count) >= 9, 3000));
+        Assert.All(values, m => Assert.Equal("GTEC0400", m.PtlCd));
+        Assert.Equal(MappedKeys, values.SelectMany(m => m.Values).Select(v => v.DataKey!).Distinct().OrderBy(x => x, StringComparer.Ordinal));
+        Assert.All(values.SelectMany(m => m.Values), v => Assert.Equal("Good", v.Quality));
+
+        Assert.True((await mgr.ExecuteActionAsync(new DeviceActionMessage { DevCd = Dev, Action = "STOP" })).Ok);
+        Assert.False((await mgr.ExecuteActionAsync(new DeviceActionMessage { DevCd = Dev, Action = "JUMP" })).Ok);
+        Assert.False((await mgr.ExecuteActionAsync(new DeviceActionMessage { DevCd = "NONE", Action = "START" })).Ok);
+
+        await mgr.DisconnectAsync(Dev);
+        Assert.Null(mgr.GetCollection(Dev));
+        Assert.Contains(states, s => s.Event == "STOPPED");
+    }
+
+    [Fact] // 측정 중 해제하면 STOP 을 먼저 보낸다 (장비가 측정 상태로 남지 않게)
+    public async Task Manager_Disconnect_While_Measuring_Sends_Stop()
+    {
+        var mgr = new DeviceRuntimeManager { ReconnectPolicy = FastPolicy };
+        mgr.SyncDevices([SerialDevice()]);
+        Assert.True(mgr.ApplyPlan(PlanInput()));
+        Assert.True(await mgr.ConnectAsync(Dev));
+        CollectionRuntime rt = mgr.GetCollection(Dev)!;
+        Assert.True(await Wait.UntilAsync(() => rt.LastInit?.AllOk == true, 5000));
+        Assert.True((await mgr.ExecuteActionAsync(new DeviceActionMessage { DevCd = Dev, Action = "START" })).Ok);
+        Assert.True(rt.Measuring);
+        await mgr.DisconnectAsync(Dev);
+        Assert.False(rt.Measuring);
+        Assert.Equal(DeviceSessionState.Stopped, rt.State);
+    }
+
+    [Fact] // 회귀: 계획 없는 가상 장치는 기존 VirtualDeviceRuntime (DATA_RECEIVED 문자열)
+    public async Task Manager_Legacy_Virtual_Device_Unchanged()
+    {
+        var mgr = new DeviceRuntimeManager();
+        var data = new ConcurrentQueue<string>();
+        mgr.DataReceived += (_, d) => data.Enqueue(d);
+        mgr.SyncDevices([LegacyVirtual(), SerialDevice()]);
+        Assert.True(await mgr.ConnectAsync("VDEV_LEGACY01"));
+        Assert.True(await Wait.UntilAsync(() => !data.IsEmpty, 3000));
+        Assert.Matches(@"^\{\d+\.\d{2},\d+\.\d{2},\d+\.\d{2}\}$", data.First());
+        Assert.Null(mgr.GetCollection("VDEV_LEGACY01"));
+        await mgr.DisconnectAsync("VDEV_LEGACY01");
+        mgr.SyncDevices([SerialDevice()]); // 빠진 장치 제거
+        Assert.Null(mgr.GetDevice("VDEV_LEGACY01"));
+    }
+
+    // ---------- 실제 Named Pipe 로 Client ↔ Terminal ----------
+
+    [Fact] // Client(IpcPipeClient) → Terminal(라우터) 전체: 장치·계획 동기화 → 연결 → START → DATA_VALUES → STOP → 해제
+    public async Task Pipe_E2E_Client_To_Terminal_Collection()
+    {
+        string pipe = "juprovider-c6a-test-" + Guid.NewGuid().ToString("N");
+        var mgr = new DeviceRuntimeManager { ReconnectPolicy = FastPolicy };
+        await using var server = new IpcPipeServer(pipe);
+        var router = new TerminalMessageRouter(mgr, m => server.IsConnected ? server.SendAsync(m) : Task.CompletedTask);
+        server.MessageReceived += router.HandleAsync;
+        server.Start();
+
+        await using var client = new IpcPipeClient(pipe);
+        var got = new ConcurrentQueue<IpcMessage>();
+        client.MessageReceived += m => { got.Enqueue(m); return Task.CompletedTask; };
+        Assert.True(await client.ConnectAsync(5000));
+        Assert.True(await Wait.UntilAsync(() => server.IsConnected, 3000));
+
+        await client.SendAsync(IpcMessage.Create(IpcMessageTypes.DeviceSync, new DeviceSyncMessage { Devices = [SerialDevice(), LegacyVirtual()] }));
+        await client.SendAsync(IpcMessage.Create(IpcMessageTypes.DevicePlanSync, PlanInput()));
+        await client.SendAsync(IpcMessage.Create(IpcMessageTypes.DeviceConnect, new DeviceConnectMessage { DevCd = Dev }));
+
+        T? Find<T>(string type, Func<T, bool> pred) where T : class =>
+            got.Where(m => m.MessageType == type).Select(m => m.GetPayload<T>()).FirstOrDefault(p => p is not null && pred(p));
+
+        Assert.True(await Wait.UntilAsync(() => Find<DeviceRuntimeStateMessage>(IpcMessageTypes.DeviceRuntimeState, s => s.Event == "INIT" && s.InitOk == true) != null, 8000), "INIT");
+        Assert.NotNull(Find<DeviceStatusMessage>(IpcMessageTypes.DeviceStatus, s => s.DevCd == Dev && s.Status == DeviceRuntimeStatus.Connected));
+        Assert.NotNull(Find<DeviceRuntimeStateMessage>(IpcMessageTypes.DeviceRuntimeState, s => s.Event == "PLAN" && s.Warnings.Count > 0));
+
+        await client.SendAsync(IpcMessage.Create(IpcMessageTypes.DeviceAction, new DeviceActionMessage { DevCd = Dev, Action = "START" }));
+        Assert.True(await Wait.UntilAsync(() => got.Count(m => m.MessageType == IpcMessageTypes.DataValues) >= 3, 5000), "DATA_VALUES");
+        Assert.NotNull(Find<DeviceActionResultMessage>(IpcMessageTypes.DeviceActionResult, r => r.Action == "START" && r.Ok && r.PtlCd == "GTEC0300"));
+        var keys = got.Where(m => m.MessageType == IpcMessageTypes.DataValues)
+            .SelectMany(m => m.GetPayload<DataValuesMessage>()!.Values).Select(v => v.DataKey).Distinct().OrderBy(x => x, StringComparer.Ordinal);
+        Assert.Equal(MappedKeys, keys);
+
+        await client.SendAsync(IpcMessage.Create(IpcMessageTypes.DeviceAction, new DeviceActionMessage { DevCd = Dev, Action = "STOP" }));
+        Assert.True(await Wait.UntilAsync(() => Find<DeviceActionResultMessage>(IpcMessageTypes.DeviceActionResult, r => r.Action == "STOP" && r.Ok) != null, 3000));
+
+        // 기존 가상 장치도 같은 파이프로 그대로 (DATA_RECEIVED)
+        await client.SendAsync(IpcMessage.Create(IpcMessageTypes.DeviceConnect, new DeviceConnectMessage { DevCd = "VDEV_LEGACY01" }));
+        Assert.True(await Wait.UntilAsync(() => got.Any(m => m.MessageType == IpcMessageTypes.DataReceived), 4000), "DATA_RECEIVED");
+
+        await client.SendAsync(IpcMessage.Create(IpcMessageTypes.DeviceDisconnect, new DeviceDisconnectMessage { DevCd = Dev }));
+        await client.SendAsync(IpcMessage.Create(IpcMessageTypes.DeviceDisconnect, new DeviceDisconnectMessage { DevCd = "VDEV_LEGACY01" }));
+        Assert.True(await Wait.UntilAsync(() => Find<DeviceStatusMessage>(IpcMessageTypes.DeviceStatus, s => s.DevCd == Dev && s.Status == DeviceRuntimeStatus.Disconnected) != null, 5000));
+        Assert.Null(mgr.GetCollection(Dev));
+    }
+}
