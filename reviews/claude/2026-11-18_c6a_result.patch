@@ -0,0 +1,61 @@
+using JuProvider.Lib.Ipc.Messages;
+using JuProvider.Lib.Protocol.Mapping;
+using JuProvider.Lib.Protocol.Runtime;
+using JuProvider.Lib.Protocol.Sync;
+
+namespace JuProvider.Terminal.Runtime;
+
+/// <summary>C6a: 수집 엔진 결과 → IPC 메시지 (lib.ipc 는 lib.protocol 을 참조하지 않으므로 Terminal 에서 변환)</summary>
+public static class CollectionIpcMapper
+{
+    public static DataValueItem ToItem(LogicalValue v) => new()
+    {
+        ChannelKey = v.Channel.ChannelKey,
+        SampleIndex = v.SampleIndex,
+        DataKey = v.Data?.Key,
+        DatGrCd = v.Data?.DatGrCd,
+        DatCd = v.Data?.DatCd,
+        DatIdx = v.Data?.DatIdx,
+        Value = v.Value,
+        Text = v.Text,
+        Unit = v.Unit,
+        Quality = v.Quality.ToString(),
+        ReceivedAt = v.ReceivedAt
+    };
+
+    public static DeviceRuntimeStateMessage State(
+        string devCd,
+        string evt,
+        CollectionRuntime? runtime,
+        DevicePlanSyncMessage? input,
+        CollectionPlan? plan,
+        string? connectionSource,
+        bool includeWarnings,
+        string? message = null)
+    {
+        plan ??= runtime?.Plan;
+        DeviceRuntimeStateMessage m = new()
+        {
+            DevCd = devCd,
+            Event = evt,
+            Session = runtime?.State.ToString(),
+            Link = runtime?.LastLink?.ToString(),
+            Measuring = runtime?.Measuring ?? false,
+            PtlGrpCd = plan?.PtlGrpCd ?? input?.PtlGrpCd,
+            PlanSource = input?.Source,
+            PlanRevision = input?.Revision,
+            ConnectionSource = connectionSource,
+            InitOk = runtime?.LastInit?.AllOk,
+            Message = message
+        };
+        if (runtime?.LastInit is { } init)
+            m.InitSteps = init.Steps.Select(s => $"{s.Key}:{s.Value.Status}").ToList();
+        if (plan is not null)
+        {
+            m.TotalItems = plan.Sources.Count;
+            m.ServerItems = plan.Sources.Count(s => s.Value == PlanSource.Server);
+            if (includeWarnings) m.Warnings = plan.Warnings.ToList();
+        }
+        return m;
+    }
+}
