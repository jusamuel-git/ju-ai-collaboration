@@ -0,0 +1,127 @@
+using System.Diagnostics;
+using JuProvider.Lib.Ipc.Messages;
+
+namespace JuProvider.Terminal.Runtime;
+
+/// <summary>
+/// Client ↔ Terminal IPC 처리 (Program 에서 분리, C6a).
+/// 수신 메시지는 받은 순서대로 처리하고, 송신은 한 번에 하나씩 보낸다 (파이프 동시 쓰기 방지).
+/// </summary>
+public sealed class TerminalMessageRouter
+{
+    private readonly DeviceRuntimeManager _manager;
+    private readonly Func<IpcMessage, Task> _send;
+    private readonly SemaphoreSlim _sendLock = new(1, 1);
+
+    public TerminalMessageRouter(DeviceRuntimeManager manager, Func<IpcMessage, Task> send)
+    {
+        _manager = manager;
+        _send = send;
+        _manager.DataReceived += (devCd, data) => _ = SendAsync(IpcMessageTypes.DataReceived,
+            new DeviceDataMessage { DevCd = devCd, ReceiveDt = DateTime.Now, Data = data });
+        _manager.ValuesReceived += m => _ = SendAsync(IpcMessageTypes.DataValues, m);
+        _manager.RuntimeStateChanged += m => _ = SendAsync(IpcMessageTypes.DeviceRuntimeState, m);
+    }
+
+    public async Task HandleAsync(IpcMessage message)
+    {
+        Debug.WriteLine($"[IPC RECEIVE] {message.MessageType}");
+        switch (message.MessageType)
+        {
+            case IpcMessageTypes.DeviceSync:
+                HandleDeviceSync(message);
+                break;
+            case IpcMessageTypes.DevicePlanSync:
+                HandlePlanSync(message);
+                break;
+            case IpcMessageTypes.DeviceConnect:
+                await HandleDeviceConnectAsync(message);
+                break;
+            case IpcMessageTypes.DeviceDisconnect:
+                await HandleDeviceDisconnectAsync(message);
+                break;
+            case IpcMessageTypes.DeviceAction:
+                await HandleDeviceActionAsync(message);
+                break;
+        }
+    }
+
+    private void HandleDeviceSync(IpcMessage message)
+    {
+        DeviceSyncMessage? payload = message.GetPayload<DeviceSyncMessage>();
+        if (payload == null) return;
+        _manager.SyncDevices(payload.Devices);
+        Debug.WriteLine($"[DEVICE SYNC] Count = {payload.Devices.Count}");
+    }
+
+    private void HandlePlanSync(IpcMessage message)
+    {
+        DevicePlanSyncMessage? payload = message.GetPayload<DevicePlanSyncMessage>();
+        if (payload == null || string.IsNullOrWhiteSpace(payload.DevCd)) return;
+        _manager.ApplyPlan(payload); // 결과는 DEVICE_RUNTIME_STATE(PLAN/ERROR)로 알린다
+    }
+
+    private async Task HandleDeviceConnectAsync(IpcMessage message)
+    {
+        DeviceConnectMessage? payload = message.GetPayload<DeviceConnectMessage>();
+        if (payload == null || string.IsNullOrWhiteSpace(payload.DevCd)) return;
+        string devCd = payload.DevCd.Trim().ToUpperInvariant();
+        try
+        {
+            await SendStatusAsync(devCd, DeviceRuntimeStatus.Connecting);
+            bool connected = await _manager.ConnectAsync(devCd);
+            await SendStatusAsync(devCd, connected ? DeviceRuntimeStatus.Connected : DeviceRuntimeStatus.Error);
+        }
+        catch (Exception ex)
+        {
+            Debug.WriteLine($"[DEVICE CONNECT ERROR] {devCd} / {ex.Message}");
+            await SendStatusAsync(devCd, DeviceRuntimeStatus.Error, ex.Message);
+        }
+    }
+
+    private async Task HandleDeviceDisconnectAsync(IpcMessage message)
+    {
+        DeviceDisconnectMessage? payload = message.GetPayload<DeviceDisconnectMessage>();
+        if (payload == null || string.IsNullOrWhiteSpace(payload.DevCd)) return;
+        string devCd = payload.DevCd.Trim().ToUpperInvariant();
+        try
+        {
+            await SendStatusAsync(devCd, DeviceRuntimeStatus.Disconnecting);
+            await _manager.DisconnectAsync(devCd);
+            await SendStatusAsync(devCd, DeviceRuntimeStatus.Disconnected);
+        }
+        catch (Exception ex)
+        {
+            Debug.WriteLine($"[DEVICE DISCONNECT ERROR] {devCd} / {ex.Message}");
+            await SendStatusAsync(devCd, DeviceRuntimeStatus.Error, ex.Message);
+        }
+    }
+
+    private async Task HandleDeviceActionAsync(IpcMessage message)
+    {
+        DeviceActionMessage? payload = message.GetPayload<DeviceActionMessage>();
+        if (payload == null || string.IsNullOrWhiteSpace(payload.DevCd)) return;
+        DeviceActionResultMessage result = await _manager.ExecuteActionAsync(payload);
+        await SendAsync(IpcMessageTypes.DeviceActionResult, result);
+    }
+
+    private Task SendStatusAsync(string devCd, string status, string? statusMessage = null) =>
+        SendAsync(IpcMessageTypes.DeviceStatus, new DeviceStatusMessage { DevCd = devCd, Status = status, Message = statusMessage });
+
+    private async Task SendAsync<T>(string type, T payload)
+    {
+        await _sendLock.WaitAsync();
+        try
+        {
+            await _send(IpcMessage.Create(type, payload));
+        }
+        catch (Exception ex)
+        {
+            Debug.WriteLine($"[IPC SEND ERROR] {type} / {ex.Message}");
+        }
+        finally
+        {
+            _sendLock.Release();
+        }
+    }
+}
