+
+    /// <summary>버퍼 끝이 시작 문자의 앞부분과 같으면 그 길이 (다음 조각에서 완성될 수 있으므로 남긴다)</summary>
+    private static int PartialStartSuffix(List<byte> buffer, byte[] start)
+    {
+        for (int k = Math.Min(start.Length - 1, buffer.Count); k > 0; k--)
+        {
+            bool match = true;
+            for (int j = 0; j < k && match; j++) match = buffer[buffer.Count - k + j] == start[j];
+            if (match) return k;
+        }
+        return 0;
+    }
 }
 
