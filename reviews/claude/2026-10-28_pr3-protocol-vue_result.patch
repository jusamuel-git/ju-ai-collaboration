+    form.model = { ...r.data }
+    form.packets = (r.data.packets || []).map(p => ({ ...p }))
+    form.errors = {}
+    form.useYn = r.data.useYn
+    form.open = true
+  } catch (e) {
+    fail(e, '프로토콜 상세 조회에 실패했습니다.')
+  } finally {
+    form.loading = false
+  }
+}
+
+function addPacket() {
+  const next = form.packets.reduce((m, p) => Math.max(m, Number(p.packetSeq) || 0), 0) + 1
