+++ b/juprovider.core/src/main/java/com/asdp/juprovider/core/action/contract/ActionOutputNormalizer.java
@@ -0,0 +1,62 @@
+package com.asdp.juprovider.core.action.contract;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Output 계약 모양 고정 (결정 AC4)
+ *
+ * Map 결과(LIST의 items 원소, RECORD, KEY)를 계약에 선언된 필드만, 선언 순서대로 담은 Map으로 바꾼다.
+ * - 값이 없는 선언 필드는 null로 포함 (필드가 빠지지 않음 → Binding 안정)
+ * - 선언되지 않은 필드는 제외
+ * - LIST 형 필드(원소가 OBJECT)는 원소도 같은 규칙
+ * Map이 아닌 결과(bean 등)와 output 선언이 비어 있는 계약은 그대로 둔다.
+ */
+public final class ActionOutputNormalizer {
+
+    private ActionOutputNormalizer() {
+    }
+
+    public static Object normalize(ActionContract contract, Object data) {
+        if (data == null || contract.output().isEmpty()) {
+            return data;
+        }
+        return switch (contract.outputKind()) {
+            case LIST -> data instanceof ListOutput<?> list
+                    ? new ListOutput<>(normalizeList(contract.output(), list.items()), list.total())
+                    : data;
+            case RECORD, KEY -> normalizeValue(contract.output(), data);
+            case NONE -> data;
+        };
+    }
+
+    private static List<Object> normalizeList(List<FieldSpec> fields, List<?> items) {
+        List<Object> result = new ArrayList<>(items.size());
+        for (Object item : items) {
+            result.add(normalizeValue(fields, item));
+        }
+        return result;
+    }
+
+    private static Object normalizeValue(List<FieldSpec> fields, Object value) {
+        if (!(value instanceof Map<?, ?> map)) {
+            return value;
+        }
+        Map<String, Object> result = new LinkedHashMap<>();
+        for (FieldSpec spec : fields) {
+            Object v = map.get(spec.name());
+            if (v != null && spec.type() == FieldType.LIST
+                    && spec.element() != null
+                    && spec.element().type() == FieldType.OBJECT
+                    && v instanceof List<?> list) {
+                v = normalizeList(spec.element().fields(), list);
+            } else if (v != null && spec.type() == FieldType.OBJECT) {
+                v = normalizeValue(spec.fields(), v);
+            }
+            result.put(spec.name(), v);
+        }
+        return result;
+    }
+}
