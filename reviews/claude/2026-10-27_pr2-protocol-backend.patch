@@ -0,0 +1,45 @@
+package com.asdp.juprovider.core.protocol.action;
+
+import java.util.function.BiFunction;
+
+import com.asdp.juprovider.core.action.ActionHandler;
+import com.asdp.juprovider.core.action.ActionRequest;
+import com.asdp.juprovider.core.action.ActionResult;
+import com.asdp.juprovider.core.action.contract.ActionContract;
+import com.asdp.juprovider.core.action.contract.ActionInput;
+
+/**
+ * 프로토콜 Action Handler 공통: HANDLER_ID = PROTOCOL.{ACT_CD}, 계약 선언, 검증된 입력으로 Service 호출
+ */
+public abstract class ProtocolActionHandler implements ActionHandler {
+
+    private final String handlerId;
+
+    private final ActionContract contract;
+
+    private final BiFunction<ActionInput, String, Object> operation;
+
+    protected ProtocolActionHandler(
+            String actionCode,
+            ActionContract contract,
+            BiFunction<ActionInput, String, Object> operation) {
+        this.handlerId = "PROTOCOL." + actionCode;
+        this.contract = contract;
+        this.operation = operation;
+    }
+
+    @Override
+    public String getHandlerId() {
+        return handlerId;
+    }
+
+    @Override
+    public ActionContract contract() {
+        return contract;
+    }
+
+    @Override
+    public ActionResult<?> execute(ActionRequest request) {
+        return ActionResult.ok(operation.apply(request.getInput(), request.getLangCd()));
+    }
+}
diff --git a/juprovider.core/src/main/java/com/asdp/juprovider/core/protocol/action/ProtocolContracts.java b/juprovider.core/src/main/java/com/asdp/juprovider/core/protocol/action/ProtocolContracts.java
