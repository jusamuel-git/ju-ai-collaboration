index 0000000..0472742
--- /dev/null
+++ b/juprovider.core/src/main/java/com/asdp/juprovider/core/protocol/service/ProtocolService.java
@@ -0,0 +1,422 @@
+package com.asdp.juprovider.core.protocol.service;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.asdp.juprovider.core.action.contract.ActionFieldError;
+import com.asdp.juprovider.core.action.contract.ActionInput;
+import com.asdp.juprovider.core.action.contract.ListOutput;
+import com.asdp.juprovider.core.action.exception.ActionConflictException;
+import com.asdp.juprovider.core.action.exception.ActionNotFoundException;
+import com.asdp.juprovider.core.action.exception.ActionValidationException;
+import com.asdp.juprovider.core.protocol.ProtocolI18nKeys;
+import com.asdp.juprovider.core.protocol.dao.ProtocolDao;
+
+/**
+ * Protocol Reference Implementation 업무 Service (결정 AC8·AC9, PR-Q1~Q5)
+ *
+ * - 쓰기 메서드는 Action 실행 트랜잭션(DynamicActionService) 안에서 호출되며, 단독 호출 시에도 @Transactional
+ * - 삭제는 논리 삭제(USE_YN=YENO0002)
+ * - GRP_CREATE: 그룹 + 기본 프로토콜 {그룹}0000 을 같은 트랜잭션에서 생성 (PR-Q1)
+ * - GRP_DELETE: 장치 + 하위 프로토콜의 실험 참조를 전체 선검사 → 하나라도 사용 중이면 409,
+ *               아니면 Packet → Protocol → Group 순서로 같은 트랜잭션에서 논리 삭제 (PR-Q3)
+ */
+@Service
+public class ProtocolService {
+
+    public static final String YES = "YENO0001";
+
+    public static final String NO = "YENO0002";
+
+    public static final String DEFAULT_PROTOCOL_SUFFIX = "0000";
+
+    public static final String DEFAULT_PROTOCOL_TYPE = "PROT0000";
+
+    public static final String DEFAULT_PROTOCOL_NAME = "기본 TX/RX";
+
+    public static final String DEFAULT_PROTOCOL_DESC = "그룹 생성 시 자동 생성";
+
+    private static final Set<String> DIRECTIONS = Set.of("TX", "RX");
+
+    private final ProtocolDao protocolDao;
+
+    public ProtocolService(ProtocolDao protocolDao) {
+        this.protocolDao = protocolDao;
+    }
+
+    // ===== Group =====
+
+    public ListOutput<Map<String, Object>> searchGroups(ActionInput in, String langCd) {
+        return ListOutput.of(protocolDao.selectGroups(
+                in.getString("keyword"),
+                in.getString("useYn"),
+                langCd));
+    }
+
+    public Map<String, Object> getGroup(ActionInput in, String langCd) {
+        String grp = in.getString("ptlGrpCd");
+        Map<String, Object> group = protocolDao.selectGroup(grp, langCd);
+        if (group == null) {
+            throw new ActionNotFoundException("프로토콜 그룹이 없습니다. ptlGrpCd=" + grp);
+        }
+        return group;
+    }
+
+    @Transactional
+    public Map<String, Object> createGroup(ActionInput in) {
+        String grp = in.getString("ptlGrpCd");
+
+        List<ActionFieldError> errors = new ArrayList<>();
+        Integer polling = positive(in, "pollingIntval", 1, errors);
+        Integer timeout = positive(in, "timeoutMs", 1, errors);
+        Integer retry = positive(in, "retryCnt", 0, errors);
+        failIfAny(errors);
+
+        if (protocolDao.selectGroupUseYn(grp) != null) {
+            throw new ActionConflictException("이미 있는 프로토콜 그룹입니다. ptlGrpCd=" + grp);
+        }
+
+        Map<String, Object> group = new HashMap<>();
+        group.put("ptlGrpCd", grp);
+        group.put("pollingIntval", polling == null ? 1000 : polling);
+        group.put("timeoutMs", timeout == null ? 3000 : timeout);
+        group.put("retryCnt", retry == null ? 3 : retry);
+        group.put("sortOrd", in.has("sortOrd") ? in.getInteger("sortOrd") : 0);
+        protocolDao.insertGroup(group);
+
+        Map<String, Object> detail = new HashMap<>();
+        detail.put("ptlGrpCd", grp);
+        detail.put("ptlGrpNm", in.getString("ptlGrpNm"));
+        detail.put("ptlGrpDesc", in.getString("ptlGrpDesc"));
+        detail.put("nmKey", ProtocolI18nKeys.groupName(grp));
+        detail.put("descKey", ProtocolI18nKeys.groupDesc(grp));
+        protocolDao.insertGroupDetail(detail);
+        upsertLang(ProtocolI18nKeys.groupName(grp), in.getString("ptlGrpNm"));
+        upsertLang(ProtocolI18nKeys.groupDesc(grp), in.getString("ptlGrpDesc"));
+
+        /*
+         * PR-Q1: 기본 프로토콜 {그룹}0000 — 같은 트랜잭션. 실패하면 그룹도 함께 rollback.
+         */
+        String defaultCd = grp + DEFAULT_PROTOCOL_SUFFIX;
+        insertProtocolRows(grp, defaultCd, DEFAULT_PROTOCOL_TYPE, null, null,
+                DEFAULT_PROTOCOL_NAME, DEFAULT_PROTOCOL_DESC);
+
+        return key(grp, null);
+    }
+
+    @Transactional
+    public Map<String, Object> updateGroup(ActionInput in) {
+        String grp = in.getString("ptlGrpCd");
+        if (protocolDao.selectGroupUseYn(grp) == null) {
+            throw new ActionNotFoundException("프로토콜 그룹이 없습니다. ptlGrpCd=" + grp);
+        }
+
+        List<ActionFieldError> errors = new ArrayList<>();
+        Integer polling = positive(in, "pollingIntval", 1, errors);
+        Integer timeout = positive(in, "timeoutMs", 1, errors);
+        Integer retry = positive(in, "retryCnt", 0, errors);
+        String useYn = reactivateOnly(in, errors);
+        failIfAny(errors);
+
+        Map<String, Object> group = new HashMap<>();
+        group.put("ptlGrpCd", grp);
+        group.put("pollingIntval", polling);
+        group.put("timeoutMs", timeout);
+        group.put("retryCnt", retry);
+        group.put("sortOrd", in.has("sortOrd") ? in.getInteger("sortOrd") : null);
+        group.put("useYn", useYn);
+        protocolDao.updateGroup(group);
+
+        Map<String, Object> detail = new HashMap<>();
+        detail.put("ptlGrpCd", grp);
+        detail.put("ptlGrpNm", in.getString("ptlGrpNm"));
+        detail.put("ptlGrpDesc", in.getString("ptlGrpDesc"));
+        protocolDao.updateGroupDetail(detail);
+        upsertLang(ProtocolI18nKeys.groupName(grp), in.getString("ptlGrpNm"));
+        upsertLang(ProtocolI18nKeys.groupDesc(grp), in.getString("ptlGrpDesc"));
+
+        return key(grp, null);
+    }
+
+    @Transactional
+    public Map<String, Object> deleteGroup(ActionInput in) {
+        String grp = in.getString("ptlGrpCd");
+        if (!YES.equals(protocolDao.selectGroupUseYn(grp))) {
+            throw new ActionNotFoundException("사용 중인 프로토콜 그룹이 없습니다. ptlGrpCd=" + grp);
+        }
+
+        /*
+         * PR-Q3: 전체 선검사 — 장치 참조 + 하위 프로토콜의 실험 참조. 하나라도 있으면 409 (아무것도 바꾸지 않음)
+         */
+        List<String> devices = protocolDao.selectActiveDevicesByGroup(grp);
+        List<String> experiments = protocolDao.selectExperimentRefsByGroup(grp);
+        if (!devices.isEmpty() || !experiments.isEmpty()) {
+            throw new ActionConflictException(
+                    "사용 중인 프로토콜 그룹은 삭제할 수 없습니다. ptlGrpCd=" + grp
+                            + (devices.isEmpty() ? "" : ", 장치=" + devices)
+                            + (experiments.isEmpty() ? "" : ", 실험(실험ID:프로토콜)=" + experiments));
+        }
+
+        /*
+         * Packet → Protocol → Group (같은 트랜잭션)
+         */
+        protocolDao.softDeletePacketsByGroup(grp);
+        protocolDao.softDeleteProtocolsByGroup(grp);
+        protocolDao.softDeleteGroup(grp);
+
+        return key(grp, null);
+    }
+
+    // ===== Protocol =====
+
+    public ListOutput<Map<String, Object>> searchProtocols(ActionInput in, String langCd) {
+        return ListOutput.of(protocolDao.selectProtocols(
+                in.getString("ptlGrpCd"),
+                in.getString("keyword"),
+                in.getString("useYn"),
+                langCd));
+    }
+
+    public Map<String, Object> getProtocol(ActionInput in, String langCd) {
+        String grp = in.getString("ptlGrpCd");
+        String cd = in.getString("ptlCd");
+        Map<String, Object> protocol = protocolDao.selectProtocol(grp, cd, langCd);
+        if (protocol == null) {
+            throw new ActionNotFoundException("프로토콜이 없습니다. ptlGrpCd=" + grp + ", ptlCd=" + cd);
+        }
+        Map<String, Object> result = new LinkedHashMap<>(protocol);
+        result.put("packets", protocolDao.selectPackets(grp, cd));
+        return result;
+    }
+
+    @Transactional
+    public Map<String, Object> createProtocol(ActionInput in) {
+        String grp = in.getString("ptlGrpCd");
+        String cd = in.getString("ptlCd");
+
+        List<ActionFieldError> errors = new ArrayList<>();
+        Integer len = positive(in, "ptlLen", 0, errors);
+        List<Map<String, Object>> packets = packets(in, grp, cd, errors);
+        failIfAny(errors);
+
+        requireActiveGroup(grp);
+        if (protocolDao.selectProtocolUseYn(grp, cd) != null) {
+            throw new ActionConflictException("이미 있는 프로토콜입니다. ptlGrpCd=" + grp + ", ptlCd=" + cd);
+        }
+
+        insertProtocolRows(grp, cd, in.getString("ptlType"), len, in.getString("ptlVal"),
+                in.getString("ptlNm"), in.getString("ptlDesc"));
+        if (packets != null) {
+            packets.forEach(protocolDao::insertPacket);
+        }
+
+        return key(grp, cd);
+    }
+
+    @Transactional
+    public Map<String, Object> updateProtocol(ActionInput in) {
+        String grp = in.getString("ptlGrpCd");
+        String cd = in.getString("ptlCd");
+
+        List<ActionFieldError> errors = new ArrayList<>();
+        Integer len = positive(in, "ptlLen", 0, errors);
+        String useYn = reactivateOnly(in, errors);
+        List<Map<String, Object>> packets = packets(in, grp, cd, errors);
+        failIfAny(errors);
+
+        if (protocolDao.selectProtocolUseYn(grp, cd) == null) {
+            throw new ActionNotFoundException("프로토콜이 없습니다. ptlGrpCd=" + grp + ", ptlCd=" + cd);
+        }
+        requireActiveGroup(grp);
+
+        Map<String, Object> protocol = new HashMap<>();
+        protocol.put("ptlGrpCd", grp);
+        protocol.put("ptlCd", cd);
+        protocol.put("ptlType", in.getString("ptlType"));
+        protocol.put("ptlLen", len);
+        protocol.put("ptlVal", in.getString("ptlVal"));
+        protocol.put("useYn", useYn);
+        protocolDao.updateProtocol(protocol);
+
+        Map<String, Object> detail = new HashMap<>();
+        detail.put("ptlGrpCd", grp);
+        detail.put("ptlCd", cd);
+        detail.put("ptlNm", in.getString("ptlNm"));
+        detail.put("ptlDesc", in.getString("ptlDesc"));
+        protocolDao.updateProtocolDetail(detail);
+        upsertLang(ProtocolI18nKeys.protocolName(grp, cd), in.getString("ptlNm"));
+        upsertLang(ProtocolI18nKeys.protocolDesc(grp, cd), in.getString("ptlDesc"));
+
+        /*
+         * packets를 보내면 전체 교체 (보내지 않으면 유지)
+         */
+        if (packets != null) {
+            protocolDao.deletePackets(grp, cd);
+            packets.forEach(protocolDao::insertPacket);
+        }
+
+        return key(grp, cd);
+    }
+
+    @Transactional
+    public Map<String, Object> deleteProtocol(ActionInput in) {
+        String grp = in.getString("ptlGrpCd");
+        String cd = in.getString("ptlCd");
+        if (!YES.equals(protocolDao.selectProtocolUseYn(grp, cd))) {
+            throw new ActionNotFoundException("사용 중인 프로토콜이 없습니다. ptlGrpCd=" + grp + ", ptlCd=" + cd);
+        }
+
+        List<String> experiments = protocolDao.selectExperimentRefsByProtocol(cd);
+        if (!experiments.isEmpty()) {
+            throw new ActionConflictException(
+                    "실험에서 사용 중인 프로토콜은 삭제할 수 없습니다. ptlCd=" + cd
+                            + ", 실험(실험ID:프로토콜)=" + experiments);
+        }
+
+        protocolDao.softDeletePackets(grp, cd);
+        protocolDao.softDeleteProtocol(grp, cd);
+
+        return key(grp, cd);
+    }
+
+    // ===== 내부 =====
+
+    private void insertProtocolRows(
+            String grp,
+            String cd,
+            String type,
+            Integer len,
+            String val,
+            String name,
+            String desc) {
+        Map<String, Object> protocol = new HashMap<>();
+        protocol.put("ptlGrpCd", grp);
+        protocol.put("ptlCd", cd);
+        protocol.put("ptlType", type);
+        protocol.put("ptlLen", len);
+        protocol.put("ptlVal", val);
+        protocolDao.insertProtocol(protocol);
+
+        Map<String, Object> detail = new HashMap<>();
+        detail.put("ptlGrpCd", grp);
+        detail.put("ptlCd", cd);
+        detail.put("ptlNm", name);
+        detail.put("ptlDesc", desc);
+        detail.put("nmKey", ProtocolI18nKeys.protocolName(grp, cd));
+        detail.put("descKey", ProtocolI18nKeys.protocolDesc(grp, cd));
+        protocolDao.insertProtocolDetail(detail);
+        upsertLang(ProtocolI18nKeys.protocolName(grp, cd), name);
+        upsertLang(ProtocolI18nKeys.protocolDesc(grp, cd), desc);
+    }
+
+    private void requireActiveGroup(String grp) {
+        String useYn = protocolDao.selectGroupUseYn(grp);
+        if (useYn == null) {
+            throw new ActionNotFoundException("프로토콜 그룹이 없습니다. ptlGrpCd=" + grp);
+        }
+        if (!YES.equals(useYn)) {
+            throw new ActionConflictException("삭제된 프로토콜 그룹입니다. ptlGrpCd=" + grp);
+        }
+    }
+
+    /** LANG0001 값만 저장 (결정 AC9). 값이 없으면 건드리지 않는다. */
+    private void upsertLang(String key, String value) {
+        if (value != null) {
+            protocolDao.upsertMultiLang(ProtocolI18nKeys.BASE_LANG, key, value);
+        }
+    }
+
+    private static Integer positive(ActionInput in, String name, int min, List<ActionFieldError> errors) {
+        if (!in.has(name)) {
+            return null;
+        }
+        Long value = in.getLong(name);
+        if (value < min || value > Integer.MAX_VALUE) {
+            errors.add(new ActionFieldError(name, ActionFieldError.INVALID_VALUE, min + " 이상이어야 합니다."));
+            return null;
+        }
+        return value.intValue();
+    }
+
+    /** 수정 Action의 useYn은 재사용(YENO0001)만 허용. 삭제는 DELETE Action으로만 (선검사 우회 방지) */
+    private static String reactivateOnly(ActionInput in, List<ActionFieldError> errors) {
+        if (!in.has("useYn")) {
+            return null;
+        }
+        String useYn = in.getString("useYn");
+        if (!YES.equals(useYn)) {
+            errors.add(new ActionFieldError("useYn", ActionFieldError.INVALID_VALUE,
+                    "수정에서는 재사용(YENO0001)만 지정할 수 있습니다. 삭제는 삭제 Action을 사용하세요."));
+            return null;
+        }
+        return useYn;
+    }
+
+    private static List<Map<String, Object>> packets(
+            ActionInput in,
+            String grp,
+            String cd,
+            List<ActionFieldError> errors) {
+        List<ActionInput> items = in.getObjectList("packets");
+        if (items == null) {
+            return null;
+        }
+        List<Map<String, Object>> rows = new ArrayList<>();
+        Set<Long> seqs = new HashSet<>();
+        for (int i = 0; i < items.size(); i++) {
+            ActionInput p = items.get(i);
+            String prefix = "packets[" + i + "].";
+            Long seq = p.getLong("packetSeq");
+            if (seq < 1 || seq > Integer.MAX_VALUE) {
+                errors.add(new ActionFieldError(prefix + "packetSeq", ActionFieldError.INVALID_VALUE, "1 이상이어야 합니다."));
+            } else if (!seqs.add(seq)) {
+                errors.add(new ActionFieldError(prefix + "packetSeq", ActionFieldError.DUPLICATE, "패킷 순번이 중복됩니다."));
+            }
+            if (!DIRECTIONS.contains(p.getString("direction"))) {
+                errors.add(new ActionFieldError(prefix + "direction", ActionFieldError.INVALID_VALUE, "TX 또는 RX만 허용됩니다."));
+            }
+            Long count = p.has("dataCount") ? p.getLong("dataCount") : 0L;
+            if (count < 0 || count > Integer.MAX_VALUE) {
+                errors.add(new ActionFieldError(prefix + "dataCount", ActionFieldError.INVALID_VALUE, "0 이상이어야 합니다."));
+            }
+
+            Map<String, Object> row = new HashMap<>();
+            row.put("ptlGrpCd", grp);
+            row.put("ptlCd", cd);
+            row.put("packetSeq", seq);
+            row.put("packetType", p.getString("packetType"));
+            row.put("direction", p.getString("direction"));
+            row.put("packetExpr", p.getString("packetExpr"));
+            row.put("responsePtlCd", p.getString("responsePtlCd"));
+            row.put("parseRule", p.getString("parseRule"));
+            row.put("dataCount", count);
+            row.put("dataType", p.getString("dataType"));
+            row.put("dataPosition", p.getString("dataPosition"));
+            rows.add(row);
+        }
+        return rows;
+    }
+
+    private static void failIfAny(List<ActionFieldError> errors) {
+        if (!errors.isEmpty()) {
+            throw new ActionValidationException(errors);
+        }
+    }
+
+    private static Map<String, Object> key(String grp, String cd) {
+        Map<String, Object> key = new LinkedHashMap<>();
+        key.put("ptlGrpCd", grp);
+        if (cd != null) {
+            key.put("ptlCd", cd);
+        }
+        return key;
+    }
+}
diff --git a/juprovider.core/src/main/resources/mapper/ProtocolMapper.xml b/juprovider.core/src/main/resources/mapper/ProtocolMapper.xml
new file mode 100644
index 0000000..fc157a1
--- /dev/null
+++ b/juprovider.core/src/main/resources/mapper/ProtocolMapper.xml
@@ -0,0 +1,283 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
+        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
+
+<!--
+  Protocol Reference Implementation (결정 AC8·AC9, PR-Q1~Q5)
+  결과 Map의 키는 Action Output 계약 필드명(camelCase)과 같다.
+  useYn 조건: null → 사용 중(YENO0001)만, 'YENO0000' → 전체
+-->
+<mapper namespace="com.asdp.juprovider.core.protocol.dao.ProtocolDao">
+
+    <sql id="useYnFilter">
+        <choose>
+            <when test="useYn == null">AND ${alias}.USE_YN = 'YENO0001'</when>
+            <when test="useYn == 'YENO0000'"></when>
+            <otherwise>AND ${alias}.USE_YN = #{useYn}</otherwise>
+        </choose>
+    </sql>
+
+    <!-- ===== Group ===== -->
+
+    <select id="selectGroups" resultType="map">
+        SELECT g.PTL_GRP_CD                          AS ptlGrpCd,
+               COALESCE(ml.RES_VAL, d.PTL_GRP_NM)    AS ptlGrpNm,
+               COALESCE(md.RES_VAL, d.PTL_GRP_DESC)  AS ptlGrpDesc,
+               g.POLLING_INTVAL                      AS pollingIntval,
+               g.TIMEOUT_MS                          AS timeoutMs,
+               g.RETRY_CNT                           AS retryCnt,
+               g.USE_YN                              AS useYn,
+               g.SORT_ORD                            AS sortOrd,
+               (SELECT COUNT(*) FROM ju_protocol p
+                 WHERE p.PTL_GRP_CD = g.PTL_GRP_CD
+                   AND p.USE_YN = 'YENO0001')        AS protocolCount
+          FROM ju_protocol_group g
+          LEFT JOIN ju_protocol_group_detail d ON d.PTL_GRP_CD = g.PTL_GRP_CD
+          LEFT JOIN ju_multi_lang ml ON ml.LANG_CD = #{langCd} AND ml.RES_KEY = d.PTL_GRP_NM_KEY
+          LEFT JOIN ju_multi_lang md ON md.LANG_CD = #{langCd} AND md.RES_KEY = d.PTL_GRP_DESC_KEY
+         WHERE 1 = 1
+           <include refid="useYnFilter"><property name="alias" value="g"/></include>
+           <if test="keyword != null">
+           AND (g.PTL_GRP_CD LIKE CONCAT('%', #{keyword}, '%')
+                OR COALESCE(ml.RES_VAL, d.PTL_GRP_NM) LIKE CONCAT('%', #{keyword}, '%'))
+           </if>
+         ORDER BY g.SORT_ORD, g.PTL_GRP_CD
+    </select>
+
+    <select id="selectGroup" resultType="map">
+        SELECT g.PTL_GRP_CD                          AS ptlGrpCd,
+               COALESCE(ml.RES_VAL, d.PTL_GRP_NM)    AS ptlGrpNm,
+               COALESCE(md.RES_VAL, d.PTL_GRP_DESC)  AS ptlGrpDesc,
+               g.POLLING_INTVAL                      AS pollingIntval,
+               g.TIMEOUT_MS                          AS timeoutMs,
+               g.RETRY_CNT                           AS retryCnt,
+               g.USE_YN                              AS useYn,
+               g.SORT_ORD                            AS sortOrd,
+               d.PTL_GRP_NM_KEY                      AS ptlGrpNmKey,
+               d.PTL_GRP_DESC_KEY                    AS ptlGrpDescKey,
+               (SELECT COUNT(*) FROM ju_protocol p
+                 WHERE p.PTL_GRP_CD = g.PTL_GRP_CD
+                   AND p.USE_YN = 'YENO0001')        AS protocolCount
+          FROM ju_protocol_group g
+          LEFT JOIN ju_protocol_group_detail d ON d.PTL_GRP_CD = g.PTL_GRP_CD
+          LEFT JOIN ju_multi_lang ml ON ml.LANG_CD = #{langCd} AND ml.RES_KEY = d.PTL_GRP_NM_KEY
+          LEFT JOIN ju_multi_lang md ON md.LANG_CD = #{langCd} AND md.RES_KEY = d.PTL_GRP_DESC_KEY
+         WHERE g.PTL_GRP_CD = #{ptlGrpCd}
+    </select>
+
+    <select id="selectGroupUseYn" resultType="string">
+        SELECT USE_YN FROM ju_protocol_group WHERE PTL_GRP_CD = #{ptlGrpCd}
+    </select>
+
+    <insert id="insertGroup">
+        INSERT INTO ju_protocol_group (PTL_GRP_CD, POLLING_INTVAL, TIMEOUT_MS, RETRY_CNT, USE_YN, SORT_ORD)
+        VALUES (#{ptlGrpCd}, #{pollingIntval}, #{timeoutMs}, #{retryCnt}, 'YENO0001', #{sortOrd})
+    </insert>
+
+    <insert id="insertGroupDetail">
+        INSERT INTO ju_protocol_group_detail (PTL_GRP_CD, PTL_GRP_NM, PTL_GRP_DESC, PTL_GRP_NM_KEY, PTL_GRP_DESC_KEY)
+        VALUES (#{ptlGrpCd}, #{ptlGrpNm}, #{ptlGrpDesc,jdbcType=VARCHAR}, #{nmKey}, #{descKey})
+    </insert>
+
+    <update id="updateGroup">
+        UPDATE ju_protocol_group
+           SET POLLING_INTVAL = COALESCE(#{pollingIntval,jdbcType=INTEGER}, POLLING_INTVAL),
+               TIMEOUT_MS     = COALESCE(#{timeoutMs,jdbcType=INTEGER}, TIMEOUT_MS),
+               RETRY_CNT      = COALESCE(#{retryCnt,jdbcType=INTEGER}, RETRY_CNT),
+               SORT_ORD       = COALESCE(#{sortOrd,jdbcType=INTEGER}, SORT_ORD),
+               USE_YN         = COALESCE(#{useYn,jdbcType=VARCHAR}, USE_YN)
+         WHERE PTL_GRP_CD = #{ptlGrpCd}
+    </update>
+
+    <update id="updateGroupDetail">
+        UPDATE ju_protocol_group_detail
+           SET PTL_GRP_NM   = COALESCE(#{ptlGrpNm,jdbcType=VARCHAR}, PTL_GRP_NM),
+               PTL_GRP_DESC = COALESCE(#{ptlGrpDesc,jdbcType=VARCHAR}, PTL_GRP_DESC)
+         WHERE PTL_GRP_CD = #{ptlGrpCd}
+    </update>
+
+    <!-- GRP_DELETE 선검사: 이 그룹을 쓰는 사용 중 장치 -->
+    <select id="selectActiveDevicesByGroup" resultType="string">
+        SELECT DEV_CD FROM ju_device
+         WHERE PTL_GRP_CD = #{ptlGrpCd}
+           AND USE_YN = 'YENO0001'
+         ORDER BY DEV_CD
+    </select>
+
+    <!-- GRP_DELETE 선검사: 그룹의 사용 중 프로토콜을 참조하는 사용 중 실험 -->
+    <select id="selectExperimentRefsByGroup" resultType="string">
+        SELECT DISTINCT CONCAT(edg.EXP_ID, ':', p.PTL_CD)
+          FROM ju_protocol p
+          JOIN ju_experiment_data_group edg
+            ON p.PTL_CD IN (edg.START_PTL_CD, edg.PAUSE_PTL_CD, edg.STOP_PTL_CD)
+           AND edg.USE_YN = 'YENO0001'
+          JOIN ju_experiment e
+            ON e.EXP_ID = edg.EXP_ID
+           AND e.USE_YN = 'YENO0001'
+         WHERE p.PTL_GRP_CD = #{ptlGrpCd}
+           AND p.USE_YN = 'YENO0001'
+         ORDER BY 1
+    </select>
+
+    <!-- DELETE 선검사: 이 프로토콜을 참조하는 사용 중 실험 -->
+    <select id="selectExperimentRefsByProtocol" resultType="string">
+        SELECT DISTINCT CONCAT(edg.EXP_ID, ':', #{ptlCd})
+          FROM ju_experiment_data_group edg
+          JOIN ju_experiment e
+            ON e.EXP_ID = edg.EXP_ID
+           AND e.USE_YN = 'YENO0001'
+         WHERE #{ptlCd} IN (edg.START_PTL_CD, edg.PAUSE_PTL_CD, edg.STOP_PTL_CD)
+           AND edg.USE_YN = 'YENO0001'
+         ORDER BY 1
+    </select>
+
+    <!-- 논리 삭제 (Packet → Protocol → Group 순서, 같은 Transaction) -->
+    <update id="softDeletePacketsByGroup">
+        UPDATE ju_protocol_packet SET USE_YN = 'YENO0002'
+         WHERE PTL_GRP_CD = #{ptlGrpCd} AND USE_YN = 'YENO0001'
+    </update>
+
+    <update id="softDeleteProtocolsByGroup">
+        UPDATE ju_protocol SET USE_YN = 'YENO0002'
+         WHERE PTL_GRP_CD = #{ptlGrpCd} AND USE_YN = 'YENO0001'
+    </update>
+
+    <update id="softDeleteGroup">
+        UPDATE ju_protocol_group SET USE_YN = 'YENO0002'
+         WHERE PTL_GRP_CD = #{ptlGrpCd}
+    </update>
+
+    <!-- ===== Protocol ===== -->
+
+    <select id="selectProtocols" resultType="map">
+        SELECT p.PTL_GRP_CD                          AS ptlGrpCd,
+               p.PTL_CD                              AS ptlCd,
+               p.PTL_TYPE                            AS ptlType,
+               COALESCE(tl.RES_VAL, td.COM_NM)       AS ptlTypeNm,
+               p.PTL_LEN                             AS ptlLen,
+               COALESCE(ml.RES_VAL, d.PTL_NM)        AS ptlNm,
+               COALESCE(md.RES_VAL, d.PTL_DESC)      AS ptlDesc,
+               p.USE_YN                              AS useYn,
+               (SELECT COUNT(*) FROM ju_protocol_packet k
+                 WHERE k.PTL_GRP_CD = p.PTL_GRP_CD AND k.PTL_CD = p.PTL_CD
+                   AND k.USE_YN = 'YENO0001')        AS packetCount
+          FROM ju_protocol p
+          LEFT JOIN ju_protocol_detail d ON d.PTL_GRP_CD = p.PTL_GRP_CD AND d.PTL_CD = p.PTL_CD
+          LEFT JOIN ju_multi_lang ml ON ml.LANG_CD = #{langCd} AND ml.RES_KEY = d.PTL_NM_KEY
+          LEFT JOIN ju_multi_lang md ON md.LANG_CD = #{langCd} AND md.RES_KEY = d.PTL_DESC_KEY
+          LEFT JOIN ju_com_code_detail td ON td.GRP_CD = 'PROT' AND td.COM_CD = p.PTL_TYPE
+          LEFT JOIN ju_multi_lang tl ON tl.LANG_CD = #{langCd} AND tl.RES_KEY = td.COM_NM_KEY
+         WHERE p.PTL_GRP_CD = #{ptlGrpCd}
+           <include refid="useYnFilter"><property name="alias" value="p"/></include>
+           <if test="keyword != null">
+           AND (p.PTL_CD LIKE CONCAT('%', #{keyword}, '%')
+                OR COALESCE(ml.RES_VAL, d.PTL_NM) LIKE CONCAT('%', #{keyword}, '%'))
+           </if>
+         ORDER BY p.PTL_CD
+    </select>
+
+    <select id="selectProtocol" resultType="map">
+        SELECT p.PTL_GRP_CD                          AS ptlGrpCd,
+               p.PTL_CD                              AS ptlCd,
+               p.PTL_TYPE                            AS ptlType,
+               COALESCE(tl.RES_VAL, td.COM_NM)       AS ptlTypeNm,
+               p.PTL_LEN                             AS ptlLen,
+               p.PTL_VAL                             AS ptlVal,
+               COALESCE(ml.RES_VAL, d.PTL_NM)        AS ptlNm,
+               COALESCE(md.RES_VAL, d.PTL_DESC)      AS ptlDesc,
+               d.PTL_NM_KEY                          AS ptlNmKey,
+               d.PTL_DESC_KEY                        AS ptlDescKey,
+               p.USE_YN                              AS useYn
+          FROM ju_protocol p
+          LEFT JOIN ju_protocol_detail d ON d.PTL_GRP_CD = p.PTL_GRP_CD AND d.PTL_CD = p.PTL_CD
+          LEFT JOIN ju_multi_lang ml ON ml.LANG_CD = #{langCd} AND ml.RES_KEY = d.PTL_NM_KEY
+          LEFT JOIN ju_multi_lang md ON md.LANG_CD = #{langCd} AND md.RES_KEY = d.PTL_DESC_KEY
+          LEFT JOIN ju_com_code_detail td ON td.GRP_CD = 'PROT' AND td.COM_CD = p.PTL_TYPE
+          LEFT JOIN ju_multi_lang tl ON tl.LANG_CD = #{langCd} AND tl.RES_KEY = td.COM_NM_KEY
+         WHERE p.PTL_GRP_CD = #{ptlGrpCd}
+           AND p.PTL_CD = #{ptlCd}
+    </select>
+
+    <select id="selectPackets" resultType="map">
+        SELECT PACKET_SEQ      AS packetSeq,
+               PACKET_TYPE     AS packetType,
+               DIRECTION       AS direction,
+               PACKET_EXPR     AS packetExpr,
+               RESPONSE_PTL_CD AS responsePtlCd,
+               PARSE_RULE      AS parseRule,
+               DATA_COUNT      AS dataCount,
+               DATA_TYPE       AS dataType,
+               DATA_POSITION   AS dataPosition,
+               USE_YN          AS useYn
+          FROM ju_protocol_packet
+         WHERE PTL_GRP_CD = #{ptlGrpCd}
+           AND PTL_CD = #{ptlCd}
+           AND USE_YN = 'YENO0001'
+         ORDER BY PACKET_SEQ
+    </select>
+
+    <select id="selectProtocolUseYn" resultType="string">
+        SELECT USE_YN FROM ju_protocol WHERE PTL_GRP_CD = #{ptlGrpCd} AND PTL_CD = #{ptlCd}
+    </select>
+
+    <insert id="insertProtocol">
+        INSERT INTO ju_protocol (PTL_GRP_CD, PTL_CD, PTL_TYPE, PTL_LEN, PTL_VAL, USE_YN)
+        VALUES (#{ptlGrpCd}, #{ptlCd}, #{ptlType}, #{ptlLen,jdbcType=INTEGER}, #{ptlVal,jdbcType=VARCHAR}, 'YENO0001')
+    </insert>
+
+    <insert id="insertProtocolDetail">
+        INSERT INTO ju_protocol_detail (PTL_GRP_CD, PTL_CD, PTL_NM, PTL_DESC, PTL_NM_KEY, PTL_DESC_KEY)
+        VALUES (#{ptlGrpCd}, #{ptlCd}, #{ptlNm}, #{ptlDesc,jdbcType=VARCHAR}, #{nmKey}, #{descKey})
+    </insert>
+
+    <update id="updateProtocol">
+        UPDATE ju_protocol
+           SET PTL_TYPE = COALESCE(#{ptlType,jdbcType=VARCHAR}, PTL_TYPE),
+               PTL_LEN  = COALESCE(#{ptlLen,jdbcType=INTEGER}, PTL_LEN),
+               PTL_VAL  = COALESCE(#{ptlVal,jdbcType=VARCHAR}, PTL_VAL),
+               USE_YN   = COALESCE(#{useYn,jdbcType=VARCHAR}, USE_YN)
+         WHERE PTL_GRP_CD = #{ptlGrpCd}
+           AND PTL_CD = #{ptlCd}
+    </update>
+
+    <update id="updateProtocolDetail">
+        UPDATE ju_protocol_detail
+           SET PTL_NM   = COALESCE(#{ptlNm,jdbcType=VARCHAR}, PTL_NM),
+               PTL_DESC = COALESCE(#{ptlDesc,jdbcType=VARCHAR}, PTL_DESC)
+         WHERE PTL_GRP_CD = #{ptlGrpCd}
+           AND PTL_CD = #{ptlCd}
+    </update>
+
+    <delete id="deletePackets">
+        DELETE FROM ju_protocol_packet WHERE PTL_GRP_CD = #{ptlGrpCd} AND PTL_CD = #{ptlCd}
+    </delete>
+
+    <insert id="insertPacket">
+        INSERT INTO ju_protocol_packet
+            (PTL_GRP_CD, PTL_CD, PACKET_SEQ, PACKET_TYPE, DIRECTION, PACKET_EXPR, RESPONSE_PTL_CD,
+             PARSE_RULE, DATA_COUNT, DATA_TYPE, DATA_POSITION, USE_YN)
+        VALUES
+            (#{ptlGrpCd}, #{ptlCd}, #{packetSeq}, #{packetType,jdbcType=VARCHAR}, #{direction},
+             #{packetExpr,jdbcType=VARCHAR}, #{responsePtlCd,jdbcType=VARCHAR}, #{parseRule,jdbcType=VARCHAR},
+             #{dataCount}, #{dataType,jdbcType=VARCHAR}, #{dataPosition,jdbcType=VARCHAR}, 'YENO0001')
+    </insert>
+
+    <update id="softDeletePackets">
+        UPDATE ju_protocol_packet SET USE_YN = 'YENO0002'
+         WHERE PTL_GRP_CD = #{ptlGrpCd} AND PTL_CD = #{ptlCd} AND USE_YN = 'YENO0001'
+    </update>
+
+    <update id="softDeleteProtocol">
+        UPDATE ju_protocol SET USE_YN = 'YENO0002'
+         WHERE PTL_GRP_CD = #{ptlGrpCd} AND PTL_CD = #{ptlCd}
+    </update>
+
+    <!-- ===== 다국어 (결정 AC9) ===== -->
+
+    <insert id="upsertMultiLang">
+        INSERT INTO ju_multi_lang (LANG_CD, RES_KEY, RES_VAL)
+        VALUES (#{langCd}, #{resKey}, #{resVal})
+        ON DUPLICATE KEY UPDATE RES_VAL = VALUES(RES_VAL)
+    </insert>
+
+</mapper>
