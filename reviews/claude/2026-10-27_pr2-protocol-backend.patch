+++ b/database/migration/06_protocol_actions.sql
@@ -0,0 +1,85 @@
+-- ============================================================
+-- Protocol Reference Implementation: 프로토콜관리(M02010100) Menu Action
+-- 2026-10-27 (결정 AC1~AC13, PR-Q1~Q5)
+-- 05_ju1_auth.sql 다음에 실행한다. 여러 번 실행해도 결과가 같다. 스키마 변경 없음.
+-- MNU_ID는 MNU_CD로 찾는다 (대리키 하드코딩 없음).
+-- ============================================================
+SET NAMES utf8mb4;
+
+-- 1) Action (ACT_CD, ACT_KIND, HANDLER_ID, SORT_ORD)
+INSERT INTO ju_menu_action (MNU_ID, ACT_CD, ACT_KIND, HANDLER_ID, USE_YN, ENABLED_YN, SORT_ORD)
+SELECT m.MNU_ID, v.ACT_CD, v.ACT_KIND, v.HANDLER_ID, 'YENO0001', 'YENO0001', v.SORT_ORD
+  FROM ju_menu m
+  JOIN (
+        SELECT 'GRP_SEARCH' AS ACT_CD, 'MACT0001' AS ACT_KIND, 'PROTOCOL.GRP_SEARCH' AS HANDLER_ID, 10 AS SORT_ORD
+        UNION ALL SELECT 'GRP_GET',    'MACT0001', 'PROTOCOL.GRP_GET',    20
+        UNION ALL SELECT 'GRP_CREATE', 'MACT0003', 'PROTOCOL.GRP_CREATE', 30
+        UNION ALL SELECT 'GRP_UPDATE', 'MACT0004', 'PROTOCOL.GRP_UPDATE', 40
+        UNION ALL SELECT 'GRP_DELETE', 'MACT0005', 'PROTOCOL.GRP_DELETE', 50
+        UNION ALL SELECT 'SEARCH',     'MACT0001', 'PROTOCOL.SEARCH',     60
+        UNION ALL SELECT 'GET',        'MACT0001', 'PROTOCOL.GET',        70
+        UNION ALL SELECT 'CREATE',     'MACT0003', 'PROTOCOL.CREATE',     80
+        UNION ALL SELECT 'UPDATE',     'MACT0004', 'PROTOCOL.UPDATE',     90
+        UNION ALL SELECT 'DELETE',     'MACT0005', 'PROTOCOL.DELETE',     100
+       ) v
+ WHERE m.MNU_CD = 'M02010100'
+   AND NOT EXISTS (SELECT 1 FROM ju_menu_action a WHERE a.MNU_ID = m.MNU_ID AND a.ACT_CD = v.ACT_CD)
+ ORDER BY v.SORT_ORD;
+
+-- 2) Action 표시정보 (다국어 키 = ACTION.PROTOCOL.{ACT_CD}.NM/.DESC)
+INSERT INTO ju_menu_action_detail (ACT_ID, ACT_NM, ACT_DESC, ACT_NM_KEY, ACT_DESC_KEY)
+SELECT a.ACT_ID, v.ACT_NM, v.ACT_DESC,
+       CONCAT('ACTION.PROTOCOL.', a.ACT_CD, '.NM'),
+       CONCAT('ACTION.PROTOCOL.', a.ACT_CD, '.DESC')
+  FROM ju_menu m
+  JOIN ju_menu_action a ON a.MNU_ID = m.MNU_ID
+  JOIN (
+        SELECT 'GRP_SEARCH' AS ACT_CD, '그룹조회' AS ACT_NM, '프로토콜 그룹 목록을 조회합니다.' AS ACT_DESC
+        UNION ALL SELECT 'GRP_GET',    '그룹상세', '프로토콜 그룹 상세정보를 조회합니다.'
+        UNION ALL SELECT 'GRP_CREATE', '그룹추가', '프로토콜 그룹을 등록하고 기본 프로토콜을 만듭니다.'
+        UNION ALL SELECT 'GRP_UPDATE', '그룹수정', '프로토콜 그룹 정보를 수정합니다.'
+        UNION ALL SELECT 'GRP_DELETE', '그룹삭제', '프로토콜 그룹과 하위 프로토콜을 삭제합니다.'
+        UNION ALL SELECT 'SEARCH',     '조회',     '프로토콜 목록을 조회합니다.'
+        UNION ALL SELECT 'GET',        '상세조회', '프로토콜과 패킷 정의를 조회합니다.'
+        UNION ALL SELECT 'CREATE',     '추가',     '프로토콜을 등록합니다.'
+        UNION ALL SELECT 'UPDATE',     '수정',     '프로토콜과 패킷 정의를 수정합니다.'
+        UNION ALL SELECT 'DELETE',     '삭제',     '프로토콜을 삭제합니다.'
+       ) v ON v.ACT_CD = a.ACT_CD
+ WHERE m.MNU_CD = 'M02010100'
+   AND NOT EXISTS (SELECT 1 FROM ju_menu_action_detail d WHERE d.ACT_ID = a.ACT_ID);
+
+-- 3) 다국어 (Action명)
+INSERT INTO ju_multi_lang (LANG_CD, RES_KEY, RES_VAL)
+SELECT v.LANG_CD, v.RES_KEY, v.RES_VAL
+  FROM (
+        SELECT 'LANG0001' AS LANG_CD, 'ACTION.PROTOCOL.GRP_SEARCH.NM' AS RES_KEY, '그룹조회' AS RES_VAL
+        UNION ALL SELECT 'LANG0001', 'ACTION.PROTOCOL.GRP_GET.NM',    '그룹상세'
+        UNION ALL SELECT 'LANG0001', 'ACTION.PROTOCOL.GRP_CREATE.NM', '그룹추가'
+        UNION ALL SELECT 'LANG0001', 'ACTION.PROTOCOL.GRP_UPDATE.NM', '그룹수정'
+        UNION ALL SELECT 'LANG0001', 'ACTION.PROTOCOL.GRP_DELETE.NM', '그룹삭제'
+        UNION ALL SELECT 'LANG0001', 'ACTION.PROTOCOL.SEARCH.NM',     '조회'
+        UNION ALL SELECT 'LANG0001', 'ACTION.PROTOCOL.GET.NM',        '상세조회'
+        UNION ALL SELECT 'LANG0001', 'ACTION.PROTOCOL.CREATE.NM',     '추가'
+        UNION ALL SELECT 'LANG0001', 'ACTION.PROTOCOL.UPDATE.NM',     '수정'
+        UNION ALL SELECT 'LANG0001', 'ACTION.PROTOCOL.DELETE.NM',     '삭제'
+        UNION ALL SELECT 'LANG0002', 'ACTION.PROTOCOL.GRP_SEARCH.NM', 'Search groups'
+        UNION ALL SELECT 'LANG0002', 'ACTION.PROTOCOL.GRP_GET.NM',    'Group detail'
+        UNION ALL SELECT 'LANG0002', 'ACTION.PROTOCOL.GRP_CREATE.NM', 'Add group'
+        UNION ALL SELECT 'LANG0002', 'ACTION.PROTOCOL.GRP_UPDATE.NM', 'Edit group'
+        UNION ALL SELECT 'LANG0002', 'ACTION.PROTOCOL.GRP_DELETE.NM', 'Delete group'
+        UNION ALL SELECT 'LANG0002', 'ACTION.PROTOCOL.SEARCH.NM',     'Search'
+        UNION ALL SELECT 'LANG0002', 'ACTION.PROTOCOL.GET.NM',        'Detail'
+        UNION ALL SELECT 'LANG0002', 'ACTION.PROTOCOL.CREATE.NM',     'Add'
+        UNION ALL SELECT 'LANG0002', 'ACTION.PROTOCOL.UPDATE.NM',     'Edit'
+        UNION ALL SELECT 'LANG0002', 'ACTION.PROTOCOL.DELETE.NM',     'Delete'
+       ) v
+ WHERE EXISTS (SELECT 1 FROM ju_language l WHERE l.LANG_CD = v.LANG_CD)
+   AND NOT EXISTS (SELECT 1 FROM ju_multi_lang x WHERE x.LANG_CD = v.LANG_CD AND x.RES_KEY = v.RES_KEY);
+
+-- 확인
+SELECT a.ACT_CD, a.ACT_KIND, a.HANDLER_ID, d.ACT_NM
+  FROM ju_menu m
+  JOIN ju_menu_action a ON a.MNU_ID = m.MNU_ID
+  LEFT JOIN ju_menu_action_detail d ON d.ACT_ID = a.ACT_ID
+ WHERE m.MNU_CD = 'M02010100'
+ ORDER BY a.SORT_ORD;
