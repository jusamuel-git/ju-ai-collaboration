+        Action = action,
+        Priority = priority,
+        Expect = noExpect ? null : expect ?? ResponseMatcher.StartsWith("{"),
+        TimeoutMs = timeoutMs,
+        RetryCount = retry,
+        Idempotent = idempotent,
+        CorrelationKey = key
+    };
