@@ -0,0 +1,85 @@
+using JuProvider.Lib.Protocol.Simulation;
+using JuProvider.Lib.Protocol.Transport;
+
+namespace JuProvider.Tests.Protocol;
+
+public class ProfileAndConfigTests
+{
+    [Fact]
+    public void BuiltIn_Profiles_Parse()
+    {
+        foreach (string id in new[] { "GTEC_SCIENCE_CUBE", "GENERIC_ECHO", "GENERIC_STREAM" })
+        {
+            Assert.Equal(id, BuiltInProfiles.Get(id).ProfileId);
+        }
+        Assert.Throws<ProfileFormatException>(() => BuiltInProfiles.Get("NOPE"));
+    }
+
+    [Theory]
+    [InlineData("""{"profileId":"X"}""")]                                                     // v 없음
+    [InlineData("""{"v":1}""")]                                                               // id 없음
+    [InlineData("""{"v":1,"profileId":"X","responses":[{"reply":"A"}]}""")]                   // match 없음
+    [InlineData("""{"v":1,"profileId":"X","responses":[{"match":"A","matchRegex":"A","reply":"B"}]}""")]
+    [InlineData("""{"v":1,"profileId":"X","responses":[{"match":"A"}]}""")]                   // reply/set 없음
+    [InlineData("""{"v":1,"profileId":"X","responses":[{"matchRegex":"(","reply":"B"}]}""")]  // 잘못된 정규식
+    [InlineData("""{"v":1,"profileId":"X","streams":[{"frame":"A"}]}""")]                     // everyMs 없음
+    [InlineData("""{"v":1,"profileId":"X","generators":{"g":{"type":"noise"}}}""")]
+    [InlineData("""{"v":1,"profileId":"X","generators":{"g":{"type":"sequence"}}}""")]
+    [InlineData("""{"v":1,"profileId":"X","vars":{"a":[1]}}""")]
+    [InlineData("""not json""")]
+    public void Invalid_Profiles(string json)
+    {
+        Assert.ThrowsAny<FormatException>(() => DeviceProfile.Parse(json));
+    }
+
+    [Fact]
+    public void ReconnectPolicy_Default_Delays()
+    {
+        ReconnectPolicy p = ReconnectPolicy.Default;
+        int[] expected = { 1, 2, 3, 5, 10, 20, 40, 60, 60, 60 };
+        for (int i = 0; i < expected.Length; i++) Assert.Equal(TimeSpan.FromSeconds(expected[i]), p.DelayFor(i + 1));
+        Assert.Equal(TimeSpan.FromSeconds(60), p.DelayFor(1000));
+        Assert.Throws<ArgumentOutOfRangeException>(() => p.DelayFor(0));
+    }
+
+    [Fact]
+    public async Task Factory_Builds_Transports()
+    {
+        await using ITransport serial = TransportFactory.FromLocalConfig("""{"transport":"serial","portName":"COM6","baudRate":115200,"parity":"even","stopBits":"Two"}""");
+        var s = Assert.IsType<SerialTransport>(serial);
+        Assert.Equal(new SerialSettings("COM6", 115200, 8, System.IO.Ports.Parity.Even, System.IO.Ports.StopBits.Two), s.Settings);
+
+        await using ITransport legacyKeys = TransportFactory.FromLocalConfig("""{"transport":"SERIAL","serialPort":"COM3","timeoutMs":500}""");
+        Assert.Equal(500, ((SerialTransport)legacyKeys).Settings.WriteTimeoutMs);
+
+        await using ITransport tcp = TransportFactory.FromLocalConfig("""{"transport":"TCP","ip":"10.0.0.1","port":"5000"}""");
+        Assert.Equal("TCP 10.0.0.1:5000", tcp.Name);
+
+        await using ITransport v = TransportFactory.FromLocalConfig("""{"transport":"VIRTUAL","profile":"GENERIC_ECHO","faults":{"dropRate":0.1,"seed":7}}""");
+        Assert.Equal("VIRTUAL GENERIC_ECHO", v.Name);
+    }
+
+    [Theory]
+    [InlineData("""{"portName":"COM1"}""")]                          // transport 없음
+    [InlineData("""{"transport":"USB"}""")]
+    [InlineData("""{"transport":"SERIAL"}""")]                       // 포트 없음
+    [InlineData("""{"transport":"SERIAL","portName":"COM1","parity":"Maybe"}""")]
+    [InlineData("""{"transport":"SERIAL","portName":"COM1","baudRate":"fast"}""")]
+    [InlineData("""{"transport":"TCP","host":"h"}""")]               // port 없음
+    [InlineData("""{"transport":"TCP","host":"h","port":70000}""")]
+    [InlineData("""{"transport":"VIRTUAL","profile":"NOPE"}""")]
+    [InlineData("""[1]""")]
+    public void Factory_Rejects_Invalid(string json)
+    {
+        Assert.Throws<TransportConfigException>(() => TransportFactory.FromLocalConfig(json));
+    }
+
+    [Fact] // S1 없는 COM 포트 → 예외 + Faulted (장비 없이 확인 가능한 범위)
+    public async Task Serial_Missing_Port_Faults()
+    {
+        await using var t = new SerialTransport(new SerialSettings("COM250"));
+        await Assert.ThrowsAnyAsync<Exception>(() => t.OpenAsync());
+        Assert.Equal(TransportState.Faulted, t.State);
+        Assert.Equal("SERIAL COM250", t.Name);
+    }
+}
diff --git a/desktop/tests/juprovider.tests.protocol/TcpTransportTests.cs b/desktop/tests/juprovider.tests.protocol/TcpTransportTests.cs
new file mode 100644
index 0000000..16faf0b
--- /dev/null
+++ b/desktop/tests/juprovider.tests.protocol/TcpTransportTests.cs
@@ -0,0 +1,110 @@
+using System.Net;
+using System.Net.Sockets;
+using System.Text;
+using JuProvider.Lib.Protocol.Transport;
+
+namespace JuProvider.Tests.Protocol;
+
+/// <summary>로컬 루프백 TCP 서버로 백그라운드 수신·조각·종료·재연결 확인</summary>
+public class TcpTransportTests
+{
+    private static TcpListener Listen()
+    {
+        var l = new TcpListener(IPAddress.Loopback, 0);
+        l.Start();
+        return l;
+    }
+
+    private static int PortOf(TcpListener l) => ((IPEndPoint)l.LocalEndpoint).Port;
+
+    [Fact] // T1 조각난 연속 수신 → Framer가 프레임 복원, 쓰기 전달
+    public async Task Receives_Fragmented_Stream_And_Writes()
+    {
+        using TcpListener listener = Listen();
+        await using var t = new TcpClientTransport("127.0.0.1", PortOf(listener));
+        var frames = new FrameCollector(t);
+
+        Task<TcpClient> accept = listener.AcceptTcpClientAsync();
+        await t.OpenAsync();
+        using TcpClient server = await accept;
+        NetworkStream s = server.GetStream();
+
+        byte[] data = Encoding.ASCII.GetBytes("{1 2 3}\r\n{4 5 6}\r\n{7 8 9}\r\n");
+        foreach (byte b in data)
+        {
+            await s.WriteAsync(new[] { b });
+            await s.FlushAsync();
+        }
+
+        Assert.True(await Wait.UntilAsync(() => frames.Frames.Count == 3), "프레임 3개 수신");
+        Assert.Equal(new[] { "{1 2 3}", "{4 5 6}", "{7 8 9}" }, frames.Snapshot());
+        Assert.Equal(TransportState.Open, t.State);
+
+        await t.WriteAsync(Encoding.ASCII.GetBytes("S{10,1}\r\n"));
+        var buf = new byte[64];
+        int n = await s.ReadAsync(buf).AsTask().WaitAsync(TimeSpan.FromSeconds(3));
+        Assert.Equal("S{10,1}\r\n", Encoding.ASCII.GetString(buf, 0, n));
+    }
+
+    [Fact] // T2 상대 종료 → Faulted
+    public async Task Peer_Close_Faults()
+    {
+        using TcpListener listener = Listen();
+        await using var t = new TcpClientTransport("127.0.0.1", PortOf(listener));
+        var states = new List<TransportState>();
+        t.StateChanged += (_, e) => { lock (states) states.Add(e.State); };
+
+        Task<TcpClient> accept = listener.AcceptTcpClientAsync();
+        await t.OpenAsync();
+        (await accept).Dispose();
+
+        Assert.True(await Wait.UntilAsync(() => t.State == TransportState.Faulted));
+        lock (states) Assert.Equal(new[] { TransportState.Opening, TransportState.Open, TransportState.Faulted }, states);
+        await Assert.ThrowsAsync<InvalidOperationException>(() => t.WriteAsync(new byte[] { 1 }));
+    }
+
+    [Fact] // T3 열 수 없는 포트 → 예외 + Faulted
+    public async Task Open_Refused_Faults()
+    {
+        int port;
+        using (TcpListener l = Listen()) { port = PortOf(l); l.Stop(); }
+        await using var t = new TcpClientTransport("127.0.0.1", port, connectTimeoutMs: 2000);
+        await Assert.ThrowsAnyAsync<Exception>(() => t.OpenAsync());
+        Assert.Equal(TransportState.Faulted, t.State);
+    }
+
+    [Fact] // T4 끊김 후 LinkSupervisor가 다시 연결 (Recovered)
+    public async Task Supervisor_Reconnects_After_Peer_Close()
+    {
+        using TcpListener listener = Listen();
+        var t = new TcpClientTransport("127.0.0.1", PortOf(listener));
+        var policy = new ReconnectPolicy([TimeSpan.FromMilliseconds(20)], TimeSpan.FromMilliseconds(40), TimeSpan.FromMilliseconds(80));
+        await using var sup = new LinkSupervisor(t, policy);
+        var events = new List<LinkEventKind>();
+        sup.Event += (_, e) => { lock (events) events.Add(e.Kind); };
+
+        Task<TcpClient> accept1 = listener.AcceptTcpClientAsync();
+        await sup.StartAsync();
+        TcpClient first = await accept1;
+        Task<TcpClient> accept2 = listener.AcceptTcpClientAsync();
+        first.Dispose();
+
+        using TcpClient second = await accept2.WaitAsync(TimeSpan.FromSeconds(5));
+        Assert.True(await Wait.UntilAsync(() => { lock (events) return events.Contains(LinkEventKind.Recovered); }));
+        Assert.Equal(TransportState.Open, t.State);
+        lock (events)
+        {
+            Assert.Equal(LinkEventKind.Connected, events[0]);
+            Assert.Contains(LinkEventKind.Faulted, events);
+            Assert.Contains(LinkEventKind.Reconnecting, events);
+        }
+    }
+
+    [Fact]
+    public void Ctor_Validates()
+    {
+        Assert.Throws<ArgumentException>(() => new TcpClientTransport(" ", 1));
+        Assert.Throws<ArgumentOutOfRangeException>(() => new TcpClientTransport("h", 0));
+        Assert.Throws<ArgumentOutOfRangeException>(() => new TcpClientTransport("h", 70000));
+    }
+}
diff --git a/desktop/tests/juprovider.tests.protocol/TransportTestUtil.cs b/desktop/tests/juprovider.tests.protocol/TransportTestUtil.cs
new file mode 100644
index 0000000..c4a5d24
--- /dev/null
+++ b/desktop/tests/juprovider.tests.protocol/TransportTestUtil.cs
@@ -0,0 +1,43 @@
+using System.Collections.Concurrent;
+using System.Text;
+using JuProvider.Lib.Protocol.Framing;
+using JuProvider.Lib.Protocol.Rules;
+using JuProvider.Lib.Protocol.Transport;
+
+namespace JuProvider.Tests.Protocol;
+
+/// <summary>Transport 수신을 CRLF Framer로 모아 문자열 프레임 목록으로 만든다</summary>
+internal sealed class FrameCollector
+{
+    private readonly IFramer _framer = FramerFactory.Create(new FrameRule { Kind = FrameKind.Delim, End = [0x0D, 0x0A] });
+    private readonly object _lock = new();
+    public ConcurrentQueue<string> Frames { get; } = new();
+    public int Chunks;
+    public int Rejected;
+
+    public FrameCollector(ITransport t) => t.Received += (_, data) =>
+    {
+        Interlocked.Increment(ref Chunks);
+        lock (_lock)
+        {
+            foreach (Frame f in _framer.Push(data)) Frames.Enqueue(Encoding.ASCII.GetString(f.Body));
+            Rejected += _framer.Rejections.Count;
+        }
+    };
+
+    public List<string> Snapshot() => Frames.ToList();
+}
+
+internal static class Wait
+{
+    public static async Task<bool> UntilAsync(Func<bool> condition, int timeoutMs = 3000)
+    {
+        var sw = System.Diagnostics.Stopwatch.StartNew();
+        while (sw.ElapsedMilliseconds < timeoutMs)
+        {
+            if (condition()) return true;
+            await Task.Delay(10);
+        }
+        return condition();
+    }
+}
diff --git a/desktop/tests/juprovider.tests.protocol/VirtualTransportTests.cs b/desktop/tests/juprovider.tests.protocol/VirtualTransportTests.cs
new file mode 100644
index 0000000..805aa16
--- /dev/null
+++ b/desktop/tests/juprovider.tests.protocol/VirtualTransportTests.cs
@@ -0,0 +1,212 @@
+using System.Text;
+using JuProvider.Lib.Protocol.Framing;
+using JuProvider.Lib.Protocol.Parsing;
+using JuProvider.Lib.Protocol.Rules;
