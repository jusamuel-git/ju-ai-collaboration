diff --git a/desktop/lib/juprovider.lib.data/Local/LocalUserRepository.cs b/desktop/lib/juprovider.lib.data/Local/LocalUserRepository.cs
new file mode 100644
index 0000000..1b23b67
--- /dev/null
+++ b/desktop/lib/juprovider.lib.data/Local/LocalUserRepository.cs
@@ -0,0 +1,379 @@
+using System.Data.Common;
+using System.Data.OleDb;
+
+namespace JuProvider.Lib.Data.Local;
+
+/*
+ * LOCAL_USER (JU-1c)
+ *
+ * USER_ID          로그인 아이디 (로컬 키)
+ * SERVER_USER_ID   서버 USER_ID
+ * DEVICE_ID        로그인했던 Client ID (다른 Client 자격이면 offline 불가)
+ * OFFLINE_TOKEN    OfflineCredential 검증자 (평문 비밀번호 아님)
+ * LAST_AUTH_DT     마지막 온라인 인증 시각
+ * EXPIRE_DT        offline 허용 만료 시각
+ * ENABLED_YN       Y: offline 허용 / N: 서버가 로그인을 거부해 무효화됨
+ * OFFLINE_FAIL_CNT offline 연속 실패 횟수 (결정 D5)
+ * OFFLINE_LOCK_YN  Y: offline 잠금 (다음 온라인 로그인 성공 시 해제)
+ */
+public sealed class LocalUserRepository
+{
+    public const string Yes = "Y";
+
+    public const string No = "N";
+
+    private readonly LocalDatabase _database;
+
+    public LocalUserRepository(
+        LocalDatabase database
+    )
+    {
+        _database = database;
+    }
+
+    public async Task<LocalUserRecord?> GetAsync(
+        string userId,
+        CancellationToken cancellationToken = default
+    )
+    {
+        await using OleDbConnection connection =
+            _database.CreateConnection();
+
+        await connection.OpenAsync(
+            cancellationToken
+        );
+
+        const string sql =
+            """
+            SELECT
+                USER_ID,
+                SERVER_USER_ID,
+                DEVICE_ID,
+                OFFLINE_TOKEN,
+                LAST_AUTH_DT,
+                EXPIRE_DT,
+                ENABLED_YN,
+                OFFLINE_FAIL_CNT,
+                OFFLINE_LOCK_YN
+            FROM LOCAL_USER
+            WHERE USER_ID = ?
+            """;
+
+        await using OleDbCommand command =
+            new(
+                sql,
+                connection
+            );
+
+        AddText(command, Normalize(userId));
+
+        await using DbDataReader reader =
+            await command.ExecuteReaderAsync(
+                cancellationToken
+            );
+
+        if (!await reader.ReadAsync(cancellationToken))
+        {
+            return null;
+        }
+
+        return new LocalUserRecord
+        {
+            UserId = ReadString(reader, 0) ?? string.Empty,
+            ServerUserId = ReadString(reader, 1),
+            DeviceId = ReadString(reader, 2),
+            OfflineToken = ReadString(reader, 3),
+            LastAuthDt = ReadDate(reader, 4),
+            ExpireDt = ReadDate(reader, 5),
+            EnabledYn = ReadString(reader, 6),
+            OfflineFailCount = reader.IsDBNull(7) ? 0 : Convert.ToInt32(reader.GetValue(7)),
+            OfflineLockYn = ReadString(reader, 8)
+        };
+    }
+
+    /*
+     * 온라인 로그인 성공: 검증자 교체, 만료 갱신, 실패횟수·잠금 해제
+     */
+    public async Task SaveOnlineLoginAsync(
+        string userId,
+        string? serverUserId,
+        string? deviceId,
+        string offlineToken,
+        DateTime authenticatedAt,
+        DateTime expireAt,
+        CancellationToken cancellationToken = default
+    )
+    {
+        string key =
+            Normalize(userId);
+
+        await using OleDbConnection connection =
+            _database.CreateConnection();
+
+        await connection.OpenAsync(
+            cancellationToken
+        );
+
+        const string updateSql =
+            """
+            UPDATE LOCAL_USER
+            SET
+                SERVER_USER_ID = ?,
+                DEVICE_ID = ?,
+                OFFLINE_TOKEN = ?,
+                LAST_AUTH_DT = ?,
+                EXPIRE_DT = ?,
+                ENABLED_YN = 'Y',
+                OFFLINE_FAIL_CNT = 0,
+                OFFLINE_LOCK_YN = 'N'
+            WHERE USER_ID = ?
+            """;
+
+        await using (OleDbCommand update = new(updateSql, connection))
+        {
+            AddText(update, serverUserId);
+            AddText(update, deviceId);
+            AddLongText(update, offlineToken);
+            AddDate(update, authenticatedAt);
+            AddDate(update, expireAt);
+            AddText(update, key);
+
+            if (await update.ExecuteNonQueryAsync(cancellationToken) > 0)
+            {
+                return;
+            }
+        }
+
+        const string insertSql =
+            """
+            INSERT INTO LOCAL_USER
+            (
+                USER_ID,
+                SERVER_USER_ID,
+                DEVICE_ID,
+                OFFLINE_TOKEN,
+                LAST_AUTH_DT,
+                EXPIRE_DT,
+                ENABLED_YN,
+                OFFLINE_FAIL_CNT,
+                OFFLINE_LOCK_YN
+            )
+            VALUES (?, ?, ?, ?, ?, ?, 'Y', 0, 'N')
+            """;
+
+        await using OleDbCommand insert =
+            new(
+                insertSql,
+                connection
+            );
+
+        AddText(insert, key);
+        AddText(insert, serverUserId);
+        AddText(insert, deviceId);
+        AddLongText(insert, offlineToken);
+        AddDate(insert, authenticatedAt);
+        AddDate(insert, expireAt);
+
+        await insert.ExecuteNonQueryAsync(
+            cancellationToken
+        );
+    }
+
+    /*
+     * 서버가 로그인을 거부(401 등)하거나 비밀번호 변경이 필요한 사용자:
+     * offline 허용을 끊는다. 다음 온라인 로그인 성공 시 다시 Y.
+     */
+    public async Task RevokeAsync(
+        string userId,
+        CancellationToken cancellationToken = default
+    )
+    {
+        await ExecuteAsync(
+            "UPDATE LOCAL_USER SET ENABLED_YN = 'N' WHERE USER_ID = ?",
+            Normalize(userId),
+            cancellationToken
+        );
+    }
+
+    /*
+     * offline 실패 1회 기록. maxFailures 이상이면 잠금. 새 실패횟수를 돌려준다.
+     */
+    public async Task<int> RecordOfflineFailureAsync(
+        string userId,
+        int maxFailures,
+        CancellationToken cancellationToken = default
+    )
+    {
+        LocalUserRecord? user =
+            await GetAsync(
+                userId,
+                cancellationToken
+            );
+
+        if (user == null)
+        {
+            return 0;
+        }
+
+        int count =
+            user.OfflineFailCount + 1;
+
+        await using OleDbConnection connection =
+            _database.CreateConnection();
+
+        await connection.OpenAsync(
+            cancellationToken
+        );
+
+        await using OleDbCommand command =
+            new(
+                "UPDATE LOCAL_USER SET OFFLINE_FAIL_CNT = ?, OFFLINE_LOCK_YN = ? WHERE USER_ID = ?",
+                connection
+            );
+
+        command.Parameters.Add(new OleDbParameter { OleDbType = OleDbType.Integer, Value = count });
+        AddText(command, count >= maxFailures ? Yes : No);
+        AddText(command, Normalize(userId));
+
+        await command.ExecuteNonQueryAsync(
+            cancellationToken
+        );
+
+        return count;
+    }
+
+    public async Task ResetOfflineFailuresAsync(
+        string userId,
+        CancellationToken cancellationToken = default
+    )
+    {
+        await ExecuteAsync(
+            "UPDATE LOCAL_USER SET OFFLINE_FAIL_CNT = 0, OFFLINE_LOCK_YN = 'N' WHERE USER_ID = ?",
+            Normalize(userId),
+            cancellationToken
+        );
+    }
+
+    private async Task ExecuteAsync(
+        string sql,
+        string key,
+        CancellationToken cancellationToken
+    )
+    {
+        await using OleDbConnection connection =
+            _database.CreateConnection();
+
+        await connection.OpenAsync(
+            cancellationToken
+        );
+
+        await using OleDbCommand command =
+            new(
+                sql,
+                connection
+            );
+
+        AddText(command, key);
+
+        await command.ExecuteNonQueryAsync(
+            cancellationToken
+        );
+    }
+
+    public static string Normalize(
+        string userId
+    )
+    {
+        return (userId ?? string.Empty).Trim();
+    }
+
+    private static void AddText(
+        OleDbCommand command,
+        string? value
+    )
+    {
+        command.Parameters.Add(
+            new OleDbParameter
+            {
+                OleDbType = OleDbType.VarWChar,
+                Value = (object?)value ?? DBNull.Value
+            }
+        );
+    }
+
+    private static void AddLongText(
+        OleDbCommand command,
+        string? value
+    )
+    {
+        command.Parameters.Add(
+            new OleDbParameter
+            {
+                OleDbType = OleDbType.LongVarWChar,
+                Value = (object?)value ?? DBNull.Value
+            }
+        );
+    }
+
+    private static void AddDate(
+        OleDbCommand command,
+        DateTime value
+    )
+    {
+        command.Parameters.Add(
+            new OleDbParameter
+            {
+                OleDbType = OleDbType.Date,
+                Value = new DateTime(
+                    value.Year,
+                    value.Month,
+                    value.Day,
+                    value.Hour,
+                    value.Minute,
+                    value.Second
+                )
+            }
+        );
+    }
+
+    private static string? ReadString(
+        DbDataReader reader,
+        int index
+    )
+    {
+        return reader.IsDBNull(index)
+            ? null
+            : Convert.ToString(reader.GetValue(index));
+    }
+
+    private static DateTime? ReadDate(
+        DbDataReader reader,
+        int index
+    )
+    {
+        return reader.IsDBNull(index)
+            ? null
+            : Convert.ToDateTime(reader.GetValue(index));
+    }
+}
+
+public sealed class LocalUserRecord
+{
+    public string UserId { get; init; } = string.Empty;
+
+    public string? ServerUserId { get; init; }
+
+    public string? DeviceId { get; init; }
+
+    public string? OfflineToken { get; init; }
+
+    public DateTime? LastAuthDt { get; init; }
+
+    public DateTime? ExpireDt { get; init; }
+
+    public string? EnabledYn { get; init; }
+
+    public int OfflineFailCount { get; init; }
+
+    public string? OfflineLockYn { get; init; }
+}
