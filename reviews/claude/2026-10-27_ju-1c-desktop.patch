new file mode 100644
index 0000000..452878f
--- /dev/null
+++ b/desktop/juprovider.client/LoginForm.cs
@@ -0,0 +1,131 @@
+using JuProvider.Client.Services;
+using JuProvider.Lib.Data.Auth;
+
+namespace juprovider.client;
+
+/*
+ * JU-1c 로그인 화면
+ * - 표시 직후 서버/Client 상태 확인 (ONLINE / OFFLINE / CLIENT_REJECTED)
+ * - 로그인: DesktopAuthService (온라인 우선, 서버 장애 시에만 offline)
+ */
+public sealed class LoginForm : Form
+{
+    private readonly DesktopAuthService _auth;
+
+    private readonly TextBox _loginId = new() { Width = 240 };
+
+    private readonly TextBox _password = new() { Width = 240, UseSystemPasswordChar = true };
+
+    private readonly Button _loginButton = new() { Text = "로그인", Width = 240, Height = 32 };
+
+    private readonly Label _status = new() { AutoSize = false, Width = 300, Height = 40 };
+
+    private readonly Label _message = new() { AutoSize = false, Width = 300, Height = 60, ForeColor = Color.Firebrick };
+
+    public DesktopSession? Session { get; private set; }
+
+    public LoginForm(
+        DesktopAuthService auth
+    )
+    {
+        _auth = auth;
+
+        Text = "JuProvider Client - 로그인";
+        FormBorderStyle = FormBorderStyle.FixedDialog;
+        MaximizeBox = false;
+        MinimizeBox = false;
+        StartPosition = FormStartPosition.CenterScreen;
+        ClientSize = new Size(340, 300);
+        AcceptButton = _loginButton;
+
+        FlowLayoutPanel panel =
+            new()
+            {
+                Dock = DockStyle.Fill,
+                FlowDirection = FlowDirection.TopDown,
+                Padding = new Padding(20),
+                WrapContents = false
+            };
+
+        panel.Controls.Add(_status);
+        panel.Controls.Add(new Label { Text = "아이디", AutoSize = true });
+        panel.Controls.Add(_loginId);
+        panel.Controls.Add(new Label { Text = "비밀번호", AutoSize = true });
+        panel.Controls.Add(_password);
+        panel.Controls.Add(_loginButton);
+        panel.Controls.Add(_message);
+
+        Controls.Add(panel);
+
+        _loginButton.Click += async (_, _) => await LoginAsync();
+        Shown += async (_, _) => await CheckServerAsync();
+    }
+
+    private async Task CheckServerAsync()
+    {
+        _status.Text = "서버 확인 중...";
+        _loginButton.Enabled = false;
+
+        SyncResult sync =
+            await _auth.SyncAsync();
+
+        ShowState(sync);
+        AppLog.Info($"[SYNC] {sync.State} devices={sync.DeviceCount}");
+
+        _loginButton.Enabled = true;
+        _loginId.Focus();
+    }
+
+    private async Task LoginAsync()
+    {
+        _loginButton.Enabled = false;
+        _message.Text = string.Empty;
+        _status.Text = "로그인 중...";
+
+        string loginId =
+            _loginId.Text.Trim();
+
+        DesktopLoginResult result =
+            await _auth.LoginAsync(
+                loginId,
+                _password.Text
+            );
+
+        _password.Clear();
+
+        if (_auth.LastSync != null)
+        {
+            ShowState(_auth.LastSync);
+        }
+
+        AppLog.Info($"[LOGIN] {loginId} {result.Code}");
+
+        if (result.Succeeded)
+        {
+            Session = result.Session;
+            DialogResult = DialogResult.OK;
+            Close();
+            return;
+        }
+
+        _message.Text = result.Message;
+        _loginButton.Enabled = true;
+        _password.Focus();
+    }
+
+    private void ShowState(
+        SyncResult sync
+    )
+    {
+        (string text, Color color) =
+            sync.State switch
+            {
+                ConnectionState.Online => ($"서버 연결됨 (ONLINE) · 장치 {sync.DeviceCount}개", Color.SeaGreen),
+                ConnectionState.Offline => ("서버 연결 안 됨 (OFFLINE) · 이전 로그인 사용자만 가능", Color.DarkOrange),
+                _ => ("Client 인증 실패 (CLIENT_REJECTED) · 로그인 불가", Color.Firebrick)
+            };
+
+        _status.Text = text;
+        _status.ForeColor = color;
+    }
+}
