+                return;
+            }
+
+            _syncLabel.Text = "동기화 중...";
+            SyncResult result = await _auth.SyncAsync();
+            AppLog.Info($"[SYNC] {result.State} devices={result.DeviceCount}");
+            ShowSync(result);
+        }
+
+        private void ShowSync(
+            SyncResult? sync
+        )
+        {
+            _syncLabel.Text =
+                sync == null
+                    ? "서버 상태: 확인 전"
+                    : $"서버 상태: {sync.State switch { ConnectionState.Online => "ONLINE", ConnectionState.Offline => "OFFLINE", _ => "CLIENT_REJECTED" }}   " +
+                      $"마지막 확인: {sync.CheckedAt:yyyy-MM-dd HH:mm:ss}   " +
+                      (sync.State == ConnectionState.Online ? $"장치 {sync.DeviceCount}개 동기화" : (sync.Message ?? string.Empty));
+        }
     }
 }
