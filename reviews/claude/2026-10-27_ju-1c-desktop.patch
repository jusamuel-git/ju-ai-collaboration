@@ -0,0 +1,56 @@
+namespace JuProvider.Lib.Data.Api;
+
+/*
+ * 서버 사용자 API 응답 형식: { success, data, message }
+ */
+public sealed class ApiEnvelope<T>
+{
+    public bool Success { get; set; }
+
+    public T? Data { get; set; }
+
+    public string? Message { get; set; }
+}
+
+/*
+ * POST /api/auth/login 응답 data
+ */
+public sealed class UserLoginData
+{
+    public string? AccessToken { get; set; }
+
+    public DateTimeOffset? ExpiresAt { get; set; }
+
+    public UserLoginInfo? User { get; set; }
+
+    public bool PasswordChangeRequired { get; set; }
+}
+
+public sealed class UserLoginInfo
+{
+    public long? UserId { get; set; }
+
+    public string? LoginId { get; set; }
+
+    public string? UserName { get; set; }
+
+    public long? AuthId { get; set; }
+
+    public string? AuthType { get; set; }
+}
+
+/*
+ * 로그인 호출 결과.
+ * StatusCode 200 + AccessToken = 성공, 4xx = 서버가 거부 (offline fallback 금지).
+ * 연결 실패·타임아웃·5xx는 예외로 올라온다 (호출 측에서 OFFLINE 판정).
+ */
+public sealed class UserLoginResponse
+{
+    public int StatusCode { get; init; }
+
+    public UserLoginData? Data { get; init; }
+
+    public bool IsSuccess =>
+        StatusCode == 200
+        && !string.IsNullOrWhiteSpace(Data?.AccessToken);
+}
diff --git a/desktop/lib/juprovider.lib.data/Api/JuProviderApiClient.cs b/desktop/lib/juprovider.lib.data/Api/JuProviderApiClient.cs
index 453337f..a295a5b 100644
--- a/desktop/lib/juprovider.lib.data/Api/JuProviderApiClient.cs
+++ b/desktop/lib/juprovider.lib.data/Api/JuProviderApiClient.cs
@@ -188,6 +188,59 @@ public sealed class JuProviderApiClient : IDisposable
         return saved;
     }
 
+    /*
+     * User 로그인 (JU-1c)
+     * POST api/auth/login
+     *
+     * 4xx: 서버가 사용자 인증을 거부 → 응답으로 반환 (예외 아님)
+     * 5xx: HttpRequestException (호출 측에서 OFFLINE 판정)
+     * 연결 실패·타임아웃: HttpRequestException / TaskCanceledException
+     */
+    public async Task<UserLoginResponse> LoginAsync(
+        string loginId,
+        string password,
+        CancellationToken cancellationToken = default
+    )
+    {
+        using HttpResponseMessage response =
+            await _httpClient.PostAsJsonAsync(
+                "api/auth/login",
+                new
+                {
+                    loginId,
+                    password
+                },
+                _jsonOptions,
+                cancellationToken
+            );
+
+        int statusCode =
+            (int)response.StatusCode;
+
+        if (statusCode >= 400 && statusCode < 500)
+        {
+            return new UserLoginResponse
+            {
+                StatusCode = statusCode
+            };
+        }
+
+        response.EnsureSuccessStatusCode();
+
+        ApiEnvelope<UserLoginData>? body =
+            await response.Content
+                .ReadFromJsonAsync<ApiEnvelope<UserLoginData>>(
+                    _jsonOptions,
+                    cancellationToken
+                );
+
+        return new UserLoginResponse
+        {
+            StatusCode = statusCode,
+            Data = body?.Data
+        };
+    }
+
     public void Dispose()
     {
         _httpClient.Dispose();
diff --git a/desktop/lib/juprovider.lib.data/Auth/DesktopAuthService.cs b/desktop/lib/juprovider.lib.data/Auth/DesktopAuthService.cs
new file mode 100644
index 0000000..266b64b
--- /dev/null
+++ b/desktop/lib/juprovider.lib.data/Auth/DesktopAuthService.cs
@@ -0,0 +1,435 @@
+using System.Net;
+
+using JuProvider.Lib.Data.Api;
+using JuProvider.Lib.Data.Local;
+using JuProvider.Lib.Device.Models;
+
+namespace JuProvider.Lib.Data.Auth;
+
+/*
+ * JU-1c Desktop: Client 인증 + User 인증 (결정 D1~D8)
+ *
+ * 연결 상태
+ *   ONLINE           Client 키로 동기화 성공
+ *   OFFLINE          연결 실패·타임아웃·5xx (서버 장애)
+ *   CLIENT_REJECTED  Client 키 거부(401/403) 또는 Client 자격 없음 → 로그인 차단
+ *
+ * 로그인
+ *   ONLINE  → 서버 로그인. 4xx(서버 거부)는 offline fallback 금지, 로컬 offline 허용도 끊는다.
+ *   OFFLINE → 같은 Client에서 이전에 온라인 로그인한 사용자만, 만료 전·잠금 아님·검증자 일치 시 허용.
+ *   CLIENT_REJECTED → 로그인 불가 (offline fallback 금지).
+ */
+public sealed class DesktopAuthService
+{
+    public const int OfflineValidDays = 7;
+
+    public const int OfflineMaxFailures = 5;
+
+    private readonly LocalDeviceRepository _deviceRepository;
+
+    private readonly LocalUserRepository _userRepository;
+
+    private readonly string _serverUrl;
+
+    private readonly string? _clientId;
+
+    private readonly string? _clientKey;
+
+    public DesktopAuthService(
+        LocalDeviceRepository deviceRepository,
+        LocalUserRepository userRepository,
+        string serverUrl,
+        string? clientId,
+        string? clientKey
+    )
+    {
+        _deviceRepository = deviceRepository;
+        _userRepository = userRepository;
+        _serverUrl = serverUrl;
+        _clientId = string.IsNullOrWhiteSpace(clientId) ? null : clientId.Trim();
+        _clientKey = string.IsNullOrWhiteSpace(clientKey) ? null : clientKey.Trim();
+    }
+
+    public string ServerUrl => _serverUrl;
+
+    public string? ClientId => _clientId;
+
+    public bool HasClientCredential =>
+        _clientId != null && _clientKey != null;
+
+    public SyncResult? LastSync { get; private set; }
+
+    /*
+     * Server -> Local DB 장치 동기화 (Client 인증 확인 겸용)
+     */
+    public async Task<SyncResult> SyncAsync(
+        CancellationToken cancellationToken = default
+    )
+    {
+        SyncResult result;
+
+        if (!HasClientCredential)
+        {
+            result = new SyncResult(
+                ConnectionState.ClientRejected,
+                0,
+                DateTime.Now,
+                "Client 자격(ClientId/ClientKey)이 설정되지 않았습니다."
+            );
+        }
+        else
+        {
+            try
+            {
+                using JuProviderApiClient apiClient =
+                    CreateApiClient();
+
+                List<DeviceSyncModel> serverDevices =
+                    await apiClient.GetDevicesAsync(
+                        cancellationToken
+                    );
+
+                await _deviceRepository.UpsertAllAsync(
+                    serverDevices,
+                    cancellationToken
+                );
+
+                result = new SyncResult(
+                    ConnectionState.Online,
+                    serverDevices.Count,
+                    DateTime.Now,
+                    null
+                );
+            }
+            catch (Exception ex) when (IsServerFailure(ex, out ConnectionState state))
+            {
+                result = new SyncResult(
+                    state,
+                    0,
+                    DateTime.Now,
+                    state == ConnectionState.ClientRejected
+                        ? "서버가 Client 키를 거부했습니다. 관리자에게 Client 등록/키 재발급을 요청하세요."
+                        : "서버에 연결할 수 없습니다."
+                );
+            }
+        }
+
+        LastSync = result;
+
+        return result;
+    }
+
+    public async Task<DesktopLoginResult> LoginAsync(
+        string loginId,
+        string password,
+        CancellationToken cancellationToken = default
+    )
+    {
+        string userId =
+            LocalUserRepository.Normalize(loginId);
+
+        if (userId.Length == 0 || string.IsNullOrEmpty(password))
+        {
+            return DesktopLoginResult.Fail(LoginResultCode.InvalidInput, "아이디와 비밀번호를 입력하세요.");
+        }
+
+        SyncResult sync =
+            await SyncAsync(
+                cancellationToken
+            );
+
+        if (sync.State == ConnectionState.ClientRejected)
+        {
+            return DesktopLoginResult.Fail(LoginResultCode.ClientRejected, sync.Message ?? "Client 인증 실패");
+        }
+
+        if (sync.State == ConnectionState.Online)
+        {
+            UserLoginResponse response;
+
+            try
+            {
+                using JuProviderApiClient apiClient =
+                    CreateApiClient();
+
+                response = await apiClient.LoginAsync(
+                    userId,
+                    password,
+                    cancellationToken
+                );
+            }
+            catch (Exception ex) when (IsServerFailure(ex, out ConnectionState state)
+                                       && state == ConnectionState.Offline)
+            {
+                return await OfflineLoginAsync(
+                    userId,
+                    password,
+                    cancellationToken
+                );
+            }
+
+            return await CompleteOnlineLoginAsync(
+                userId,
+                password,
+                response,
+                cancellationToken
+            );
+        }
+
+        return await OfflineLoginAsync(
+            userId,
+            password,
+            cancellationToken
+        );
+    }
+
+    private async Task<DesktopLoginResult> CompleteOnlineLoginAsync(
+        string userId,
+        string password,
+        UserLoginResponse response,
+        CancellationToken cancellationToken
+    )
+    {
+        if (!response.IsSuccess)
+        {
+            // 서버 거부(401 등): offline fallback 금지, 기존 offline 허용도 끊는다.
+            await _userRepository.RevokeAsync(userId, cancellationToken);
+
+            return DesktopLoginResult.Fail(
+                LoginResultCode.InvalidCredentials,
+                "아이디 또는 비밀번호가 올바르지 않습니다."
+            );
+        }
+
+        UserLoginData data =
+            response.Data!;
+
+        if (data.PasswordChangeRequired)
+        {
+            await _userRepository.RevokeAsync(userId, cancellationToken);
+
+            return DesktopLoginResult.Fail(
+                LoginResultCode.PasswordChangeRequired,
+                "비밀번호 변경이 필요합니다. 웹 콘솔에서 비밀번호를 변경한 뒤 다시 로그인하세요."
+            );
+        }
+
+        DateTime now = DateTime.Now;
+
+        await _userRepository.SaveOnlineLoginAsync(
+            userId,
+            data.User?.UserId?.ToString(System.Globalization.CultureInfo.InvariantCulture),
+            _clientId,
+            OfflineCredential.Create(password),
+            now,
+            now.AddDays(OfflineValidDays),
+            cancellationToken
+        );
+
+        return DesktopLoginResult.Ok(
+            LoginResultCode.OnlineSuccess,
+            new DesktopSession(
+                userId,
+                data.User?.UserName ?? userId,
+                data.User?.AuthType,
+                ConnectionState.Online,
+                data.AccessToken,
+                data.ExpiresAt
+            )
+        );
+    }
+
+    private async Task<DesktopLoginResult> OfflineLoginAsync(
+        string userId,
+        string password,
+        CancellationToken cancellationToken
+    )
+    {
+        LocalUserRecord? user =
+            await _userRepository.GetAsync(
+                userId,
+                cancellationToken
+            );
+
+        if (user == null
+            || string.IsNullOrWhiteSpace(user.OfflineToken)
+            || !string.Equals(user.DeviceId, _clientId, StringComparison.Ordinal))
+        {
+            return DesktopLoginResult.Fail(
+                LoginResultCode.OfflineNotAvailable,
+                "서버에 연결할 수 없고, 이 PC에서 온라인 로그인한 기록이 없어 오프라인 로그인을 할 수 없습니다."
+            );
+        }
+
+        if (user.EnabledYn != LocalUserRepository.Yes)
+        {
+            return DesktopLoginResult.Fail(
+                LoginResultCode.OfflineDisabled,
+                "오프라인 로그인이 해제된 사용자입니다. 서버 연결 후 다시 로그인하세요."
+            );
+        }
+
+        if (user.OfflineLockYn == LocalUserRepository.Yes)
+        {
+            return DesktopLoginResult.Fail(
+                LoginResultCode.OfflineLocked,
+                "오프라인 로그인이 잠겼습니다. 서버 연결 후 온라인으로 로그인하세요."
+            );
+        }
+
+        if (user.ExpireDt == null || user.ExpireDt.Value < DateTime.Now)
+        {
+            return DesktopLoginResult.Fail(
+                LoginResultCode.OfflineExpired,
+                "오프라인 로그인 기간이 지났습니다. 서버 연결 후 다시 로그인하세요."
+            );
+        }
+
+        if (!OfflineCredential.Verify(password, user.OfflineToken))
+        {
+            int failures =
+                await _userRepository.RecordOfflineFailureAsync(
+                    userId,
+                    OfflineMaxFailures,
+                    cancellationToken
+                );
+
+            return failures >= OfflineMaxFailures
+                ? DesktopLoginResult.Fail(
+                    LoginResultCode.OfflineLocked,
+                    "오프라인 로그인 실패가 계속되어 잠겼습니다. 서버 연결 후 온라인으로 로그인하세요.")
+                : DesktopLoginResult.Fail(
+                    LoginResultCode.InvalidCredentials,
+                    "아이디 또는 비밀번호가 올바르지 않습니다.");
+        }
+
+        await _userRepository.ResetOfflineFailuresAsync(
+            userId,
+            cancellationToken
+        );
+
+        return DesktopLoginResult.Ok(
+            LoginResultCode.OfflineSuccess,
+            new DesktopSession(
+                userId,
+                userId,
+                null,
+                ConnectionState.Offline,
+                null,
+                null
+            )
+        );
+    }
+
+    private JuProviderApiClient CreateApiClient()
+    {
+        return new JuProviderApiClient(
+            _serverUrl,
+            _clientId,
+            _clientKey
+        );
+    }
+
+    /*
+     * 서버 호출 예외 분류
+     *   401/403            → ClientRejected (Client 체인 거부)
+     *   그 외 HTTP 오류·연결 실패·타임아웃 → Offline
+     */
+    private static bool IsServerFailure(
+        Exception ex,
+        out ConnectionState state
+    )
+    {
+        switch (ex)
+        {
+            case HttpRequestException http
+                when http.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden:
+                state = ConnectionState.ClientRejected;
+                return true;
+
+            case HttpRequestException:
+            case TaskCanceledException:
+            case TimeoutException:
+                state = ConnectionState.Offline;
+                return true;
+
+            default:
+                state = ConnectionState.Offline;
+                return false;
+        }
+    }
+}
+
+public enum ConnectionState
+{
+    Online,
+    Offline,
+    ClientRejected
+}
+
+public enum LoginResultCode
+{
+    OnlineSuccess,
+    OfflineSuccess,
+    InvalidInput,
+    InvalidCredentials,
+    PasswordChangeRequired,
+    ClientRejected,
+    OfflineNotAvailable,
+    OfflineDisabled,
+    OfflineLocked,
+    OfflineExpired
+}
+
+public sealed record SyncResult(
+    ConnectionState State,
+    int DeviceCount,
+    DateTime CheckedAt,
+    string? Message
+);
+
+public sealed record DesktopSession(
+    string LoginId,
+    string UserName,
+    string? AuthType,
+    ConnectionState Mode,
+    string? AccessToken,
+    DateTimeOffset? ExpiresAt
+)
+{
+    // 토큰이 로그·화면에 찍히지 않도록 ToString에서 제외한다.
+    public override string ToString() =>
+        $"{LoginId} ({Mode})";
+}
+
+public sealed class DesktopLoginResult
+{
+    public LoginResultCode Code { get; private init; }
+
+    public string? Message { get; private init; }
+
+    public DesktopSession? Session { get; private init; }
+
+    public bool Succeeded =>
+        Session != null;
+
+    public static DesktopLoginResult Ok(
+        LoginResultCode code,
+        DesktopSession session
+    ) =>
+        new()
+        {
+            Code = code,
+            Session = session
+        };
+
+    public static DesktopLoginResult Fail(
+        LoginResultCode code,
+        string message
+    ) =>
+        new()
+        {
+            Code = code,
+            Message = message
+        };
+}
diff --git a/desktop/lib/juprovider.lib.data/Auth/OfflineCredential.cs b/desktop/lib/juprovider.lib.data/Auth/OfflineCredential.cs
new file mode 100644
index 0000000..e31995c
--- /dev/null
+++ b/desktop/lib/juprovider.lib.data/Auth/OfflineCredential.cs
@@ -0,0 +1,128 @@
+using System.Security.Cryptography;
+
+namespace JuProvider.Lib.Data.Auth;
+
+/*
+ * JU-1c offline 검증자 (결정 D1)
+ *
+ * 형식: pbkdf2-sha256${반복}${salt Base64}${hash Base64}
+ *
+ * - 서버 비밀번호 평문이나 서버 BCrypt 해시는 로컬에 저장하지 않는다.
+ * - 온라인 로그인에 성공했을 때만 새로 만든다 (사용자별 새 salt).
+ * - .NET 기본 라이브러리(Rfc2898DeriveBytes)만 사용한다.
+ */
+public static class OfflineCredential
+{
+    public const string Scheme = "pbkdf2-sha256";
+
+    public const int Iterations = 210_000;
+
+    private const int SaltSize = 16;
+
+    private const int HashSize = 32;
+
+    private const int MinIterations = 100_000;
+
+    private const int MaxIterations = 5_000_000;
+
+    public static string Create(
+        string password
+    )
+    {
+        ArgumentException.ThrowIfNullOrEmpty(password);
+
+        byte[] salt =
+            RandomNumberGenerator.GetBytes(
+                SaltSize
+            );
+
+        byte[] hash =
+            Derive(
+                password,
+                salt,
+                Iterations
+            );
+
+        return string.Join(
+            '$',
+            Scheme,
+            Iterations.ToString(System.Globalization.CultureInfo.InvariantCulture),
+            Convert.ToBase64String(salt),
+            Convert.ToBase64String(hash)
+        );
+    }
+
+    public static bool Verify(
+        string password,
+        string? stored
+    )
+    {
+        if (string.IsNullOrEmpty(password)
+            || string.IsNullOrWhiteSpace(stored))
+        {
+            return false;
+        }
+
+        string[] parts =
+            stored.Split('$');
+
+        if (parts.Length != 4
+            || parts[0] != Scheme
+            || !int.TryParse(
+                parts[1],
+                System.Globalization.NumberStyles.None,
+                System.Globalization.CultureInfo.InvariantCulture,
+                out int iterations)
+            || iterations < MinIterations
+            || iterations > MaxIterations)
+        {
+            return false;
+        }
+
+        try
+        {
+            byte[] salt =
+                Convert.FromBase64String(parts[2]);
+
+            byte[] expected =
+                Convert.FromBase64String(parts[3]);
+
+            if (salt.Length != SaltSize
+                || expected.Length != HashSize)
+            {
+                return false;
+            }
+
+            byte[] actual =
+                Derive(
+                    password,
+                    salt,
+                    iterations
+                );
+
+            return CryptographicOperations.FixedTimeEquals(
+                actual,
+                expected
+            );
+        }
+        catch (FormatException)
+        {
+            return false;
+        }
+    }
+
+    private static byte[] Derive(
+        string password,
+        byte[] salt,
+        int iterations
+    )
+    {
+        return Rfc2898DeriveBytes.Pbkdf2(
+            password,
+            salt,
+            iterations,
+            HashAlgorithmName.SHA256,
+            HashSize
+        );
+    }
+}
