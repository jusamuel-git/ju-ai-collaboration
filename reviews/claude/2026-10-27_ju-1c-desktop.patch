@@ -0,0 +1,53 @@
+using System.Diagnostics;
+using System.Text;
+
+namespace JuProvider.Client.Services;
+
+/*
+ * Client 실행 로그: {app}\logs\client_yyyyMMdd.log
+ * 비밀번호·토큰·Client Key는 기록하지 않는다.
+ */
+internal static class AppLog
+{
+    private static readonly object Sync = new();
+
+    public static void Info(
+        string message
+    )
+    {
+        string line =
+            $"{DateTime.Now:yyyy-MM-dd HH:mm:ss} {message}";
+
+        Debug.WriteLine(line);
+
+        try
+        {
+            string directory =
+                Path.Combine(
+                    AppContext.BaseDirectory,
+                    "logs"
+                );
+
+            Directory.CreateDirectory(directory);
+
+            string path =
+                Path.Combine(
+                    directory,
+                    $"client_{DateTime.Now:yyyyMMdd}.log"
+                );
+
+            lock (Sync)
+            {
+                File.AppendAllText(
+                    path,
+                    line + Environment.NewLine,
+                    Encoding.UTF8
+                );
+            }
+        }
+        catch (Exception ex)
+        {
+            Debug.WriteLine($"[LOG ERROR] {ex.Message}");
+        }
+    }
+}
