diff --git a/juprovider.backend/src/test/java/com/asdp/juprovider/core/protocol/ProtocolRulesTest.java b/juprovider.backend/src/test/java/com/asdp/juprovider/core/protocol/ProtocolRulesTest.java
index 477fb8d..cfd6660 100644
--- a/juprovider.backend/src/test/java/com/asdp/juprovider/core/protocol/ProtocolRulesTest.java
+++ b/juprovider.backend/src/test/java/com/asdp/juprovider/core/protocol/ProtocolRulesTest.java
@@ -71,16 +71,32 @@ class ProtocolRulesTest {
                 ok = false;
             }
             assertEquals(v.get("java").asBoolean(), ok, rule);
+            // 서버가 허용하는 regex 는 Desktop(.NET)에서도 해석 가능해야 한다 (D3)
+            assertFalse(v.get("java").asBoolean() && !v.get("dotnet").asBoolean(), "서버 허용·Desktop 불가: " + rule);
             n++;
         }
         for (JsonNode v : root.get("match")) {
             boolean m = java.util.regex.Pattern.compile(v.get("regex").asText()).matcher(v.get("input").asText()).find();
-            assertEquals(v.get("match").asBoolean(), m, v.get("regex").asText() + " / " + v.get("input").asText());
+            boolean expected = v.has("match") ? v.get("match").asBoolean() : v.get("java").asBoolean();
+            assertEquals(expected, m, v.get("regex").asText() + " / " + v.get("input").asText());
             n++;
         }
         assertTrue(n >= 20, "벡터 수 " + n);
     }
 
+    /** D3: Java 에서만 되거나 의미가 다른 문법은 저장 거부, 공통 문법은 허용 */
+    @Test
+    void javaOnlyRegexRejected() {
+        for (String bad : new String[] { "a*+", "a?+", "a{1,2}+", "\\Qx\\E", "\\H", "\\V", "\\X", "\\N{LATIN SMALL LETTER A}",
+                "\\p{javaLowerCase}", "[ab&&b]", "[a[b]]", "(?u)a", "(?iU:a)" }) {
+            assertThrows(ProtocolRules.RuleException.class,
+                    () -> ProtocolRules.validateExpectRule("{\"regex\":\"" + bad.replace("\\", "\\\\") + "\"}"), bad);
+        }
+        for (String ok : new String[] { "^[{][A-Za-z]", "a+?", "a*?b", "(?i)ok", "(?s:.)", "[\\[\\]]", "\\p{L}", "[^}]+", "x{3}", "(?<n>a)\\k<n>" }) {
+            assertDoesNotThrow(() -> ProtocolRules.validateExpectRule("{\"regex\":\"" + ok.replace("\\", "\\\\") + "\"}"), ok);
+        }
+    }
+
     @Test
     void gtecVerifiedValuesPass() {
         assertDoesNotThrow(() -> ProtocolRules.validateFrameRule("{\"v\":1,\"kind\":\"DELIM\",\"start\":\"{\",\"end\":\"[CR][LF]\",\"maxLen\":512}"));
diff --git a/juprovider.core/src/main/java/com/asdp/juprovider/core/protocol/rule/ProtocolRules.java b/juprovider.core/src/main/java/com/asdp/juprovider/core/protocol/rule/ProtocolRules.java
index dbbc0ed..7cab4bf 100644
--- a/juprovider.core/src/main/java/com/asdp/juprovider/core/protocol/rule/ProtocolRules.java
+++ b/juprovider.core/src/main/java/com/asdp/juprovider/core/protocol/rule/ProtocolRules.java
@@ -270,7 +270,110 @@ public final class ProtocolRules {
             } catch (PatternSyntaxException ex) {
                 throw new RuleException("regex 오류: " + ex.getDescription());
             }
+            String javaOnly = javaOnlyRegexSyntax(v);
+            if (javaOnly != null) {
+                throw new RuleException("Desktop(.NET)에서 쓸 수 없거나 의미가 다른 regex 문법입니다: " + javaOnly);
+            }
+        }
+    }
+
+    /**
+     * C5e 준비(D3): 응답 판정 regex 는 Desktop(.NET)에서만 실행된다. Java 에서는 컴파일되지만 .NET 에서 오류이거나 의미가 다른 문법을 막는다.
+     * (.NET 전용 문법은 Java 컴파일에서 이미 오류) — 공통 벡터 rule_vectors.json expect 의 java/dotnet 값으로 양쪽 확인.
+     * 막는 것: 소유 수량자(*+ ++ ?+ {n}+), \Q..\E, \h \H \v \V \R \X \N \x{..} \p{java..},
+     *          문자 클래스 안의 '['(Java 합집합 / .NET 차집합·문자)와 &&(Java 교집합), 인라인 플래그 d·u·U.
+     *
+     * @return 문제 문법 설명, 없으면 null
+     */
+    static String javaOnlyRegexSyntax(String s) {
+        int n = s.length();
+        boolean inClass = false;
+        boolean prevQuantifier = false;
+        for (int i = 0; i < n; i++) {
+            char c = s.charAt(i);
+            if (c == '\\') {
+                if (i + 1 >= n) {
+                    return null;
+                }
+                char d = s.charAt(i + 1);
+                if ("QEhHvVRXN".indexOf(d) >= 0) {
+                    return "\\" + d;
+                }
+                if (d == 'x' && i + 2 < n && s.charAt(i + 2) == '{') {
+                    return "\\x{..}";
+                }
+                if ((d == 'p' || d == 'P') && i + 2 < n && s.charAt(i + 2) == '{') {
+                    int close = s.indexOf('}', i + 3);
+                    if (s.startsWith("java", i + 3)) {
+                        return "\\" + d + "{java..}";
+                    }
+                    i = close < 0 ? n : close;
+                } else {
+                    i++;
+                }
+                prevQuantifier = false;
+                continue;
+            }
+            if (inClass) {
+                if (c == '[') {
+                    return "문자 클래스 안의 '[' (\\[ 로 쓰세요)";
+                }
+                if (c == '&' && i + 1 < n && s.charAt(i + 1) == '&') {
+                    return "문자 클래스 안의 &&";
+                }
+                if (c == ']') {
+                    inClass = false;
+                }
+                continue;
+            }
+            switch (c) {
+                case '[' -> {
+                    inClass = true;
+                    if (i + 1 < n && s.charAt(i + 1) == '^') {
+                        i++;
+                    }
+                    if (i + 1 < n && s.charAt(i + 1) == ']') {
+                        i++;
+                    }
+                    prevQuantifier = false;
+                }
+                case '(' -> {
+                    if (i + 1 < n && s.charAt(i + 1) == '?') {
+                        int j = i + 2;
+                        while (j < n && "idmsuxU-".indexOf(s.charAt(j)) >= 0) {
+                            j++;
+                        }
+                        String flags = s.substring(i + 2, j);
+                        if (!flags.isEmpty() && j < n && (s.charAt(j) == ')' || s.charAt(j) == ':')
+                                && (flags.indexOf('d') >= 0 || flags.indexOf('u') >= 0 || flags.indexOf('U') >= 0)) {
+                            return "인라인 플래그 (?" + flags + ")";
+                        }
+                        i++;
+                    }
+                    prevQuantifier = false;
+                }
+                case '*', '+', '?' -> {
+                    if (prevQuantifier && c == '+') {
+                        return "소유 수량자 '" + s.charAt(i - 1) + "+'";
+                    }
+                    prevQuantifier = !(prevQuantifier && c == '?');
+                }
+                case '{' -> {
+                    int close = s.indexOf('}', i + 1);
+                    if (close > i && s.substring(i + 1, close).matches("[0-9]+(,[0-9]*)?")) {
+                        if (close + 1 < n && s.charAt(close + 1) == '+') {
+                            return "소유 수량자 '" + s.substring(i, close + 1) + "+'";
+                        }
+                        i = close;
+                        prevQuantifier = true;
+                    } else {
+                        prevQuantifier = false;
+                    }
+                }
+                default -> prevQuantifier = false;
+            }
         }
+        return null;
     }
 
     // ===== 공통 =====
