@@ -0,0 +1,57 @@
+using JuProvider.Lib.Protocol.Expression;
+using static JuProvider.Tests.Protocol.TestUtil;
+
+namespace JuProvider.Tests.Protocol;
+
+public class ExpressionTests
+{
+    [Fact] // E1
+    public void SeedExpressions_RoundTrip()
+    {
+        List<string> list = SeedExpressions().ToList();
+        Assert.True(list.Count >= 10, "seed 표현식 목록이 비었습니다.");
+        foreach (string e in list)
+        {
+            byte[] bytes = ProtocolExpression.ToBytes(e);
+            string display = ProtocolExpression.ToDisplay(bytes);
+            Assert.Equal(bytes, ProtocolExpression.ToBytes(display));
+        }
+    }
+
+    [Fact]
+    public void Known_Bytes()
+    {
+        Assert.Equal(new byte[] { 0x53, 0x7B, 0x31, 0x30, 0x2C, 0x31, 0x7D, 0x0D, 0x0A }, B("S{10,1}[CR][LF]"));
+        Assert.Equal(new byte[] { 0x02, 0x41, 0x00, 0x03 }, B("[STX]A[00][ETX]"));
+        Assert.Equal(new byte[] { 0x10, 0xFF }, B("[dle][ff]"));
+        Assert.Empty(ProtocolExpression.ToBytes(null));
+        Assert.Equal("53 7B 0D", ProtocolExpression.Hex(new byte[] { 0x53, 0x7B, 0x0D }));
+    }
+
+    [Fact]
+    public void Display_Escapes_Bracket_And_NonPrintable_For_RoundTrip()
+    {
+        byte[] data = { (byte)'[', (byte)'A', (byte)']', 0x01, 0x0D, 0x7F };
+        string display = ProtocolExpression.ToDisplay(data);
+        Assert.Equal("[5B]A][01][CR][7F]", display);
+        Assert.Equal(data, ProtocolExpression.ToBytes(display));
+    }
+
+    [Theory] // E2
+    [InlineData("S{10,1}[CR")]
+    [InlineData("[XYZ]")]
+    [InlineData("[0G]")]
+    [InlineData("[123]")]
+    [InlineData("가")]
+    public void Invalid_Expression_Throws(string expr)
+    {
+        Assert.Throws<FormatException>(() => ProtocolExpression.ToBytes(expr));
+    }
+
+    [Fact]
+    public void AllBytes_RoundTrip()
+    {
+        byte[] all = Enumerable.Range(0, 256).Select(i => (byte)i).ToArray();
+        Assert.Equal(all, ProtocolExpression.ToBytes(ProtocolExpression.ToDisplay(all)));
+    }
+}
diff --git a/desktop/tests/juprovider.tests.protocol/FrameStartTests.cs b/desktop/tests/juprovider.tests.protocol/FrameStartTests.cs
new file mode 100644
index 0000000..58760e3
--- /dev/null
+++ b/desktop/tests/juprovider.tests.protocol/FrameStartTests.cs
@@ -0,0 +1,85 @@
+using System.Text;
+using JuProvider.Lib.Protocol.Framing;
+using JuProvider.Lib.Protocol.Rules;
+
+namespace JuProvider.Tests.Protocol;
+
+/// <summary>C4 Frame Rule 시작 문자 + 잡음 제거 ({ … }[CR][LF])</summary>
+public class FrameStartTests
+{
+    private static IFramer Gtec() => FramerFactory.Create(new FrameRule { Kind = FrameKind.Delim, Start = "{"u8.ToArray(), End = [0x0D, 0x0A] });
+
+    private static List<string> Push(IFramer f, params string[] chunks)
+    {
+        var bodies = new List<string>();
+        foreach (string c in chunks)
+            foreach (Frame fr in f.Push(Encoding.ASCII.GetBytes(c))) bodies.Add(Encoding.ASCII.GetString(fr.Body));
+        return bodies;
+    }
+
+    [Fact]
+    public void Noise_Before_Start_Is_Dropped()
+    {
+        IFramer f = Gtec();
+        Assert.Equal(new[] { "{1 2 3}" }, Push(f, "xxÿ{1 2 3}\r\n"));
+        Assert.Contains(f.Rejections, r => r.Reason.Contains("잡음"));
+        Assert.Equal(0, f.Pending);
+    }
+
+    [Fact] // 재연결 직후 앞부분이 잘린 프레임은 버리고 다음 정상 프레임부터
+    public void Truncated_Frame_After_Reconnect_Is_Dropped()
+    {
+        IFramer f = Gtec();
+        Assert.Equal(new[] { "{ +4.7E+1 0 0}" }, Push(f, " -0.00000E+0 -0.00000E+0}\r\n{ +4.7E+1 0 0}\r\n"));
+    }
+
+    [Fact] // 끝 없이 다음 { 가 오면 앞의 깨진 조각 제거
+    public void Broken_Frame_Without_End_Is_Dropped()
+    {
+        IFramer f = Gtec();
+        Assert.Equal(new[] { "{3 4 5}" }, Push(f, "{1 2", "{3 4 5}\r\n"));
+        Assert.Contains(f.Rejections, r => r.Reason.Contains("깨진"));
+    }
+
+    [Fact]
+    public void Fragmented_Frames_And_Several_In_One_Chunk()
+    {
+        IFramer f = Gtec();
+        Assert.Empty(Push(f, "{1 2", " 3}\r"));
+        Assert.Equal(new[] { "{1 2 3}", "{4 5 6}" }, Push(f, "\n{4 5 6}\r\n{7"));
+        Assert.Equal(2, f.Pending);
+    }
+
+    [Fact] // 시작 문자 없는 쓰레기만 오면 버퍼에 쌓지 않는다
+    public void Garbage_Only_Is_Not_Buffered()
+    {
+        IFramer f = Gtec();
+        Assert.Empty(Push(f, "garbage without start"));
+        Assert.Equal(0, f.Pending);
+    }
+
+    [Fact] // 여러 바이트 시작 문자: 끝에 걸친 앞부분은 남긴다
+    public void Multi_Byte_Start_Keeps_Partial_Suffix()
+    {
+        IFramer f = FramerFactory.Create(new FrameRule { Kind = FrameKind.Delim, Start = "AB"u8.ToArray(), End = [0x0D, 0x0A] });
+        Assert.Empty(Push(f, "xxA"));
+        Assert.Equal(1, f.Pending);
+        Assert.Equal(new[] { "AB1" }, Push(f, "B1\r\n"));
+    }
+
+    [Fact] // 시작 문자 없으면 기존 동작 그대로
+    public void Without_Start_Behaviour_Unchanged()
+    {
+        IFramer f = FramerFactory.Create(new FrameRule { Kind = FrameKind.Delim, End = [0x0D, 0x0A] });
+        Assert.Equal(new[] { "xx{1}" }, Push(f, "xx{1}\r\n"));
+    }
+
+    [Fact]
+    public void RuleReader_Reads_Start()
+    {
+        FrameRule r = RuleReader.ReadFrameRule("""{"v":1,"kind":"DELIM","start":"{","end":"[CR][LF]"}""")!;
+        Assert.Equal(new byte[] { 0x7B }, r.Start);
+        Assert.Null(RuleReader.ReadFrameRule("""{"v":1,"kind":"DELIM"}""")!.Start);
+        Assert.Throws<RuleFormatException>(() => RuleReader.ReadFrameRule("""{"v":1,"kind":"DELIM","start":""}"""));
+    }
+}
diff --git a/desktop/tests/juprovider.tests.protocol/FramerTests.cs b/desktop/tests/juprovider.tests.protocol/FramerTests.cs
new file mode 100644
index 0000000..e0af5ff
--- /dev/null
+++ b/desktop/tests/juprovider.tests.protocol/FramerTests.cs
@@ -0,0 +1,162 @@
+using JuProvider.Lib.Protocol.Framing;
+using JuProvider.Lib.Protocol.Rules;
+using static JuProvider.Tests.Protocol.TestUtil;
+
+namespace JuProvider.Tests.Protocol;
+
+public class FramerTests
+{
+    private static IFramer Delim() => FramerFactory.Create(RuleReader.ReadFrameRule("""{"v":1,"kind":"DELIM","end":"[CR][LF]"}""")!);
+
+    [Theory] // F1 조각 크기와 무관하게 같은 결과
+    [InlineData(1)]
+    [InlineData(2)]
+    [InlineData(3)]
+    [InlineData(7)]
+    [InlineData(1000)]
+    public void Delim_Fragmented_And_Multiple(int chunk)
+    {
+        byte[] data = B("{1.0 2.0 3.0}[CR][LF]{4 5 6}[CR][LF][CR][LF]{7 8");
+        IFramer f = Delim();
+        List<Frame> frames = PushInChunks(f, data, chunk);
+
+        Assert.Equal(2, frames.Count); // 빈 프레임은 건너뜀, 마지막 미완성은 버퍼에 남음
+        Assert.Equal(B("{1.0 2.0 3.0}"), frames[0].Body);
+        Assert.Equal(B("{4 5 6}[CR][LF]"), frames[1].Raw);
+        Assert.Equal(B("{7 8").Length, f.Pending);
+
+        frames = f.Push(B("}[CR][LF]")).ToList();
+        Assert.Single(frames);
+        Assert.Equal(B("{7 8}"), frames[0].Body);
+    }
+
+    [Fact] // F1 최대 길이 초과 → 버퍼 비움
+    public void Delim_MaxLength_Clears()
+    {
+        IFramer f = FramerFactory.Create(RuleReader.ReadFrameRule("""{"v":1,"kind":"DELIM","end":"[LF]","maxLen":8}""")!);
+        Assert.Empty(f.Push(B("0123456789")));
+        Assert.Single(f.Rejections);
+        Assert.Equal(0, f.Pending);
+        Assert.Single(f.Push(B("ok[LF]")));
+    }
+
+    [Fact] // F2 STX 앞 쓰레기, escape 된 ETX
+    public void StxEtx_Garbage_And_Escape()
+    {
+        IFramer f = FramerFactory.Create(RuleReader.ReadFrameRule("""{"v":1,"kind":"STXETX","stx":"[STX]","etx":"[ETX]","escape":"[DLE]"}""")!);
+        byte[] data = B("xx[STX]A[DLE][ETX]B[DLE][DLE][ETX][STX]C[ETX]");
+        List<Frame> frames = PushInChunks(f, data, 1);
+
+        Assert.Equal(2, frames.Count);
+        Assert.Equal(new byte[] { 0x41, 0x03, 0x42, 0x10 }, frames[0].Body);
+        Assert.Equal(B("C"), frames[1].Body);
+    }
+
+    [Fact]
+    public void StxEtx_Garbage_Is_Reported()
+    {
+        IFramer f = FramerFactory.Create(new FrameRule { Kind = FrameKind.StxEtx });
+        Assert.Single(f.Push(B("zz[STX]A[ETX]")));
+        Assert.Contains(f.Rejections, r => r.Reason == "STX 앞 데이터");
+    }
+
+    [Fact] // F3
+    public void Fixed_Length()
+    {
+        IFramer f = FramerFactory.Create(RuleReader.ReadFrameRule("""{"v":1,"kind":"FIXED","len":3}""")!);
+        List<Frame> frames = PushInChunks(f, B("ABCDEFG"), 2);
+        Assert.Equal(2, frames.Count);
+        Assert.Equal(B("DEF"), frames[1].Body);
+        Assert.Equal(1, f.Pending);
+    }
+
+    [Theory] // F3 BE/LE, 헤더 포함 여부, adjust
+    [InlineData("""{"v":1,"kind":"LENFIELD","offset":1,"size":2,"endian":"BE"}""", "[AA][00][02]XY[AA][00][01]Z")]
+    [InlineData("""{"v":1,"kind":"LENFIELD","offset":1,"size":2,"endian":"LE"}""", "[AA][02][00]XY[AA][01][00]Z")]
+    [InlineData("""{"v":1,"kind":"LENFIELD","offset":0,"size":1,"includesHeader":true,"adjust":0}""", "[03]XY[02]Z")]
+    [InlineData("""{"v":1,"kind":"LENFIELD","offset":0,"size":1,"adjust":1}""", "[01]XY[00]Z")]
+    public void LengthField(string rule, string data)
+    {
+        IFramer f = FramerFactory.Create(RuleReader.ReadFrameRule(rule)!);
+        List<Frame> frames = PushInChunks(f, B(data), 1);
+        Assert.Equal(2, frames.Count);
+        Assert.EndsWith("XY", System.Text.Encoding.ASCII.GetString(frames[0].Body));
+        Assert.EndsWith("Z", System.Text.Encoding.ASCII.GetString(frames[1].Body));
+    }
+
+    [Fact] // F3 잘못된 길이 → 1바이트씩 버리고 재동기화
+    public void LengthField_Invalid_Resyncs()
+    {
+        IFramer f = FramerFactory.Create(RuleReader.ReadFrameRule("""{"v":1,"kind":"LENFIELD","offset":0,"size":1,"includesHeader":true,"maxLen":4}""")!);
+        List<Frame> frames = f.Push(B("[00][09][02]A")).ToList();
+        Assert.Single(frames);
+        Assert.Equal(B("[02]A"), frames[0].Body);
+        Assert.Equal(2, f.Rejections.Count);
+    }
+
+    [Theory] // F4
+    [InlineData("SUM8")]
+    [InlineData("XOR8")]
+    [InlineData("CRC16_MODBUS")]
+    public void Checksum_Valid_Stripped_Invalid_Rejected(string type)
+    {
+        ChecksumType t = type switch { "SUM8" => ChecksumType.Sum8, "XOR8" => ChecksumType.Xor8, _ => ChecksumType.Crc16Modbus };
+        byte[] payload = B("12AB");
+        byte[] good = payload.Concat(Checksum.Compute(t, payload)).Concat(B("[CR][LF]")).ToArray();
+        byte[] bad = payload.Concat(Checksum.Compute(t, B("ZZZY"))).Concat(B("[CR][LF]")).ToArray();
+
+        IFramer f = FramerFactory.Create(RuleReader.ReadFrameRule($$$"""{"v":1,"kind":"DELIM","end":"[CR][LF]","checksum":{"type":"{{{type}}}"}}""")!);
+        List<Frame> frames = f.Push(good).ToList();
+        Assert.Single(frames);
+        Assert.Equal(payload, frames[0].Body);
+
+        Assert.Empty(f.Push(bad));
+        Assert.Contains(f.Rejections, r => r.Reason == "체크섬 불일치");
+    }
+
+    [Theory] // F4 계산 범위 from/to: 헤더 1바이트·끝 1바이트 제외
+    [InlineData("""{"from":1,"to":-1}""")]
+    [InlineData("""{"from":1,"to":4}""")]
+    public void Checksum_Range_From_To(string range)
+    {
+        // 데이터부 AA 01 02 03 0D, 계산 범위 01 02 03 → SUM8 = 06
+        byte[] frame = { 0xAA, 0x01, 0x02, 0x03, 0x0D, 0x06 };
+        string rule = "{\"v\":1,\"kind\":\"FIXED\",\"len\":6,\"checksum\":{\"type\":\"SUM8\"," + range[1..] + "}";
+        IFramer f = FramerFactory.Create(RuleReader.ReadFrameRule(rule)!);
+
+        List<Frame> frames = f.Push(frame).ToList();
+        Assert.Single(frames);
+        Assert.Equal(new byte[] { 0xAA, 0x01, 0x02, 0x03, 0x0D }, frames[0].Body);
+
+        // 전체 범위였다면 맞았을 값 → 범위 규칙에서는 불일치
+        byte whole = Checksum.Compute(ChecksumType.Sum8, new byte[] { 0xAA, 0x01, 0x02, 0x03, 0x0D })[0];
+        Assert.Empty(f.Push(new byte[] { 0xAA, 0x01, 0x02, 0x03, 0x0D, whole }));
+        Assert.Contains(f.Rejections, r => r.Reason == "체크섬 불일치");
+    }
+
+    [Fact] // F4 범위가 데이터부를 벗어나면 프레임 버림
+    public void Checksum_Range_Invalid_Rejected()
+    {
+        IFramer f = FramerFactory.Create(RuleReader.ReadFrameRule("""{"v":1,"kind":"FIXED","len":3,"checksum":{"type":"XOR8","from":3}}""")!);
+        Assert.Empty(f.Push(new byte[] { 0x01, 0x02, 0x03 }));
+        Assert.Contains(f.Rejections, r => r.Reason == "체크섬 범위 오류");
+    }
+
+    [Fact]
+    public void ChecksumRule_TryRange()
+    {
+        var c = new ChecksumRule(ChecksumType.Sum8, 1, -1);
+        Assert.True(c.TryRange(5, out int s, out int e));
+        Assert.Equal((1, 4), (s, e));
+        Assert.True(new ChecksumRule(ChecksumType.Sum8).TryRange(5, out s, out e));
+        Assert.Equal((0, 5), (s, e));
+        Assert.False(new ChecksumRule(ChecksumType.Sum8, 0, 6).TryRange(5, out _, out _));
+    }
+
+    [Fact]
+    public void Crc16Modbus_KnownVector()
+    {
+        // 01 03 00 00 00 01 → CRC 84 0A (Little Endian)
+        Assert.Equal(new byte[] { 0x84, 0x0A }, Checksum.Compute(ChecksumType.Crc16Modbus, new byte[] { 0x01, 0x03, 0x00, 0x00, 0x00, 0x01 }));
+    }
+}
diff --git a/desktop/tests/juprovider.tests.protocol/MappingTests.cs b/desktop/tests/juprovider.tests.protocol/MappingTests.cs
new file mode 100644
index 0000000..ccfe324
--- /dev/null
+++ b/desktop/tests/juprovider.tests.protocol/MappingTests.cs
@@ -0,0 +1,167 @@
+using JuProvider.Lib.Protocol.Mapping;
+using JuProvider.Lib.Protocol.Parsing;
+
+namespace JuProvider.Tests.Protocol;
+
+public class MappingTests
+{
+    private static readonly DateTimeOffset At = new(2026, 10, 30, 10, 0, 0, TimeSpan.FromHours(9));
+
+    private static LogicalDataRef R(string cd, int idx, string gr = "GTEC") => new(gr, cd, idx);
+
+    private static RawValue V(string key, double? value, int sample = 0, string? text = null, bool absent = false) =>
+        new(key, sample, value, text ?? value?.ToString(System.Globalization.CultureInfo.InvariantCulture), absent);
+
+    private static List<ChannelMapEntry> Entries() =>
+    [
+        new("DEV1", "1", R("AIN", 1), Unit: "V", Min: 0, Max: 5),
+        new("DEV1", "2", R("AIN", 2), Unit: "V"),
+        new("DEV1", "3", R("AIN", 3), Unit: "V"),
+    ];
+
+    [Fact] // D1 같은 입력 → 같은 LogicalDataRef, 매핑 목록 순서와 무관
+    public void D1_Same_Input_Same_Refs_Regardless_Of_Entry_Order()
+    {
+        var raw = new[] { V("1", 1.0), V("2", 2.0), V("3", 3.0) };
+        List<ChannelMapEntry> entries = Entries();
+        entries.Add(new("DEV1", "1", R("AIN_X10", 1), Transform: new ValueTransform(10)));
+
+        var forward = new DataMapper(entries).Map("DEV1", "P", raw, At);
+        var backward = new DataMapper(Enumerable.Reverse(entries).ToList()).Map("DEV1", "P", raw, At);
+        var again = new DataMapper(entries).Map("DEV1", "P", raw, At);
+
+        Assert.Equal(forward, backward);
+        Assert.Equal(forward, again);
+        Assert.Equal(new[] { "GTEC/AIN/1", "GTEC/AIN_X10/1", "GTEC/AIN/2", "GTEC/AIN/3" }, forward.Select(v => v.Data!.Key));
+    }
+
+    [Fact] // D1b 같은 대상 중복 행은 1개로
+    public void D1b_Duplicate_Entries_Collapse()
+    {
+        List<ChannelMapEntry> entries = [.. Entries(), .. Entries()];
+        var mapper = new DataMapper(entries);
+        Assert.Equal(3, mapper.EntryCount);
+        Assert.Single(mapper.Map("DEV1", "P", [V("1", 1.0)], At));
+    }
+
+    [Fact] // D2 ChannelKey 는 문자열 그대로 비교 ("1" ≠ "01", 대소문자 구분), 위치·이름 키 공존
+    public void D2_ChannelKey_Is_Exact_String()
+    {
+        var mapper = new DataMapper(
+        [
+            new("DEV1", "1", R("POS", 1)),
+            new("DEV1", "CH1", R("NAMED", 1)),
+        ]);
+
+        var r = mapper.Map("DEV1", "P", [V("1", 1), V("01", 2), V("CH1", 3), V("ch1", 4)], At);
+
+        Assert.Equal(DataQuality.Good, r[0].Quality);
+        Assert.Equal(R("POS", 1), r[0].Data);
+        Assert.Equal(DataQuality.Unmapped, r[1].Quality);
+        Assert.Equal(R("NAMED", 1), r[2].Data);
+        Assert.Equal(DataQuality.Unmapped, r[3].Quality);
+        Assert.NotEqual(new ChannelRef("DEV1", "1"), new ChannelRef("DEV1", "01"));
+    }
+
+    [Fact] // D3 한 채널 → 원값·환산값 두 논리 Data
+    public void D3_One_Channel_Two_Logical_Data()
+    {
+        var mapper = new DataMapper(
+        [
+            new("DEV1", "1", R("RAW", 1)),
+            new("DEV1", "1", R("TEMP", 1), Transform: new ValueTransform(Scale: 100, Offset: -50), Unit: "C"),
+        ]);
+
+        var r = mapper.Map("DEV1", "P", [V("1", 0.75)], At);
+
+        Assert.Equal(2, r.Count);
+        Assert.NotEqual(r[0].Data, r[1].Data);
+        Assert.Equal(0.75, r.Single(v => v.Data == R("RAW", 1)).Value);
+        Assert.Equal(25.0, r.Single(v => v.Data == R("TEMP", 1)).Value!.Value, 6);
+        Assert.Equal("C", r.Single(v => v.Data == R("TEMP", 1)).Unit);
+    }
+
+    [Fact] // D4 매핑 없는 채널 → 버리지 않고 UNMAPPED
+    public void D4_Unmapped_Channel_Reported()
+    {
+        var r = new DataMapper(Entries()).Map("DEV1", "P", [V("1", 1), V("9", 9)], At);
+        Assert.Equal(2, r.Count);
+        LogicalValue un = r[1];
+        Assert.Equal(DataQuality.Unmapped, un.Quality);
+        Assert.Null(un.Data);
+        Assert.Equal(9, un.Value);
+        Assert.Equal(new ChannelRef("DEV1", "9"), un.Channel);
+    }
+
+    [Fact] // D5 SAMPLES: 같은 LogicalDataRef + SampleIndex 순서 보존
+    public void D5_Samples_Keep_Order_And_Ref()
+    {
+        var raw = Enumerable.Range(0, 6).Select(i => V("2", i * 0.5, sample: i)).ToArray();
+        var r = new DataMapper(Entries()).Map("DEV1", "P", raw, At);
+
+        Assert.Equal(6, r.Count);
+        Assert.All(r, v => Assert.Equal(R("AIN", 2), v.Data));
+        Assert.Equal(Enumerable.Range(0, 6), r.Select(v => v.SampleIndex));
+        Assert.Equal(raw.Select(x => x.Value), r.Select(v => v.Value));
+    }
+
+    [Fact] // D6 TAG_ID=CH<n> 임시 변환 = 매핑 테이블 형식과 같은 결과
+    public void D6_Legacy_TagId_Equals_Table_Form()
+    {
+        var warnings = new List<string>();
+        var legacy = LegacyTagIdMapping.ToEntries(
+        [
+            new("DEV1", "GTEC", "AIN", 1, "CH1", "V", 0, 5),
+            new("DEV1", "GTEC", "AIN", 2, "CH2", "V"),
+            new("DEV1", "GTEC", "AIN", 3, "CH03", "V"),
+            new("DEV1", "GTEC", "DIG", 1, "PHOTO"),
+            new("DEV1", "GTEC", "DIG", 2, null),
+        ], warnings);
+
+        Assert.Equal(2, warnings.Count);
+        Assert.Equal(Entries(), legacy);
+
+        var raw = new[] { V("1", 1.5), V("2", 2.5), V("3", 3.5) };
+        Assert.Equal(new DataMapper(Entries()).Map("DEV1", "P", raw, At), new DataMapper(legacy).Map("DEV1", "P", raw, At));
+    }
+
+    [Fact] // D7 같은 DEV_CD 는 연결 방식(직접·Gateway 하위)과 무관하게 같은 키
+    public void D7_DeviceRef_Has_No_Parent()
+    {
+        var mapper = new DataMapper(Entries());
+        var direct = mapper.Map("DEV1", "P_DIRECT", [V("1", 1)], At);
+        var viaGateway = mapper.Map("DEV1", "P_GATEWAY", [V("1", 1)], At);
+
+        Assert.Equal(direct[0].Device, viaGateway[0].Device);
+        Assert.Equal(direct[0].Data, viaGateway[0].Data);
+        Assert.Equal(new DeviceRef("DEV1"), direct[0].Device);
+    }
+
+    [Fact] // D8 범위 밖 → 값 유지 + RANGE
+    public void D8_Out_Of_Range_Keeps_Value()
+    {
+        var r = new DataMapper(Entries()).Map("DEV1", "P", [V("1", 7.5), V("1", -1), V("1", 5)], At);
+        Assert.Equal(new[] { DataQuality.Range, DataQuality.Range, DataQuality.Good }, r.Select(v => v.Quality));
+        Assert.Equal(7.5, r[0].Value);
+    }
+
+    [Fact] // PTL_CD 지정 행은 그 프로토콜에서만, 숫자 아닌 값은 PARSE_ERR, Absent 는 제외
+    public void PtlCd_Filter_ParseErr_And_Absent()
+    {
+        var mapper = new DataMapper(
+        [
+            new("DEV1", "1", R("ONLY_P1", 1), PtlCd: "P1"),
+            new("DEV1", "1", R("ALL", 1)),
+        ]);
+
+        Assert.Equal(2, mapper.Map("DEV1", "P1", [V("1", 1)], At).Count);
+        Assert.Equal(R("ALL", 1), mapper.Map("DEV1", "P2", [V("1", 1)], At).Single().Data);
+
+        var bad = mapper.Map("DEV1", "P2", [V("1", null, text: "N/A")], At).Single();
+        Assert.Equal(DataQuality.ParseErr, bad.Quality);
+        Assert.Equal("N/A", bad.Text);
+
+        Assert.Empty(mapper.Map("DEV1", "P2", [V("1", null, text: "000", absent: true)], At));
+        Assert.Throws<ArgumentException>(() => new DataMapper([new("", "1", R("X", 1))]));
+    }
+}
