+        new() { PtlCd = "NORESP", Pattern = ExchangePattern.TxRx, Roles = ProtocolRole.Info, Tx = "S{99}",
+                Expect = ResponseMatcher.StartsWith("{"), TimeoutMs = 5000 },
+        new() { PtlCd = "SLOW", Pattern = ExchangePattern.TxRx, Roles = ProtocolRole.Info, Tx = "S{98}",
