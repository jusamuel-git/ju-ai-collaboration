+using System.Collections.Concurrent;
+using System.Diagnostics;
+using System.Text;
+using System.Text.RegularExpressions;
+using JuProvider.Lib.Protocol.Framing;
+using JuProvider.Lib.Protocol.Model;
+using JuProvider.Lib.Protocol.Scheduling;
+
+namespace JuProvider.Tests.Protocol;
+
+/// <summary>가짜 Link: 쓰기를 기록하고, Responder가 정한 지연 뒤 응답 프레임을 Scheduler에 넣는다</summary>
+internal sealed class FakeLink : ILinkWriter
+{
+    private readonly Stopwatch _clock = Stopwatch.StartNew();
+    public CommandScheduler Scheduler = null!;
+    public ConcurrentQueue<(string Text, long At)> Writes { get; } = new();
+    public Func<string, (int, string)[]>? Responder;
+    public bool FailWrites;
+
+    public Task WriteAsync(ReadOnlyMemory<byte> data, CancellationToken cancellationToken = default)
+    {
+        if (FailWrites) throw new IOException("쓰기 실패(테스트)");
+        string text = Encoding.ASCII.GetString(data.Span);
+        Writes.Enqueue((text, _clock.ElapsedMilliseconds));
+        foreach (var (delay, body) in Responder?.Invoke(text) ?? [])
+        {
+            _ = Task.Run(async () =>
+            {
+                if (delay > 0) await Task.Delay(delay);
+                Scheduler.OnFrame(F(body));
+            });
+        }
+        return Task.CompletedTask;
+    }
+
+    public List<string> Sent => Writes.Select(w => w.Text).ToList();
+
+    public long WriteTime(string text) => Writes.First(w => w.Text == text).At;
+
+    public static Frame F(string body) => new(Encoding.ASCII.GetBytes(body + "\r\n"), Encoding.ASCII.GetBytes(body));
+}
+
+public class SchedulerTests
+{
+    private static (CommandScheduler S, FakeLink L) Create(SchedulerOptions? options = null,
+        Func<string, (int, string)[]>? responder = null)
+    {
+        var link = new FakeLink { Responder = responder };
+        var s = new CommandScheduler(link, options ?? new SchedulerOptions(LateGuardMs: 0));
+        link.Scheduler = s;
+        return (s, link);
+    }
+
+    private static CommandRequest Req(string payload, string dev = "D1", ExchangePattern pattern = ExchangePattern.TxRx,
+        CommandAction action = CommandAction.None, CommandPriority priority = CommandPriority.Info,
+        ResponseMatcher? expect = null, int timeoutMs = 500, int retry = 0, bool idempotent = true, string? key = null,
+        bool noExpect = false) => new()
+    {
+        DevCd = dev,
+        PtlCd = payload,
+        Payload = Encoding.ASCII.GetBytes(payload),
+        Pattern = pattern,
+        Action = action,
+        Priority = priority,
+        Expect = noExpect ? null : expect ?? ResponseMatcher.StartsWith("{"),
+        TimeoutMs = timeoutMs,
+        RetryCount = retry,
+        Idempotent = idempotent,
+        CorrelationKey = key
+    };
+
+    private static string Body(CommandResult r) => Encoding.ASCII.GetString(r.Response!.Body);
+
+    private static (int, string)[] Reply(int delay, string body) => [(delay, body)];
+
+    // ---------- 기본 ----------
+
+    [Fact]
+    public async Task TxRx_Completes_With_Response_And_TxOnly_On_Write()
+    {
+        var (s, _) = Create(responder: t => t == "Q" ? Reply(10, "{A}") : []);
+        await using var _s = s;
+
+        CommandResult r = await s.EnqueueAsync(Req("Q"));
+        Assert.Equal(CommandStatus.Completed, r.Status);
+        Assert.Equal("{A}", Body(r));
+        Assert.Equal(1, r.Attempts);
+
+        CommandResult t = await s.EnqueueAsync(Req("T", pattern: ExchangePattern.TxOnly));
+        Assert.Equal(CommandStatus.Completed, t.Status);
+        Assert.Null(t.Response);
+    }
+
+    [Fact]
+    public async Task Write_Failure_Is_LinkDown_And_RxStream_Rejected()
+    {
+        var (s, l) = Create();
+        await using var _s = s;
+        l.FailWrites = true;
+        Assert.Equal(CommandStatus.LinkDown, (await s.EnqueueAsync(Req("Q"))).Status);
+        Assert.Equal(CommandStatus.Rejected, (await s.EnqueueAsync(Req("R", pattern: ExchangePattern.RxStream))).Status);
+    }
+
+    [Fact]
+    public async Task TxOnly_InterCommandGap_Is_Applied()
+    {
+        var (s, l) = Create(new SchedulerOptions(InterCommandGapMs: 120, LateGuardMs: 0));
+        await using var _s = s;
+        var a = s.EnqueueAsync(Req("A", pattern: ExchangePattern.TxOnly));
+        var b = s.EnqueueAsync(Req("B", pattern: ExchangePattern.TxOnly));
+        await Task.WhenAll(a, b);
+        Assert.True(l.WriteTime("B") - l.WriteTime("A") >= 100, $"gap {l.WriteTime("B") - l.WriteTime("A")}");
+    }
+
+    // ---------- M: 응답 매칭 충돌 ----------
+
+    [Fact] // M1 대기 중 연속 데이터 → 스트림으로, 진짜 응답으로 완료
+    public async Task M1_Stream_Frames_While_Waiting_Go_To_Unmatched()
+    {
+        var (s, _) = Create(responder: t => t == "S{20}"
+            ? [(10, "{1.0 2.0 3.0}"), (30, "{1.1 2.1 3.1}"), (80, "{008,000,000,000}")]
+            : []);
+        await using var _s = s;
+        var unmatched = new ConcurrentQueue<string>();
+        s.Unmatched += (_, f) => unmatched.Enqueue(Encoding.ASCII.GetString(f.Body));
+
+        CommandResult r = await s.EnqueueAsync(Req("S{20}", expect: ResponseMatcher.Regex(@"^\{\d{3},\d{3},\d{3},\d{3}\}$")));
+
+        Assert.Equal(CommandStatus.Completed, r.Status);
+        Assert.Equal("{008,000,000,000}", Body(r));
+        Assert.Equal(new[] { "{1.0 2.0 3.0}", "{1.1 2.1 3.1}" }, unmatched.ToArray());
+    }
+
+    [Fact] // M2 응답 형식이 같은 두 명령: 직렬이라 각자 자기 응답, 순서 유지
+    public async Task M2_Same_Response_Shape_Serial_No_Crossing()
+    {
+        var (s, l) = Create(responder: t => t switch
+        {
+            "A" => Reply(60, "{A}"),
+            "B" => Reply(5, "{B}"),
+            _ => []
+        });
+        await using var _s = s;
+
+        var a = s.EnqueueAsync(Req("A"));
+        var b = s.EnqueueAsync(Req("B"));
+        CommandResult[] r = await Task.WhenAll(a, b);
+
+        Assert.Equal("{A}", Body(r[0]));
+        Assert.Equal("{B}", Body(r[1]));
+        Assert.Equal(new[] { "A", "B" }, l.Sent);
+        Assert.True(l.WriteTime("B") - l.WriteTime("A") >= 50, "B 는 A 응답 뒤에 송신");
+    }
+
+    [Fact] // M3 상관키 병렬: 응답 순서가 뒤바뀌어도 키로 연결
+    public async Task M3_Correlation_Key_Parallel_Out_Of_Order()
+    {
+        var keyRegex = new Regex(@"^\{(\w+):");
+        var options = new SchedulerOptions(FullDuplex: true, MaxInFlight: 4, LateGuardMs: 0,
+            CorrelationOf: f => keyRegex.Match(Encoding.ASCII.GetString(f.Body)) is { Success: true } m ? m.Groups[1].Value : null);
+        var (s, l) = Create(options, t => t switch
+        {
+            "K1" => Reply(120, "{K1:one}"),
+            "K2" => Reply(70, "{K2:two}"),
+            "K3" => Reply(20, "{K3:three}"),
+            _ => []
+        });
+        await using var _s = s;
+
+        var tasks = new[] { "K1", "K2", "K3" }.Select(k => s.EnqueueAsync(Req(k, key: k))).ToArray();
+        Assert.True(await Wait.UntilAsync(() => l.Writes.Count == 3, 100), "3건이 응답 전에 모두 송신");
+        CommandResult[] r = await Task.WhenAll(tasks);
+
+        Assert.Equal("{K1:one}", Body(r[0]));
+        Assert.Equal("{K2:two}", Body(r[1]));
+        Assert.Equal("{K3:three}", Body(r[2]));
+    }
+
+    [Fact] // M4 타임아웃 후 늦은 응답 → 다음 명령에 연결되지 않음 (LATE)
+    public async Task M4_Late_Response_Not_Linked_To_Next_Command()
+    {
+        var (s, l) = Create(new SchedulerOptions(LateGuardMs: 250), t => t switch
+        {
+            "Q1" => Reply(180, "{R1}"),
+            "Q2" => Reply(20, "{R2}"),
+            _ => []
+        });
+        await using var _s = s;
+        var late = new ConcurrentQueue<string>();
+        s.Late += (_, f) => late.Enqueue(Encoding.ASCII.GetString(f.Body));
+
+        var a = s.EnqueueAsync(Req("Q1", timeoutMs: 100, expect: ResponseMatcher.StartsWith("{R")));
+        var b = s.EnqueueAsync(Req("Q2", timeoutMs: 1000, expect: ResponseMatcher.StartsWith("{R")));
+
+        Assert.Equal(CommandStatus.Timeout, (await a).Status);
+        CommandResult rb = await b;
+        Assert.Equal(CommandStatus.Completed, rb.Status);
+        Assert.Equal("{R2}", Body(rb));
+        Assert.Equal(new[] { "{R1}" }, late.ToArray());
+        Assert.True(l.WriteTime("Q2") - l.WriteTime("Q1") >= 300, "타임아웃 + guard 뒤 송신");
+    }
+
+    [Fact] // M4b 상관키: 타임아웃된 키의 늦은 응답은 LATE
+    public async Task M4b_Late_Response_By_Correlation_Key()
+    {
+        var options = new SchedulerOptions(FullDuplex: true, MaxInFlight: 2, LateGuardMs: 0,
+            CorrelationOf: f => Encoding.ASCII.GetString(f.Body) is var b && b.StartsWith("{K") ? b[1..3] : null);
+        var (s, _) = Create(options, t => t == "K1" ? Reply(150, "{K1}") : []);
+        await using var _s = s;
+        var late = new ConcurrentQueue<string>();
+        s.Late += (_, f) => late.Enqueue(Encoding.ASCII.GetString(f.Body));
+
+        Assert.Equal(CommandStatus.Timeout, (await s.EnqueueAsync(Req("K1", key: "K1", timeoutMs: 60))).Status);
+        Assert.True(await Wait.UntilAsync(() => late.Count == 1, 1000));
+    }
+
+    [Fact] // M5 Expect 없는 레거시 TX_RX → 첫 프레임 + 경고 1회
+    public async Task M5_Legacy_No_Expect_Takes_First_Frame_With_Warning()
+    {
+        var (s, _) = Create(responder: t => t == "L" ? Reply(5, "anything") : []);
+        await using var _s = s;
+        var warnings = new ConcurrentQueue<string>();
+        s.Warning += (_, w) => warnings.Enqueue(w);
+
+        CommandResult r1 = await s.EnqueueAsync(Req("L", noExpect: true));
+        CommandResult r2 = await s.EnqueueAsync(Req("L", noExpect: true));
+
+        Assert.Equal("anything", Body(r1));
+        Assert.Equal(CommandStatus.Completed, r2.Status);
+        Assert.Single(warnings);
+    }
+
+    [Fact] // M6 같은 상관키 동시 등록 → Rejected
+    public async Task M6_Duplicate_Correlation_Key_Rejected()
+    {
+        var options = new SchedulerOptions(FullDuplex: true, MaxInFlight: 2, LateGuardMs: 0, CorrelationOf: _ => null);
+        var (s, _) = Create(options);
+        await using var _s = s;
+
+        var first = s.EnqueueAsync(Req("K1", key: "K1", timeoutMs: 200));
+        CommandResult dup = await s.EnqueueAsync(Req("K1", key: "K1"));
+
+        Assert.Equal(CommandStatus.Rejected, dup.Status);
+        Assert.Equal(CommandStatus.Timeout, (await first).Status);
+    }
+
+    // ---------- S: STOP 우선순위·취소·타임아웃 ----------
+
+    [Fact] // S1 STOP 은 진행 중 명령 다음 첫 번째
+    public async Task S1_Stop_Runs_First_After_InFlight()
+    {
+        var (s, l) = Create(responder: t => t == "BUSY" ? Reply(100, "{busy}") : t.StartsWith("STOP") ? [] : Reply(5, "{ok}"));
+        await using var _s = s;
+
+        var busy = s.EnqueueAsync(Req("BUSY"));
+        Assert.True(await Wait.UntilAsync(() => l.Writes.Count == 1, 500));
+        var tasks = new List<Task<CommandResult>>
+        {
+            s.EnqueueAsync(Req("INFO1")),
+            s.EnqueueAsync(Req("POLL1", pattern: ExchangePattern.Poll, priority: CommandPriority.Poll)),
+            s.EnqueueAsync(Req("INFO2")),
+            s.EnqueueAsync(Req("CTRL1", priority: CommandPriority.Control)),
+            s.EnqueueAsync(Req("STOP", pattern: ExchangePattern.TxOnly, action: CommandAction.Stop)),
+        };
+        await busy;
+        CommandResult[] r = await Task.WhenAll(tasks);
+
+        Assert.All(r, x => Assert.Equal(CommandStatus.Completed, x.Status));
+        Assert.Equal(new[] { "BUSY", "STOP", "CTRL1", "INFO1", "INFO2", "POLL1" }, l.Sent);
+    }
+
+    [Fact] // S2 STOP: 같은 장치 대기 중 START·PAUSE 취소, 다른 장치·다른 명령 유지
+    public async Task S2_Stop_Cancels_Pending_Start_And_Pause_Of_Same_Device()
+    {
+        var (s, l) = Create(responder: t => t == "BUSY" ? Reply(80, "{busy}") : Reply(5, "{ok}"));
+        await using var _s = s;
+
+        var busy = s.EnqueueAsync(Req("BUSY"));
+        Assert.True(await Wait.UntilAsync(() => l.Writes.Count == 1, 500));
+        var start1 = s.EnqueueAsync(Req("START1", action: CommandAction.Start, priority: CommandPriority.Control, idempotent: false));
+        var pause1 = s.EnqueueAsync(Req("PAUSE1", action: CommandAction.Pause, priority: CommandPriority.Control, idempotent: false));
+        var info1 = s.EnqueueAsync(Req("INFO1"));
+        var start2 = s.EnqueueAsync(Req("START2", dev: "D2", action: CommandAction.Start, priority: CommandPriority.Control, idempotent: false));
+        var stop1 = s.EnqueueAsync(Req("STOP1", pattern: ExchangePattern.TxOnly, action: CommandAction.Stop));
+
+        CommandResult rs1 = await start1, rp1 = await pause1;
+        Assert.Equal(CommandStatus.Cancelled, rs1.Status);
+        Assert.Contains("STOP", rs1.Reason);
+        Assert.Equal(CommandStatus.Cancelled, rp1.Status);
+
+        await Task.WhenAll(busy, info1, start2, stop1);
+        Assert.Equal(CommandStatus.Completed, (await info1).Status);
+        Assert.Equal(CommandStatus.Completed, (await start2).Status);
+        Assert.DoesNotContain("START1", l.Sent);
+        Assert.DoesNotContain("PAUSE1", l.Sent);
+        Assert.Equal("STOP1", l.Sent[1]);
+    }
+
+    [Fact] // S3 상태 전이(START)는 재시도 안 함, INFO 는 RetryCount 까지
+    public async Task S3_Retry_Only_For_Idempotent()
+    {
+        var (s, l) = Create();
+        await using var _s = s;
+
+        CommandResult info = await s.EnqueueAsync(Req("INFO", timeoutMs: 60, retry: 2));
+        Assert.Equal(CommandStatus.Timeout, info.Status);
+        Assert.Equal(3, info.Attempts);
+
+        CommandResult start = await s.EnqueueAsync(Req("START", timeoutMs: 60, retry: 2, action: CommandAction.Start, idempotent: false));
+        Assert.Equal(CommandStatus.Timeout, start.Status);
+        Assert.Equal(1, start.Attempts);
+
+        Assert.Equal(3, l.Sent.Count(x => x == "INFO"));
+        Assert.Equal(1, l.Sent.Count(x => x == "START"));
+    }
+
+    [Fact] // S4 진행 중 취소: 호출자 즉시 Cancelled, Link 는 타임아웃까지 점유
+    public async Task S4_Cancel_InFlight_Keeps_Link_Busy_Until_Timeout()
+    {
+        var (s, l) = Create(responder: t => t == "B" ? Reply(5, "{b}") : []);
+        await using var _s = s;
+        using var cts = new CancellationTokenSource();
+
+        var sw = Stopwatch.StartNew();
+        var a = s.EnqueueAsync(Req("A", timeoutMs: 300), cts.Token);
+        var b = s.EnqueueAsync(Req("B"));
+        Assert.True(await Wait.UntilAsync(() => l.Writes.Count == 1, 500));
+        cts.Cancel();
+
+        CommandResult ra = await a;
+        Assert.Equal(CommandStatus.Cancelled, ra.Status);
+        Assert.True(sw.ElapsedMilliseconds < 250, $"취소 결과가 늦음 {sw.ElapsedMilliseconds}");
+
+        Assert.Equal(CommandStatus.Completed, (await b).Status);
+        Assert.True(l.WriteTime("B") - l.WriteTime("A") >= 280, $"B 송신이 타임아웃 전 {l.WriteTime("B") - l.WriteTime("A")}");
+    }
+
+    [Fact] // S4b 대기 중 취소: 큐에서 제거, 송신 안 함
+    public async Task S4b_Cancel_Queued_Is_Never_Sent()
+    {
+        var (s, l) = Create(responder: t => t == "A" ? Reply(80, "{a}") : Reply(5, "{x}"));
+        await using var _s = s;
+        using var cts = new CancellationTokenSource();
+
+        var a = s.EnqueueAsync(Req("A"));
+        var q = s.EnqueueAsync(Req("Q"), cts.Token);
+        cts.Cancel();
+
+        Assert.Equal(CommandStatus.Cancelled, (await q).Status);
+        await a;
+        await Task.Delay(50);
+        Assert.DoesNotContain("Q", l.Sent);
+    }
+
+    [Fact] // S5 연속 타임아웃 3회 → Link 의심 1회, 성공하면 초기화
+    public async Task S5_Three_Consecutive_Timeouts_Raise_LinkSuspect_Once()
+    {
+        var (s, _) = Create(responder: t => t == "OK" ? Reply(5, "{ok}") : []);
+        await using var _s = s;
+        var suspects = new ConcurrentQueue<int>();
+        s.LinkSuspect += (_, n) => suspects.Enqueue(n);
+
+        for (int i = 0; i < 4; i++) Assert.Equal(CommandStatus.Timeout, (await s.EnqueueAsync(Req($"T{i}", timeoutMs: 40))).Status);
+        Assert.Equal(new[] { 3 }, suspects.ToArray());
+
+        Assert.Equal(CommandStatus.Completed, (await s.EnqueueAsync(Req("OK"))).Status);
+        for (int i = 0; i < 3; i++) await s.EnqueueAsync(Req($"U{i}", timeoutMs: 40));
+        Assert.Equal(new[] { 3, 3 }, suspects.ToArray());
+    }
+
+    [Fact] // S6 폴링: 이전 회차 미완료면 건너뜀
+    public async Task S6_Poll_Skipped_While_Previous_Pending()
+    {
+        var (s, l) = Create(responder: t => t == "P" ? Reply(100, "{p}") : []);
+        await using var _s = s;
+
+        var first = s.EnqueueAsync(Req("P", pattern: ExchangePattern.Poll, priority: CommandPriority.Poll));
+        CommandResult second = await s.EnqueueAsync(Req("P", pattern: ExchangePattern.Poll, priority: CommandPriority.Poll));
+        Assert.Equal(CommandStatus.Skipped, second.Status);
+        Assert.Equal(CommandStatus.Completed, (await first).Status);
+
+        CommandResult third = await s.EnqueueAsync(Req("P", pattern: ExchangePattern.Poll, priority: CommandPriority.Poll));
+        Assert.Equal(CommandStatus.Completed, third.Status);
+        Assert.Equal(2, l.Sent.Count(x => x == "P"));
+    }
+
+    [Fact] // S7 Link 끊김 → 대기·진행 전부 LinkDown, 복구 후 정상
+    public async Task S7_LinkDown_Fails_All_And_Recovers()
+    {
+        var (s, l) = Create(responder: t => t == "E" ? Reply(5, "{e}") : []);
+        await using var _s = s;
+
+        var a = s.EnqueueAsync(Req("A", timeoutMs: 2000));
+        var b = s.EnqueueAsync(Req("B"));
+        var c = s.EnqueueAsync(Req("C", pattern: ExchangePattern.TxOnly));
+        Assert.True(await Wait.UntilAsync(() => l.Writes.Count == 1, 500));
+
+        s.OnLinkDown();
+        CommandResult[] r = await Task.WhenAll(a, b, c);
+        Assert.All(r, x => Assert.Equal(CommandStatus.LinkDown, x.Status));
+        Assert.Equal(CommandStatus.LinkDown, (await s.EnqueueAsync(Req("D"))).Status);
+
+        s.OnLinkUp();
+        Assert.Equal(CommandStatus.Completed, (await s.EnqueueAsync(Req("E"))).Status);
+        Assert.Equal(new[] { "A", "E" }, l.Sent);
+    }
+}
