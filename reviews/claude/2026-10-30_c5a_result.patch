+    private sealed record Rig(DeviceSession Session, VirtualTransport Transport, GtecLikeDevice Device,
+        ConcurrentQueue<LogicalValue> Values, ConcurrentQueue<InitRoutineResult> Inits, ConcurrentQueue<string> Warnings) : IAsyncDisposable
