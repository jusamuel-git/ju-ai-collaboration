@@ -0,0 +1,23 @@
+namespace JuProvider.Lib.Protocol.Framing;
+
+/// <summary>완성된 프레임. Raw = 받은 바이트 그대로, Body = 규칙에 따른 내용 (FrameRule 설명 참고)</summary>
+public sealed record Frame(byte[] Raw, byte[] Body);
+
+/// <summary>버린 바이트와 사유 (Traffic 로그용)</summary>
+public sealed record FrameRejection(string Reason, byte[] Data);
+
+/// <summary>바이트 조각 → 완성 프레임. 조각을 여러 번 나눠 넣어도 결과가 같아야 한다.</summary>
+public interface IFramer
+{
+    /// <summary>새 바이트를 넣고 완성된 프레임을 꺼낸다. 미완성 부분은 내부 버퍼에 남는다.</summary>
+    IReadOnlyList<Frame> Push(ReadOnlySpan<byte> chunk);
+
+    /// <summary>버린 데이터 (Push 호출마다 새로 채워짐)</summary>
+    IReadOnlyList<FrameRejection> Rejections { get; }
+
+    /// <summary>미완성 버퍼 비우기 (재연결 등)</summary>
+    void Reset();
+
+    /// <summary>현재 버퍼에 남은 바이트 수</summary>
+    int Pending { get; }
+}
diff --git a/desktop/lib/juprovider.lib.protocol/Framing/FramerBase.cs b/desktop/lib/juprovider.lib.protocol/Framing/FramerBase.cs
new file mode 100644
index 0000000..578be28
--- /dev/null
+++ b/desktop/lib/juprovider.lib.protocol/Framing/FramerBase.cs
@@ -0,0 +1,87 @@
+using JuProvider.Lib.Protocol.Rules;
+
+namespace JuProvider.Lib.Protocol.Framing;
+
+/// <summary>버퍼·거부 목록·최대 길이·체크섬 공통 처리</summary>
+public abstract class FramerBase : IFramer
+{
+    protected readonly FrameRule Rule;
+    protected readonly List<byte> Buffer = new();
+    private readonly List<FrameRejection> _rejections = new();
+
+    protected FramerBase(FrameRule rule) => Rule = rule;
+
+    public IReadOnlyList<FrameRejection> Rejections => _rejections;
+    public int Pending => Buffer.Count;
+
+    public void Reset() => Buffer.Clear();
+
+    public IReadOnlyList<Frame> Push(ReadOnlySpan<byte> chunk)
+    {
+        _rejections.Clear();
+        foreach (byte b in chunk) Buffer.Add(b);
+
+        var frames = new List<Frame>();
+        while (TryTake(out Frame? frame))
+        {
+            if (frame is null) continue;
+            if (ApplyChecksum(frame, out Frame? ok)) frames.Add(ok!);
+        }
+
+        if (Buffer.Count > Rule.MaxLength)
+        {
+            Reject("최대 길이 초과", Buffer.ToArray());
+            Buffer.Clear();
+        }
+
+        return frames;
+    }
+
+    /// <summary>버퍼에서 프레임 1개를 꺼낸다. 더 꺼낼 게 없으면 false. 꺼냈지만 버린 경우 true + frame=null.</summary>
+    protected abstract bool TryTake(out Frame? frame);
+
+    protected void Reject(string reason, byte[] data) => _rejections.Add(new FrameRejection(reason, data));
+
+    protected byte[] TakeFront(int count)
+    {
+        byte[] taken = Buffer.GetRange(0, count).ToArray();
+        Buffer.RemoveRange(0, count);
+        return taken;
+    }
+
+    private bool ApplyChecksum(Frame frame, out Frame? result)
+    {
+        ChecksumRule c = Rule.Checksum;
+        result = frame;
+        if (c.Type == ChecksumType.None) return true;
+
+        byte[] body = frame.Body;
+        int size = c.Size;
+        if (body.Length < size)
+        {
+            Reject("체크섬 길이 부족", frame.Raw);
+            result = null;
+            return false;
+        }
+
+        int dataLength = body.Length - size;
+        if (!c.TryRange(dataLength, out int start, out int end))
+        {
+            Reject("체크섬 범위 오류", frame.Raw);
+            result = null;
+            return false;
+        }
+
+        ReadOnlySpan<byte> covered = body.AsSpan(start, end - start);
+        ReadOnlySpan<byte> actual = body.AsSpan(dataLength, size);
+        if (!Checksum.Verify(c.Type, covered, actual))
+        {
+            Reject("체크섬 불일치", frame.Raw);
+            result = null;
+            return false;
+        }
+
+        result = frame with { Body = body[..^size] };
+        return true;
+    }
+}
diff --git a/desktop/lib/juprovider.lib.protocol/Framing/Framers.cs b/desktop/lib/juprovider.lib.protocol/Framing/Framers.cs
new file mode 100644
index 0000000..fca7380
--- /dev/null
+++ b/desktop/lib/juprovider.lib.protocol/Framing/Framers.cs
@@ -0,0 +1,182 @@
+using JuProvider.Lib.Protocol.Rules;
+
+namespace JuProvider.Lib.Protocol.Framing;
+
+/// <summary>
+/// 끝 구분자. Body = 구분자 앞부분. 빈 프레임은 건너뜀.
+/// Start 가 있으면(C4) 시작 문자 앞 잡음 제거, 끝 없이 다음 시작 문자가 오면 깨진 조각 제거(거부 기록).
+/// </summary>
+public sealed class DelimiterFramer(FrameRule rule) : FramerBase(rule)
+{
+    protected override bool TryTake(out Frame? frame)
+    {
+        frame = null;
+        byte[] end = Rule.End;
+        byte[]? start = Rule.Start is { Length: > 0 } s ? s : null;
+
+        if (start is null)
+        {
+            int at = IndexOf(Buffer, end, 0);
+            if (at < 0) return false;
+
+            byte[] raw = TakeFront(at + end.Length);
+            byte[] body = raw[..at];
+            if (body.Length > 0) frame = new Frame(raw, body);
+            return true;
+        }
+
+        int first = IndexOf(Buffer, start, 0);
+        if (first < 0)
+        {
+            int keep = PartialStartSuffix(Buffer, start);
+            int drop = Buffer.Count - keep;
+            if (drop > 0) Reject("시작 문자 전 잡음", TakeFront(drop));
+            return false;
+        }
+        if (first > 0) Reject("시작 문자 전 잡음", TakeFront(first));
+
+        int endAt = IndexOf(Buffer, end, start.Length);
+        int next = IndexOf(Buffer, start, start.Length);
+        if (next >= 0 && (endAt < 0 || next < endAt))
+        {
+            Reject("끝 구분자 없이 다음 시작 문자 (깨진 프레임)", TakeFront(next));
+            return true;
+        }
+        if (endAt < 0) return false;
+
+        byte[] whole = TakeFront(endAt + end.Length);
+        frame = new Frame(whole, whole[..endAt]);
+        return true;
+    }
+
+    private static int IndexOf(List<byte> buffer, byte[] pattern, int from)
+    {
+        for (int i = from; i <= buffer.Count - pattern.Length; i++)
+        {
+            int j = 0;
+            while (j < pattern.Length && buffer[i + j] == pattern[j]) j++;
+            if (j == pattern.Length) return i;
+        }
+        return -1;
+    }
+
+    /// <summary>버퍼 끝이 시작 문자의 앞부분과 같으면 그 길이 (다음 조각에서 완성될 수 있으므로 남긴다)</summary>
+    private static int PartialStartSuffix(List<byte> buffer, byte[] start)
+    {
+        for (int k = Math.Min(start.Length - 1, buffer.Count); k > 0; k--)
+        {
+            bool match = true;
+            for (int j = 0; j < k && match; j++) match = buffer[buffer.Count - k + j] == start[j];
+            if (match) return k;
+        }
+        return 0;
+    }
+}
+
+/// <summary>
+/// 시작·끝 바이트. STX 앞의 바이트는 버림(거부 기록). Escape가 있으면 다음 1바이트를 그대로 내용으로 본다.
+/// Body = STX/ETX 제외, escape 해제된 내용.
+/// </summary>
+public sealed class StxEtxFramer(FrameRule rule) : FramerBase(rule)
+{
+    protected override bool TryTake(out Frame? frame)
+    {
+        frame = null;
+        if (Buffer.Count == 0) return false;
+
+        int start = Buffer.IndexOf(Rule.Stx);
+        if (start < 0)
+        {
+            Reject("STX 없음", TakeFront(Buffer.Count));
+            return false;
+        }
+        if (start > 0)
+        {
+            Reject("STX 앞 데이터", TakeFront(start));
+        }
+
+        var body = new List<byte>();
+        for (int i = 1; i < Buffer.Count; i++)
+        {
+            byte b = Buffer[i];
+            if (Rule.Escape is byte esc && b == esc)
+            {
+                if (i + 1 >= Buffer.Count) return false; // escape 다음 바이트 대기
+                body.Add(Buffer[++i]);
+                continue;
+            }
+            if (b == Rule.Etx)
+            {
+                byte[] raw = TakeFront(i + 1);
+                frame = new Frame(raw, body.ToArray());
+                return true;
+            }
+            if (b == Rule.Stx && Rule.Escape is null)
+            {
+                // ETX 없이 새 STX → 앞 프레임은 깨진 것으로 보고 버림
+                Reject("ETX 없이 새 STX", TakeFront(i));
+                return true;
+            }
+            body.Add(b);
+        }
+        return false;
+    }
+}
+
+/// <summary>고정 길이. Body = 프레임 전체.</summary>
+public sealed class FixedLengthFramer(FrameRule rule) : FramerBase(rule)
+{
+    protected override bool TryTake(out Frame? frame)
+    {
+        frame = null;
+        if (Buffer.Count < Rule.Length) return false;
+        byte[] raw = TakeFront(Rule.Length);
+        frame = new Frame(raw, raw);
+        return true;
+    }
+}
+
+/// <summary>
+/// 길이 필드. 전체 길이 = 헤더 포함이면 값+adjust, 아니면 (offset+size)+값+adjust.
+/// Body = 프레임 전체. 길이가 잘못되면(헤더보다 짧거나 MaxLength 초과) 1바이트 버리고 다시 찾는다.
+/// </summary>
+public sealed class LengthFieldFramer(FrameRule rule) : FramerBase(rule)
+{
+    protected override bool TryTake(out Frame? frame)
+    {
+        frame = null;
+        int header = Rule.LengthOffset + Rule.LengthSize;
+        if (Buffer.Count < header) return false;
+
+        long value = 0;
+        for (int k = 0; k < Rule.LengthSize; k++)
+        {
+            int idx = Rule.LengthBigEndian ? Rule.LengthOffset + k : Rule.LengthOffset + Rule.LengthSize - 1 - k;
+            value = (value << 8) | Buffer[idx];
+        }
+
+        long total = (Rule.LengthIncludesHeader ? value : header + value) + Rule.LengthAdjust;
+        if (total < header || total > Rule.MaxLength)
+        {
+            Reject("길이 필드 값 오류", TakeFront(1));
+            return true;
+        }
+        if (Buffer.Count < total) return false;
+
+        byte[] raw = TakeFront((int)total);
+        frame = new Frame(raw, raw);
+        return true;
+    }
+}
+
+public static class FramerFactory
+{
+    public static IFramer Create(FrameRule rule) => rule.Kind switch
+    {
+        FrameKind.Delim => new DelimiterFramer(rule),
+        FrameKind.StxEtx => new StxEtxFramer(rule),
+        FrameKind.Fixed => new FixedLengthFramer(rule),
+        FrameKind.LenField => new LengthFieldFramer(rule),
+        _ => throw new ArgumentOutOfRangeException(nameof(rule))
+    };
+}
diff --git a/desktop/lib/juprovider.lib.protocol/Mapping/DataMapping.cs b/desktop/lib/juprovider.lib.protocol/Mapping/DataMapping.cs
new file mode 100644
index 0000000..c3660e2
--- /dev/null
+++ b/desktop/lib/juprovider.lib.protocol/Mapping/DataMapping.cs
@@ -0,0 +1,196 @@
+using System.Globalization;
+using System.Text.RegularExpressions;
+using JuProvider.Lib.Protocol.Parsing;
+
+namespace JuProvider.Lib.Protocol.Mapping;
+
+/// <summary>장치 = DEV_CD. Gateway 부모는 키에 넣지 않는다 (C0 §6, D7)</summary>
+public sealed record DeviceRef(string DevCd);
+
+/// <summary>채널 = DEV_CD + ChannelKey. ChannelKey는 대소문자 구분 문자열 그대로 비교("1" ≠ "01", "ch1" ≠ "CH1")</summary>
+public sealed record ChannelRef(string DevCd, string ChannelKey);
+
+/// <summary>논리 Data = DAT_GR_CD + DAT_CD + DAT_IDX (ju_data_tag)</summary>
+public sealed record LogicalDataRef(string DatGrCd, string DatCd, int DatIdx) : IComparable<LogicalDataRef>
+{
+    public string Key => $"{DatGrCd}/{DatCd}/{DatIdx.ToString(CultureInfo.InvariantCulture)}";
+
+    public int CompareTo(LogicalDataRef? other)
+    {
+        if (other is null) return 1;
+        int c = string.CompareOrdinal(DatGrCd, other.DatGrCd);
+        if (c != 0) return c;
+        c = string.CompareOrdinal(DatCd, other.DatCd);
+        return c != 0 ? c : DatIdx.CompareTo(other.DatIdx);
+    }
+
+    public override string ToString() => Key;
+}
+
+public enum DataQuality
+{
+    Good,
+    /// <summary>DAT_MIN/MAX 밖. 값은 유지</summary>
+    Range,
+    /// <summary>숫자 값 없음</summary>
+    ParseErr,
+    Stale,
+    /// <summary>매핑 없는 채널. 값을 버리지 않고 보고</summary>
+    Unmapped
+}
+
+public sealed record ValueTransform(double Scale = 1, double Offset = 0)
+{
+    public static ValueTransform Identity { get; } = new();
+
+    public double Apply(double value) => value * Scale + Offset;
+}
+
+/// <summary>
+/// 매핑 1행 (C0 §6, 이후 ju_data_channel_map). PtlCd 가 있으면 그 프로토콜 응답에서만 적용.
+/// Min/Max 는 변환 후 값 기준.
+/// </summary>
+public sealed record ChannelMapEntry(
+    string DevCd,
+    string ChannelKey,
+    LogicalDataRef Target,
+    string? PtlCd = null,
+    ValueTransform? Transform = null,
+    string? Unit = null,
+    double? Min = null,
+    double? Max = null,
+    bool Use = true);
+
+public sealed record LogicalValue(
+    DeviceRef Device,
+    ChannelRef Channel,
+    int SampleIndex,
+    LogicalDataRef? Data,
+    double? Value,
+    string? Text,
+    string? Unit,
+    DataQuality Quality,
+    DateTimeOffset ReceivedAt,
+    DateTimeOffset? DeviceTime = null);
+
+public interface IDataMapper
+{
+    IReadOnlyList<LogicalValue> Map(string devCd, string ptlCd, IReadOnlyList<RawValue> values, DateTimeOffset? receivedAt = null);
+}
+
+/// <summary>
+/// 원시값 → 논리 Data. 매핑 목록만 받는다 (CH&lt;n&gt; 규칙은 LegacyTagIdMapping 에 격리).
+/// 결과 순서: 입력 원시값 순서 → 한 채널의 여러 대상은 LogicalDataRef 정렬 순. 매핑 목록 순서와 무관 (D1).
+/// Absent(INFO 미연결) 값은 건너뛴다.
+/// </summary>
+public sealed class DataMapper : IDataMapper
+{
+    private readonly Dictionary<(string DevCd, string ChannelKey), ChannelMapEntry[]> _index;
+
+    public DataMapper(IEnumerable<ChannelMapEntry> entries)
+    {
+        ArgumentNullException.ThrowIfNull(entries);
+        var list = entries.ToList();
+        foreach (ChannelMapEntry e in list)
+        {
+            if (string.IsNullOrEmpty(e.DevCd) || string.IsNullOrEmpty(e.ChannelKey) || e.Target is null
+                || string.IsNullOrEmpty(e.Target.DatGrCd) || string.IsNullOrEmpty(e.Target.DatCd))
+            {
+                throw new ArgumentException($"매핑 항목 값 누락: {e}", nameof(entries));
+            }
+        }
+
+        _index = list
+            .Where(e => e.Use)
+            .GroupBy(e => (e.DevCd, e.ChannelKey))
+            .ToDictionary(
+                g => g.Key,
+                g => g
+                    .GroupBy(e => (e.PtlCd, e.Target))   // 같은 대상 중복 제거 (먼저 온 것)
+                    .Select(x => x.First())
+                    .OrderBy(e => e.Target)
+                    .ThenBy(e => e.PtlCd, StringComparer.Ordinal)
+                    .ToArray());
+    }
+
+    public int EntryCount => _index.Values.Sum(a => a.Length);
+
+    public IReadOnlyList<LogicalValue> Map(string devCd, string ptlCd, IReadOnlyList<RawValue> values, DateTimeOffset? receivedAt = null)
+    {
+        ArgumentNullException.ThrowIfNull(values);
+        DateTimeOffset at = receivedAt ?? DateTimeOffset.Now;
+        var device = new DeviceRef(devCd);
+        var result = new List<LogicalValue>(values.Count);
+
+        foreach (RawValue raw in values)
+        {
+            if (raw.Absent) continue;
+            var channel = new ChannelRef(devCd, raw.ChannelKey);
+
+            ChannelMapEntry[] targets = _index.TryGetValue((devCd, raw.ChannelKey), out var all)
+                ? all.Where(e => e.PtlCd is null || e.PtlCd == ptlCd).ToArray()
+                : [];
+
+            if (targets.Length == 0)
+            {
+                result.Add(new LogicalValue(device, channel, raw.SampleIndex, null, raw.Value, raw.Text, null, DataQuality.Unmapped, at));
+                continue;
+            }
+
+            foreach (ChannelMapEntry e in targets)
+            {
+                if (raw.Value is not { } v)
+                {
+                    result.Add(new LogicalValue(device, channel, raw.SampleIndex, e.Target, null, raw.Text, e.Unit, DataQuality.ParseErr, at));
+                    continue;
+                }
+
+                double value = (e.Transform ?? ValueTransform.Identity).Apply(v);
+                bool outOfRange = (e.Min is { } min && value < min) || (e.Max is { } max && value > max);
+                result.Add(new LogicalValue(device, channel, raw.SampleIndex, e.Target, value, raw.Text, e.Unit,
+                    outOfRange ? DataQuality.Range : DataQuality.Good, at));
+            }
+        }
+        return result;
+    }
+}
+
+/// <summary>과거 ju_data_tag 1행 (TAG_ID 관례 변환용)</summary>
+public sealed record LegacyDataTag(
+    string DevCd,
+    string DatGrCd,
+    string DatCd,
+    int DatIdx,
+    string? TagId,
+    string? Unit = null,
+    double? Min = null,
+    double? Max = null);
+
+/// <summary>
+/// 임시 변환 (C0-Q7): TAG_ID = "CH&lt;n&gt;" → ChannelKey "n" (앞의 0 제거, TEXT 파서의 위치 키와 같음).
+/// 매핑 테이블(ju_data_channel_map)이 생기면 이 클래스만 빼면 된다. 결과는 테이블 형식과 같은 ChannelMapEntry.
+/// </summary>
+public static partial class LegacyTagIdMapping
+{
+    [GeneratedRegex("^CH([0-9]{1,4})$", RegexOptions.CultureInvariant)]
+    private static partial Regex TagIdPattern();
+
+    public static IReadOnlyList<ChannelMapEntry> ToEntries(IEnumerable<LegacyDataTag> tags, ICollection<string>? warnings = null)
+    {
+        ArgumentNullException.ThrowIfNull(tags);
+        var result = new List<ChannelMapEntry>();
+        foreach (LegacyDataTag t in tags)
+        {
+            Match m = TagIdPattern().Match(t.TagId ?? string.Empty);
+            if (!m.Success)
+            {
+                warnings?.Add($"{t.DevCd} {t.DatGrCd}/{t.DatCd}/{t.DatIdx}: TAG_ID '{t.TagId}' 는 CH<n> 형식이 아님 → 제외");
+                continue;
+            }
+            string key = int.Parse(m.Groups[1].Value, CultureInfo.InvariantCulture).ToString(CultureInfo.InvariantCulture);
+            result.Add(new ChannelMapEntry(t.DevCd, key, new LogicalDataRef(t.DatGrCd, t.DatCd, t.DatIdx),
+                Unit: t.Unit, Min: t.Min, Max: t.Max));
+        }
+        return result;
+    }
+}
diff --git a/desktop/lib/juprovider.lib.protocol/Model/ProtocolModel.cs b/desktop/lib/juprovider.lib.protocol/Model/ProtocolModel.cs
new file mode 100644
index 0000000..2546fce
--- /dev/null
+++ b/desktop/lib/juprovider.lib.protocol/Model/ProtocolModel.cs
@@ -0,0 +1,46 @@
+namespace JuProvider.Lib.Protocol.Model;
+
+/// <summary>프로토콜 교환 방식 (C0 §3). 프로토콜당 1개</summary>
+public enum ExchangePattern
+{
+    /// <summary>송신만. 쓰기 완료 = 완료</summary>
+    TxOnly,
+    /// <summary>송신 후 응답 1건</summary>
+    TxRx,
+    /// <summary>장비가 보내는 연속 수신. Scheduler를 거치지 않음</summary>
+    RxStream,
+    /// <summary>주기적 TX_RX</summary>
+    Poll
+}
+
+/// <summary>프로토콜 역할 (C0 §3). 복수 가능</summary>
+[Flags]
+public enum ProtocolRole
+{
+    None = 0,
+    Info = 1,
+    Control = 2,
+    Data = 4
+}
+
+/// <summary>상태 전이 명령 구분. STOP 우선순위·START/PAUSE 취소 규칙에 쓴다</summary>
+public enum CommandAction
+{
+    None,
+    Start,
+    Pause,
+    Stop
+}
+
+public static class ProtocolModel
+{
+    /// <summary>공통코드 PROT → ExchangePattern (C0 §3 확정 의미)</summary>
+    public static ExchangePattern FromPtlType(string? ptlType) => ptlType switch
+    {
+        "PROT0000" => ExchangePattern.Poll,
+        "PROT0001" => ExchangePattern.TxOnly,
+        "PROT0002" => ExchangePattern.RxStream,
+        "PROT0003" => ExchangePattern.TxRx,
+        _ => throw new ArgumentException($"알 수 없는 PTL_TYPE: {ptlType}", nameof(ptlType))
+    };
+}
diff --git a/desktop/lib/juprovider.lib.protocol/Parsing/Parsers.cs b/desktop/lib/juprovider.lib.protocol/Parsing/Parsers.cs
new file mode 100644
index 0000000..67dbbc1
--- /dev/null
+++ b/desktop/lib/juprovider.lib.protocol/Parsing/Parsers.cs
@@ -0,0 +1,171 @@
+using System.Buffers.Binary;
+using System.Globalization;
+using System.Text;
+using JuProvider.Lib.Protocol.Framing;
+using JuProvider.Lib.Protocol.Rules;
+
+namespace JuProvider.Lib.Protocol.Parsing;
+
+/// <summary>
+/// 파서 출력 1개.
+/// ChannelKey: TEXT=위치("1","2",…), SAMPLES=선택 채널 키, INFO/BINARY=필드 key. 문자열 그대로 비교한다("1" ≠ "01").
+/// Value: 숫자 값(INFO는 null), Text: 원래 토큰, Absent: INFO에서 '없음' 값과 같을 때 true.
+/// </summary>
+public sealed record RawValue(string ChannelKey, int SampleIndex, double? Value, string? Text, bool Absent = false);
+
+/// <summary>SAMPLES 모드의 선택 채널 등 실행 시점 값</summary>
+public sealed record ParseContext(string SelectedChannelKey = "1");
+
+public sealed record ParseResult(bool Ok, IReadOnlyList<RawValue> Values, string? Error)
+{
+    public static ParseResult Fail(string error) => new(false, [], error);
+    public static ParseResult Success(IReadOnlyList<RawValue> values) => new(true, values, null);
+}
+
+public interface IFrameParser
+{
+    ParseResult Parse(Frame frame, ParseContext? context = null);
+}
+
+public static class ParserFactory
+{
+    public static IFrameParser Create(ParseRule rule) => rule.Kind switch
+    {
+        ParseKind.Text => new TextFrameParser(rule),
+        ParseKind.Info => new InfoFrameParser(rule),
+        ParseKind.Binary => new BinaryFrameParser(rule),
+        _ => throw new ArgumentOutOfRangeException(nameof(rule))
+    };
+}
+
+internal static class TextTokens
+{
+    /// <summary>ASCII 본문 → (trim 확인 후) 토큰. 실패 시 null + 사유</summary>
+    public static string[]? Split(Frame frame, ParseRule rule, out string? error)
+    {
+        error = null;
+        foreach (byte b in frame.Body)
+        {
+            if (b > 0x7F)
+            {
+                error = "ASCII가 아닌 바이트";
+                return null;
+            }
+        }
+
+        string s = Encoding.ASCII.GetString(frame.Body).Trim();
+        if (rule.Trim is { Length: 2 } trim)
+        {
+            if (s.Length < 2 || s[0] != trim[0] || s[^1] != trim[1])
+            {
+                error = $"앞뒤 문자 불일치 (기대 {trim[0]}…{trim[1]})";
+                return null;
+            }
+            s = s[1..^1];
+        }
+
+        string[] tokens = rule.Separator switch
+        {
+            TextSeparator.Comma => s.Split(',', StringSplitOptions.TrimEntries),
+            TextSeparator.Tab => s.Split('\t', StringSplitOptions.TrimEntries),
+            _ => s.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
+        };
+
+        if (tokens.Length == 1 && tokens[0].Length == 0) tokens = [];
+        if (rule.Count > 0 && tokens.Length != rule.Count)
+        {
+            error = $"항목 수 불일치 (기대 {rule.Count}, 실제 {tokens.Length})";
+            return null;
+        }
+        return tokens;
+    }
+}
+
+/// <summary>TEXT: 숫자 토큰 → CHANNELS("1".."n") 또는 SAMPLES(선택 채널, 샘플 0..n-1)</summary>
+public sealed class TextFrameParser(ParseRule rule) : IFrameParser
+{
+    public ParseResult Parse(Frame frame, ParseContext? context = null)
+    {
+        string[]? tokens = TextTokens.Split(frame, rule, out string? error);
+        if (tokens is null) return ParseResult.Fail(error!);
+        if (tokens.Length == 0) return ParseResult.Fail("항목 없음");
+
+        var values = new List<RawValue>(tokens.Length);
+        string selected = (context ?? new ParseContext()).SelectedChannelKey;
+
+        for (int i = 0; i < tokens.Length; i++)
+        {
+            if (!double.TryParse(tokens[i], NumberStyles.Float, CultureInfo.InvariantCulture, out double v))
+            {
+                return ParseResult.Fail($"숫자가 아님: '{tokens[i]}' (항목 {i + 1})");
+            }
+            values.Add(rule.Map == ValueMap.Channels
+                ? new RawValue((i + 1).ToString(CultureInfo.InvariantCulture), 0, v, tokens[i])
+                : new RawValue(selected, i, v, tokens[i]));
+        }
+        return ParseResult.Success(values);
+    }
+}
+
+/// <summary>INFO: 토큰 i → Fields[i], 숫자 변환 없음. Absent 값이면 Absent=true</summary>
+public sealed class InfoFrameParser(ParseRule rule) : IFrameParser
+{
+    public ParseResult Parse(Frame frame, ParseContext? context = null)
+    {
+        string[]? tokens = TextTokens.Split(frame, rule with { Count = rule.Fields.Count }, out string? error);
+        if (tokens is null) return ParseResult.Fail(error!);
+
+        var values = new List<RawValue>(tokens.Length);
+        for (int i = 0; i < tokens.Length; i++)
+        {
+            if (tokens[i].Length == 0) return ParseResult.Fail($"빈 항목 (항목 {i + 1})");
+            bool absent = rule.Absent is not null && string.Equals(tokens[i], rule.Absent, StringComparison.Ordinal);
+            values.Add(new RawValue(rule.Fields[i], 0, null, tokens[i], absent));
+        }
+        return ParseResult.Success(values);
+    }
+}
+
+/// <summary>BINARY: Body 기준 offset의 값 × scale + valueOffset</summary>
+public sealed class BinaryFrameParser(ParseRule rule) : IFrameParser
+{
+    public ParseResult Parse(Frame frame, ParseContext? context = null)
+    {
+        ReadOnlySpan<byte> body = frame.Body;
+        var values = new List<RawValue>(rule.BinaryFields.Count);
+
+        foreach (BinaryField f in rule.BinaryFields)
+        {
+            int size = Size(f.Type);
+            if (f.Offset + size > body.Length)
+            {
+                return ParseResult.Fail($"{f.Key}: 프레임 길이 부족 (필요 {f.Offset + size}, 실제 {body.Length})");
+            }
+            double raw = Read(body.Slice(f.Offset, size), f.Type, f.BigEndian);
+            values.Add(new RawValue(f.Key, 0, raw * f.Scale + f.ValueOffset, null));
+        }
+        return ParseResult.Success(values);
+    }
+
+    private static int Size(BinaryType t) => t switch
+    {
+        BinaryType.U8 or BinaryType.I8 => 1,
+        BinaryType.U16 or BinaryType.I16 => 2,
+        BinaryType.U32 or BinaryType.I32 or BinaryType.F32 => 4,
+        BinaryType.F64 => 8,
+        _ => throw new ArgumentOutOfRangeException(nameof(t))
+    };
+
+    private static double Read(ReadOnlySpan<byte> s, BinaryType t, bool be) => t switch
+    {
+        BinaryType.U8 => s[0],
+        BinaryType.I8 => (sbyte)s[0],
+        BinaryType.U16 => be ? BinaryPrimitives.ReadUInt16BigEndian(s) : BinaryPrimitives.ReadUInt16LittleEndian(s),
+        BinaryType.I16 => be ? BinaryPrimitives.ReadInt16BigEndian(s) : BinaryPrimitives.ReadInt16LittleEndian(s),
+        BinaryType.U32 => be ? BinaryPrimitives.ReadUInt32BigEndian(s) : BinaryPrimitives.ReadUInt32LittleEndian(s),
+        BinaryType.I32 => be ? BinaryPrimitives.ReadInt32BigEndian(s) : BinaryPrimitives.ReadInt32LittleEndian(s),
+        BinaryType.F32 => be ? BinaryPrimitives.ReadSingleBigEndian(s) : BinaryPrimitives.ReadSingleLittleEndian(s),
+        BinaryType.F64 => be ? BinaryPrimitives.ReadDoubleBigEndian(s) : BinaryPrimitives.ReadDoubleLittleEndian(s),
+        _ => throw new ArgumentOutOfRangeException(nameof(t))
+    };
+}
diff --git a/desktop/lib/juprovider.lib.protocol/Rules/FrameRule.cs b/desktop/lib/juprovider.lib.protocol/Rules/FrameRule.cs
new file mode 100644
index 0000000..049f4c6
--- /dev/null
+++ b/desktop/lib/juprovider.lib.protocol/Rules/FrameRule.cs
@@ -0,0 +1,89 @@
+namespace JuProvider.Lib.Protocol.Rules;
+
+/// <summary>프레임 구분 방식 (C0 §4)</summary>
+public enum FrameKind
+{
+    /// <summary>끝 구분자 (예: [CR][LF])</summary>
+    Delim,
+    /// <summary>시작·끝 바이트 + 선택 escape (예: [STX]…[ETX], DLE)</summary>
+    StxEtx,
+    /// <summary>고정 길이</summary>
+    Fixed,
+    /// <summary>헤더 안 길이 필드로 가변 길이</summary>
+    LenField
+}
+
+public enum ChecksumType
+{
+    None,
+    Sum8,
+    Xor8,
+    Crc16Modbus
+}
+
+/// <summary>
+/// 체크섬: 프레임 본문(Body)의 마지막 Size 바이트가 체크섬 값이다.
+/// 데이터부 D = Body[0 .. Body.Length - Size).
+/// 계산 범위 = D[From .. End), End = To &gt; 0 이면 To, To &lt;= 0 이면 D.Length + To (기본 0 = 끝까지).
+/// 범위가 잘못되면(From &gt; End, End &gt; D.Length) 프레임을 버린다.
+/// 검증 후 체크섬 바이트는 Body에서 제거한다. CRC16_MODBUS 값은 Little Endian.
+/// 예: 헤더 1바이트 제외 → from=1, 마지막 1바이트(예: 종료 문자) 제외 → to=-1
+/// </summary>
+public sealed record ChecksumRule(ChecksumType Type, int From = 0, int To = 0)
+{
+    public int Size => Type switch
+    {
+        ChecksumType.None => 0,
+        ChecksumType.Crc16Modbus => 2,
+        _ => 1
+    };
+
+    /// <summary>데이터부 길이에 대한 계산 범위 [start, end). 잘못되면 false</summary>
+    public bool TryRange(int dataLength, out int start, out int end)
+    {
+        start = From;
+        end = To > 0 ? To : dataLength + To;
+        return start >= 0 && end <= dataLength && start <= end;
+    }
+}
+
+/// <summary>
+/// 바이트 흐름 → 프레임 규칙. 바이트 값은 ProtocolExpression 문법으로 적고 여기서는 변환된 바이트를 가진다.
+/// Body 정의:
+///  - Delim  : 끝 구분자를 뺀 앞부분
+///  - StxEtx : STX·ETX를 빼고 escape를 푼 내용
+///  - Fixed / LenField : 프레임 전체 (바이너리 Parse Rule의 offset 기준)
+/// </summary>
+public sealed record FrameRule
+{
+    public FrameKind Kind { get; init; } = FrameKind.Delim;
+
+    public byte[] End { get; init; } = [0x0D, 0x0A];
+
+    /// <summary>
+    /// Delim: 프레임 시작 문자(선택, C4). 있으면 시작 문자 앞의 바이트는 잡음으로 버리고,
+    /// 끝 구분자 전에 다음 시작 문자가 오면 앞의 깨진 조각을 버린다. Body 에는 시작 문자가 포함된다.
+    /// </summary>
+    public byte[]? Start { get; init; }
+
+    public byte Stx { get; init; } = 0x02;
+    public byte Etx { get; init; } = 0x03;
+    public byte? Escape { get; init; }
+
+    /// <summary>Fixed 길이</summary>
+    public int Length { get; init; }
+
+    /// <summary>LenField: 길이 필드 위치·크기(1,2,4)·바이트 순서</summary>
+    public int LengthOffset { get; init; }
+    public int LengthSize { get; init; } = 1;
+    public bool LengthBigEndian { get; init; } = true;
+    /// <summary>LenField: 길이 값에 더할 보정값</summary>
+    public int LengthAdjust { get; init; }
+    /// <summary>LenField: 길이 값이 헤더(0..LengthOffset+LengthSize)까지 포함하는지</summary>
+    public bool LengthIncludesHeader { get; init; }
+
+    /// <summary>이 길이를 넘으면 버퍼를 비우고 거부한다 (쓰레기 데이터 보호)</summary>
+    public int MaxLength { get; init; } = 4096;
+
+    public ChecksumRule Checksum { get; init; } = new(ChecksumType.None);
+}
diff --git a/desktop/lib/juprovider.lib.protocol/Rules/LegacyRuleText.cs b/desktop/lib/juprovider.lib.protocol/Rules/LegacyRuleText.cs
new file mode 100644
index 0000000..995534d
--- /dev/null
+++ b/desktop/lib/juprovider.lib.protocol/Rules/LegacyRuleText.cs
@@ -0,0 +1,79 @@
+namespace JuProvider.Lib.Protocol.Rules;
+
+/// <summary>
+/// 과거 GTEC 규칙 텍스트(읽기 호환):
+///   FRAME=CRLF;STX={;ETX=};MODE=DELIMITED|INFO|NONE;SEP=SPACE|COMMA;COUNT=3;MAP=CHANNELS|SAMPLES|NONE
+/// 과거 의미: 프레임은 CRLF로 끊고, STX/ETX 문자는 프레임 내용의 앞뒤 확인용이었다.
+/// 변환: Frame = DELIM [CR][LF], Parse = TEXT(trim = STX+ETX) 또는 INFO(CH1..CHn).
+/// 과거 INFO(센서정보)는 4항목 고정이었다 → COUNT가 없으면 4.
+/// </summary>
+public static class LegacyRuleText
+{
+    public static (FrameRule? Frame, ParseRule? Parse) ToRules(string text)
+    {
+        var values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
+        foreach (string item in text.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
+        {
+            int p = item.IndexOf('=');
+            if (p <= 0) throw new RuleFormatException($"규칙 항목은 KEY=VALUE 형식이어야 합니다: {item}");
+            values[item[..p].Trim()] = item[(p + 1)..].Trim();
+        }
+        if (values.Count == 0) throw new RuleFormatException("규칙이 비어 있습니다.");
+
+        string V(string key, string fallback) => values.TryGetValue(key, out string? v) && v.Length > 0 ? v : fallback;
+
+        string frame = V("FRAME", "CRLF").ToUpperInvariant();
+        FrameRule frameRule = frame switch
+        {
+            "CRLF" => new FrameRule { Kind = FrameKind.Delim, End = [0x0D, 0x0A] },
+            "LF" => new FrameRule { Kind = FrameKind.Delim, End = [0x0A] },
+            "CR" => new FrameRule { Kind = FrameKind.Delim, End = [0x0D] },
+            _ => throw new RuleFormatException($"과거 규칙 FRAME 값을 알 수 없습니다: {frame}")
+        };
+
+        string stx = V("STX", "{");
+        string etx = V("ETX", "}");
+        if (stx.Length != 1 || etx.Length != 1) throw new RuleFormatException("과거 규칙 STX/ETX는 1글자입니다.");
+        string trim = stx + etx;
+
+        string mode = V("MODE", "DELIMITED").ToUpperInvariant();
+        string map = V("MAP", "CHANNELS").ToUpperInvariant();
+        int count = RuleReader.ParseIntInvariant(V("COUNT", "0"), "COUNT");
+        if (count < 0) throw new RuleFormatException("COUNT는 0 이상이어야 합니다.");
+
+        if (mode == "NONE" || map == "NONE")
+        {
+            return (frameRule, null);
+        }
+
+        if (mode == "INFO")
+        {
+            int n = count > 0 ? count : 4;
+            return (frameRule, new ParseRule
+            {
+                Kind = ParseKind.Info,
+                Trim = trim,
+                Separator = RuleReader.Sep(V("SEP", "COMMA")),
+                Fields = Enumerable.Range(1, n).Select(i => "CH" + i).ToArray(),
+                Count = n,
+                Absent = "000"
+            });
+        }
+
+        if (mode != "DELIMITED") throw new RuleFormatException($"과거 규칙 MODE 값을 알 수 없습니다: {mode}");
+
+        return (frameRule, new ParseRule
+        {
+            Kind = ParseKind.Text,
+            Trim = trim,
+            Separator = RuleReader.Sep(V("SEP", "SPACE")),
+            Count = count,
+            Map = map switch
+            {
+                "CHANNELS" => ValueMap.Channels,
+                "SAMPLES" => ValueMap.Samples,
+                _ => throw new RuleFormatException($"과거 규칙 MAP 값을 알 수 없습니다: {map}")
+            }
+        });
+    }
+}
diff --git a/desktop/lib/juprovider.lib.protocol/Rules/ParseRule.cs b/desktop/lib/juprovider.lib.protocol/Rules/ParseRule.cs
new file mode 100644
index 0000000..3adbcfa
--- /dev/null
+++ b/desktop/lib/juprovider.lib.protocol/Rules/ParseRule.cs
@@ -0,0 +1,63 @@
+namespace JuProvider.Lib.Protocol.Rules;
+
+public enum ParseKind
+{
+    /// <summary>ASCII 텍스트 숫자 목록 (GTEC 저속·고속)</summary>
+    Text,
+    /// <summary>ASCII 텍스트 항목 목록 (센서정보 등, 숫자 변환 없음)</summary>
+    Info,
+    /// <summary>바이너리 필드</summary>
+    Binary
+}
+
+public enum TextSeparator
+{
+    /// <summary>공백·탭 연속 허용</summary>
+    Space,
+    Comma,
+    Tab
+}
+
+public enum ValueMap
+{
+    /// <summary>토큰 i → 채널 "i+1", 샘플 0</summary>
+    Channels,
+    /// <summary>토큰 i → 선택 채널, 샘플 i</summary>
+    Samples
+}
+
+public enum BinaryType
+{
+    U8, I8, U16, I16, U32, I32, F32, F64
+}
+
+/// <summary>BINARY 필드: Body 기준 Offset 위치의 값 → (raw × Scale + ValueOffset)</summary>
+public sealed record BinaryField(
+    string Key,
+    int Offset,
+    BinaryType Type,
+    bool BigEndian = false,
+    double Scale = 1,
+    double ValueOffset = 0);
+
+/// <summary>
+/// 프레임 → 원시값 규칙 (C0 §4).
+/// Trim: 앞뒤 감싸는 문자 2개(예: "{}"). 지정하면 프레임이 반드시 그 문자로 시작·끝나야 한다.
+/// Count: 0이면 토큰 수 검사 안 함.
+/// </summary>
+public sealed record ParseRule
+{
+    public ParseKind Kind { get; init; } = ParseKind.Text;
+
+    public string? Trim { get; init; }
+    public TextSeparator Separator { get; init; } = TextSeparator.Space;
+    public int Count { get; init; }
+    public ValueMap Map { get; init; } = ValueMap.Channels;
+
+    /// <summary>INFO: 항목 순서대로 붙일 채널 키 (예: CH1..CH4)</summary>
+    public IReadOnlyList<string> Fields { get; init; } = [];
+    /// <summary>INFO: 이 값이면 미연결/없음으로 표시 (예: "000")</summary>
+    public string? Absent { get; init; }
+
+    public IReadOnlyList<BinaryField> BinaryFields { get; init; } = [];
+}
diff --git a/desktop/lib/juprovider.lib.protocol/Rules/RuleReader.cs b/desktop/lib/juprovider.lib.protocol/Rules/RuleReader.cs
new file mode 100644
index 0000000..db9eea8
--- /dev/null
+++ b/desktop/lib/juprovider.lib.protocol/Rules/RuleReader.cs
@@ -0,0 +1,284 @@
+using System.Globalization;
+using System.Text.Json;
+using JuProvider.Lib.Protocol.Expression;
+
+namespace JuProvider.Lib.Protocol.Rules;
+
+public sealed class RuleFormatException(string message) : FormatException(message);
+
+/// <summary>
+/// Frame Rule / Parse Rule 읽기 (C0 §4.1).
+/// - JSON v1: {"v":1,"kind":"DELIM", ...}
+/// - 과거 GTEC 텍스트: FRAME=CRLF;STX={;ETX=};MODE=DELIMITED;SEP=SPACE;COUNT=3;MAP=CHANNELS (읽기 호환)
+/// 빈 값이면 null (규칙 없음).
+/// </summary>
+public static class RuleReader
+{
+    public static FrameRule? ReadFrameRule(string? text)
+    {
+        if (string.IsNullOrWhiteSpace(text)) return null;
+        string t = text.Trim();
+        return t.StartsWith('{') ? FrameFromJson(t) : LegacyRuleText.ToRules(t).Frame;
+    }
+
+    public static ParseRule? ReadParseRule(string? text)
+    {
+        if (string.IsNullOrWhiteSpace(text)) return null;
+        string t = text.Trim();
+        return t.StartsWith('{') ? ParseFromJson(t) : LegacyRuleText.ToRules(t).Parse;
+    }
+
+    // ----- JSON -----
+
+    private static JsonElement Root(string json)
+    {
+        JsonElement root;
+        try
+        {
+            using JsonDocument doc = JsonDocument.Parse(json);
+            root = doc.RootElement.Clone();
+        }
+        catch (JsonException ex)
+        {
+            throw new RuleFormatException("규칙 JSON 형식 오류: " + ex.Message);
+        }
+
+        if (root.ValueKind != JsonValueKind.Object) throw new RuleFormatException("규칙은 JSON 객체여야 합니다.");
+        int v = root.TryGetProperty("v", out JsonElement ve) && ve.TryGetInt32(out int n) ? n : 0;
+        if (v != 1) throw new RuleFormatException($"지원하지 않는 규칙 버전입니다: v={v}");
+        return root;
+    }
+
+    private static string Kind(JsonElement r) =>
+        Str(r, "kind") ?? throw new RuleFormatException("kind가 필요합니다.");
+
+    private static FrameRule FrameFromJson(string json)
+    {
+        JsonElement r = Root(json);
+        string kind = Kind(r).ToUpperInvariant();
+        int maxLen = Int(r, "maxLen") ?? 4096;
+        if (maxLen <= 0) throw new RuleFormatException("maxLen은 1 이상이어야 합니다.");
+        ChecksumRule checksum = ReadChecksum(r);
+
+        FrameRule rule = kind switch
+        {
+            "DELIM" => new FrameRule
+            {
+                Kind = FrameKind.Delim,
+                End = Bytes(Str(r, "end") ?? "[CR][LF]", "end", minLength: 1),
+                Start = Str(r, "start") is { } st ? Bytes(st, "start", minLength: 1) : null
+            },
+            "STXETX" => new FrameRule
+            {
+                Kind = FrameKind.StxEtx,
+                Stx = OneByte(Str(r, "stx") ?? "[STX]", "stx"),
+                Etx = OneByte(Str(r, "etx") ?? "[ETX]", "etx"),
+                Escape = Str(r, "escape") is { } esc ? OneByte(esc, "escape") : null
+            },
+            "FIXED" => new FrameRule
+            {
+                Kind = FrameKind.Fixed,
+                Length = Int(r, "len") is int len && len > 0 ? len : throw new RuleFormatException("FIXED는 len(1 이상)이 필요합니다.")
+            },
+            "LENFIELD" => ReadLenField(r),
+            _ => throw new RuleFormatException($"알 수 없는 frame kind: {kind}")
+        };
+
+        return rule with { MaxLength = maxLen, Checksum = checksum };
+    }
+
+    private static FrameRule ReadLenField(JsonElement r)
+    {
+        int offset = Int(r, "offset") ?? throw new RuleFormatException("LENFIELD는 offset이 필요합니다.");
+        int size = Int(r, "size") ?? 1;
+        if (offset < 0) throw new RuleFormatException("offset은 0 이상이어야 합니다.");
+        if (size is not (1 or 2 or 4)) throw new RuleFormatException("size는 1, 2, 4 중 하나여야 합니다.");
+        string endian = (Str(r, "endian") ?? "BE").ToUpperInvariant();
+        if (endian is not ("BE" or "LE")) throw new RuleFormatException("endian은 BE 또는 LE입니다.");
+
+        return new FrameRule
+        {
+            Kind = FrameKind.LenField,
+            LengthOffset = offset,
+            LengthSize = size,
+            LengthBigEndian = endian == "BE",
+            LengthAdjust = Int(r, "adjust") ?? 0,
+            LengthIncludesHeader = Bool(r, "includesHeader") ?? false
+        };
+    }
+
+    private static ChecksumRule ReadChecksum(JsonElement r)
+    {
+        if (!r.TryGetProperty("checksum", out JsonElement c) || c.ValueKind == JsonValueKind.Null)
+        {
+            return new ChecksumRule(ChecksumType.None);
+        }
+
+        string type = (Str(c, "type") ?? "NONE").ToUpperInvariant();
+        ChecksumType t = type switch
+        {
+            "NONE" => ChecksumType.None,
+            "SUM8" => ChecksumType.Sum8,
+            "XOR8" => ChecksumType.Xor8,
+            "CRC16_MODBUS" => ChecksumType.Crc16Modbus,
+            _ => throw new RuleFormatException($"알 수 없는 checksum type: {type}")
+        };
+        int from = Int(c, "from") ?? 0;
+        if (from < 0) throw new RuleFormatException("checksum.from은 0 이상이어야 합니다.");
+        int to = Int(c, "to") ?? 0;
+        if (to > 0 && to < from) throw new RuleFormatException("checksum.to는 from 이상이어야 합니다 (양수일 때).");
+        return new ChecksumRule(t, from, to);
+    }
+
+    private static ParseRule ParseFromJson(string json)
+    {
+        JsonElement r = Root(json);
+        string kind = Kind(r).ToUpperInvariant();
+        string? trim = Str(r, "trim");
+        if (trim is not null && trim.Length != 2) throw new RuleFormatException("trim은 앞·뒤 2글자입니다 (예: \"{}\").");
+
+        switch (kind)
+        {
+            case "TEXT":
+            {
+                int count = Int(r, "count") ?? 0;
+                if (count < 0) throw new RuleFormatException("count는 0 이상이어야 합니다.");
+                return new ParseRule
+                {
+                    Kind = ParseKind.Text,
+                    Trim = trim,
+                    Separator = Sep(Str(r, "sep")),
+                    Count = count,
+                    Map = (Str(r, "map") ?? "CHANNELS").ToUpperInvariant() switch
+                    {
+                        "CHANNELS" => ValueMap.Channels,
+                        "SAMPLES" => ValueMap.Samples,
+                        string m => throw new RuleFormatException($"알 수 없는 map: {m}")
+                    }
+                };
+            }
+            case "INFO":
+            {
+                IReadOnlyList<string> fields = StrArray(r, "fields");
+                if (fields.Count == 0) throw new RuleFormatException("INFO는 fields가 필요합니다.");
+                return new ParseRule
+                {
+                    Kind = ParseKind.Info,
+                    Trim = trim,
+                    Separator = Sep(Str(r, "sep") ?? "COMMA"),
+                    Fields = fields,
+                    Count = fields.Count,
+                    Absent = Str(r, "absent")
+                };
+            }
+            case "BINARY":
+                return new ParseRule { Kind = ParseKind.Binary, BinaryFields = ReadBinaryFields(r) };
+            default:
+                throw new RuleFormatException($"알 수 없는 parse kind: {kind}");
+        }
+    }
+
+    private static IReadOnlyList<BinaryField> ReadBinaryFields(JsonElement r)
+    {
+        if (!r.TryGetProperty("fields", out JsonElement arr) || arr.ValueKind != JsonValueKind.Array || arr.GetArrayLength() == 0)
+        {
+            throw new RuleFormatException("BINARY는 fields 배열이 필요합니다.");
+        }
+
+        var list = new List<BinaryField>();
+        var keys = new HashSet<string>(StringComparer.Ordinal);
+        foreach (JsonElement f in arr.EnumerateArray())
+        {
+            string key = Str(f, "key") ?? throw new RuleFormatException("BINARY 필드에 key가 필요합니다.");
+            if (!keys.Add(key)) throw new RuleFormatException($"BINARY 필드 key 중복: {key}");
+            int offset = Int(f, "offset") ?? throw new RuleFormatException($"{key}: offset이 필요합니다.");
+            if (offset < 0) throw new RuleFormatException($"{key}: offset은 0 이상이어야 합니다.");
+            string typeText = (Str(f, "type") ?? throw new RuleFormatException($"{key}: type이 필요합니다.")).ToUpperInvariant();
+            if (!Enum.TryParse(typeText, ignoreCase: true, out BinaryType type) || !Enum.IsDefined(type))
+            {
+                throw new RuleFormatException($"{key}: 알 수 없는 type {typeText}");
+            }
+            string endian = (Str(f, "endian") ?? "LE").ToUpperInvariant();
+            if (endian is not ("BE" or "LE")) throw new RuleFormatException($"{key}: endian은 BE 또는 LE입니다.");
+
+            list.Add(new BinaryField(key, offset, type, endian == "BE",
+                Dbl(f, "scale") ?? 1, Dbl(f, "valueOffset") ?? 0));
+        }
+        return list;
+    }
+
+    // ----- 공통 -----
+
+    internal static TextSeparator Sep(string? text) => (text ?? "SPACE").ToUpperInvariant() switch
+    {
+        "SPACE" => TextSeparator.Space,
+        "COMMA" => TextSeparator.Comma,
+        "TAB" => TextSeparator.Tab,
+        string s => throw new RuleFormatException($"알 수 없는 sep: {s}")
+    };
+
+    private static byte[] Bytes(string expr, string name, int minLength)
+    {
+        byte[] b;
+        try { b = ProtocolExpression.ToBytes(expr); }
+        catch (FormatException ex) { throw new RuleFormatException($"{name}: {ex.Message}"); }
+        if (b.Length < minLength) throw new RuleFormatException($"{name}: {minLength}바이트 이상이어야 합니다.");
+        return b;
+    }
+
+    internal static byte OneByte(string expr, string name)
+    {
+        byte[] b = Bytes(expr, name, 1);
+        if (b.Length != 1) throw new RuleFormatException($"{name}: 1바이트여야 합니다.");
+        return b[0];
+    }
+
+    private static string? Str(JsonElement e, string name) =>
+        e.TryGetProperty(name, out JsonElement v) && v.ValueKind == JsonValueKind.String ? v.GetString() : null;
+
+    private static int? Int(JsonElement e, string name)
+    {
+        if (!e.TryGetProperty(name, out JsonElement v) || v.ValueKind == JsonValueKind.Null) return null;
+        if (v.ValueKind == JsonValueKind.Number && v.TryGetInt32(out int n)) return n;
+        throw new RuleFormatException($"{name}: 정수여야 합니다.");
+    }
+
+    private static double? Dbl(JsonElement e, string name)
+    {
+        if (!e.TryGetProperty(name, out JsonElement v) || v.ValueKind == JsonValueKind.Null) return null;
+        if (v.ValueKind == JsonValueKind.Number) return v.GetDouble();
+        throw new RuleFormatException($"{name}: 숫자여야 합니다.");
+    }
+
+    private static bool? Bool(JsonElement e, string name)
+    {
+        if (!e.TryGetProperty(name, out JsonElement v) || v.ValueKind == JsonValueKind.Null) return null;
+        return v.ValueKind switch
+        {
+            JsonValueKind.True => true,
+            JsonValueKind.False => false,
+            _ => throw new RuleFormatException($"{name}: true/false여야 합니다.")
+        };
+    }
+
+    private static IReadOnlyList<string> StrArray(JsonElement e, string name)
+    {
+        if (!e.TryGetProperty(name, out JsonElement v) || v.ValueKind != JsonValueKind.Array) return [];
+        var list = new List<string>();
+        foreach (JsonElement x in v.EnumerateArray())
+        {
+            if (x.ValueKind != JsonValueKind.String || string.IsNullOrEmpty(x.GetString()))
+            {
+                throw new RuleFormatException($"{name}: 빈 값이 아닌 문자열 배열이어야 합니다.");
+            }
+            list.Add(x.GetString()!);
+        }
+        if (list.Distinct(StringComparer.Ordinal).Count() != list.Count) throw new RuleFormatException($"{name}: 중복 항목");
+        return list;
+    }
+
+    internal static int ParseIntInvariant(string s, string name) =>
+        int.TryParse(s, NumberStyles.Integer, CultureInfo.InvariantCulture, out int n)
+            ? n
+            : throw new RuleFormatException($"{name}: 정수여야 합니다 ({s}).");
+}
diff --git a/desktop/lib/juprovider.lib.protocol/Scheduling/CommandScheduler.cs b/desktop/lib/juprovider.lib.protocol/Scheduling/CommandScheduler.cs
new file mode 100644
index 0000000..c665b65
--- /dev/null
+++ b/desktop/lib/juprovider.lib.protocol/Scheduling/CommandScheduler.cs
@@ -0,0 +1,428 @@
+using JuProvider.Lib.Protocol.Framing;
+using JuProvider.Lib.Protocol.Model;
+
+namespace JuProvider.Lib.Protocol.Scheduling;
+
+/// <summary>
+/// Link 1개의 송신 순서·응답 매칭·타임아웃 (C0 §2). Link : Scheduler = 1 : 1.
+/// <list type="bullet">
+/// <item>기본 직렬(진행 중 1건). FullDuplex + CorrelationOf + 상관키 있는 명령끼리만 MaxInFlight 까지 병렬.</item>
+/// <item>다음 명령 선택: 우선순위(STOP &gt; CONTROL &gt; INFO &gt; POLL) → 등록 순서.</item>
+/// <item>수신 프레임 매칭 순서: 상관키 → 진행 중 명령의 Expect → (타임아웃 직후) LATE → Expect 없는 레거시 첫 프레임 → Unmatched(스트림).</item>
+/// <item>재시도는 Idempotent 명령만. 연속 타임아웃 K회면 LinkSuspect 1회 (재연결은 Link 소유자 판단).</item>
+/// <item>진행 중 취소: 호출자는 즉시 Cancelled, Link는 응답·타임아웃까지 점유.</item>
+/// </list>
+/// 수신 프레임은 OnFrame, Link 상태는 OnLinkDown/OnLinkUp 으로 알려 준다.
+/// </summary>
+public sealed class CommandScheduler : IAsyncDisposable
+{
+    private static readonly TimeSpan LateKeyLifetime = TimeSpan.FromSeconds(30);
+
+    private sealed class Entry(CommandRequest request)
+    {
+        public CommandRequest Request { get; } = request;
+        public TaskCompletionSource<CommandResult> Tcs { get; } = new(TaskCreationOptions.RunContinuationsAsynchronously);
+        public long Seq;
+        public int Attempts;
+        public int SendNo;
+        public bool CallerCancelled;
+        public CancellationTokenRegistration Registration;
+        public CancellationTokenSource? TimeoutCts;
+    }
+
+    private readonly ILinkWriter _writer;
+    private readonly SchedulerOptions _options;
+    private readonly object _lock = new();
+    private readonly List<Entry> _queue = [];
+    private readonly List<Entry> _inFlight = [];
+    private readonly List<Entry> _guardEntries = [];
+    private readonly Dictionary<string, long> _lateKeys = new(StringComparer.Ordinal);
+    private readonly HashSet<string> _legacyWarned = new(StringComparer.Ordinal);
+    private readonly SemaphoreSlim _signal = new(0);
+    private readonly CancellationTokenSource _life = new();
+    private readonly Task _loop;
+    private long _seq;
+    private bool _linkUp;
+    private bool _disposed;
+    private int _consecutiveTimeouts;
+    private long _guardUntil;
+    private long _gapUntil;
+
+    public CommandScheduler(ILinkWriter writer, SchedulerOptions? options = null)
+    {
+        _writer = writer ?? throw new ArgumentNullException(nameof(writer));
+        _options = options ?? new SchedulerOptions();
+        if (_options.MaxInFlight < 1) throw new ArgumentOutOfRangeException(nameof(options), "MaxInFlight >= 1");
+        _linkUp = _options.StartLinkUp;
+        _loop = Task.Run(LoopAsync);
+    }
+
+    /// <summary>어떤 대기 명령에도 맞지 않는 프레임 (RX_STREAM 처리 대상)</summary>
+    public event EventHandler<Frame>? Unmatched;
+
+    /// <summary>타임아웃된 명령의 늦은 응답. 다음 명령에 연결하지 않고 버린다</summary>
+    public event EventHandler<Frame>? Late;
+
+    /// <summary>연속 타임아웃이 SuspectAfterTimeouts 에 도달 (값 = 연속 횟수)</summary>
+    public event EventHandler<int>? LinkSuspect;
+
+    public event EventHandler<string>? Warning;
+
+    public SchedulerOptions Options => _options;
+
+    public bool LinkUp { get { lock (_lock) return _linkUp; } }
+
+    public int PendingCount { get { lock (_lock) return _queue.Count; } }
+
+    public int InFlightCount { get { lock (_lock) return _inFlight.Count; } }
+
+    private static long Now => Environment.TickCount64;
+
+    public Task<CommandResult> EnqueueAsync(CommandRequest request, CancellationToken cancellationToken = default)
+    {
+        ArgumentNullException.ThrowIfNull(request);
+        var entry = new Entry(request);
+        List<Entry> stopped = [];
+        CommandResult? immediate = null;
+
+        lock (_lock)
+        {
+            if (_disposed) immediate = new(CommandStatus.Cancelled, null, 0, "Scheduler 종료됨");
+            else if (!_linkUp) immediate = new(CommandStatus.LinkDown, null, 0, "Link 끊김");
+            else if (cancellationToken.IsCancellationRequested) immediate = new(CommandStatus.Cancelled, null, 0);
+            else if (request.Pattern == ExchangePattern.RxStream) immediate = new(CommandStatus.Rejected, null, 0, "RX_STREAM 은 송신 대상이 아님");
+            else if (request.CorrelationKey is { } key && Active().Any(e => e.Request.CorrelationKey == key))
+                immediate = new(CommandStatus.Rejected, null, 0, $"같은 상관키 진행 중: {key}");
+            else if (request.Pattern == ExchangePattern.Poll && Active().Any(e =>
+                         e.Request.Pattern == ExchangePattern.Poll && e.Request.DevCd == request.DevCd && e.Request.PtlCd == request.PtlCd))
+                immediate = new(CommandStatus.Skipped, null, 0, "이전 폴링 미완료");
+            else
+            {
+                if (request.Action == CommandAction.Stop)
+                {
+                    stopped = _queue.Where(e => e.Request.DevCd == request.DevCd
+                                                && e.Request.Action is CommandAction.Start or CommandAction.Pause).ToList();
+                    foreach (Entry e in stopped) _queue.Remove(e);
+                }
+                entry.Seq = ++_seq;
+                _queue.Add(entry);
+            }
+        }
+
+        if (immediate is not null) return Task.FromResult(immediate);
+
+        foreach (Entry e in stopped) Finish(e, new(CommandStatus.Cancelled, null, e.Attempts, "STOP 우선: 대기 중 시작·일시정지 취소"));
+        if (cancellationToken.CanBeCanceled) entry.Registration = cancellationToken.Register(() => CancelEntry(entry));
+        Signal();
+        return entry.Tcs.Task;
+    }
+
+    /// <summary>장치의 대기 중 명령 취소 (진행 중은 제외). 취소한 개수</summary>
+    public int CancelDevice(string devCd, Func<CommandRequest, bool>? filter = null)
+    {
+        List<Entry> removed;
+        lock (_lock)
+        {
+            removed = _queue.Where(e => e.Request.DevCd == devCd && (filter?.Invoke(e.Request) ?? true)).ToList();
+            foreach (Entry e in removed) _queue.Remove(e);
+        }
+        foreach (Entry e in removed) Finish(e, new(CommandStatus.Cancelled, null, e.Attempts, "장치 명령 취소"));
+        return removed.Count;
+    }
+
+    /// <summary>Framer가 만든 수신 프레임 1개</summary>
+    public void OnFrame(Frame frame)
+    {
+        ArgumentNullException.ThrowIfNull(frame);
+        Entry? matched = null;
+        bool late = false;
+        string? warning = null;
+
+        lock (_lock)
+        {
+            string? key = _options.CorrelationOf?.Invoke(frame);
+            if (key is not null)
+            {
+                matched = _inFlight.FirstOrDefault(e => e.Request.CorrelationKey == key);
+                if (matched is null && _lateKeys.TryGetValue(key, out long until) && until > Now) late = true;
+            }
+            else
+            {
+                matched = _inFlight.FirstOrDefault(e => e.Request.Expect is { } x && x.IsMatch(frame));
+
+                if (matched is null && Now < _guardUntil && _guardEntries.Any(e => e.Request.Expect is { } x && x.IsMatch(frame)))
+                    late = true;
+
+                if (matched is null && !late)
+                {
+                    matched = _inFlight.FirstOrDefault(e => e.Request.Expect is null && e.Request.CorrelationKey is null);
+                    if (matched is not null && _legacyWarned.Add(matched.Request.PtlCd))
+                        warning = $"{matched.Request.DevCd}/{matched.Request.PtlCd}: 응답 조건(Expect) 없음 → 요청 후 첫 프레임으로 연결";
+                }
+            }
+
+            if (matched is not null)
+            {
+                _inFlight.Remove(matched);
+                _consecutiveTimeouts = 0;
+            }
+        }
+
+        if (warning is not null) Warning?.Invoke(this, warning);
+
+        if (matched is not null)
+        {
+            Finish(matched, new(CommandStatus.Completed, frame, matched.Attempts));
+            Signal();
+        }
+        else if (late)
+        {
+            Late?.Invoke(this, frame);
+        }
+        else
+        {
+            Unmatched?.Invoke(this, frame);
+        }
+    }
+
+    /// <summary>Link 끊김: 대기·진행 전부 LinkDown, 이후 등록도 LinkDown</summary>
+    public void OnLinkDown()
+    {
+        List<Entry> all;
+        lock (_lock)
+        {
+            _linkUp = false;
+            all = [.. _inFlight, .. _queue];
+            _inFlight.Clear();
+            _queue.Clear();
+            _guardEntries.Clear();
+            _guardUntil = 0;
+        }
+        foreach (Entry e in all) Finish(e, new(CommandStatus.LinkDown, null, e.Attempts, "Link 끊김"));
+    }
+
+    public void OnLinkUp()
+    {
+        lock (_lock)
+        {
+            _linkUp = true;
+            _consecutiveTimeouts = 0;
+        }
+        Signal();
+    }
+
+    public async ValueTask DisposeAsync()
+    {
+        List<Entry> all;
+        lock (_lock)
+        {
+            if (_disposed) return;
+            _disposed = true;
+            all = [.. _inFlight, .. _queue];
+            _inFlight.Clear();
+            _queue.Clear();
+        }
+        foreach (Entry e in all) Finish(e, new(CommandStatus.Cancelled, null, e.Attempts, "Scheduler 종료됨"));
+        _life.Cancel();
+        try { await _loop.ConfigureAwait(false); } catch { /* 종료 */ }
+        _life.Dispose();
+        _signal.Dispose();
+    }
+
+    private IEnumerable<Entry> Active() => _inFlight.Concat(_queue);
+
+    private void Signal()
+    {
+        try { _signal.Release(); } catch (ObjectDisposedException) { }
+    }
+
+    private async Task LoopAsync()
+    {
+        CancellationToken ct = _life.Token;
+        try
+        {
+            while (true)
+            {
+                await _signal.WaitAsync(ct).ConfigureAwait(false);
+                while (true)
+                {
+                    Entry? next;
+                    int waitMs;
+                    lock (_lock) next = TakeNext(out waitMs);
+
+                    if (next is not null)
+                    {
+                        await SendAsync(next, ct).ConfigureAwait(false);
+                        continue;
+                    }
+                    if (waitMs <= 0) break;
+                    await Task.Delay(waitMs, ct).ConfigureAwait(false);
+                }
+            }
+        }
+        catch (OperationCanceledException)
+        {
+            // 종료
+        }
+    }
+
+    /// <summary>lock 안에서 호출. 보낼 명령을 진행 중으로 옮겨 돌려준다. 기다려야 하면 waitMs &gt; 0</summary>
+    private Entry? TakeNext(out int waitMs)
+    {
+        waitMs = 0;
+        if (_disposed || !_linkUp || _queue.Count == 0) return null;
+
+        long now = Now;
+        if (now < _guardUntil)
+        {
+            waitMs = (int)Math.Max(1, _guardUntil - now);
+            return null;
+        }
+        _guardEntries.Clear();
+
+        if (now < _gapUntil)
+        {
+            waitMs = (int)Math.Max(1, _gapUntil - now);
+            return null;
+        }
+
+        Entry candidate = _queue
+            .OrderByDescending(e => e.Request.EffectivePriority)
+            .ThenBy(e => e.Seq)
+            .First();
+
+        if (_inFlight.Count > 0)
+        {
+            bool parallel = _options.FullDuplex
+                            && _options.CorrelationOf is not null
+                            && _inFlight.Count < _options.MaxInFlight
+                            && candidate.Request.CorrelationKey is not null
+                            && _inFlight.All(e => e.Request.CorrelationKey is not null);
+            if (!parallel) return null; // 진행 중 명령 완료 시 Signal
+        }
+
+        _queue.Remove(candidate);
+        _inFlight.Add(candidate);
+        candidate.Attempts++;
+        candidate.SendNo++;
+        return candidate;
+    }
+
+    private async Task SendAsync(Entry e, CancellationToken ct)
+    {
+        try
+        {
+            await _writer.WriteAsync(e.Request.Payload, ct).ConfigureAwait(false);
+        }
+        catch (OperationCanceledException) when (ct.IsCancellationRequested)
+        {
+            return;
+        }
+        catch (Exception ex)
+        {
+            bool removed;
+            lock (_lock) removed = _inFlight.Remove(e);
+            if (removed) Finish(e, new(CommandStatus.LinkDown, null, e.Attempts, "쓰기 실패: " + ex.Message));
+            Signal();
+            return;
+        }
+
+        if (!e.Request.ExpectsResponse)
+        {
+            bool removed;
+            lock (_lock)
+            {
+                removed = _inFlight.Remove(e);
+                if (_options.InterCommandGapMs > 0) _gapUntil = Now + _options.InterCommandGapMs;
+            }
+            if (removed) Finish(e, new(CommandStatus.Completed, null, e.Attempts));
+            Signal();
+            return;
+        }
+
+        int timeoutMs = e.Request.TimeoutMs > 0 ? e.Request.TimeoutMs : _options.DefaultTimeoutMs;
+        CancellationTokenSource cts;
+        int sendNo;
+        lock (_lock)
+        {
+            if (!_inFlight.Contains(e)) return; // 쓰는 동안 응답이 왔거나 Link 끊김
+            cts = new CancellationTokenSource();
+            e.TimeoutCts?.Dispose();
+            e.TimeoutCts = cts;
+            sendNo = e.SendNo;
+        }
+
+        _ = Task.Delay(timeoutMs, cts.Token).ContinueWith(
+            t => { if (!t.IsCanceled) OnTimeout(e, sendNo); },
+            CancellationToken.None, TaskContinuationOptions.None, TaskScheduler.Default);
+    }
+
+    private void OnTimeout(Entry e, int sendNo)
+    {
+        bool retry;
+        bool suspect = false;
+        int count;
+
+        lock (_lock)
+        {
+            if (e.SendNo != sendNo || !_inFlight.Remove(e)) return;
+
+            count = ++_consecutiveTimeouts;
+            if (count == _options.SuspectAfterTimeouts) suspect = true;
+
+            if (_options.LateGuardMs > 0)
+            {
+                _guardUntil = Now + _options.LateGuardMs;
+                _guardEntries.Add(e);
+            }
+
+            retry = !_disposed && _linkUp && !e.CallerCancelled
+                    && e.Request.Idempotent && e.Attempts <= e.Request.RetryCount;
+            if (retry)
+            {
+                _queue.Add(e); // Seq 유지 → 같은 우선순위에서 먼저
+            }
+            else if (e.Request.CorrelationKey is { } key)
+            {
+                _lateKeys[key] = Now + (long)LateKeyLifetime.TotalMilliseconds;
+                foreach (string k in _lateKeys.Where(p => p.Value <= Now).Select(p => p.Key).ToList()) _lateKeys.Remove(k);
+            }
+        }
+
+        // 의심 이벤트를 결과보다 먼저: 호출자가 Timeout 을 받았을 때 Link 의심은 이미 알려진 상태
+        if (suspect) LinkSuspect?.Invoke(this, count);
+        if (!retry) Finish(e, new(CommandStatus.Timeout, null, e.Attempts, "응답 없음"));
+        Signal();
+    }
+
+    private void CancelEntry(Entry e)
+    {
+        bool queued;
+        bool inFlight = false;
+        lock (_lock)
+        {
+            queued = _queue.Remove(e);
+            if (!queued && _inFlight.Contains(e))
+            {
+                e.CallerCancelled = true;
+                inFlight = true;
+            }
+        }
+
+        if (queued) Finish(e, new(CommandStatus.Cancelled, null, e.Attempts));
+        else if (inFlight) e.Tcs.TrySetResult(new(CommandStatus.Cancelled, null, e.Attempts, "진행 중 취소: 응답·타임아웃까지 Link 점유"));
+    }
+
+    private static void Finish(Entry e, CommandResult result)
+    {
+        e.Registration.Unregister();
+        CancellationTokenSource? cts = e.TimeoutCts;
+        e.TimeoutCts = null;
+        if (cts is not null)
+        {
+            try { cts.Cancel(); } catch (ObjectDisposedException) { }
+            cts.Dispose();
+        }
+        e.Tcs.TrySetResult(result);
+    }
+}
diff --git a/desktop/lib/juprovider.lib.protocol/Scheduling/Commands.cs b/desktop/lib/juprovider.lib.protocol/Scheduling/Commands.cs
new file mode 100644
index 0000000..458059f
--- /dev/null
+++ b/desktop/lib/juprovider.lib.protocol/Scheduling/Commands.cs
@@ -0,0 +1,129 @@
+using System.Text;
+using System.Text.RegularExpressions;
+using JuProvider.Lib.Protocol.Framing;
+using JuProvider.Lib.Protocol.Model;
+using JuProvider.Lib.Protocol.Parsing;
+using JuProvider.Lib.Protocol.Transport;
+
+namespace JuProvider.Lib.Protocol.Scheduling;
+
+/// <summary>우선순위 (C0 §2.1): STOP &gt; CONTROL &gt; INFO &gt; POLL</summary>
+public enum CommandPriority
+{
+    Poll = 0,
+    Info = 1,
+    Control = 2,
+    Stop = 3
+}
+
+/// <summary>
+/// 명령 결과. Skipped = 같은 폴링이 아직 끝나지 않아 이번 회차를 건너뜀(C0 §2.5).
+/// </summary>
+public enum CommandStatus
+{
+    Completed,
+    Timeout,
+    Cancelled,
+    LinkDown,
+    Rejected,
+    Skipped
+}
+
+/// <summary>응답 판별 (C0 §2.3 의 Expect). 프레임 Body 기준</summary>
+public sealed class ResponseMatcher
+{
+    private readonly Func<Frame, bool> _predicate;
+
+    private ResponseMatcher(string description, Func<Frame, bool> predicate)
+    {
+        Description = description;
+        _predicate = predicate;
+    }
+
+    public string Description { get; }
+
+    public bool IsMatch(Frame frame)
+    {
+        try { return _predicate(frame); }
+        catch { return false; }
+    }
+
+    public override string ToString() => Description;
+
+    public static ResponseMatcher Any { get; } = new("any", _ => true);
+
+    public static ResponseMatcher StartsWith(string ascii)
+    {
+        byte[] prefix = Encoding.ASCII.GetBytes(ascii);
+        return new($"startsWith '{ascii}'", f => new ReadOnlySpan<byte>(f.Body).StartsWith(new ReadOnlySpan<byte>(prefix)));
+    }
+
+    public static ResponseMatcher Regex(string pattern)
+    {
+        var regex = new System.Text.RegularExpressions.Regex(pattern, RegexOptions.CultureInvariant);
+        return new($"regex {pattern}", f => regex.IsMatch(Encoding.ASCII.GetString(f.Body)));
+    }
+
+    /// <summary>응답 프로토콜의 Parse Rule로 해석 가능하면 맞음</summary>
+    public static ResponseMatcher Parses(IFrameParser parser, string description = "parses") =>
+        new(description, f => parser.Parse(f).Ok);
+
+    public static ResponseMatcher Custom(string description, Func<Frame, bool> predicate) => new(description, predicate);
+}
+
+/// <summary>
+/// 명령 1건 (C0 §2.1). Payload는 ProtocolExpression으로 만든 바이트.
+/// TimeoutMs 0 = Scheduler 기본값. Expect 없는 TX_RX/POLL = 레거시 "요청 후 첫 프레임"(경고).
+/// </summary>
+public sealed record CommandRequest
+{
+    public required string DevCd { get; init; }
+    public required string PtlCd { get; init; }
+    public required byte[] Payload { get; init; }
+    public ExchangePattern Pattern { get; init; } = ExchangePattern.TxRx;
+    public ProtocolRole Roles { get; init; } = ProtocolRole.Info;
+    public CommandAction Action { get; init; } = CommandAction.None;
+    public CommandPriority Priority { get; init; } = CommandPriority.Info;
+    public ResponseMatcher? Expect { get; init; }
+    public int TimeoutMs { get; init; }
+    public int RetryCount { get; init; }
+    public bool Idempotent { get; init; } = true;
+    public string? CorrelationKey { get; init; }
+
+    /// <summary>STOP 은 Priority 값과 관계없이 최우선</summary>
+    public CommandPriority EffectivePriority => Action == CommandAction.Stop ? CommandPriority.Stop : Priority;
+
+    public bool ExpectsResponse => Pattern is ExchangePattern.TxRx or ExchangePattern.Poll;
+}
+
+public sealed record CommandResult(CommandStatus Status, Frame? Response, int Attempts, string? Reason = null)
+{
+    public bool Ok => Status == CommandStatus.Completed;
+}
+
+/// <summary>Link 쓰기 추상 (Scheduler는 Transport를 직접 모른다)</summary>
+public interface ILinkWriter
+{
+    Task WriteAsync(ReadOnlyMemory<byte> data, CancellationToken cancellationToken = default);
+}
+
+public sealed class TransportLinkWriter(ITransport transport) : ILinkWriter
+{
+    public Task WriteAsync(ReadOnlyMemory<byte> data, CancellationToken cancellationToken = default) =>
+        transport.WriteAsync(data, cancellationToken);
+}
+
+/// <summary>
+/// FullDuplex + CorrelationOf 가 있을 때만 MaxInFlight 까지 병렬 (C0 §2.2).
+/// LateGuardMs: 타임아웃 뒤 다음 송신까지 기다리는 시간. 이 사이에 온, 타임아웃된 명령의 Expect에 맞는 프레임은 LATE.
+/// SuspectAfterTimeouts: 연속 타임아웃 K회면 LinkSuspect 1회.
+/// </summary>
+public sealed record SchedulerOptions(
+    bool FullDuplex = false,
+    int MaxInFlight = 1,
+    int DefaultTimeoutMs = 1000,
+    int InterCommandGapMs = 0,
+    int LateGuardMs = 200,
+    int SuspectAfterTimeouts = 3,
+    Func<Frame, string?>? CorrelationOf = null,
+    bool StartLinkUp = true);
diff --git a/desktop/lib/juprovider.lib.protocol/Session/DeviceSession.cs b/desktop/lib/juprovider.lib.protocol/Session/DeviceSession.cs
new file mode 100644
index 0000000..1d02c1e
--- /dev/null
+++ b/desktop/lib/juprovider.lib.protocol/Session/DeviceSession.cs
@@ -0,0 +1,376 @@
+using JuProvider.Lib.Protocol.Expression;
+using JuProvider.Lib.Protocol.Framing;
+using JuProvider.Lib.Protocol.Mapping;
+using JuProvider.Lib.Protocol.Model;
+using JuProvider.Lib.Protocol.Parsing;
+using JuProvider.Lib.Protocol.Rules;
+using JuProvider.Lib.Protocol.Scheduling;
+using JuProvider.Lib.Protocol.Transport;
+
+namespace JuProvider.Lib.Protocol.Session;
+
+/// <summary>
+/// 세션이 실행할 프로토콜 1개 (서버 ju_protocol 정의의 Desktop 측 형태).
+/// Tx: 송신 표현식(ProtocolExpression). Parse: 응답·스트림 해석 규칙(DATA 역할일 때 논리 Data로).
+/// Idempotent 미지정 = Action 이 None 이고 CONTROL 역할이 아니면 true.
+/// </summary>
+public sealed record ProtocolDefinition
+{
+    public required string PtlCd { get; init; }
+    public required ExchangePattern Pattern { get; init; }
+    public ProtocolRole Roles { get; init; } = ProtocolRole.Info;
+    public CommandAction Action { get; init; } = CommandAction.None;
+    public string? Tx { get; init; }
+    public ResponseMatcher? Expect { get; init; }
+    public ParseRule? Parse { get; init; }
+    public ParseContext? ParseContext { get; init; }
+    public int TimeoutMs { get; init; }
+    public int RetryCount { get; init; }
+    public bool? Idempotent { get; init; }
+}
+
+public enum DeviceSessionState
+{
+    Created,
+    /// <summary>연결·재연결 직후 초기화 루틴 실행 중 (C4). 외부 명령은 루틴이 끝날 때까지 기다린다</summary>
+    Initializing,
+    Ready,
+    /// <summary>연속 타임아웃으로 Link 의심. 재연결 판단은 Link 소유자</summary>
+    Degraded,
+    /// <summary>Link 끊김. 세션은 재연결하지 않음</summary>
+    Suspended,
+    Stopped
+}
+
+/// <summary>
+/// 세션 설정 (C4). InitRoutine: 연결·재연결 때마다 순서대로 실행할 프로토콜(예: GTEC STOP → 장치확인 → 센서정보 → 모드).
+/// InitDelayMs: Link 열린 뒤 루틴 시작 전 대기(장비 기동 시간).
+/// </summary>
+public sealed record DeviceSessionOptions(IReadOnlyList<string>? InitRoutine = null, int InitDelayMs = 500)
+{
+    public static DeviceSessionOptions Default { get; } = new();
+}
+
+/// <summary>초기화 루틴 1회 결과. Completed=false 면 Link 끊김·중지로 중단됨</summary>
+public sealed record InitRoutineResult(bool Completed, IReadOnlyList<KeyValuePair<string, CommandResult>> Steps)
+{
+    public bool AllOk => Completed && Steps.All(s => s.Value.Ok);
+}
+
+public sealed class ValuesEventArgs(string ptlCd, IReadOnlyList<LogicalValue> values) : EventArgs
+{
+    public string PtlCd { get; } = ptlCd;
+    public IReadOnlyList<LogicalValue> Values { get; } = values;
+}
+
+/// <summary>
+/// 장치 1대의 논리 통신 (C0 §0, §8). Transport 수신 → Framer → Scheduler(응답 매칭) → 남은 프레임은 RX_STREAM 프로토콜로
+/// → Parser → Mapper → Values 이벤트. 일반 장치는 Link : Session = 1 : 1 이므로 Framer·Scheduler를 세션이 가진다.
+/// Link 열기·재연결은 하지 않는다 (LinkSupervisor 책임). Transport 상태만 따라간다.
+/// </summary>
+public sealed class DeviceSession : IAsyncDisposable
+{
+    private readonly ITransport _transport;
+    private readonly IFramer _framer;
+    private readonly object _framerLock = new();
+    private readonly IDataMapper _mapper;
+    private readonly Dictionary<string, ProtocolDefinition> _protocols;
+    private readonly List<ProtocolDefinition> _streams;
+    private readonly Dictionary<string, IFrameParser> _parsers = new(StringComparer.Ordinal);
+    private readonly SchedulerOptions _schedulerOptions;
+    private readonly DeviceSessionOptions _options;
+    private readonly object _stateLock = new();
+    private readonly object _initLock = new();
+    private CancellationTokenSource? _initCts;
+    private Task _initTask = Task.CompletedTask;
+    private CommandScheduler? _scheduler;
+    private DeviceSessionState _state = DeviceSessionState.Created;
+
+    public DeviceSession(string devCd, ITransport transport, FrameRule frameRule, IEnumerable<ProtocolDefinition> protocols,
+        IDataMapper mapper, SchedulerOptions? schedulerOptions = null, DeviceSessionOptions? options = null)
+    {
+        if (string.IsNullOrEmpty(devCd)) throw new ArgumentException("DEV_CD 필요", nameof(devCd));
+        DevCd = devCd;
+        Device = new DeviceRef(devCd);
+        _transport = transport ?? throw new ArgumentNullException(nameof(transport));
+        _framer = FramerFactory.Create(frameRule ?? throw new ArgumentNullException(nameof(frameRule)));
+        _mapper = mapper ?? throw new ArgumentNullException(nameof(mapper));
+        _schedulerOptions = schedulerOptions ?? new SchedulerOptions();
+        _options = options ?? DeviceSessionOptions.Default;
+
+        _protocols = new Dictionary<string, ProtocolDefinition>(StringComparer.Ordinal);
+        _streams = [];
+        foreach (ProtocolDefinition p in protocols ?? throw new ArgumentNullException(nameof(protocols)))
+        {
+            if (!_protocols.TryAdd(p.PtlCd, p)) throw new ArgumentException($"PTL_CD 중복: {p.PtlCd}", nameof(protocols));
+            if (p.Parse is not null) _parsers[p.PtlCd] = ParserFactory.Create(p.Parse);
+            if (p.Pattern == ExchangePattern.RxStream) _streams.Add(p);
+        }
+
+        foreach (string step in _options.InitRoutine ?? [])
+        {
+            if (!_protocols.TryGetValue(step, out ProtocolDefinition? d))
+                throw new ArgumentException($"초기화 루틴의 프로토콜 없음: {step}", nameof(options));
+            if (d.Pattern == ExchangePattern.RxStream)
+                throw new ArgumentException($"초기화 루틴에 RX_STREAM 불가: {step}", nameof(options));
+        }
+    }
+
+    public string DevCd { get; }
+
+    public DeviceRef Device { get; }
+
+    public DeviceSessionState State { get { lock (_stateLock) return _state; } }
+
+    public CommandScheduler? Scheduler => _scheduler;
+
+    public event EventHandler<ValuesEventArgs>? Values;
+
+    public event EventHandler<DeviceSessionState>? StateChanged;
+
+    public event EventHandler<string>? Warning;
+
+    /// <summary>초기화 루틴 1회 끝 (연결·재연결마다)</summary>
+    public event EventHandler<InitRoutineResult>? InitCompleted;
+
+    public DeviceSessionOptions Options => _options;
+
+    /// <summary>어떤 응답·스트림 프로토콜에도 맞지 않은 프레임</summary>
+    public event EventHandler<Frame>? UnhandledFrame;
+
+    public Task StartAsync()
+    {
+        lock (_stateLock)
+        {
+            if (_state != DeviceSessionState.Created) throw new InvalidOperationException($"이미 시작됨 ({_state})");
+        }
+
+        bool open = _transport.State == TransportState.Open;
+        var scheduler = new CommandScheduler(new TransportLinkWriter(_transport), _schedulerOptions with { StartLinkUp = open });
+        scheduler.Unmatched += (_, f) => HandleStream(f);
+        scheduler.Late += (_, f) => Warning?.Invoke(this, $"{DevCd}: 늦은 응답 버림 '{ProtocolExpression.ToDisplay(f.Raw)}'");
+        scheduler.Warning += (_, w) => Warning?.Invoke(this, w);
+        scheduler.LinkSuspect += (_, n) =>
+        {
+            Warning?.Invoke(this, $"{DevCd}: 연속 타임아웃 {n}회 → Link 의심");
+            SetState(DeviceSessionState.Degraded, onlyFrom: DeviceSessionState.Ready);
+        };
+        _scheduler = scheduler;
+
+        _transport.Received += OnReceived;
+        _transport.StateChanged += OnTransportState;
+        if (open) BeginReady();
+        else SetState(DeviceSessionState.Suspended);
+        return Task.CompletedTask;
+    }
+
+    public async Task StopAsync()
+    {
+        CommandScheduler? scheduler;
+        lock (_stateLock)
+        {
+            if (_state is DeviceSessionState.Stopped or DeviceSessionState.Created) { _state = DeviceSessionState.Stopped; return; }
+            scheduler = _scheduler;
+        }
+        _transport.Received -= OnReceived;
+        _transport.StateChanged -= OnTransportState;
+        CancelInit();
+        SetState(DeviceSessionState.Stopped);
+        if (scheduler is not null) await scheduler.DisposeAsync().ConfigureAwait(false);
+    }
+
+    public ValueTask DisposeAsync() => new(StopAsync());
+
+    /// <summary>프로토콜 1개 실행. DATA 역할 + Parse 규칙이 있으면 응답을 논리 Data로 Values 에 낸다</summary>
+    public async Task<CommandResult> ExecuteAsync(string ptlCd, CancellationToken cancellationToken = default)
+    {
+        Task init;
+        lock (_initLock) init = _initTask;
+        if (!init.IsCompleted)
+        {
+            try { await init.WaitAsync(cancellationToken).ConfigureAwait(false); }
+            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
+            {
+                return new(CommandStatus.Cancelled, null, 0);
+            }
+            catch { /* 루틴 실패는 아래 상태 검사로 */ }
+        }
+        return await ExecuteCoreAsync(ptlCd, cancellationToken).ConfigureAwait(false);
+    }
+
+    private async Task<CommandResult> ExecuteCoreAsync(string ptlCd, CancellationToken cancellationToken)
+    {
+        CommandScheduler? scheduler = _scheduler;
+        DeviceSessionState state = State;
+        if (scheduler is null || state is DeviceSessionState.Created or DeviceSessionState.Stopped)
+            return new(CommandStatus.Rejected, null, 0, $"세션 상태 {state}");
+        if (!_protocols.TryGetValue(ptlCd, out ProtocolDefinition? def))
+            return new(CommandStatus.Rejected, null, 0, $"알 수 없는 프로토콜: {ptlCd}");
+        if (def.Pattern == ExchangePattern.RxStream)
+            return new(CommandStatus.Rejected, null, 0, "RX_STREAM 은 실행 대상이 아님");
+        if (string.IsNullOrEmpty(def.Tx))
+            return new(CommandStatus.Rejected, null, 0, "송신 표현식 없음");
+
+        byte[] payload;
+        try { payload = ProtocolExpression.ToBytes(def.Tx); }
+        catch (FormatException ex) { return new(CommandStatus.Rejected, null, 0, "표현식 오류: " + ex.Message); }
+
+        var request = new CommandRequest
+        {
+            DevCd = DevCd,
+            PtlCd = def.PtlCd,
+            Payload = payload,
+            Pattern = def.Pattern,
+            Roles = def.Roles,
+            Action = def.Action,
+            Priority = PriorityOf(def),
+            Expect = def.Expect,
+            TimeoutMs = def.TimeoutMs,
+            RetryCount = def.RetryCount,
+            Idempotent = def.Idempotent ?? (def.Action == CommandAction.None && !def.Roles.HasFlag(ProtocolRole.Control))
+        };
+
+        CommandResult result = await scheduler.EnqueueAsync(request, cancellationToken).ConfigureAwait(false);
+        if (result.Ok && result.Response is { } frame && def.Roles.HasFlag(ProtocolRole.Data) && def.Parse is not null)
+        {
+            Publish(def, frame);
+        }
+        return result;
+    }
+
+    public static CommandPriority PriorityOf(ProtocolDefinition def)
+    {
+        if (def.Action == CommandAction.Stop) return CommandPriority.Stop;
+        if (def.Roles.HasFlag(ProtocolRole.Control) || def.Action != CommandAction.None) return CommandPriority.Control;
+        if (def.Pattern == ExchangePattern.Poll) return CommandPriority.Poll;
+        return CommandPriority.Info;
+    }
+
+    private void OnReceived(object? sender, byte[] data)
+    {
+        IReadOnlyList<Frame> frames;
+        lock (_framerLock) frames = _framer.Push(data);
+        CommandScheduler? scheduler = _scheduler;
+        if (scheduler is null) return;
+        foreach (Frame f in frames) scheduler.OnFrame(f);
+    }
+
+    private void OnTransportState(object? sender, TransportStateChangedEventArgs e)
+    {
+        CommandScheduler? scheduler = _scheduler;
+        if (scheduler is null || State == DeviceSessionState.Stopped) return;
+
+        switch (e.State)
+        {
+            case TransportState.Open:
+                lock (_framerLock) _framer.Reset();
+                scheduler.OnLinkUp();
+                BeginReady();
+                break;
+            case TransportState.Faulted:
+            case TransportState.Closed:
+                CancelInit();
+                scheduler.OnLinkDown();
+                SetState(DeviceSessionState.Suspended);
+                break;
+        }
+    }
+
+    /// <summary>Link 열림: 초기화 루틴이 있으면 Initializing → 루틴 → Ready, 없으면 바로 Ready</summary>
+    private void BeginReady()
+    {
+        IReadOnlyList<string> routine = _options.InitRoutine ?? [];
+        if (routine.Count == 0)
+        {
+            SetState(DeviceSessionState.Ready);
+            return;
+        }
+
+        var cts = new CancellationTokenSource();
+        lock (_initLock)
+        {
+            _initCts?.Cancel();
+            _initCts = cts;
+            SetState(DeviceSessionState.Initializing);
+            _initTask = Task.Run(() => RunInitAsync(routine, cts.Token));
+        }
+    }
+
+    private void CancelInit()
+    {
+        lock (_initLock)
+        {
+            _initCts?.Cancel();
+            _initCts = null;
+        }
+    }
+
+    private async Task RunInitAsync(IReadOnlyList<string> routine, CancellationToken ct)
+    {
+        var steps = new List<KeyValuePair<string, CommandResult>>();
+        bool completed = false;
+        try
+        {
+            if (_options.InitDelayMs > 0) await Task.Delay(_options.InitDelayMs, ct).ConfigureAwait(false);
+            foreach (string ptlCd in routine)
+            {
+                ct.ThrowIfCancellationRequested();
+                CommandResult r = await ExecuteCoreAsync(ptlCd, ct).ConfigureAwait(false);
+                steps.Add(new(ptlCd, r));
+                if (!r.Ok) Warning?.Invoke(this, $"{DevCd}: 초기화 루틴 {ptlCd} {r.Status} {r.Reason}");
+                if (r.Status is CommandStatus.LinkDown or CommandStatus.Cancelled) break;
+            }
+            completed = steps.Count == routine.Count && !ct.IsCancellationRequested;
+        }
+        catch (OperationCanceledException)
+        {
+            // 끊김·중지로 중단
+        }
+
+        if (completed) SetState(DeviceSessionState.Ready, onlyFrom: DeviceSessionState.Initializing);
+        InitCompleted?.Invoke(this, new InitRoutineResult(completed, steps));
+    }
+
+    private void HandleStream(Frame frame)
+    {
+        foreach (ProtocolDefinition def in _streams)
+        {
+            if (def.Expect is not null && !def.Expect.IsMatch(frame)) continue;
+            if (!_parsers.ContainsKey(def.PtlCd))
+            {
+                if (def.Expect is not null) return; // 해석 규칙 없는 스트림: 받기만
+                continue;
+            }
+            if (Publish(def, frame) || def.Expect is not null) return;
+        }
+        UnhandledFrame?.Invoke(this, frame);
+    }
+
+    /// <summary>해석 성공하면 true</summary>
+    private bool Publish(ProtocolDefinition def, Frame frame)
+    {
+        if (!_parsers.TryGetValue(def.PtlCd, out IFrameParser? parser)) return false;
+        ParseResult parsed = parser.Parse(frame, def.ParseContext);
+        if (!parsed.Ok)
+        {
+            Warning?.Invoke(this, $"{DevCd}/{def.PtlCd}: 해석 실패 ({parsed.Error}) '{ProtocolExpression.ToDisplay(frame.Raw)}'");
+            return false;
+        }
+
+        IReadOnlyList<LogicalValue> values = _mapper.Map(DevCd, def.PtlCd, parsed.Values, DateTimeOffset.Now);
+        if (values.Count > 0) Values?.Invoke(this, new ValuesEventArgs(def.PtlCd, values));
+        return true;
+    }
+
+    private void SetState(DeviceSessionState next, DeviceSessionState? onlyFrom = null)
+    {
+        lock (_stateLock)
+        {
+            if (_state == next) return;
+            if (onlyFrom is { } from && _state != from) return;
+            if (_state == DeviceSessionState.Stopped) return;
+            _state = next;
+        }
+        StateChanged?.Invoke(this, next);
+    }
+}
diff --git a/desktop/lib/juprovider.lib.protocol/Simulation/BuiltInProfiles.cs b/desktop/lib/juprovider.lib.protocol/Simulation/BuiltInProfiles.cs
new file mode 100644
index 0000000..559e584
--- /dev/null
+++ b/desktop/lib/juprovider.lib.protocol/Simulation/BuiltInProfiles.cs
@@ -0,0 +1,58 @@
+namespace JuProvider.Lib.Protocol.Simulation;
+
+/// <summary>
+/// 기본 프로파일 (C0-Q6: 1차는 코드에 포함된 리소스, DB 저장은 후속).
+/// GTEC_SCIENCE_CUBE 명령은 seed의 GTEC 프로토콜(PTL_VAL)과 같다:
+///  S{TEST}·S{10,3} 확인, S{20} 센서정보, S{11,n} 모드, S{12,초} 간격, S{10,1} 시작, S{10,0} 중지.
+/// </summary>
+public static class BuiltInProfiles
+{
+    public const string GtecScienceCubeJson = """
+    {
+      "profileId": "GTEC_SCIENCE_CUBE", "v": 1, "seed": 1,
+      "vars": { "running": false, "mode": "ANALOG", "intervalMs": 100, "sensor1": "008" },
+      "responses": [
+        { "match": "S{TEST}", "reply": "{OK}[CR][LF]" },
+        { "match": "S{10,3}", "reply": "{OK}[CR][LF]" },
+        { "match": "S{20}",   "reply": "{${sensor1},000,000,000}[CR][LF]" },
+        { "match": "S{10,1}", "set": { "running": true } },
+        { "match": "S{10,0}", "set": { "running": false } },
+        { "match": "S{11,1}", "set": { "mode": "ANALOG" } },
+        { "match": "S{11,0}", "set": { "mode": "PHOTOGATE1" } },
+        { "match": "S{11,2}", "set": { "mode": "PHOTOGATE2" } },
+        { "matchRegex": "^S\\{12,(?<sec>[0-9]+(\\.[0-9]+)?)\\}$", "set": { "intervalMs": "${sec*1000}" } }
+      ],
+      "streams": [
+        { "when": "running==true && mode==ANALOG", "everyMs": "${intervalMs}", "frame": "{${ch1} ${ch2} ${ch3}}[CR][LF]" }
+      ],
+      "generators": {
+        "ch1": { "type": "sine", "amp": 1, "periodMs": 2000, "offset": 2 },
+        "ch2": { "type": "ramp", "value": 0, "step": 0.1, "max": 5 },
+        "ch3": { "type": "random", "min": 0, "max": 5 }
+      }
+    }
+    """;
+
+    /// <summary>받은 요청을 그대로 + [CR][LF] 로 돌려준다</summary>
+    public const string EchoJson = """
+    { "profileId": "GENERIC_ECHO", "v": 1,
+      "responses": [ { "matchRegex": "^(?<all>.*)$", "reply": "${all}[CR][LF]" } ] }
+    """;
+
+    /// <summary>연결되면 바로 일정 간격으로 순번을 보낸다</summary>
+    public const string StreamJson = """
+    { "profileId": "GENERIC_STREAM", "v": 1,
+      "vars": { "running": true, "everyMs": 20 },
+      "responses": [ { "match": "STOP", "set": { "running": false } }, { "match": "START", "set": { "running": true } } ],
+      "streams": [ { "when": "running", "everyMs": "${everyMs}", "frame": "{${seq}}[CR][LF]" } ],
+      "generators": { "seq": { "type": "ramp", "value": 1, "step": 1, "max": 1000000 } } }
+    """;
+
+    public static DeviceProfile Get(string profileId) => profileId.ToUpperInvariant() switch
+    {
+        "GTEC_SCIENCE_CUBE" => DeviceProfile.Parse(GtecScienceCubeJson),
+        "GENERIC_ECHO" => DeviceProfile.Parse(EchoJson),
+        "GENERIC_STREAM" => DeviceProfile.Parse(StreamJson),
+        _ => throw new ProfileFormatException($"알 수 없는 프로파일: {profileId}")
+    };
+}
diff --git a/desktop/lib/juprovider.lib.protocol/Simulation/DeviceProfile.cs b/desktop/lib/juprovider.lib.protocol/Simulation/DeviceProfile.cs
new file mode 100644
index 0000000..9245ec4
--- /dev/null
+++ b/desktop/lib/juprovider.lib.protocol/Simulation/DeviceProfile.cs
@@ -0,0 +1,134 @@
+using System.Globalization;
+using System.Text.Json;
+using System.Text.RegularExpressions;
+
+namespace JuProvider.Lib.Protocol.Simulation;
+
+public sealed class ProfileFormatException(string message) : FormatException(message);
+
+public sealed record ProfileResponse(string? Match, Regex? MatchRegex, string? Reply, IReadOnlyDictionary<string, string> Set);
+
+public sealed record ProfileStream(string When, string EveryMs, string Frame);
+
+public sealed record GeneratorSpec(string Type, double Value, double Min, double Max, double Step, double Amp, double PeriodMs, double Offset, IReadOnlyList<double> Values);
+
+/// <summary>
+/// 장치 프로파일 (C0 §5, JSON v1). 코드가 아니라 데이터로 장치 동작을 적는다.
+/// {"profileId","v":1,"seed","vars":{..},"responses":[{"match"|"matchRegex","reply","set":{..}}],
+///  "streams":[{"when","everyMs","frame"}],"generators":{"name":{"type":"constant|ramp|sine|random|sequence",..}}}
+/// match: 요청 표현식(끝의 [CR][LF]는 무시하고 비교). reply/frame: 표현식 템플릿, ${이름}·${이름*수}·${이름/수}.
+/// when: "이름", "이름==값", "이름!=값"을 && 로 연결.
+/// </summary>
+public sealed record DeviceProfile(
+    string ProfileId,
+    int Seed,
+    IReadOnlyDictionary<string, string> Vars,
+    IReadOnlyList<ProfileResponse> Responses,
+    IReadOnlyList<ProfileStream> Streams,
+    IReadOnlyDictionary<string, GeneratorSpec> Generators)
+{
+    public static DeviceProfile Parse(string json)
+    {
+        JsonElement r;
+        try
+        {
+            using JsonDocument doc = JsonDocument.Parse(json);
+            r = doc.RootElement.Clone();
+        }
+        catch (JsonException ex)
+        {
+            throw new ProfileFormatException("프로파일 JSON 형식 오류: " + ex.Message);
+        }
+
+        if (r.ValueKind != JsonValueKind.Object) throw new ProfileFormatException("프로파일은 JSON 객체입니다.");
+        if (!r.TryGetProperty("v", out JsonElement v) || v.ValueKind != JsonValueKind.Number || v.GetInt32() != 1)
+        {
+            throw new ProfileFormatException("프로파일 버전 v=1 이 필요합니다.");
+        }
+
+        string id = Str(r, "profileId") ?? throw new ProfileFormatException("profileId가 필요합니다.");
+        int seed = r.TryGetProperty("seed", out JsonElement s) && s.ValueKind == JsonValueKind.Number ? s.GetInt32() : 1;
+
+        var vars = new Dictionary<string, string>(StringComparer.Ordinal);
+        if (r.TryGetProperty("vars", out JsonElement ve) && ve.ValueKind == JsonValueKind.Object)
+        {
+            foreach (JsonProperty p in ve.EnumerateObject()) vars[p.Name] = Scalar(p.Value, "vars." + p.Name);
+        }
+
+        var responses = new List<ProfileResponse>();
+        if (r.TryGetProperty("responses", out JsonElement re) && re.ValueKind == JsonValueKind.Array)
+        {
+            foreach (JsonElement x in re.EnumerateArray())
+            {
+                string? match = Str(x, "match");
+                string? regexText = Str(x, "matchRegex");
+                if ((match is null) == (regexText is null)) throw new ProfileFormatException("response는 match 또는 matchRegex 중 하나가 필요합니다.");
+                Regex? regex = null;
+                if (regexText is not null)
+                {
+                    try { regex = new Regex(regexText, RegexOptions.CultureInvariant, TimeSpan.FromMilliseconds(200)); }
+                    catch (ArgumentException ex) { throw new ProfileFormatException("matchRegex 오류: " + ex.Message); }
+                }
+                var set = new Dictionary<string, string>(StringComparer.Ordinal);
+                if (x.TryGetProperty("set", out JsonElement se) && se.ValueKind == JsonValueKind.Object)
+                {
+                    foreach (JsonProperty p in se.EnumerateObject()) set[p.Name] = Scalar(p.Value, "set." + p.Name);
+                }
+                string? reply = Str(x, "reply");
+                if (reply is null && set.Count == 0) throw new ProfileFormatException("response는 reply 또는 set이 필요합니다.");
+                responses.Add(new ProfileResponse(match, regex, reply, set));
+            }
+        }
+
+        var streams = new List<ProfileStream>();
+        if (r.TryGetProperty("streams", out JsonElement st) && st.ValueKind == JsonValueKind.Array)
+        {
+            foreach (JsonElement x in st.EnumerateArray())
+            {
+                streams.Add(new ProfileStream(
+                    Str(x, "when") ?? "",
+                    x.TryGetProperty("everyMs", out JsonElement e) ? Scalar(e, "everyMs") : throw new ProfileFormatException("stream everyMs가 필요합니다."),
+                    Str(x, "frame") ?? throw new ProfileFormatException("stream frame이 필요합니다.")));
+            }
+        }
+
+        var generators = new Dictionary<string, GeneratorSpec>(StringComparer.Ordinal);
+        if (r.TryGetProperty("generators", out JsonElement ge) && ge.ValueKind == JsonValueKind.Object)
+        {
+            foreach (JsonProperty p in ge.EnumerateObject())
+            {
+                string type = (Str(p.Value, "type") ?? throw new ProfileFormatException($"generator {p.Name}: type이 필요합니다.")).ToLowerInvariant();
+                if (type is not ("constant" or "ramp" or "sine" or "random" or "sequence"))
+                {
+                    throw new ProfileFormatException($"generator {p.Name}: 알 수 없는 type {type}");
+                }
+                var values = new List<double>();
+                if (p.Value.TryGetProperty("values", out JsonElement va) && va.ValueKind == JsonValueKind.Array)
+                {
+                    foreach (JsonElement n in va.EnumerateArray()) values.Add(n.GetDouble());
+                }
+                if (type == "sequence" && values.Count == 0) throw new ProfileFormatException($"generator {p.Name}: values가 필요합니다.");
+                generators[p.Name] = new GeneratorSpec(type,
+                    Num(p.Value, "value", 0), Num(p.Value, "min", 0), Num(p.Value, "max", 1), Num(p.Value, "step", 1),
+                    Num(p.Value, "amp", 1), Num(p.Value, "periodMs", 1000), Num(p.Value, "offset", 0), values);
+            }
+        }
+
+        return new DeviceProfile(id, seed, vars, responses, streams, generators);
+    }
+
+    private static string? Str(JsonElement e, string name) =>
+        e.TryGetProperty(name, out JsonElement v) && v.ValueKind == JsonValueKind.String ? v.GetString() : null;
+
+    private static double Num(JsonElement e, string name, double fallback) =>
+        e.TryGetProperty(name, out JsonElement v) && v.ValueKind == JsonValueKind.Number ? v.GetDouble() : fallback;
+
+    private static string Scalar(JsonElement e, string name) => e.ValueKind switch
+    {
+        JsonValueKind.String => e.GetString()!,
+        JsonValueKind.Number => e.GetDouble().ToString(CultureInfo.InvariantCulture),
+        JsonValueKind.True => "true",
+        JsonValueKind.False => "false",
+        _ => throw new ProfileFormatException($"{name}: 문자열·숫자·true/false만 허용됩니다.")
+    };
+}
diff --git a/desktop/lib/juprovider.lib.protocol/Simulation/ISimulatedDevice.cs b/desktop/lib/juprovider.lib.protocol/Simulation/ISimulatedDevice.cs
new file mode 100644
index 0000000..5ed2ff1
--- /dev/null
+++ b/desktop/lib/juprovider.lib.protocol/Simulation/ISimulatedDevice.cs
@@ -0,0 +1,21 @@
+namespace JuProvider.Lib.Protocol.Simulation;
+
+/// <summary>시뮬레이터 장치가 바이트를 내보내는 곳 (VirtualTransport)</summary>
+public interface ISimulatorSink
+{
+    void Send(byte[] data);
+}
+
+/// <summary>가상 장치. 요청을 받고 응답·연속 데이터를 sink로 보낸다.</summary>
+public interface ISimulatedDevice
+{
+    string ProfileId { get; }
+
+    /// <summary>연결 시작. lifetime이 취소되면 연속 송신을 멈춘다.</summary>
+    void Open(ISimulatorSink sink, CancellationToken lifetime);
+
+    /// <summary>쓰기 1회 = 요청 1건</summary>
+    void OnRequest(byte[] request);
+
+    void Close();
+}
diff --git a/desktop/lib/juprovider.lib.protocol/Simulation/ProfileSimulator.cs b/desktop/lib/juprovider.lib.protocol/Simulation/ProfileSimulator.cs
new file mode 100644
index 0000000..e8fbb13
--- /dev/null
+++ b/desktop/lib/juprovider.lib.protocol/Simulation/ProfileSimulator.cs
@@ -0,0 +1,234 @@
+using System.Diagnostics;
+using System.Globalization;
+using System.Text.RegularExpressions;
+using JuProvider.Lib.Protocol.Expression;
+
+namespace JuProvider.Lib.Protocol.Simulation;
+
+/// <summary>범용 시뮬레이터 엔진: DeviceProfile에 따라 요청에 응답하고, 조건이 맞는 동안 연속 송신한다.</summary>
+public sealed partial class ProfileSimulator(DeviceProfile profile) : ISimulatedDevice
+{
+    private readonly object _lock = new();
+    private readonly Dictionary<string, string> _vars = new(StringComparer.Ordinal);
+    private readonly Dictionary<string, double> _ramp = new(StringComparer.Ordinal);
+    private readonly Dictionary<string, int> _sequence = new(StringComparer.Ordinal);
+    private Random _random = new(profile.Seed);
+    private readonly Stopwatch _clock = new();
+    private ISimulatorSink? _sink;
+    private Task? _streamTask;
+
+    public DeviceProfile Profile { get; } = profile;
+    public string ProfileId => Profile.ProfileId;
+
+    /// <summary>처리하지 못한 요청 수 (매칭 없음·템플릿 오류)</summary>
+    public int UnmatchedRequests { get; private set; }
+
+    /// <summary>현재 변수 값 (시험용)</summary>
+    public string? GetVar(string name)
+    {
+        lock (_lock) return _vars.TryGetValue(name, out string? v) ? v : null;
+    }
+
+    public void Open(ISimulatorSink sink, CancellationToken lifetime)
+    {
+        lock (_lock)
+        {
+            // 연결마다 장치 상태 초기화 (전원 재투입과 같음)
+            _vars.Clear();
+            foreach (var p in Profile.Vars) _vars[p.Key] = p.Value;
+            _ramp.Clear();
+            _sequence.Clear();
+            _random = new Random(Profile.Seed);
+            _sink = sink;
+            _clock.Restart();
+        }
+        if (Profile.Streams.Count > 0)
+        {
+            _streamTask = Task.Run(() => StreamLoopAsync(lifetime));
+        }
+    }
+
+    public void Close()
+    {
+        lock (_lock) _sink = null;
+    }
+
+    public void OnRequest(byte[] request)
+    {
+        byte[]? reply = null;
+        ISimulatorSink? sink;
+        lock (_lock)
+        {
+            sink = _sink;
+            string display = Normalize(request);
+            bool handled = false;
+
+            foreach (ProfileResponse r in Profile.Responses)
+            {
+                Dictionary<string, string>? groups = Match(r, display);
+                if (groups is null) continue;
+
+                try
+                {
+                    foreach (var s in r.Set) _vars[s.Key] = Render(s.Value, groups);
+                    if (r.Reply is not null) reply = ProtocolExpression.ToBytes(Render(r.Reply, groups));
+                    handled = true;
+                }
+                catch (Exception ex) when (ex is FormatException or InvalidOperationException)
+                {
+                    handled = false;
+                }
+                break;
+            }
+            if (!handled) UnmatchedRequests++;
+        }
+        if (reply is not null) sink?.Send(reply);
+    }
+
+    // ----- 내부 -----
+
+    private static string Normalize(byte[] bytes)
+    {
+        int end = bytes.Length;
+        while (end > 0 && (bytes[end - 1] == 0x0D || bytes[end - 1] == 0x0A)) end--;
+        return ProtocolExpression.ToDisplay(bytes.AsSpan(0, end));
+    }
+
+    private static Dictionary<string, string>? Match(ProfileResponse r, string display)
+    {
+        if (r.Match is not null)
+        {
+            return Normalize(ProtocolExpression.ToBytes(r.Match)) == display ? new Dictionary<string, string>() : null;
+        }
+        System.Text.RegularExpressions.Match m = r.MatchRegex!.Match(display);
+        if (!m.Success) return null;
+        var groups = new Dictionary<string, string>(StringComparer.Ordinal);
+        foreach (Group g in m.Groups)
+        {
+            if (!int.TryParse(g.Name, out _)) groups[g.Name] = g.Value;
+        }
+        return groups;
+    }
+
+    [GeneratedRegex(@"\$\{(?<name>[A-Za-z_][A-Za-z0-9_]*)(?:(?<op>[*/])(?<num>[0-9]+(?:\.[0-9]+)?))?\}")]
+    private static partial Regex TokenRegex();
+
+    /// <summary>${이름}, ${이름*수}, ${이름/수}. 우선순위: 정규식 그룹 → 생성기 → 변수. 없으면 InvalidOperationException</summary>
+    private string Render(string template, IReadOnlyDictionary<string, string> groups) =>
+        TokenRegex().Replace(template, m =>
+        {
+            string name = m.Groups["name"].Value;
+            string value = groups.TryGetValue(name, out string? g) ? g
+                : Profile.Generators.TryGetValue(name, out GeneratorSpec? gen) ? Format(Next(name, gen))
+                : _vars.TryGetValue(name, out string? v) ? v
+                : throw new InvalidOperationException($"템플릿 값 없음: {name}");
+
+            if (!m.Groups["op"].Success) return value;
+            if (!double.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out double x))
+            {
+                throw new InvalidOperationException($"숫자가 아님: {name}={value}");
+            }
+            double k = double.Parse(m.Groups["num"].Value, CultureInfo.InvariantCulture);
+            return Format(m.Groups["op"].Value == "*" ? x * k : x / k);
+        });
+
+    private static string Format(double v) => Math.Round(v, 4).ToString("0.####", CultureInfo.InvariantCulture);
+
+    private double Next(string name, GeneratorSpec g)
+    {
+        switch (g.Type)
+        {
+            case "constant":
+                return g.Value;
+            case "ramp":
+            {
+                double cur = _ramp.TryGetValue(name, out double c) ? c : g.Value;
+                double next = cur + g.Step;
+                _ramp[name] = next > g.Max ? g.Value : next;
+                return cur;
+            }
+            case "sine":
+                return g.Offset + g.Amp * Math.Sin(2 * Math.PI * _clock.Elapsed.TotalMilliseconds / Math.Max(1, g.PeriodMs));
+            case "random":
+                return g.Min + _random.NextDouble() * (g.Max - g.Min);
+            case "sequence":
+            {
+                int i = _sequence.TryGetValue(name, out int idx) ? idx : 0;
+                _sequence[name] = i + 1;
+                return g.Values[i % g.Values.Count];
+            }
+            default:
+                throw new InvalidOperationException("알 수 없는 생성기: " + g.Type);
+        }
+    }
+
+    private bool When(string condition)
+    {
+        if (string.IsNullOrWhiteSpace(condition)) return true;
+        foreach (string part in condition.Split("&&", StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
+        {
+            bool ok;
+            int ne = part.IndexOf("!=", StringComparison.Ordinal);
+            int eq = part.IndexOf("==", StringComparison.Ordinal);
+            if (ne > 0)
+            {
+                ok = !string.Equals(Var(part[..ne].Trim()), part[(ne + 2)..].Trim(), StringComparison.Ordinal);
+            }
+            else if (eq > 0)
+            {
+                ok = string.Equals(Var(part[..eq].Trim()), part[(eq + 2)..].Trim(), StringComparison.Ordinal);
+            }
+            else
+            {
+                string v = Var(part);
+                ok = v.Length > 0 && v != "false" && v != "0";
+            }
+            if (!ok) return false;
+        }
+        return true;
+    }
+
+    private string Var(string name) => _vars.TryGetValue(name, out string? v) ? v : "";
+
+    private async Task StreamLoopAsync(CancellationToken lifetime)
+    {
+        var last = new double[Profile.Streams.Count];
+        Array.Fill(last, double.NegativeInfinity);
+        try
+        {
+            while (!lifetime.IsCancellationRequested)
+            {
+                for (int i = 0; i < Profile.Streams.Count; i++)
+                {
+                    byte[]? frame = null;
+                    ISimulatorSink? sink;
+                    lock (_lock)
+                    {
+                        sink = _sink;
+                        ProfileStream s = Profile.Streams[i];
+                        if (sink is null || !When(s.When))
+                        {
+                            last[i] = double.NegativeInfinity;
+                            continue;
+                        }
+                        double now = _clock.Elapsed.TotalMilliseconds;
+                        double every = double.TryParse(Render(s.EveryMs, new Dictionary<string, string>()), NumberStyles.Float,
+                            CultureInfo.InvariantCulture, out double e) ? Math.Max(1, e) : 1000;
+                        if (now - last[i] < every) continue;
+                        last[i] = now;
+                        frame = ProtocolExpression.ToBytes(Render(s.Frame, new Dictionary<string, string>()));
+                    }
+                    sink?.Send(frame!);
+                }
+                await Task.Delay(5, lifetime).ConfigureAwait(false);
+            }
+        }
+        catch (OperationCanceledException)
+        {
+        }
+        catch (Exception ex) when (ex is FormatException or InvalidOperationException)
+        {
+            // 프로파일 템플릿 오류 → 연속 송신 중단 (요청 응답은 계속)
+        }
+    }
+}
diff --git a/desktop/lib/juprovider.lib.protocol/Sync/CollectionPlan.cs b/desktop/lib/juprovider.lib.protocol/Sync/CollectionPlan.cs
new file mode 100644
index 0000000..c92241d
--- /dev/null
+++ b/desktop/lib/juprovider.lib.protocol/Sync/CollectionPlan.cs
@@ -0,0 +1,148 @@
+using JuProvider.Lib.Protocol.Mapping;
+using JuProvider.Lib.Protocol.Model;
+using JuProvider.Lib.Protocol.Rules;
+using JuProvider.Lib.Protocol.Scheduling;
+using JuProvider.Lib.Protocol.Session;
+using JuProvider.Lib.Protocol.Transport;
+
+namespace JuProvider.Lib.Protocol.Sync;
+
+/// <summary>DeviceSession 생성에 필요한 것 전부 (서버 정의 + 수집 설정 결합 결과)</summary>
+public sealed record CollectionPlan(
+    string DevCd,
+    string PtlGrpCd,
+    FrameRule Frame,
+    IReadOnlyList<ProtocolDefinition> Protocols,
+    SchedulerOptions Scheduler,
+    DeviceSessionOptions Session,
+    IReadOnlyList<ChannelMapEntry> MapEntries,
+    IReadOnlyList<string> Warnings)
+{
+    public IDataMapper CreateMapper() => new DataMapper(MapEntries);
+
+    public DeviceSession CreateSession(ITransport transport) =>
+        new(DevCd, transport, Frame, Protocols, CreateMapper(), Scheduler, Session);
+}
+
+/// <summary>
+/// 서버 내려받기(ProtocolGroupSync·DataTagSync) + 그룹별 CollectionProfile → CollectionPlan (C4).
+/// <list type="bullet">
+/// <item>프로토콜 목록은 서버가 기준. 수집 설정에만 있는 PTL_CD 는 경고 후 무시</item>
+/// <item>송신: 설정 tx → TX 패킷 PACKET_EXPR → PTL_VAL</item>
+/// <item>교환 방식: 설정 pattern → PTL_TYPE(PROT 코드)</item>
+/// <item>해석 규칙: 설정 parse → RX 패킷 PARSE_RULE(JSON 만, 그 외는 경고 후 무시)</item>
+/// <item>타임아웃: 설정 → 그룹 TIMEOUT_MS, 재시도: 그룹 RETRY_CNT (Idempotent 명령만 적용됨)</item>
+/// <item>매핑: 장치의 데이터 태그 TAG_ID=CH&lt;n&gt; 임시 변환 (매핑 테이블은 C5)</item>
+/// </list>
+/// </summary>
+public static class CollectionPlanBuilder
+{
+    public static CollectionPlan Build(string devCd, ProtocolGroupSync group, IEnumerable<DataTagSync> tags, CollectionProfile? profile = null)
+    {
+        ArgumentException.ThrowIfNullOrEmpty(devCd);
+        ArgumentNullException.ThrowIfNull(group);
+        ArgumentNullException.ThrowIfNull(tags);
+        profile ??= BuiltInCollectionProfiles.Get(group.PtlGrpCd) ?? CollectionProfile.Empty(group.PtlGrpCd);
+        if (profile.PtlGrpCd != group.PtlGrpCd)
+            throw new ArgumentException($"수집 설정 그룹({profile.PtlGrpCd})과 서버 그룹({group.PtlGrpCd})이 다름", nameof(profile));
+
+        var warnings = new List<string>();
+        var protocols = new List<ProtocolDefinition>();
+        var known = new HashSet<string>(StringComparer.Ordinal);
+
+        foreach (ProtocolSync p in group.Protocols ?? [])
+        {
+            known.Add(p.PtlCd);
+            profile.Protocols.TryGetValue(p.PtlCd, out ProtocolOverlay? o);
+
+            ExchangePattern pattern;
+            if (o?.Pattern is { } op) pattern = op;
+            else
+            {
+                try { pattern = ProtocolModel.FromPtlType(p.PtlType); }
+                catch (ArgumentException)
+                {
+                    warnings.Add($"{p.PtlCd}: PTL_TYPE '{p.PtlType}' 해석 불가 → 제외");
+                    continue;
+                }
+            }
+
+            string? tx = pattern == ExchangePattern.RxStream ? null : FirstNonEmpty(
+                o?.Tx,
+                (p.Packets ?? []).Where(k => string.Equals(k.Direction, "TX", StringComparison.OrdinalIgnoreCase))
+                    .OrderBy(k => k.PacketSeq).Select(k => k.PacketExpr).FirstOrDefault(x => !string.IsNullOrEmpty(x)),
+                p.PtlVal);
+            if (pattern != ExchangePattern.RxStream && tx is null)
+            {
+                warnings.Add($"{p.PtlCd}: 송신 표현식 없음 → 제외");
+                continue;
+            }
+
+            ParseRule? parse = o?.Parse;
+            if (parse is null)
+            {
+                string? text = (p.Packets ?? []).Where(k => string.Equals(k.Direction, "RX", StringComparison.OrdinalIgnoreCase))
+                    .OrderBy(k => k.PacketSeq).Select(k => k.ParseRule).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x));
+                if (text is not null)
+                {
+                    if (text.TrimStart().StartsWith('{'))
+                    {
+                        try { parse = RuleReader.ReadParseRule(text); }
+                        catch (RuleFormatException ex) { warnings.Add($"{p.PtlCd}: PARSE_RULE 오류 → 무시 ({ex.Message})"); }
+                    }
+                    else warnings.Add($"{p.PtlCd}: PARSE_RULE 이 JSON 규칙이 아님 → 무시");
+                }
+            }
+
+            if (pattern == ExchangePattern.RxStream && parse is null)
+                warnings.Add($"{p.PtlCd}: RX_STREAM 인데 해석 규칙 없음 → 수신만");
+
+            if (o is null && p.PtlType == "PROT0000")
+                warnings.Add($"{p.PtlCd}: 수집 설정 없음, PTL_TYPE POLLING 그대로 사용");
+
+            protocols.Add(new ProtocolDefinition
+            {
+                PtlCd = p.PtlCd,
+                Pattern = pattern,
+                Roles = o?.Roles ?? (pattern == ExchangePattern.RxStream ? ProtocolRole.Data : ProtocolRole.Info),
+                Action = o?.Action ?? CommandAction.None,
+                Tx = tx,
+                Expect = o?.Expect,
+                Parse = parse,
+                TimeoutMs = o?.TimeoutMs ?? group.TimeoutMs,
+                RetryCount = Math.Max(0, group.RetryCnt),
+                Idempotent = o?.Idempotent
+            });
+        }
+
+        foreach (string extra in profile.Protocols.Keys.Where(k => !known.Contains(k)).OrderBy(k => k, StringComparer.Ordinal))
+            warnings.Add($"{extra}: 수집 설정에만 있음(서버 정의 없음) → 무시");
+
+        var defined = protocols.ToDictionary(x => x.PtlCd, StringComparer.Ordinal);
+        var routine = new List<string>();
+        foreach (string step in profile.InitRoutine)
+        {
+            if (defined.TryGetValue(step, out ProtocolDefinition? d) && d.Pattern != ExchangePattern.RxStream) routine.Add(step);
+            else warnings.Add($"초기화 루틴 {step}: 사용할 수 있는 프로토콜 없음 → 제외");
+        }
+
+        var tagWarnings = new List<string>();
+        IReadOnlyList<ChannelMapEntry> map = LegacyTagIdMapping.ToEntries(
+            tags.Where(t => t.DevCd == devCd)
+                .Select(t => new LegacyDataTag(t.DevCd, t.DatGrCd, t.DatCd, t.DatIdx, t.TagId, NullIfEmpty(t.DatUnit),
+                    (double?)t.DatMin, (double?)t.DatMax)),
+            tagWarnings);
+        warnings.AddRange(tagWarnings);
+
+        var scheduler = new SchedulerOptions(
+            DefaultTimeoutMs: group.TimeoutMs > 0 ? group.TimeoutMs : 1000,
+            InterCommandGapMs: profile.InterCommandGapMs);
+        var session = new DeviceSessionOptions(routine, profile.InitDelayMs);
+
+        return new CollectionPlan(devCd, group.PtlGrpCd, profile.Frame, protocols, scheduler, session, map, warnings);
+    }
+
+    private static string? FirstNonEmpty(params string?[] values) => values.FirstOrDefault(v => !string.IsNullOrEmpty(v));
+
+    private static string? NullIfEmpty(string? s) => string.IsNullOrEmpty(s) ? null : s;
+}
diff --git a/desktop/lib/juprovider.lib.protocol/Sync/CollectionProfile.cs b/desktop/lib/juprovider.lib.protocol/Sync/CollectionProfile.cs
new file mode 100644
index 0000000..ef2c8d9
--- /dev/null
+++ b/desktop/lib/juprovider.lib.protocol/Sync/CollectionProfile.cs
@@ -0,0 +1,217 @@
+using System.Text.Json;
+using JuProvider.Lib.Protocol.Model;
+using JuProvider.Lib.Protocol.Rules;
+using JuProvider.Lib.Protocol.Scheduling;
+
+namespace JuProvider.Lib.Protocol.Sync;
+
+public sealed class CollectionProfileException(string message) : Exception(message);
+
+/// <summary>프로토콜 1개의 수집 보정 (서버 정의 위에 덮어씀)</summary>
+public sealed record ProtocolOverlay(
+    ExchangePattern? Pattern = null,
+    ProtocolRole? Roles = null,
+    CommandAction? Action = null,
+    string? Tx = null,
+    ResponseMatcher? Expect = null,
+    ParseRule? Parse = null,
+    int? TimeoutMs = null,
+    bool? Idempotent = null);
+
+/// <summary>
+/// 프로토콜 그룹별 수집 설정 (C4). DB 컬럼이 생기기 전(C5, 별도 승인)까지 Desktop 리소스로 둔다 (C0-Q6과 같은 방식).
+/// <list type="bullet">
+/// <item>Frame: Frame Rule (시작 문자·잡음 제거 포함)</item>
+/// <item>InterCommandGapMs: 명령 간격 (GTEC 200 ms)</item>
+/// <item>InitRoutine / InitDelayMs: 연결·재연결 초기화 루틴</item>
+/// <item>Protocols: PTL_CD 별 보정 (교환 방식·역할·응답 조건·해석 규칙). 현재 seed PTL_TYPE 은 모두 POLLING 이라 보정 필요</item>
+/// </list>
+/// JSON v1:
+/// <code>
+/// { "v":1, "ptlGrpCd":"GTEC", "frame":{"v":1,"kind":"DELIM","start":"{","end":"[CR][LF]"},
+///   "interCommandGapMs":200, "initDelayMs":500, "initRoutine":["GTEC0301","GTEC0001"],
+///   "protocols":{ "GTEC0001":{"pattern":"TX_RX","roles":["INFO"],"expect":{"regex":"^\\{[A-Za-z]"}} } }
+/// </code>
+/// </summary>
+public sealed record CollectionProfile(
+    string PtlGrpCd,
+    FrameRule Frame,
+    int InterCommandGapMs,
+    int InitDelayMs,
+    IReadOnlyList<string> InitRoutine,
+    IReadOnlyDictionary<string, ProtocolOverlay> Protocols)
+{
+    /// <summary>보정 없는 기본값 (CRLF, 간격 0, 루틴 없음)</summary>
+    public static CollectionProfile Empty(string ptlGrpCd) =>
+        new(ptlGrpCd, new FrameRule(), 0, 0, [], new Dictionary<string, ProtocolOverlay>(StringComparer.Ordinal));
+
+    public static CollectionProfile Parse(string json)
+    {
+        JsonElement root;
+        try
+        {
+            using JsonDocument doc = JsonDocument.Parse(json);
+            root = doc.RootElement.Clone();
+        }
+        catch (JsonException ex)
+        {
+            throw new CollectionProfileException("수집 설정 JSON 형식 오류: " + ex.Message);
+        }
+
+        if (root.ValueKind != JsonValueKind.Object) throw new CollectionProfileException("수집 설정은 JSON 객체여야 합니다.");
+        if (!(root.TryGetProperty("v", out JsonElement v) && v.TryGetInt32(out int ver) && ver == 1))
+            throw new CollectionProfileException("지원하지 않는 수집 설정 버전 (v=1 필요)");
+
+        string grp = Str(root, "ptlGrpCd") ?? throw new CollectionProfileException("ptlGrpCd 필요");
+
+        FrameRule frame = new();
+        if (root.TryGetProperty("frame", out JsonElement f) && f.ValueKind == JsonValueKind.Object)
+        {
+            try { frame = RuleReader.ReadFrameRule(f.GetRawText()) ?? new FrameRule(); }
+            catch (RuleFormatException ex) { throw new CollectionProfileException("frame: " + ex.Message); }
+        }
+
+        int gap = Int(root, "interCommandGapMs") ?? 0;
+        int delay = Int(root, "initDelayMs") ?? 500;
+        if (gap < 0 || delay < 0) throw new CollectionProfileException("interCommandGapMs, initDelayMs 는 0 이상");
+
+        var routine = new List<string>();
+        if (root.TryGetProperty("initRoutine", out JsonElement r))
+        {
+            if (r.ValueKind != JsonValueKind.Array) throw new CollectionProfileException("initRoutine 은 배열");
+            foreach (JsonElement x in r.EnumerateArray())
+            {
+                string? s = x.ValueKind == JsonValueKind.String ? x.GetString() : null;
+                if (string.IsNullOrEmpty(s)) throw new CollectionProfileException("initRoutine 항목은 PTL_CD 문자열");
+                routine.Add(s);
+            }
+        }
+
+        var protocols = new Dictionary<string, ProtocolOverlay>(StringComparer.Ordinal);
+        if (root.TryGetProperty("protocols", out JsonElement ps))
+        {
+            if (ps.ValueKind != JsonValueKind.Object) throw new CollectionProfileException("protocols 는 객체");
+            foreach (JsonProperty p in ps.EnumerateObject()) protocols[p.Name] = ReadOverlay(p.Name, p.Value);
+        }
+
+        return new CollectionProfile(grp, frame, gap, delay, routine, protocols);
+    }
+
+    private static ProtocolOverlay ReadOverlay(string ptlCd, JsonElement e)
+    {
+        if (e.ValueKind != JsonValueKind.Object) throw new CollectionProfileException($"{ptlCd}: 객체여야 함");
+        try
+        {
+            ExchangePattern? pattern = Str(e, "pattern")?.ToUpperInvariant() switch
+            {
+                null => null,
+                "TX_ONLY" => ExchangePattern.TxOnly,
+                "TX_RX" => ExchangePattern.TxRx,
+                "RX_STREAM" => ExchangePattern.RxStream,
+                "POLL" => ExchangePattern.Poll,
+                string x => throw new CollectionProfileException($"{ptlCd}: 알 수 없는 pattern {x}")
+            };
+
+            ProtocolRole? roles = null;
+            if (e.TryGetProperty("roles", out JsonElement re))
+            {
+                if (re.ValueKind != JsonValueKind.Array || re.GetArrayLength() == 0) throw new CollectionProfileException($"{ptlCd}: roles 는 1개 이상 배열");
+                ProtocolRole acc = ProtocolRole.None;
+                foreach (JsonElement x in re.EnumerateArray())
+                {
+                    acc |= (x.ValueKind == JsonValueKind.String ? x.GetString()!.ToUpperInvariant() : null) switch
+                    {
+                        "INFO" => ProtocolRole.Info,
+                        "CONTROL" => ProtocolRole.Control,
+                        "DATA" => ProtocolRole.Data,
+                        var y => throw new CollectionProfileException($"{ptlCd}: 알 수 없는 role {y}")
+                    };
+                }
+                roles = acc;
+            }
+
+            CommandAction? action = Str(e, "action")?.ToUpperInvariant() switch
+            {
+                null => null,
+                "NONE" => CommandAction.None,
+                "START" => CommandAction.Start,
+                "PAUSE" => CommandAction.Pause,
+                "STOP" => CommandAction.Stop,
+                string x => throw new CollectionProfileException($"{ptlCd}: 알 수 없는 action {x}")
+            };
+
+            ResponseMatcher? expect = null;
+            if (e.TryGetProperty("expect", out JsonElement ex) && ex.ValueKind == JsonValueKind.Object)
+            {
+                if (Str(ex, "startsWith") is { } sw) expect = ResponseMatcher.StartsWith(sw);
+                else if (Str(ex, "regex") is { } rx) expect = ResponseMatcher.Regex(rx);
+                else throw new CollectionProfileException($"{ptlCd}: expect 는 startsWith 또는 regex");
+            }
+
+            ParseRule? parse = null;
+            if (e.TryGetProperty("parse", out JsonElement pe) && pe.ValueKind == JsonValueKind.Object)
+                parse = RuleReader.ReadParseRule(pe.GetRawText());
+
+            int? timeout = Int(e, "timeoutMs");
+            if (timeout is < 0) throw new CollectionProfileException($"{ptlCd}: timeoutMs 는 0 이상");
+
+            bool? idem = e.TryGetProperty("idempotent", out JsonElement ie) && ie.ValueKind is JsonValueKind.True or JsonValueKind.False
+                ? ie.GetBoolean()
+                : null;
+
+            return new ProtocolOverlay(pattern, roles, action, Str(e, "tx"), expect, parse, timeout, idem);
+        }
+        catch (RuleFormatException rf)
+        {
+            throw new CollectionProfileException($"{ptlCd}: {rf.Message}");
+        }
+        catch (ArgumentException ae)
+        {
+            throw new CollectionProfileException($"{ptlCd}: {ae.Message}");
+        }
+    }
+
+    private static string? Str(JsonElement e, string name) =>
+        e.TryGetProperty(name, out JsonElement v) && v.ValueKind == JsonValueKind.String ? v.GetString() : null;
+
+    private static int? Int(JsonElement e, string name)
+    {
+        if (!e.TryGetProperty(name, out JsonElement v) || v.ValueKind == JsonValueKind.Null) return null;
+        if (v.ValueKind == JsonValueKind.Number && v.TryGetInt32(out int n)) return n;
+        throw new CollectionProfileException($"{name}: 정수여야 합니다.");
+    }
+}
+
+/// <summary>내장 수집 설정 (실장비 COM6 검증값, 2026-10-30)</summary>
+public static class BuiltInCollectionProfiles
+{
+    /// <summary>
+    /// GTEC Science Cube: 측정 중엔 S{10,0} 외 명령을 무시하므로 STOP 먼저 → 장치확인 → 센서정보 → 모드.
+    /// TX_ONLY 연속 송신은 200 ms 간격 (0 ms 면 시작 명령 누락). 수신은 { … }[CR][LF], { 앞 잡음 제거.
+    /// </summary>
+    public const string GtecJson = """
+    {
+      "v": 1, "ptlGrpCd": "GTEC",
+      "frame": { "v": 1, "kind": "DELIM", "start": "{", "end": "[CR][LF]", "maxLen": 512 },
+      "interCommandGapMs": 200, "initDelayMs": 500,
+      "initRoutine": [ "GTEC0301", "GTEC0001", "GTEC0002", "GTEC0100" ],
+      "protocols": {
+        "GTEC0000": { "pattern": "TX_RX", "roles": ["INFO"], "expect": { "startsWith": "{OK" }, "tx": "S{TEST}[CR][LF]" },
+        "GTEC0001": { "pattern": "TX_RX", "roles": ["INFO"], "expect": { "regex": "^\\{[A-Za-z]" } },
+        "GTEC0002": { "pattern": "TX_RX", "roles": ["INFO"], "expect": { "regex": "^\\{\\d{3},\\d{3},\\d{3},\\d{3}\\}$" },
+                      "parse": { "v": 1, "kind": "INFO", "trim": "{}", "fields": ["CH1","CH2","CH3","CH4"], "absent": "000" } },
+        "GTEC0100": { "pattern": "TX_ONLY", "roles": ["CONTROL"], "idempotent": true },
+        "GTEC0300": { "pattern": "TX_ONLY", "roles": ["CONTROL"], "action": "START" },
+        "GTEC0301": { "pattern": "TX_ONLY", "roles": ["CONTROL"], "action": "STOP" },
+        "GTEC0400": { "pattern": "RX_STREAM", "roles": ["DATA"],
+                      "parse": { "v": 1, "kind": "TEXT", "trim": "{}", "sep": "SPACE", "count": 3 } }
+      }
+    }
+    """;
+
+    public static CollectionProfile? Get(string ptlGrpCd) => ptlGrpCd switch
+    {
+        "GTEC" => CollectionProfile.Parse(GtecJson),
+        _ => null
+    };
+}
