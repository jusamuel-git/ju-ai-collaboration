diff --git a/desktop/tests/juprovider.tests.protocol/CollectionTests.cs b/desktop/tests/juprovider.tests.protocol/CollectionTests.cs
new file mode 100644
index 0000000..02621f3
--- /dev/null
+++ b/desktop/tests/juprovider.tests.protocol/CollectionTests.cs
@@ -0,0 +1,395 @@
+using System.Collections.Concurrent;
+using System.Text;
+using System.Text.Json;
+using JuProvider.Lib.Protocol.Mapping;
+using JuProvider.Lib.Protocol.Model;
+using JuProvider.Lib.Protocol.Rules;
+using JuProvider.Lib.Protocol.Scheduling;
+using JuProvider.Lib.Protocol.Session;
+using JuProvider.Lib.Protocol.Simulation;
+using JuProvider.Lib.Protocol.Sync;
+using JuProvider.Lib.Protocol.Transport;
+
+namespace JuProvider.Tests.Protocol;
+
+/// <summary>
+/// 실장비(COM6 Science Cube) 동작을 흉내 내는 가상 장치 (2026-10-30 확인 내용):
+/// 측정 중엔 S{10,0} 외 명령 무시, 응답 없는 명령(모드·시작·중지) 직후 MinGapMs 안에 온 요청은 놓침, 연결이 끊겨도 측정 상태 유지.
+/// </summary>
+internal sealed class GtecLikeDevice : ISimulatedDevice
+{
+    private readonly object _lock = new();
+    private ISimulatorSink? _sink;
+    private long _lastSilent = long.MinValue / 2;
+
+    public int MinGapMs { get; init; } = 150;
+    public volatile bool Running;
+    public ConcurrentQueue<string> Accepted { get; } = new();
+    public ConcurrentQueue<string> Ignored { get; } = new();
+    public string ProfileId => "GTEC_LIKE";
+
+    public void Open(ISimulatorSink sink, CancellationToken lifetime)
+    {
+        lock (_lock) _sink = sink;
+        _ = Task.Run(async () =>
+        {
+            int n = 0;
+            while (!lifetime.IsCancellationRequested)
+            {
+                try { await Task.Delay(20, lifetime); } catch (OperationCanceledException) { break; }
+                if (Running) Send($"{{ +{++n}.0E+0 -0.00000E+0 -0.00000E+0}}\r\n");
+            }
+        });
+    }
+
+    public void OnRequest(byte[] request)
+    {
+        string s = Encoding.ASCII.GetString(request).TrimEnd('\r', '\n');
+        long now = Environment.TickCount64;
+        bool tooFast;
+        lock (_lock) tooFast = now - _lastSilent < MinGapMs;
+        if (tooFast || (Running && s != "S{10,0}"))
+        {
+            Ignored.Enqueue(s);
+            return;
+        }
+
+        Accepted.Enqueue(s);
+        switch (s)
+        {
+            case "S{10,3}": Send("{Science Cube Lite II Memory}\r\n"); return;
+            case "S{20}": Send("{008,000,000,000}\r\n"); return;
+            case "S{10,0}": Running = false; break;
+            case "S{10,1}": Running = true; break;
+        }
+        lock (_lock) _lastSilent = now;
+    }
+
+    public void Close()
+    {
+        lock (_lock) _sink = null;
+    }
+
