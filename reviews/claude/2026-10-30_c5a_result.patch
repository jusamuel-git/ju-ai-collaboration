+        CommandResult info = await s.ExecuteAsync("GTEC0002");
+        Assert.Equal("{008,000,000,000}", Encoding.ASCII.GetString(info.Response!.Body));
+
+        Assert.Equal(CommandStatus.Completed, (await s.ExecuteAsync("GTEC0300")).Status);
+        Assert.True(await Wait.UntilAsync(() => values.Count >= 9, 3000), $"values {values.Count}");
+
+        LogicalValue[] snapshot = values.ToArray();
+        Assert.All(snapshot, v => Assert.Equal(DataQuality.Good, v.Quality));
+        Assert.All(snapshot, v => Assert.Equal(new DeviceRef(Dev), v.Device));
+        Assert.Equal(
+            new[] { "GTEC/AIN/1", "GTEC/AIN/2", "GTEC/AIN/3" },
+            snapshot.Select(v => v.Data!.Key).Distinct().OrderBy(x => x, StringComparer.Ordinal));
+
+        Assert.Equal(CommandStatus.Completed, (await s.ExecuteAsync("GTEC0301")).Status);
+        await Task.Delay(300);
+        int stopped = values.Count;
+        await Task.Delay(400);
+        Assert.Equal(stopped, values.Count);
+    }
+
+    [Fact] // M1 통합: 연속 데이터 중 센서정보 요청 → 응답은 명령으로, 데이터는 계속 논리 Data로
+    public async Task Request_During_Stream_Does_Not_Swallow_Data()
+    {
+        var (s, t, values) = await StartAsync();
+        await using var _t = t;
+        await using var _s = s;
+        var unhandled = new ConcurrentQueue<string>();
+        s.UnhandledFrame += (_, f) => unhandled.Enqueue(Encoding.ASCII.GetString(f.Body));
+
+        await s.ExecuteAsync("GTEC0300");
+        Assert.True(await Wait.UntilAsync(() => values.Count >= 3, 3000));
+
+        for (int i = 0; i < 3; i++)
+        {
+            int before = values.Count;
+            CommandResult info = await s.ExecuteAsync("GTEC0002");
+            Assert.Equal(CommandStatus.Completed, info.Status);
+            Assert.Equal("{008,000,000,000}", Encoding.ASCII.GetString(info.Response!.Body));
+            Assert.True(await Wait.UntilAsync(() => values.Count > before, 2000), "요청 후에도 데이터 계속");
+        }
+
+        await s.ExecuteAsync("GTEC0301");
+        Assert.Empty(unhandled);
+    }
+
+    [Fact] // Link 끊김 → Suspended + 진행 중 LinkDown, 다시 열면 Ready
+    public async Task Link_Down_Suspends_And_Reopen_Recovers()
+    {
+        var (s, t, _) = await StartAsync();
+        await using var _t = t;
+        await using var _s = s;
+        var states = new ConcurrentQueue<DeviceSessionState>();
+        s.StateChanged += (_, st) => states.Enqueue(st);
+
+        Task<CommandResult> pending = s.ExecuteAsync("NORESP");
+        Assert.True(await Wait.UntilAsync(() => s.Scheduler!.InFlightCount == 1, 1000));
+        t.ForceDisconnect();
+
+        CommandResult r = await pending.WaitAsync(TimeSpan.FromSeconds(2));
+        Assert.Equal(CommandStatus.LinkDown, r.Status);
+        Assert.True(await Wait.UntilAsync(() => s.State == DeviceSessionState.Suspended, 1000));
+        Assert.Equal(CommandStatus.LinkDown, (await s.ExecuteAsync("GTEC0000")).Status);
+
+        await t.OpenAsync();
+        Assert.True(await Wait.UntilAsync(() => s.State == DeviceSessionState.Ready, 1000));
+        Assert.Equal(CommandStatus.Completed, (await s.ExecuteAsync("GTEC0000")).Status);
+        Assert.Equal(new[] { DeviceSessionState.Suspended, DeviceSessionState.Ready }, states.ToArray());
+    }
+
+    [Fact] // STOP 이 대기 중 START 를 취소 (세션 경로)
+    public async Task Stop_Cancels_Pending_Start_Through_Session()
+    {
+        var sim = new ProfileSimulator(BuiltInProfiles.Get("GTEC_SCIENCE_CUBE"));
+        var t = new VirtualTransport(sim);
+        await using var _t = t;
+        await t.OpenAsync();
+        var s = new DeviceSession(Dev, t, CrLf, GtecProtocols(), GtecMapper());
+        await using var _s = s;
+        await s.StartAsync();
+
+        Task<CommandResult> busy = s.ExecuteAsync("SLOW");
+        Assert.True(await Wait.UntilAsync(() => s.Scheduler!.InFlightCount == 1, 1000));
+        Task<CommandResult> start = s.ExecuteAsync("GTEC0300");
+        Task<CommandResult> stop = s.ExecuteAsync("GTEC0301");
+
+        Assert.Equal(CommandStatus.Cancelled, (await start).Status);
+        Assert.Equal(CommandStatus.Timeout, (await busy).Status);
+        Assert.Equal(CommandStatus.Completed, (await stop).Status);
+        Assert.Equal("false", sim.GetVar("running"));
+    }
+
+    [Fact] // 같은 DEV_CD, 다른 Link(조각난 수신) → 같은 식별자
+    public async Task Same_Device_Different_Link_Same_Identifiers()
+    {
+        var (a, ta, va) = await StartAsync();
+        var (b, tb, vb) = await StartAsync(new FaultOptions(FragmentSize: 3));
+        await using var _ta = ta;
+        await using var _tb = tb;
+        await using var _a = a;
+        await using var _b = b;
+
+        await a.ExecuteAsync("GTEC0300");
+        await b.ExecuteAsync("GTEC0300");
+        Assert.True(await Wait.UntilAsync(() => va.Count >= 6 && vb.Count >= 6, 3000));
+        await a.ExecuteAsync("GTEC0301");
+        await b.ExecuteAsync("GTEC0301");
+
+        static string[] Keys(IEnumerable<LogicalValue> v) =>
+            v.Select(x => $"{x.Device.DevCd}|{x.Channel.ChannelKey}|{x.Data!.Key}").Distinct().OrderBy(x => x, StringComparer.Ordinal).ToArray();
+        Assert.Equal(Keys(va), Keys(vb));
+    }
+
+    [Fact]
+    public async Task Execute_Rejects_Unknown_Stream_And_Before_Start()
+    {
+        VirtualTransport t = GtecTransport();
+        await using var _t = t;
+        await t.OpenAsync();
+        var s = new DeviceSession(Dev, t, CrLf, GtecProtocols(), GtecMapper());
+        await using var _s = s;
+
+        Assert.Equal(CommandStatus.Rejected, (await s.ExecuteAsync("GTEC0000")).Status);
+        await s.StartAsync();
+        Assert.Equal(CommandStatus.Rejected, (await s.ExecuteAsync("NONE")).Status);
+        Assert.Equal(CommandStatus.Rejected, (await s.ExecuteAsync("GTEC0400")).Status);
+        Assert.Throws<ArgumentException>(() => new DeviceSession(Dev, t, CrLf, [.. GtecProtocols(), .. GtecProtocols()], GtecMapper()));
+    }
+
+    [Fact]
+    public void Priority_And_Pattern_Mapping()
+    {
+        Assert.Equal(CommandPriority.Stop, DeviceSession.PriorityOf(new() { PtlCd = "S", Pattern = ExchangePattern.TxOnly, Action = CommandAction.Stop }));
+        Assert.Equal(CommandPriority.Control, DeviceSession.PriorityOf(new() { PtlCd = "C", Pattern = ExchangePattern.TxRx, Roles = ProtocolRole.Control }));
+        Assert.Equal(CommandPriority.Poll, DeviceSession.PriorityOf(new() { PtlCd = "P", Pattern = ExchangePattern.Poll, Roles = ProtocolRole.Data }));
+        Assert.Equal(CommandPriority.Info, DeviceSession.PriorityOf(new() { PtlCd = "I", Pattern = ExchangePattern.TxRx }));
+        Assert.Equal(ExchangePattern.Poll, ProtocolModel.FromPtlType("PROT0000"));
+        Assert.Equal(ExchangePattern.TxOnly, ProtocolModel.FromPtlType("PROT0001"));
+        Assert.Equal(ExchangePattern.RxStream, ProtocolModel.FromPtlType("PROT0002"));
+        Assert.Equal(ExchangePattern.TxRx, ProtocolModel.FromPtlType("PROT0003"));
+        Assert.Throws<ArgumentException>(() => ProtocolModel.FromPtlType("X"));
+    }
+}
