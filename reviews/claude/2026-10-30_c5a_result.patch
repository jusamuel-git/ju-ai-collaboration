@@ -0,0 +1,170 @@
+package com.asdp.juprovider.core.protocolsync.service;
+
+import java.math.BigDecimal;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.ArrayList;
+import java.util.HexFormat;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import org.springframework.stereotype.Service;
+
+import com.asdp.juprovider.core.protocolsync.dao.ProtocolSyncDao;
+import com.asdp.juprovider.core.protocolsync.dto.DataTagSync;
+import com.asdp.juprovider.core.protocolsync.dto.ProtocolGroupSync;
+import com.asdp.juprovider.core.protocolsync.dto.ProtocolPacketSync;
+import com.asdp.juprovider.core.protocolsync.dto.ProtocolSync;
+import com.asdp.juprovider.core.protocolsync.dto.SyncResult;
+
+/**
+ * C4 프로토콜·데이터 태그 내려받기 (읽기 전용, DB 변경 없음).
+ *
+ * 그룹 → 프로토콜 → 패킷을 조회 순서(정렬된 SQL) 그대로 묶는다.
+ * revision 은 결과 내용의 SHA-256 이라 같은 데이터면 항상 같다.
+ */
+@Service
+public class ProtocolSyncService {
+
+    private final ProtocolSyncDao dao;
+
+    public ProtocolSyncService(ProtocolSyncDao dao) {
+        this.dao = dao;
+    }
+
+    /** ptlGrpCd 가 null 이면 사용 중인 전체 그룹 */
+    public SyncResult<ProtocolGroupSync> getProtocolGroups(String ptlGrpCd) {
+
+        Map<String, List<ProtocolPacketSync>> packets = new LinkedHashMap<>();
+        for (Map<String, Object> r : nullSafe(dao.selectSyncPackets(ptlGrpCd))) {
+            String key = str(r, "ptlGrpCd") + "\u0000" + str(r, "ptlCd");
+            packets.computeIfAbsent(key, k -> new ArrayList<>()).add(new ProtocolPacketSync(
+                    integer(r, "packetSeq", 0),
+                    str(r, "packetType"),
+                    str(r, "direction"),
+                    str(r, "packetExpr"),
+                    str(r, "responsePtlCd"),
+                    str(r, "parseRule"),
+                    integer(r, "dataCount", 0),
+                    str(r, "dataType"),
+                    str(r, "dataPosition")));
+        }
+
+        Map<String, List<ProtocolSync>> protocols = new LinkedHashMap<>();
+        for (Map<String, Object> r : nullSafe(dao.selectSyncProtocols(ptlGrpCd))) {
+            String grp = str(r, "ptlGrpCd");
+            String ptl = str(r, "ptlCd");
+            protocols.computeIfAbsent(grp, k -> new ArrayList<>()).add(new ProtocolSync(
+                    ptl,
+                    str(r, "ptlType"),
+                    nullableInteger(r, "ptlLen"),
+                    str(r, "ptlVal"),
+                    str(r, "ptlNm"),
+                    str(r, "ptlDesc"),
+                    List.copyOf(packets.getOrDefault(grp + "\u0000" + ptl, List.of()))));
+        }
+
+        List<ProtocolGroupSync> groups = new ArrayList<>();
+        for (Map<String, Object> r : nullSafe(dao.selectSyncGroups(ptlGrpCd))) {
+            String grp = str(r, "ptlGrpCd");
+            groups.add(new ProtocolGroupSync(
+                    grp,
+                    str(r, "ptlGrpNm"),
+                    integer(r, "pollingIntval", 1000),
+                    integer(r, "timeoutMs", 3000),
+                    integer(r, "retryCnt", 3),
+                    integer(r, "sortOrd", 0),
+                    List.copyOf(protocols.getOrDefault(grp, List.of()))));
+        }
+
+        return result(groups);
+    }
+
+    /** devCd 가 null 이면 사용 중인 전체 장치 */
+    public SyncResult<DataTagSync> getDataTags(String devCd) {
+
+        List<DataTagSync> tags = new ArrayList<>();
+        for (Map<String, Object> r : nullSafe(dao.selectSyncDataTags(devCd))) {
+            tags.add(new DataTagSync(
+                    str(r, "devCd"),
+                    str(r, "datGrCd"),
+                    str(r, "datCd"),
+                    integer(r, "datIdx", 0),
+                    str(r, "datType"),
+                    str(r, "datUnit"),
+                    str(r, "tagId"),
+                    str(r, "datNm"),
+                    decimal(r, "datMin"),
+                    decimal(r, "datMax"),
+                    integer(r, "sortOrd", 0)));
+        }
+        return result(tags);
+    }
+
+    static <T> SyncResult<T> result(List<T> items) {
+        List<T> copy = List.copyOf(items);
+        return new SyncResult<>(revisionOf(copy), copy, List.of());
+    }
+
+    /** record toString 은 필드 순서·값이 같으면 같다 → 내용 해시 */
+    static String revisionOf(List<?> items) {
+        try {
+            MessageDigest md = MessageDigest.getInstance("SHA-256");
+            byte[] hash = md.digest(items.toString().getBytes(StandardCharsets.UTF_8));
+            return HexFormat.of().formatHex(hash);
+        } catch (NoSuchAlgorithmException e) {
+            throw new IllegalStateException("SHA-256 사용 불가", e);
+        }
+    }
+
+    private static List<Map<String, Object>> nullSafe(List<Map<String, Object>> rows) {
+        return rows == null ? List.of() : rows;
+    }
+
+    private static Object value(Map<String, Object> r, String key) {
+        if (r.containsKey(key)) {
+            return r.get(key);
+        }
+        // DB 드라이버가 별칭 대소문자를 바꾼 경우 대비
+        for (Map.Entry<String, Object> e : r.entrySet()) {
+            if (e.getKey() != null && e.getKey().equalsIgnoreCase(key)) {
+                return e.getValue();
+            }
+        }
+        return null;
+    }
+
+    private static String str(Map<String, Object> r, String key) {
+        Object v = value(r, key);
+        return v == null ? null : v.toString();
+    }
+
+    private static Integer nullableInteger(Map<String, Object> r, String key) {
+        Object v = value(r, key);
+        if (v == null) {
+            return null;
+        }
+        if (v instanceof Number n) {
+            return n.intValue();
+        }
+        return Integer.valueOf(v.toString().trim());
+    }
+
+    private static int integer(Map<String, Object> r, String key, int fallback) {
+        Integer v = nullableInteger(r, key);
+        return v == null ? fallback : v;
+    }
+
+    private static BigDecimal decimal(Map<String, Object> r, String key) {
+        Object v = value(r, key);
+        if (v == null) {
+            return null;
+        }
+        if (v instanceof BigDecimal d) {
+            return d;
+        }
+        return new BigDecimal(v.toString().trim());
+    }
+}
diff --git a/juprovider.core/src/main/resources/mapper/ProtocolSyncMapper.xml b/juprovider.core/src/main/resources/mapper/ProtocolSyncMapper.xml
new file mode 100644
index 0000000..447ab98
--- /dev/null
+++ b/juprovider.core/src/main/resources/mapper/ProtocolSyncMapper.xml
@@ -0,0 +1,98 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
+        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
+
+<!-- C4 프로토콜·데이터 태그 내려받기 (읽기 전용). 사용여부 YENO0001 만. -->
+<mapper namespace="com.asdp.juprovider.core.protocolsync.dao.ProtocolSyncDao">
+
+    <select id="selectSyncGroups" resultType="map">
+        SELECT G.PTL_GRP_CD      AS ptlGrpCd,
+               GD.PTL_GRP_NM     AS ptlGrpNm,
+               G.POLLING_INTVAL  AS pollingIntval,
+               G.TIMEOUT_MS      AS timeoutMs,
+               G.RETRY_CNT       AS retryCnt,
+               G.SORT_ORD        AS sortOrd
+          FROM ju_protocol_group G
+          LEFT JOIN ju_protocol_group_detail GD
+            ON GD.PTL_GRP_CD = G.PTL_GRP_CD
+         WHERE G.USE_YN = 'YENO0001'
+        <if test="ptlGrpCd != null">
+           AND G.PTL_GRP_CD = #{ptlGrpCd}
+        </if>
+         ORDER BY G.SORT_ORD, G.PTL_GRP_CD
+    </select>
+
+    <select id="selectSyncProtocols" resultType="map">
+        SELECT P.PTL_GRP_CD  AS ptlGrpCd,
+               P.PTL_CD      AS ptlCd,
+               P.PTL_TYPE    AS ptlType,
+               P.PTL_LEN     AS ptlLen,
+               P.PTL_VAL     AS ptlVal,
+               PD.PTL_NM     AS ptlNm,
+               PD.PTL_DESC   AS ptlDesc
+          FROM ju_protocol P
+          JOIN ju_protocol_group G
+            ON G.PTL_GRP_CD = P.PTL_GRP_CD
+           AND G.USE_YN = 'YENO0001'
+          LEFT JOIN ju_protocol_detail PD
+            ON PD.PTL_GRP_CD = P.PTL_GRP_CD
+           AND PD.PTL_CD = P.PTL_CD
+         WHERE P.USE_YN = 'YENO0001'
+        <if test="ptlGrpCd != null">
+           AND P.PTL_GRP_CD = #{ptlGrpCd}
+        </if>
+         ORDER BY P.PTL_GRP_CD, P.PTL_CD
+    </select>
+
+    <select id="selectSyncPackets" resultType="map">
+        SELECT K.PTL_GRP_CD       AS ptlGrpCd,
+               K.PTL_CD           AS ptlCd,
+               K.PACKET_SEQ       AS packetSeq,
+               K.PACKET_TYPE      AS packetType,
+               K.DIRECTION        AS direction,
+               K.PACKET_EXPR      AS packetExpr,
+               K.RESPONSE_PTL_CD  AS responsePtlCd,
+               K.PARSE_RULE       AS parseRule,
+               K.DATA_COUNT       AS dataCount,
+               K.DATA_TYPE        AS dataType,
+               K.DATA_POSITION    AS dataPosition
+          FROM ju_protocol_packet K
+          JOIN ju_protocol P
+            ON P.PTL_GRP_CD = K.PTL_GRP_CD
+           AND P.PTL_CD = K.PTL_CD
+           AND P.USE_YN = 'YENO0001'
+         WHERE K.USE_YN = 'YENO0001'
+        <if test="ptlGrpCd != null">
+           AND K.PTL_GRP_CD = #{ptlGrpCd}
+        </if>
+         ORDER BY K.PTL_GRP_CD, K.PTL_CD, K.PACKET_SEQ
+    </select>
+
+    <select id="selectSyncDataTags" resultType="map">
+        SELECT DG.DEV_CD       AS devCd,
+               T.DAT_GR_CD     AS datGrCd,
+               T.DAT_CD        AS datCd,
+               T.DAT_IDX       AS datIdx,
+               T.DAT_TYPE      AS datType,
+               T.DAT_UNIT      AS datUnit,
+               T.TAG_ID        AS tagId,
+               TD.DAT_NM       AS datNm,
+               TD.DAT_MIN      AS datMin,
+               TD.DAT_MAX      AS datMax,
+               T.SORT_ORD      AS sortOrd
+          FROM ju_data_tag T
+          JOIN ju_data_group DG
+            ON DG.DAT_GR_CD = T.DAT_GR_CD
+           AND DG.USE_YN = 'YENO0001'
+          LEFT JOIN ju_data_tag_detail TD
+            ON TD.DAT_GR_CD = T.DAT_GR_CD
+           AND TD.DAT_CD = T.DAT_CD
+           AND TD.DAT_IDX = T.DAT_IDX
+         WHERE T.USE_YN = 'YENO0001'
+        <if test="devCd != null">
+           AND DG.DEV_CD = #{devCd}
+        </if>
+         ORDER BY DG.DEV_CD, DG.SORT_ORD, T.DAT_GR_CD, T.SORT_ORD, T.DAT_CD, T.DAT_IDX
+    </select>
+
+</mapper>
