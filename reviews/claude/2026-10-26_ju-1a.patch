+package com.asdp.juprovider.security;
+
+import java.time.Instant;
+import java.time.temporal.ChronoUnit;
+
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.security.oauth2.jose.jws.MacAlgorithm;
+import org.springframework.security.oauth2.jwt.JwsHeader;
+import org.springframework.security.oauth2.jwt.Jwt;
+import org.springframework.security.oauth2.jwt.JwtClaimsSet;
+import org.springframework.security.oauth2.jwt.JwtEncoder;
+import org.springframework.security.oauth2.jwt.JwtEncoderParameters;
+import org.springframework.stereotype.Service;
+
+import com.asdp.juprovider.core.security.ExecutionContext;
+
+/**
+ * JU 사용자 Access Token 발급과 클레임 해석.
+ *
+ * 클레임
+ *   sub       : USER_ID
+ *   login_id  : LOGIN_ID
+ *   auth_id   : AUTH_ID
+ *   auth_type : AUTH_TYPE (예: AUTH0001)
+ *   pwv       : 발급 시점의 비밀번호 버전 (PW_CHANGE_DT epoch 초, 없으면 0).
+ *               요청마다 DB 값과 비교해서, 비밀번호 변경 전에 발급된 토큰을 거부한다.
+ */
+@Service
+public class JwtTokenService {
+
+    public static final String CLAIM_LOGIN_ID = "login_id";
+    public static final String CLAIM_AUTH_ID = "auth_id";
+    public static final String CLAIM_AUTH_TYPE = "auth_type";
+    public static final String CLAIM_PASSWORD_VERSION = "pwv";
+
+    private final JwtEncoder jwtEncoder;
+    private final String issuer;
+    private final long accessTokenMinutes;
+
+    public JwtTokenService(
+            JwtEncoder jwtEncoder,
+            @Value("${juprovider.security.jwt.issuer:juprovider}") String issuer,
+            @Value("${juprovider.security.jwt.access-token-minutes:60}") long accessTokenMinutes) {
+        this.jwtEncoder = jwtEncoder;
+        this.issuer = issuer;
+        this.accessTokenMinutes = accessTokenMinutes;
+    }
+
+    public IssuedToken issue(
+            Long userId,
+            String loginId,
+            Long authId,
+            String authType,
+            long passwordVersion) {
+        Instant now = Instant.now();
+        Instant expiresAt = now.plus(accessTokenMinutes, ChronoUnit.MINUTES);
+        JwtClaimsSet claims = JwtClaimsSet.builder()
+                .issuer(issuer)
+                .issuedAt(now)
+                .expiresAt(expiresAt)
+                .subject(String.valueOf(userId))
+                .claim(CLAIM_LOGIN_ID, loginId)
+                .claim(CLAIM_AUTH_ID, authId)
+                .claim(CLAIM_AUTH_TYPE, authType)
+                .claim(CLAIM_PASSWORD_VERSION, passwordVersion)
+                .build();
+        JwsHeader header = JwsHeader.with(MacAlgorithm.HS256).build();
+        String token = jwtEncoder
+                .encode(JwtEncoderParameters.from(header, claims))
+                .getTokenValue();
+        return new IssuedToken(token, expiresAt);
+    }
+
+    public static Long userId(Jwt jwt) {
+        return Long.valueOf(jwt.getSubject());
+    }
+
+    public static long passwordVersion(Jwt jwt) {
+        return toLong(jwt.getClaim(CLAIM_PASSWORD_VERSION), -1L);
+    }
+
+    public static Long authId(Jwt jwt) {
+        Object value = jwt.getClaim(CLAIM_AUTH_ID);
+        return value == null ? null : toLong(value, -1L);
+    }
+
+    public static ExecutionContext toContext(Jwt jwt) {
+        return ExecutionContext.ofUser(userId(jwt), authId(jwt));
+    }
+
+    private static long toLong(Object value, long fallback) {
+        if (value instanceof Number number) {
+            return number.longValue();
+        }
+        if (value == null) {
+            return fallback;
+        }
+        try {
+            return Long.parseLong(value.toString());
+        } catch (NumberFormatException e) {
+            return fallback;
+        }
+    }
+
+    public record IssuedToken(String token, Instant expiresAt) {
+    }
+}
