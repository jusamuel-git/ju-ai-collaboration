+package com.asdp.juprovider.core.security;
+
+/**
+ * Core 업무 실행 주체 (읽기 전용).
+ *
+ * Backend가 인증 정보(사용자 JWT, JU-1B부터 Client 자격)를 해석해서 만든다.
+ * Core는 HTTP/토큰을 모르고 이 값만 사용한다.
+ *
+ * userId/authId : 작업한 사용자 (ju_user.USER_ID, ju_auth.AUTH_ID)
+ * clientId      : 요청한 Desktop Client (JU-1B)
+ */
+public record ExecutionContext(
+        Long userId,
+        Long authId,
+        String clientId) {
+
+    public static ExecutionContext ofUser(Long userId, Long authId) {
+        return new ExecutionContext(userId, authId, null);
+    }
+
+    public boolean hasUser() {
+        return userId != null && authId != null;
+    }
+}
