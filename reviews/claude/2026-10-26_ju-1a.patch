+package com.asdp.juprovider.security;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import org.springframework.core.convert.converter.Converter;
+import org.springframework.security.authentication.AbstractAuthenticationToken;
+import org.springframework.security.core.GrantedAuthority;
+import org.springframework.security.core.authority.SimpleGrantedAuthority;
+import org.springframework.security.oauth2.jwt.Jwt;
+import org.springframework.security.oauth2.server.resource.InvalidBearerTokenException;
+import org.springframework.security.oauth2.server.resource.authentication.JwtAuthenticationToken;
+
+import com.asdp.juprovider.service.AuthService;
+import com.asdp.juprovider.service.AuthService.UserState;
+
+/**
+ * 서명·만료가 확인된 JWT를 현재 DB 상태와 대조해서 인증 객체로 만든다.
+ *
+ * 거부(401): 사용자/권한이 없거나 미사용, 비밀번호 버전(pwv) 불일치(변경 전에 발급된 토큰)
+ * 권한:
+ *   USER        : 로그인한 사용자 (/api/auth/me, /api/auth/password)
+ *   PW_OK       : 비밀번호 변경이 끝난 사용자 (그 밖의 보호 API)
+ *   ROLE_{AUTH_TYPE}
+ *
+ * MVC 변환기로 자동 등록되지 않도록 Bean이 아니라 SecurityConfig에서 직접 만든다.
+ */
+public class UserTokenAuthenticationConverter implements Converter<Jwt, AbstractAuthenticationToken> {
+
+    public static final String AUTHORITY_USER = "USER";
+    public static final String AUTHORITY_PASSWORD_OK = "PW_OK";
+
+    private final AuthService authService;
+
+    public UserTokenAuthenticationConverter(AuthService authService) {
+        this.authService = authService;
+    }
+
+    @Override
+    public AbstractAuthenticationToken convert(Jwt jwt) {
+        Long userId;
+        try {
+            userId = JwtTokenService.userId(jwt);
+        } catch (RuntimeException e) {
+            throw new InvalidBearerTokenException("토큰이 올바르지 않습니다.");
+        }
+        UserState state = authService.findActiveUserState(userId)
+                .orElseThrow(() -> new InvalidBearerTokenException("사용할 수 없는 계정입니다."));
+        if (state.passwordVersion() != JwtTokenService.passwordVersion(jwt)) {
+            throw new InvalidBearerTokenException("비밀번호가 변경되어 다시 로그인해야 합니다.");
+        }
+
+        List<GrantedAuthority> authorities = new ArrayList<>();
+        authorities.add(new SimpleGrantedAuthority(AUTHORITY_USER));
+        if (!state.passwordChangeRequired()) {
+            authorities.add(new SimpleGrantedAuthority(AUTHORITY_PASSWORD_OK));
+            authorities.add(new SimpleGrantedAuthority("ROLE_" + state.authType()));
+        }
+        return new JwtAuthenticationToken(jwt, authorities, jwt.getSubject());
+    }
+}
