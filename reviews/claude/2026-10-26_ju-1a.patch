+package com.asdp.juprovider.config;
+
+import java.nio.charset.StandardCharsets;
+import java.security.SecureRandom;
+
+import javax.crypto.SecretKey;
+import javax.crypto.spec.SecretKeySpec;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.security.oauth2.jose.jws.MacAlgorithm;
+import org.springframework.security.oauth2.jwt.JwtDecoder;
+import org.springframework.security.oauth2.jwt.JwtEncoder;
+import org.springframework.security.oauth2.jwt.JwtValidators;
+import org.springframework.security.oauth2.jwt.NimbusJwtDecoder;
+import org.springframework.security.oauth2.jwt.NimbusJwtEncoder;
+
+import com.nimbusds.jose.jwk.source.ImmutableSecret;
+
+/**
+ * JU 사용자 JWT (HS256) 발급/검증 설정.
+ *
+ * - JU_JWT_SECRET(juprovider.security.jwt.secret)이 없거나 32바이트 미만이면 기동 실패
+ * - 단, allow-random-secret=true(dev profile 전용)이고 값이 없으면 임시 키 + WARN
+ * - 서명키 값은 로그에 쓰지 않는다
+ */
+@Configuration
+public class JwtConfig {
+
+    private static final Logger log = LoggerFactory.getLogger(JwtConfig.class);
+
+    static final int MIN_SECRET_BYTES = 32;
+
+    @Bean
+    public SecretKey jwtSecretKey(
+            @Value("${juprovider.security.jwt.secret:}") String secret,
+            @Value("${juprovider.security.jwt.allow-random-secret:false}") boolean allowRandomSecret) {
+        return new SecretKeySpec(resolveSecret(secret, allowRandomSecret), "HmacSHA256");
+    }
+
+    static byte[] resolveSecret(String secret, boolean allowRandomSecret) {
+        if (secret == null || secret.isBlank()) {
+            if (!allowRandomSecret) {
+                throw new IllegalStateException(
+                        "JU_JWT_SECRET이 설정되지 않았습니다. (Tomcat bin\\setenv.bat, 32바이트 이상)");
+            }
+            byte[] random = new byte[MIN_SECRET_BYTES];
+            new SecureRandom().nextBytes(random);
+            log.warn("JU_JWT_SECRET이 없어 임시 서명키를 사용합니다 (dev profile 전용). "
+                    + "재시작하면 발급된 토큰은 모두 무효가 됩니다.");
+            return random;
+        }
+        byte[] keyBytes = secret.getBytes(StandardCharsets.UTF_8);
+        if (keyBytes.length < MIN_SECRET_BYTES) {
+            throw new IllegalStateException(
+                    "JU_JWT_SECRET은 32바이트 이상이어야 합니다.");
+        }
+        return keyBytes;
+    }
+
+    @Bean
+    public JwtEncoder jwtEncoder(SecretKey jwtSecretKey) {
+        return new NimbusJwtEncoder(new ImmutableSecret<>(jwtSecretKey));
+    }
+
+    @Bean
+    public JwtDecoder jwtDecoder(
+            SecretKey jwtSecretKey,
+            @Value("${juprovider.security.jwt.issuer:juprovider}") String issuer) {
+        NimbusJwtDecoder decoder = NimbusJwtDecoder
+                .withSecretKey(jwtSecretKey)
+                .macAlgorithm(MacAlgorithm.HS256)
+                .build();
+        decoder.setJwtValidator(JwtValidators.createDefaultWithIssuer(issuer));
+        return decoder;
+    }
+}
