+package com.asdp.juprovider.config;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import org.junit.jupiter.api.Test;
+
+/** JU_JWT_SECRET 기동 조건 (JU-1A) */
+class JwtConfigTest {
+
+    private static final String VALID = "0123456789abcdef0123456789abcdef"; // 32바이트 (테스트용 더미)
+
+    @Test
+    void missingSecretFailsWithoutDevProfile() {
+        assertThrows(IllegalStateException.class, () -> JwtConfig.resolveSecret("", false));
+        assertThrows(IllegalStateException.class, () -> JwtConfig.resolveSecret(null, false));
+    }
+
+    @Test
+    void shortSecretFailsEvenInDevProfile() {
+        assertThrows(IllegalStateException.class, () -> JwtConfig.resolveSecret("short", false));
+        assertThrows(IllegalStateException.class, () -> JwtConfig.resolveSecret("short", true));
+    }
+
+    @Test
+    void validSecretIsUsed() {
+        assertEquals(32, JwtConfig.resolveSecret(VALID, false).length);
+    }
+
+    @Test
+    void devProfileAllowsRandomSecretWhenMissing() {
+        assertEquals(JwtConfig.MIN_SECRET_BYTES, JwtConfig.resolveSecret("", true).length);
+    }
+}
