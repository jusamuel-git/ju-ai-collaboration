@@ -0,0 +1,78 @@
+using System.Diagnostics;
+using System.Text.Json;
+
+namespace JuProvider.Client.Services;
+
+/*
+ * Client 실행 설정: {app}\config\client.json
+ *
+ * {
+ *   "ServerUrl": "http://localhost:8081/juprovider/",
+ *   "ClientId":  "서버 관리자 API로 등록한 CLIENT_ID",
+ *   "ClientKey": "등록/재발급 때 한 번만 표시된 키"
+ * }
+ *
+ * 파일이 없거나 읽지 못하면 기본 서버 주소만 사용한다 (Client 자격 없음 → 서버 동기화 실패 → OFFLINE).
+ * ClientKey는 비밀 값이므로 저장소에 올리지 않는다.
+ */
+public sealed class ClientSettings
+{
+    public const string DefaultServerUrl = "http://localhost:8081/juprovider/";
+
+    public static string SettingsPath =>
+        Path.Combine(
+            AppContext.BaseDirectory,
+            "config",
+            "client.json"
+        );
+
+    public string ServerUrl { get; set; } = DefaultServerUrl;
+
+    public string? ClientId { get; set; }
+
+    public string? ClientKey { get; set; }
+
+    public bool HasClientCredential =>
+        !string.IsNullOrWhiteSpace(ClientId)
+        && !string.IsNullOrWhiteSpace(ClientKey);
+
+    public static ClientSettings Load()
+    {
+        try
+        {
+            if (!File.Exists(SettingsPath))
+            {
+                return new ClientSettings();
+            }
+
+            ClientSettings? settings =
+                JsonSerializer.Deserialize<ClientSettings>(
+                    File.ReadAllText(SettingsPath),
+                    new JsonSerializerOptions
+                    {
+                        PropertyNameCaseInsensitive = true
+                    }
+                );
+
+            if (settings == null)
+            {
+                return new ClientSettings();
+            }
+
+            if (string.IsNullOrWhiteSpace(settings.ServerUrl))
+            {
+                settings.ServerUrl = DefaultServerUrl;
+            }
+
+            return settings;
+        }
+        catch (Exception ex)
+        {
+            Debug.WriteLine(
+                $"[CLIENT SETTINGS ERROR] {ex.Message}"
+            );
+
+            return new ClientSettings();
+        }
+    }
+}
