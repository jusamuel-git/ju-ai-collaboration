@@ -0,0 +1,42 @@
+-- ============================================================
+-- JU-1 인증/권한: 기존 설치 DB 보정
+-- 2026-10-25
+-- 04_ju0_install_fix.sql 다음에 실행한다. 여러 번 실행해도 결과가 같다.
+-- ============================================================
+SET NAMES utf8mb4;
+
+-- 1) Desktop Client 인증 테이블
+CREATE TABLE IF NOT EXISTS `ju_client` (
+  `CLIENT_ID` varchar(100) NOT NULL COMMENT 'Desktop Client 식별자',
+  `KEY_HASH` varchar(64) NOT NULL COMMENT 'Client 키 SHA-256 해시(16진). 키 원문은 저장하지 않음',
+  `USE_YN` varchar(8) NOT NULL DEFAULT 'YENO0001' COMMENT '사용여부 공통코드(YENO)',
+  `KEY_ISSUED_DT` datetime(3) NOT NULL DEFAULT current_timestamp(3) COMMENT '키 발급 일시',
+  `LAST_SEEN_DT` datetime(3) DEFAULT NULL COMMENT '마지막 인증 성공 일시',
+  `CREATED_DT` datetime(3) NOT NULL DEFAULT current_timestamp(3) COMMENT '등록 일시',
+  PRIMARY KEY (`CLIENT_ID`)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='Desktop Client 인증';
+
+CREATE TABLE IF NOT EXISTS `ju_client_detail` (
+  `CLIENT_ID` varchar(100) NOT NULL COMMENT 'Desktop Client 식별자',
+  `CLIENT_NM` varchar(100) NOT NULL COMMENT 'Client 표시명',
+  `CLIENT_DESC` varchar(500) DEFAULT NULL COMMENT 'Client 설명(설치 위치 등)',
+  PRIMARY KEY (`CLIENT_ID`),
+  CONSTRAINT `FK_CLIENT_DTL` FOREIGN KEY (`CLIENT_ID`) REFERENCES `ju_client` (`CLIENT_ID`) ON DELETE CASCADE
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='Desktop Client 표시정보';
+
+-- 2) AUTH_ATTR 형식 변환: 메뉴코드(9자리) → 메뉴코드 + 권한비트(16진 2자리)
+--    어드민(AUTH0001)은 FF(전체), 그 외는 01(조회). 이미 11자리인 항목은 바뀌지 않는다.
+--    (역참조 \1 뒤에 숫자가 바로 오지 않도록 임시 문자 ~를 거친다)
+UPDATE ju_auth
+   SET AUTH_ATTR = REPLACE(REGEXP_REPLACE(AUTH_ATTR, '"(M[0-9]{8})"', '"\\1~"'), '~"', 'FF"')
+ WHERE AUTH_TYPE = 'AUTH0001';
+
+UPDATE ju_auth
+   SET AUTH_ATTR = REPLACE(REGEXP_REPLACE(AUTH_ATTR, '"(M[0-9]{8})"', '"\\1~"'), '~"', '01"')
+ WHERE AUTH_TYPE <> 'AUTH0001';
+
+ALTER TABLE ju_auth
+  MODIFY `AUTH_ATTR` longtext DEFAULT NULL COMMENT '메뉴 권한 JSON 배열. 항목=메뉴코드(9)+권한비트(16진 2자리, MACT.COM_VAL)';
+
+-- 확인
+SELECT AUTH_ID, AUTH_TYPE, LEFT(AUTH_ATTR, 80) AS AUTH_ATTR_HEAD FROM ju_auth ORDER BY AUTH_ID;
