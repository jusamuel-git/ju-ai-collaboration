+package com.asdp.juprovider.security;
+
+import java.io.IOException;
+import java.util.List;
+
+import org.springframework.security.authentication.UsernamePasswordAuthenticationToken;
+import org.springframework.security.core.authority.SimpleGrantedAuthority;
+import org.springframework.security.core.context.SecurityContext;
+import org.springframework.security.core.context.SecurityContextHolder;
+import org.springframework.web.filter.OncePerRequestFilter;
+
+import com.asdp.juprovider.core.client.service.ClientService;
+
+import jakarta.servlet.FilterChain;
+import jakarta.servlet.ServletException;
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletResponse;
+
+/**
+ * Desktop Client 자격 인증.
+ *
+ * 요청 헤더 X-JU-Client-Id, X-JU-Client-Key를 ju_client와 대조한다.
+ * 성공하면 principal = CLIENT_ID, 권한 = CLIENT.
+ * 실패하면 인증 없이 다음 필터로 넘기고, 인가 단계에서 401이 된다.
+ *
+ * Spring Bean으로 등록하지 않는다 (서블릿 필터 자동 등록 방지). SecurityConfig에서 직접 생성한다.
+ */
+public class ClientKeyAuthenticationFilter extends OncePerRequestFilter {
+
+    public static final String HEADER_CLIENT_ID = "X-JU-Client-Id";
+    public static final String HEADER_CLIENT_KEY = "X-JU-Client-Key";
+    public static final String CLIENT_AUTHORITY = "CLIENT";
+
+    private final ClientService clientService;
+
+    public ClientKeyAuthenticationFilter(ClientService clientService) {
+        this.clientService = clientService;
+    }
+
+    @Override
+    protected void doFilterInternal(
+            HttpServletRequest request,
+            HttpServletResponse response,
+            FilterChain filterChain) throws ServletException, IOException {
+
+        String clientId = request.getHeader(HEADER_CLIENT_ID);
+        String clientKey = request.getHeader(HEADER_CLIENT_KEY);
+
+        if (clientId != null && clientKey != null
+                && clientService.verify(clientId.trim(), clientKey.trim())) {
+
+            UsernamePasswordAuthenticationToken authentication =
+                    UsernamePasswordAuthenticationToken.authenticated(
+                            clientId.trim(),
+                            null,
+                            List.of(new SimpleGrantedAuthority(CLIENT_AUTHORITY)));
+
+            SecurityContext context = SecurityContextHolder.createEmptyContext();
+            context.setAuthentication(authentication);
+            SecurityContextHolder.setContext(context);
+        }
+
+        filterChain.doFilter(request, response);
+    }
+}
