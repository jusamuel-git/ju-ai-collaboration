@@ -0,0 +1,107 @@
+package com.asdp.juprovider.core.security;
+
+import java.util.List;
+
+import org.springframework.stereotype.Service;
+
+import com.asdp.juprovider.core.menu.dto.Menu;
+import com.asdp.juprovider.core.menu.service.MenuService;
+import com.asdp.juprovider.core.security.dao.PermissionDao;
+import com.asdp.juprovider.core.security.dto.ActionPermission;
+
+/**
+ * 메뉴 표시 권한과 Menu Action 실행 권한 검사.
+ *
+ * 권한 데이터(ju_auth.AUTH_ATTR)는 매번 DB에서 읽는다.
+ * 권한을 바꾸면 다시 로그인하지 않아도 바로 적용된다.
+ */
+@Service
+public class PermissionService {
+
+    private final PermissionDao permissionDao;
+    private final MenuService menuService;
+
+    public PermissionService(
+            PermissionDao permissionDao,
+            MenuService menuService) {
+        this.permissionDao = permissionDao;
+        this.menuService = menuService;
+    }
+
+    public AuthorityAttribute getAuthority(Long authId) {
+        if (authId == null) {
+            throw new PermissionDeniedException("권한 정보가 없습니다.");
+        }
+
+        String authAttr = permissionDao.selectActiveAuthAttr(authId);
+
+        if (authAttr == null) {
+            throw new PermissionDeniedException("사용할 수 없는 권한입니다.");
+        }
+
+        return AuthorityAttribute.parse(authAttr);
+    }
+
+    /**
+     * Menu Action 실행 권한 검사.
+     * 권한 비트 & ACT_KIND 비트가 0이면 PermissionDeniedException.
+     */
+    public void checkAction(
+            ExecutionContext context,
+            Long menuId,
+            String actionCode) {
+
+        if (context == null || !context.hasUser()) {
+            throw new PermissionDeniedException("로그인 사용자만 실행할 수 있습니다.");
+        }
+
+        ActionPermission permission =
+                permissionDao.selectActionPermission(menuId, actionCode);
+
+        if (permission == null) {
+            throw new IllegalArgumentException(
+                    "사용할 수 없는 Menu Action입니다. "
+                            + "menuId=" + menuId
+                            + ", actionCode=" + actionCode);
+        }
+
+        int actionBit = parseBit(permission.getActionBit());
+
+        if (actionBit == 0) {
+            throw new PermissionDeniedException(
+                    "Action 종류의 권한 비트가 정의되지 않았습니다. ACT_KIND="
+                            + permission.getActionKind());
+        }
+
+        AuthorityAttribute authority = getAuthority(context.authId());
+
+        if (!authority.allows(permission.getMenuCode(), actionBit)) {
+            throw new PermissionDeniedException(
+                    "실행 권한이 없습니다. menu=" + permission.getMenuCode()
+                            + ", action=" + actionCode);
+        }
+    }
+
+    /** 권한에 포함된 메뉴만 반환한다. (사용·활성 메뉴 기준) */
+    public List<Menu> getPermittedMenus(
+            AuthorityAttribute authority,
+            String langCd) {
+
+        return menuService.getMenus(langCd)
+                .stream()
+                .filter(menu -> authority.hasMenu(menu.getMenuCode()))
+                .toList();
+    }
+
+    private static int parseBit(String value) {
+        if (value == null || value.isBlank()) {
+            return 0;
+        }
+
+        try {
+            return Integer.parseInt(value.trim(), 16);
+        } catch (NumberFormatException e) {
+            return 0;
+        }
+    }
+}
