+}
diff --git a/juprovider.core/src/main/resources/mapper/ClientMapper.xml b/juprovider.core/src/main/resources/mapper/ClientMapper.xml
new file mode 100644
index 0000000..e54fe56
--- /dev/null
+++ b/juprovider.core/src/main/resources/mapper/ClientMapper.xml
@@ -0,0 +1,105 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
+        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
+
+<mapper namespace="com.asdp.juprovider.core.client.dao.ClientDao">
+
+    <resultMap id="clientResultMap"
+               type="com.asdp.juprovider.core.client.dto.JuClient">
+        <id property="clientId" column="CLIENT_ID"/>
+        <result property="keyHash" column="KEY_HASH"/>
+        <result property="useYn" column="USE_YN"/>
+        <result property="keyIssuedAt" column="KEY_ISSUED_DT"/>
+        <result property="lastSeenAt" column="LAST_SEEN_DT"/>
+        <result property="createdAt" column="CREATED_DT"/>
+        <result property="clientName" column="CLIENT_NM"/>
+        <result property="clientDescription" column="CLIENT_DESC"/>
+    </resultMap>
+
+    <sql id="clientColumns">
+        c.CLIENT_ID,
+        c.KEY_HASH,
+        c.USE_YN,
+        c.KEY_ISSUED_DT,
+        c.LAST_SEEN_DT,
+        c.CREATED_DT,
+        d.CLIENT_NM,
+        d.CLIENT_DESC
+    </sql>
+
+    <select id="selectClient" resultMap="clientResultMap">
+        SELECT <include refid="clientColumns"/>
+          FROM ju_client c
+          LEFT JOIN ju_client_detail d
+            ON d.CLIENT_ID = c.CLIENT_ID
+         WHERE c.CLIENT_ID = #{clientId}
+    </select>
+
+    <select id="selectClients" resultMap="clientResultMap">
+        SELECT <include refid="clientColumns"/>
+          FROM ju_client c
+          LEFT JOIN ju_client_detail d
+            ON d.CLIENT_ID = c.CLIENT_ID
+         ORDER BY c.CLIENT_ID
+    </select>
+
+    <insert id="insertClient">
+        INSERT INTO ju_client (
+            CLIENT_ID,
+            KEY_HASH,
+            USE_YN,
+            KEY_ISSUED_DT
+        ) VALUES (
+            #{clientId},
+            #{keyHash},
+            'YENO0001',
+            CURRENT_TIMESTAMP(3)
+        )
+    </insert>
+
+    <insert id="upsertClientDetail">
+        INSERT INTO ju_client_detail (
+            CLIENT_ID,
+            CLIENT_NM,
+            CLIENT_DESC
+        ) VALUES (
+            #{clientId},
+            #{clientName},
+            #{clientDescription}
+        )
+        ON DUPLICATE KEY UPDATE
+            CLIENT_NM = VALUES(CLIENT_NM),
+            CLIENT_DESC = VALUES(CLIENT_DESC)
+    </insert>
+
+    <!-- 키 재발급: 사용 중인 Client만. USE_YN은 바꾸지 않는다 -->
+    <update id="updateClientKey">
+        UPDATE ju_client
+           SET KEY_HASH = #{keyHash},
+               KEY_ISSUED_DT = CURRENT_TIMESTAMP(3)
+         WHERE CLIENT_ID = #{clientId}
+           AND USE_YN = 'YENO0001'
+    </update>
+
+    <!-- 명시적 재등록: 사용 중지된 Client를 새 키로 다시 사용 -->
+    <update id="reactivateClient">
+        UPDATE ju_client
+           SET KEY_HASH = #{keyHash},
+               KEY_ISSUED_DT = CURRENT_TIMESTAMP(3),
+               USE_YN = 'YENO0001'
+         WHERE CLIENT_ID = #{clientId}
+    </update>
+
+    <update id="updateUseYn">
+        UPDATE ju_client
+           SET USE_YN = #{useYn}
+         WHERE CLIENT_ID = #{clientId}
+    </update>
+
+    <update id="updateLastSeen">
+        UPDATE ju_client
+           SET LAST_SEEN_DT = CURRENT_TIMESTAMP(3)
+         WHERE CLIENT_ID = #{clientId}
+    </update>
+
+</mapper>
diff --git a/juprovider.core/src/main/resources/mapper/PermissionMapper.xml b/juprovider.core/src/main/resources/mapper/PermissionMapper.xml
new file mode 100644
index 0000000..80efb4e
--- /dev/null
+++ b/juprovider.core/src/main/resources/mapper/PermissionMapper.xml
@@ -0,0 +1,34 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
+        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
+
+<mapper namespace="com.asdp.juprovider.core.security.dao.PermissionDao">
+
+    <select id="selectActiveAuthAttr" resultType="java.lang.String">
+        SELECT a.AUTH_ATTR
+          FROM ju_auth a
+         WHERE a.AUTH_ID = #{authId}
+           AND a.USE_YN = 'YENO0001'
+    </select>
+
+    <select id="selectActionPermission"
+            resultType="com.asdp.juprovider.core.security.dto.ActionPermission">
+        SELECT m.MNU_CD   AS menuCode,
+               a.ACT_KIND AS actionKind,
+               c.COM_VAL  AS actionBit
+          FROM ju_menu_action a
+          JOIN ju_menu m
+            ON m.MNU_ID = a.MNU_ID
+           AND m.USE_YN = 'YENO0001'
+           AND m.ENABLED_YN = 'YENO0001'
+          LEFT JOIN ju_com_code c
+            ON c.GRP_CD = 'MACT'
+           AND c.COM_CD = a.ACT_KIND
+           AND c.USE_YN = 'YENO0001'
+         WHERE a.MNU_ID = #{menuId}
+           AND a.ACT_CD = #{actionCode}
+           AND a.USE_YN = 'YENO0001'
+           AND a.ENABLED_YN = 'YENO0001'
+    </select>
+
+</mapper>
