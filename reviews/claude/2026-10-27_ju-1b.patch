+package com.asdp.juprovider.security;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import org.junit.jupiter.api.Test;
+
+import com.asdp.juprovider.core.security.AuthorityAttribute;
+
+/** AUTH_ATTR 해석 (JU-1B) */
+class AuthorityAttributeTest {
+
+    @Test
+    void parsesElevenDigitItemsWithBits() {
+        AuthorityAttribute a = AuthorityAttribute.parse("[\"M01000000FF\",\"M0201000001\"]");
+        assertEquals(0xFF, a.bitsOf("M01000000"));
+        assertEquals(0x01, a.bitsOf("M02010000"));
+        assertTrue(a.allows("M02010000", 0x01));
+        assertFalse(a.allows("M02010000", 0x02));
+    }
+
+    @Test
+    void legacyNineDigitItemIsMenuOnly() {
+        AuthorityAttribute a = AuthorityAttribute.parse("[\"M03000000\"]");
+        assertTrue(a.hasMenu("M03000000"));
+        assertEquals(0, a.bitsOf("M03000000"));
+        assertFalse(a.allows("M03000000", 0x01));
+    }
+
+    @Test
+    void duplicateMenusMergeBits() {
+        AuthorityAttribute a = AuthorityAttribute.parse("[\"M0201000001\",\"M0201000004\"]");
+        assertEquals(0x05, a.bitsOf("M02010000"));
+    }
+
+    @Test
+    void unknownMenuAndZeroBitAreDenied() {
+        AuthorityAttribute a = AuthorityAttribute.parse("[\"M01000000FF\"]");
+        assertFalse(a.allows("M09000000", 0x01));
+        assertFalse(a.allows("M01000000", 0));
+        assertFalse(AuthorityAttribute.parse(null).hasMenu("M01000000"));
+    }
+}
