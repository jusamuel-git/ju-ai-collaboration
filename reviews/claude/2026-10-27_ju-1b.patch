+package com.asdp.juprovider.core.security.dto;
+
+/**
+ * Menu Action 실행 권한 판단 정보.
+ *
+ * actionBit: ACT_KIND(MACT) 공통코드의 COM_VAL (16진 문자열)
+ */
+public class ActionPermission {
+
+    private String menuCode;
+    private String actionKind;
+    private String actionBit;
+
