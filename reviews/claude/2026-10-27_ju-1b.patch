+package com.asdp.juprovider.core.client.dto;
+
+import java.time.LocalDateTime;
+
+/**
+ * Desktop Client 등록 정보 (ju_client + ju_client_detail).
+ * keyHash는 Client 키의 SHA-256 16진 문자열이다. 키 원문은 저장하지 않는다.
+ */
+public class JuClient {
+
+    private String clientId;
+    private String keyHash;
+    private String useYn;
+    private LocalDateTime keyIssuedAt;
+    private LocalDateTime lastSeenAt;
+    private LocalDateTime createdAt;
+    private String clientName;
+    private String clientDescription;
+
+    public String getClientId() {
+        return clientId;
+    }
+
+    public void setClientId(String clientId) {
+        this.clientId = clientId;
+    }
+
+    public String getKeyHash() {
+        return keyHash;
+    }
+
+    public void setKeyHash(String keyHash) {
+        this.keyHash = keyHash;
+    }
+
+    public String getUseYn() {
+        return useYn;
+    }
+
+    public void setUseYn(String useYn) {
+        this.useYn = useYn;
+    }
+
+    public LocalDateTime getKeyIssuedAt() {
+        return keyIssuedAt;
+    }
+
+    public void setKeyIssuedAt(LocalDateTime keyIssuedAt) {
+        this.keyIssuedAt = keyIssuedAt;
+    }
+
+    public LocalDateTime getLastSeenAt() {
+        return lastSeenAt;
+    }
+
+    public void setLastSeenAt(LocalDateTime lastSeenAt) {
+        this.lastSeenAt = lastSeenAt;
+    }
+
+    public LocalDateTime getCreatedAt() {
+        return createdAt;
+    }
+
+    public void setCreatedAt(LocalDateTime createdAt) {
+        this.createdAt = createdAt;
+    }
+
+    public String getClientName() {
+        return clientName;
+    }
+
+    public void setClientName(String clientName) {
+        this.clientName = clientName;
+    }
+
+    public String getClientDescription() {
+        return clientDescription;
+    }
+
+    public void setClientDescription(String clientDescription) {
+        this.clientDescription = clientDescription;
+    }
+}
diff --git a/juprovider.core/src/main/java/com/asdp/juprovider/core/client/service/ClientService.java b/juprovider.core/src/main/java/com/asdp/juprovider/core/client/service/ClientService.java
new file mode 100644
index 0000000..fc01f92
--- /dev/null
+++ b/juprovider.core/src/main/java/com/asdp/juprovider/core/client/service/ClientService.java
@@ -0,0 +1,157 @@
+package com.asdp.juprovider.core.client.service;
+
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.security.SecureRandom;
+import java.util.Base64;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.regex.Pattern;
+
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.asdp.juprovider.core.client.dao.ClientDao;
+import com.asdp.juprovider.core.client.dto.IssuedClientKey;
+import com.asdp.juprovider.core.client.dto.JuClient;
+
+/**
+ * Desktop Client 등록과 Client 키 검증.
+ *
+ * - 키는 서버가 만든 32바이트 난수(Base64URL)이고, DB에는 SHA-256 해시만 저장한다.
+ * - 키 원문은 발급/재발급 응답에서 한 번만 돌려준다.
+ * - 삭제는 논리 삭제(USE_YN=YENO0002). 사용 중지된 Client는 같은 CLIENT_ID로 명시적으로 다시 등록할 때만
+ *   새 키로 재활성화한다. 키 재발급은 사용 중인 Client만 가능하다.
+ */
+@Service
+public class ClientService {
+
+    private static final String USE_YES = "YENO0001";
+    private static final String USE_NO = "YENO0002";
+
+    private static final Pattern CLIENT_ID_PATTERN =
+            Pattern.compile("^[A-Za-z0-9_.-]{1,100}$");
+
+    private final ClientDao clientDao;
+    private final SecureRandom secureRandom = new SecureRandom();
+
+    public ClientService(ClientDao clientDao) {
+        this.clientDao = clientDao;
+    }
+
+    public List<JuClient> getClients() {
+        return clientDao.selectClients();
+    }
+
+    @Transactional
+    public IssuedClientKey register(
+            String clientId,
+            String clientName,
+            String clientDescription) {
+
+        String id = normalizeClientId(clientId);
+        JuClient existing = clientDao.selectClient(id);
+
+        if (existing != null && USE_YES.equals(existing.getUseYn())) {
+            throw new IllegalArgumentException("이미 등록된 Client입니다: " + id);
+        }
+
+        String key = newKey();
+
+        if (existing == null) {
+            clientDao.insertClient(id, hash(key));
+        } else {
+            clientDao.reactivateClient(id, hash(key));
+        }
+
+        clientDao.upsertClientDetail(
+                id,
+                clientName == null || clientName.isBlank() ? id : clientName.trim(),
+                clientDescription);
+
+        return new IssuedClientKey(id, key);
+    }
+
+    @Transactional
+    public IssuedClientKey reissueKey(String clientId) {
+        String id = normalizeClientId(clientId);
+        JuClient existing = clientDao.selectClient(id);
+
+        if (existing == null) {
+            throw new IllegalArgumentException("등록되지 않은 Client입니다: " + id);
+        }
+
+        if (!USE_YES.equals(existing.getUseYn())) {
+            throw new IllegalArgumentException(
+                    "사용 중지된 Client입니다. 다시 사용하려면 재등록하세요: " + id);
+        }
+        String key = newKey();
+        if (clientDao.updateClientKey(id, hash(key)) == 0) {
+            throw new IllegalArgumentException(
+                    "사용 중지된 Client입니다. 다시 사용하려면 재등록하세요: " + id);
+        }
+        return new IssuedClientKey(id, key);
+    }
+
+    @Transactional
+    public void disable(String clientId) {
+        String id = normalizeClientId(clientId);
+
+        if (clientDao.updateUseYn(id, USE_NO) == 0) {
+            throw new IllegalArgumentException("등록되지 않은 Client입니다: " + id);
+        }
+    }
+
+    /**
+     * Client 키 검증. 성공하면 마지막 접속 일시를 갱신한다.
+     */
+    @Transactional
+    public boolean verify(String clientId, String clientKey) {
+        if (clientId == null || clientKey == null
+                || !CLIENT_ID_PATTERN.matcher(clientId).matches()) {
+            return false;
+        }
+
+        JuClient client = clientDao.selectClient(clientId);
+
+        if (client == null || !USE_YES.equals(client.getUseYn())
+                || client.getKeyHash() == null) {
+            return false;
+        }
+
+        boolean matched = MessageDigest.isEqual(
+                client.getKeyHash().getBytes(StandardCharsets.US_ASCII),
+                hash(clientKey).getBytes(StandardCharsets.US_ASCII));
+
+        if (matched) {
+            clientDao.updateLastSeen(clientId);
+        }
+
+        return matched;
+    }
+
+    private static String normalizeClientId(String clientId) {
+        if (clientId == null || !CLIENT_ID_PATTERN.matcher(clientId.trim()).matches()) {
+            throw new IllegalArgumentException(
+                    "CLIENT_ID는 영문, 숫자, _ . - 로 1~100자여야 합니다.");
+        }
+        return clientId.trim();
+    }
+
+    private String newKey() {
+        byte[] bytes = new byte[32];
+        secureRandom.nextBytes(bytes);
+        return Base64.getUrlEncoder().withoutPadding().encodeToString(bytes);
+    }
+
+    private static String hash(String value) {
+        try {
+            MessageDigest digest = MessageDigest.getInstance("SHA-256");
+            return HexFormat.of().formatHex(
+                    digest.digest(value.getBytes(StandardCharsets.UTF_8)));
+        } catch (NoSuchAlgorithmException e) {
+            throw new IllegalStateException("SHA-256을 사용할 수 없습니다.", e);
+        }
+    }
+}
diff --git a/juprovider.core/src/main/java/com/asdp/juprovider/core/security/AuthorityAttribute.java b/juprovider.core/src/main/java/com/asdp/juprovider/core/security/AuthorityAttribute.java
new file mode 100644
index 0000000..a4b1224
--- /dev/null
+++ b/juprovider.core/src/main/java/com/asdp/juprovider/core/security/AuthorityAttribute.java
@@ -0,0 +1,86 @@
+package com.asdp.juprovider.core.security;
+
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * ju_auth.AUTH_ATTR 해석.
+ *
+ * 형식: 문자열 JSON 배열. 항목 = 메뉴코드(9자리) + 권한 비트(16진 2자리)
+ *   예) ["M01000000FF", "M0201020001"]
+ *
+ * - 비트 값은 공통코드 MACT의 COM_VAL (조회 01, 등록 02, 수정 04, 삭제 08, 실행 10, 내보내기 20)
+ * - 비트가 없는 9자리 항목은 "메뉴 표시만 허용"(비트 0)으로 본다.
+ * - 같은 메뉴가 여러 번 나오면 비트를 합친다.
+ */
+public final class AuthorityAttribute {
+
+    private static final Pattern ITEM = Pattern.compile("\"([^\"]+)\"");
+
+    private static final Pattern MENU_WITH_BITS =
+            Pattern.compile("^(M[0-9]{8})([0-9A-Fa-f]{2})$");
+
+    private final Map<String, Integer> menuBits;
+
+    private AuthorityAttribute(Map<String, Integer> menuBits) {
+        this.menuBits = Collections.unmodifiableMap(menuBits);
+    }
+
+    public static AuthorityAttribute parse(String authAttr) {
+        Map<String, Integer> result = new LinkedHashMap<>();
+
+        if (authAttr != null) {
+            Matcher matcher = ITEM.matcher(authAttr);
+
+            while (matcher.find()) {
+                String item = matcher.group(1).trim();
+
+                if (item.isEmpty()) {
+                    continue;
+                }
+
+                Matcher withBits = MENU_WITH_BITS.matcher(item);
+
+                String menuCode;
+                int bits;
+
+                if (withBits.matches()) {
+                    menuCode = withBits.group(1);
+                    bits = Integer.parseInt(withBits.group(2), 16);
+                } else {
+                    menuCode = item;
+                    bits = 0;
+                }
+
+                result.merge(menuCode, bits, (a, b) -> a | b);
+            }
+        }
+
+        return new AuthorityAttribute(result);
+    }
+
+    public boolean hasMenu(String menuCode) {
+        return menuCode != null && menuBits.containsKey(menuCode);
+    }
+
+    public int bitsOf(String menuCode) {
+        Integer bits = menuCode == null ? null : menuBits.get(menuCode);
+        return bits == null ? 0 : bits;
+    }
+
+    public boolean allows(String menuCode, int actionBit) {
+        return actionBit != 0 && (bitsOf(menuCode) & actionBit) != 0;
+    }
+
+    public Map<String, Integer> menuBits() {
+        return menuBits;
+    }
+
+    /** 비트를 16진 2자리 문자열로 표시 (예: 15 -> "0F") */
+    public static String toHex(int bits) {
+        return String.format("%02X", bits & 0xFF);
+    }
+}
diff --git a/juprovider.core/src/main/java/com/asdp/juprovider/core/security/PermissionDeniedException.java b/juprovider.core/src/main/java/com/asdp/juprovider/core/security/PermissionDeniedException.java
