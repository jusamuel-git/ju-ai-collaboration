+namespace JuProvider.Lib.Protocol.Framing;
+
+/// <summary>완성된 프레임. Raw = 받은 바이트 그대로, Body = 규칙에 따른 내용 (FrameRule 설명 참고)</summary>
+public sealed record Frame(byte[] Raw, byte[] Body);
+
+/// <summary>버린 바이트와 사유 (Traffic 로그용)</summary>
+public sealed record FrameRejection(string Reason, byte[] Data);
+
+/// <summary>바이트 조각 → 완성 프레임. 조각을 여러 번 나눠 넣어도 결과가 같아야 한다.</summary>
+public interface IFramer
+{
+    /// <summary>새 바이트를 넣고 완성된 프레임을 꺼낸다. 미완성 부분은 내부 버퍼에 남는다.</summary>
+    IReadOnlyList<Frame> Push(ReadOnlySpan<byte> chunk);
+
+    /// <summary>버린 데이터 (Push 호출마다 새로 채워짐)</summary>
+    IReadOnlyList<FrameRejection> Rejections { get; }
+
+    /// <summary>미완성 버퍼 비우기 (재연결 등)</summary>
+    void Reset();
+
+    /// <summary>현재 버퍼에 남은 바이트 수</summary>
+    int Pending { get; }
+}
diff --git a/desktop/lib/juprovider.lib.protocol/Framing/FramerBase.cs b/desktop/lib/juprovider.lib.protocol/Framing/FramerBase.cs
new file mode 100644
index 0000000..939abcc
--- /dev/null
+++ b/desktop/lib/juprovider.lib.protocol/Framing/FramerBase.cs
@@ -0,0 +1,79 @@
+using JuProvider.Lib.Protocol.Rules;
+
+namespace JuProvider.Lib.Protocol.Framing;
+
+/// <summary>버퍼·거부 목록·최대 길이·체크섬 공통 처리</summary>
+public abstract class FramerBase : IFramer
+{
+    protected readonly FrameRule Rule;
+    protected readonly List<byte> Buffer = new();
+    private readonly List<FrameRejection> _rejections = new();
+
+    protected FramerBase(FrameRule rule) => Rule = rule;
+
+    public IReadOnlyList<FrameRejection> Rejections => _rejections;
+    public int Pending => Buffer.Count;
+
+    public void Reset() => Buffer.Clear();
+
+    public IReadOnlyList<Frame> Push(ReadOnlySpan<byte> chunk)
+    {
+        _rejections.Clear();
+        foreach (byte b in chunk) Buffer.Add(b);
+
+        var frames = new List<Frame>();
+        while (TryTake(out Frame? frame))
+        {
+            if (frame is null) continue;
+            if (ApplyChecksum(frame, out Frame? ok)) frames.Add(ok!);
+        }
+
+        if (Buffer.Count > Rule.MaxLength)
+        {
+            Reject("최대 길이 초과", Buffer.ToArray());
+            Buffer.Clear();
+        }
+
+        return frames;
+    }
+
+    /// <summary>버퍼에서 프레임 1개를 꺼낸다. 더 꺼낼 게 없으면 false. 꺼냈지만 버린 경우 true + frame=null.</summary>
+    protected abstract bool TryTake(out Frame? frame);
+
+    protected void Reject(string reason, byte[] data) => _rejections.Add(new FrameRejection(reason, data));
+
+    protected byte[] TakeFront(int count)
+    {
+        byte[] taken = Buffer.GetRange(0, count).ToArray();
+        Buffer.RemoveRange(0, count);
+        return taken;
+    }
+
+    private bool ApplyChecksum(Frame frame, out Frame? result)
+    {
+        ChecksumRule c = Rule.Checksum;
+        result = frame;
+        if (c.Type == ChecksumType.None) return true;
+
+        byte[] body = frame.Body;
+        int size = c.Size;
+        if (body.Length < c.From + size)
+        {
+            Reject("체크섬 길이 부족", frame.Raw);
+            result = null;
+            return false;
+        }
+
+        ReadOnlySpan<byte> covered = body.AsSpan(c.From, body.Length - size - c.From);
+        ReadOnlySpan<byte> actual = body.AsSpan(body.Length - size, size);
+        if (!Checksum.Verify(c.Type, covered, actual))
+        {
+            Reject("체크섬 불일치", frame.Raw);
+            result = null;
+            return false;
+        }
+
+        result = frame with { Body = body[..^size] };
+        return true;
+    }
+}
diff --git a/desktop/lib/juprovider.lib.protocol/Framing/Framers.cs b/desktop/lib/juprovider.lib.protocol/Framing/Framers.cs
new file mode 100644
index 0000000..75c2ae2
--- /dev/null
+++ b/desktop/lib/juprovider.lib.protocol/Framing/Framers.cs
@@ -0,0 +1,139 @@
+using JuProvider.Lib.Protocol.Rules;
+
+namespace JuProvider.Lib.Protocol.Framing;
+
+/// <summary>끝 구분자. Body = 구분자 앞부분. 빈 프레임은 건너뜀.</summary>
+public sealed class DelimiterFramer(FrameRule rule) : FramerBase(rule)
+{
+    protected override bool TryTake(out Frame? frame)
+    {
+        frame = null;
+        byte[] end = Rule.End;
+        int at = IndexOf(Buffer, end);
+        if (at < 0) return false;
+
+        byte[] raw = TakeFront(at + end.Length);
+        byte[] body = raw[..at];
+        if (body.Length > 0) frame = new Frame(raw, body);
+        return true;
+    }
+
+    private static int IndexOf(List<byte> buffer, byte[] pattern)
+    {
+        for (int i = 0; i <= buffer.Count - pattern.Length; i++)
+        {
+            int j = 0;
+            while (j < pattern.Length && buffer[i + j] == pattern[j]) j++;
+            if (j == pattern.Length) return i;
+        }
+        return -1;
+    }
+}
+
+/// <summary>
+/// 시작·끝 바이트. STX 앞의 바이트는 버림(거부 기록). Escape가 있으면 다음 1바이트를 그대로 내용으로 본다.
+/// Body = STX/ETX 제외, escape 해제된 내용.
+/// </summary>
+public sealed class StxEtxFramer(FrameRule rule) : FramerBase(rule)
+{
+    protected override bool TryTake(out Frame? frame)
+    {
+        frame = null;
+        if (Buffer.Count == 0) return false;
+
+        int start = Buffer.IndexOf(Rule.Stx);
+        if (start < 0)
+        {
+            Reject("STX 없음", TakeFront(Buffer.Count));
+            return false;
+        }
+        if (start > 0)
+        {
+            Reject("STX 앞 데이터", TakeFront(start));
+        }
+
+        var body = new List<byte>();
+        for (int i = 1; i < Buffer.Count; i++)
+        {
+            byte b = Buffer[i];
+            if (Rule.Escape is byte esc && b == esc)
+            {
+                if (i + 1 >= Buffer.Count) return false; // escape 다음 바이트 대기
+                body.Add(Buffer[++i]);
+                continue;
+            }
+            if (b == Rule.Etx)
+            {
+                byte[] raw = TakeFront(i + 1);
+                frame = new Frame(raw, body.ToArray());
+                return true;
+            }
+            if (b == Rule.Stx && Rule.Escape is null)
+            {
+                // ETX 없이 새 STX → 앞 프레임은 깨진 것으로 보고 버림
+                Reject("ETX 없이 새 STX", TakeFront(i));
+                return true;
+            }
+            body.Add(b);
+        }
+        return false;
+    }
+}
+
+/// <summary>고정 길이. Body = 프레임 전체.</summary>
+public sealed class FixedLengthFramer(FrameRule rule) : FramerBase(rule)
+{
+    protected override bool TryTake(out Frame? frame)
+    {
+        frame = null;
+        if (Buffer.Count < Rule.Length) return false;
+        byte[] raw = TakeFront(Rule.Length);
+        frame = new Frame(raw, raw);
+        return true;
+    }
+}
+
+/// <summary>
+/// 길이 필드. 전체 길이 = 헤더 포함이면 값+adjust, 아니면 (offset+size)+값+adjust.
+/// Body = 프레임 전체. 길이가 잘못되면(헤더보다 짧거나 MaxLength 초과) 1바이트 버리고 다시 찾는다.
+/// </summary>
+public sealed class LengthFieldFramer(FrameRule rule) : FramerBase(rule)
+{
+    protected override bool TryTake(out Frame? frame)
+    {
+        frame = null;
+        int header = Rule.LengthOffset + Rule.LengthSize;
+        if (Buffer.Count < header) return false;
+
+        long value = 0;
+        for (int k = 0; k < Rule.LengthSize; k++)
+        {
+            int idx = Rule.LengthBigEndian ? Rule.LengthOffset + k : Rule.LengthOffset + Rule.LengthSize - 1 - k;
+            value = (value << 8) | Buffer[idx];
+        }
+
+        long total = (Rule.LengthIncludesHeader ? value : header + value) + Rule.LengthAdjust;
+        if (total < header || total > Rule.MaxLength)
+        {
+            Reject("길이 필드 값 오류", TakeFront(1));
+            return true;
+        }
+        if (Buffer.Count < total) return false;
+
+        byte[] raw = TakeFront((int)total);
+        frame = new Frame(raw, raw);
+        return true;
+    }
+}
+
+public static class FramerFactory
+{
+    public static IFramer Create(FrameRule rule) => rule.Kind switch
+    {
+        FrameKind.Delim => new DelimiterFramer(rule),
+        FrameKind.StxEtx => new StxEtxFramer(rule),
+        FrameKind.Fixed => new FixedLengthFramer(rule),
+        FrameKind.LenField => new LengthFieldFramer(rule),
+        _ => throw new ArgumentOutOfRangeException(nameof(rule))
+    };
+}
diff --git a/desktop/lib/juprovider.lib.protocol/Parsing/Parsers.cs b/desktop/lib/juprovider.lib.protocol/Parsing/Parsers.cs
