+package com.asdp.juprovider.action;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.math.BigDecimal;
+import java.time.LocalDateTime;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+import org.junit.jupiter.api.Test;
+
+import com.asdp.juprovider.core.action.contract.ActionContract;
+import com.asdp.juprovider.core.action.contract.ActionFieldError;
+import com.asdp.juprovider.core.action.contract.ActionInput;
+import com.asdp.juprovider.core.action.contract.ActionInputValidator;
+import com.asdp.juprovider.core.action.contract.FieldSpec;
+import com.asdp.juprovider.core.action.contract.OutputKind;
+import com.asdp.juprovider.core.action.exception.ActionValidationException;
+
+class ActionInputValidatorTest {
+
+    private final ActionInputValidator validator =
+            new ActionInputValidator(grp -> "PROT".equals(grp) ? Set.of("PROT0000", "PROT0001") : Set.of());
+
+    private final ActionContract contract = ActionContract.of(
+            1,
+            OutputKind.KEY,
+            List.of(
+                    FieldSpec.string("ptlGrpCd", true, 20),
+                    FieldSpec.string("ptlNm", false, 5),
+                    FieldSpec.code("ptlType", false, "PROT"),
+                    FieldSpec.integer("ptlLen", false),
+                    FieldSpec.decimal("ratio", false),
+                    FieldSpec.bool("flag", false),
+                    FieldSpec.datetime("at", false),
+                    FieldSpec.object("opt", false, List.of(FieldSpec.string("k", true, 10))),
+                    FieldSpec.listOf("packets", false, List.of(
+                            FieldSpec.integer("packetSeq", true),
+                            FieldSpec.string("direction", true, 10)))),
+            null);
+
+    private static Map<String, Object> map(Object... kv) {
+        Map<String, Object> m = new LinkedHashMap<>();
+        for (int i = 0; i < kv.length; i += 2) {
+            m.put((String) kv[i], kv[i + 1]);
+        }
+        return m;
+    }
+
+    private List<ActionFieldError> errors(Map<String, Object> params) {
+        return assertThrows(ActionValidationException.class, () -> validator.validate(contract, params)).getErrors();
+    }
+
+    private static boolean has(List<ActionFieldError> errors, String field, String code) {
+        return errors.stream().anyMatch(e -> e.field().equals(field) && e.code().equals(code));
+    }
+
+    @Test
+    void validInputIsConvertedToDeclaredTypes() {
+        ActionInput input = validator.validate(contract, map(
+                "ptlGrpCd", "GTEC",
+                "ptlType", "PROT0001",
+                "ptlLen", 12,
+                "ratio", 0.5,
+                "flag", true,
+                "at", "2026-10-27T16:00:00",
+                "opt", map("k", "v"),
+                "packets", List.of(map("packetSeq", 1, "direction", "TX"))));
+
+        assertEquals("GTEC", input.getString("ptlGrpCd"));
+        assertEquals(12L, input.getLong("ptlLen"));
+        assertEquals(new BigDecimal("0.5"), input.getDecimal("ratio"));
+        assertEquals(Boolean.TRUE, input.getBoolean("flag"));
+        assertEquals(LocalDateTime.of(2026, 10, 27, 16, 0), input.getDateTime("at"));
+        assertEquals("v", input.getObject("opt").getString("k"));
+        assertEquals(1L, input.getObjectList("packets").get(0).getLong("packetSeq"));
+        assertTrue(!input.has("ptlNm"));
+    }
+
+    @Test
+    void requiredMissingOrBlank() {
+        assertTrue(has(errors(map()), "ptlGrpCd", ActionFieldError.REQUIRED));
+        assertTrue(has(errors(map("ptlGrpCd", "  ")), "ptlGrpCd", ActionFieldError.REQUIRED));
+    }
+
+    @Test
+    void unknownFieldIsRejectedIncludingNested() {
+        List<ActionFieldError> e = errors(map(
+                "ptlGrpCd", "GTEC",
+                "extra", 1,
+                "opt", map("k", "v", "x", 1),
+                "packets", List.of(map("packetSeq", 1, "direction", "TX", "y", 2))));
+        assertTrue(has(e, "extra", ActionFieldError.UNKNOWN_FIELD));
+        assertTrue(has(e, "opt.x", ActionFieldError.UNKNOWN_FIELD));
+        assertTrue(has(e, "packets[0].y", ActionFieldError.UNKNOWN_FIELD));
+    }
+
+    @Test
+    void typeMismatchLengthAndCode() {
+        List<ActionFieldError> e = errors(map(
+                "ptlGrpCd", 10,
+                "ptlNm", "123456",
+                "ptlType", "PROT9999",
+                "ptlLen", "12",
+                "flag", "true",
+                "at", "not-a-date",
+                "packets", List.of(map("packetSeq", 1.5))));
+        assertTrue(has(e, "ptlGrpCd", ActionFieldError.TYPE_MISMATCH));
+        assertTrue(has(e, "ptlNm", ActionFieldError.MAX_LENGTH));
+        assertTrue(has(e, "ptlType", ActionFieldError.INVALID_CODE));
+        assertTrue(has(e, "ptlLen", ActionFieldError.TYPE_MISMATCH));
+        assertTrue(has(e, "flag", ActionFieldError.TYPE_MISMATCH));
+        assertTrue(has(e, "at", ActionFieldError.TYPE_MISMATCH));
+        assertTrue(has(e, "packets[0].packetSeq", ActionFieldError.TYPE_MISMATCH));
+        assertTrue(has(e, "packets[0].direction", ActionFieldError.REQUIRED));
+    }
+}
