+package com.asdp.juprovider.core.action.exception;
+
+import java.util.List;
+
+import com.asdp.juprovider.core.action.contract.ActionFieldError;
+
+/**
+ * Action 오류 계약 (결정 AC5)
+ * status : HTTP 상태, code : 응답 code, errors : 필드 오류 목록
+ */
+public abstract class ActionException extends RuntimeException {
+
+    private final int status;
+
+    private final String code;
+
+    private final List<ActionFieldError> errors;
+
+    protected ActionException(
+            int status,
+            String code,
+            String message,
+            List<ActionFieldError> errors) {
+        super(message);
+        this.status = status;
+        this.code = code;
+        this.errors = errors == null ? List.of() : List.copyOf(errors);
+    }
+
+    public int getStatus() {
+        return status;
+    }
+
+    public String getCode() {
+        return code;
+    }
+
+    public List<ActionFieldError> getErrors() {
+        return errors;
+    }
+}
