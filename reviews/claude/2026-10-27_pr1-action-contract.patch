+package com.asdp.juprovider.config;
+
+import java.util.List;
+import java.util.stream.Collectors;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.boot.context.event.ApplicationReadyEvent;
+import org.springframework.context.event.EventListener;
+import org.springframework.stereotype.Component;
+
+import com.asdp.juprovider.core.action.service.DynamicActionService;
+import com.asdp.juprovider.core.menu.dto.MenuAction;
+
+/**
+ * 기동 시 DB 활성 Action의 HANDLER_ID ↔ 코드 Handler 정합성 검사 (결정 AC7)
+ * 불일치는 기동을 막지 않고 WARN으로 남긴다. 해당 Action 호출은 501.
+ */
+@Component
+public class ActionHandlerConsistencyCheck {
+
+    private static final Logger log = LoggerFactory.getLogger(ActionHandlerConsistencyCheck.class);
+
+    private final DynamicActionService dynamicActionService;
+
+    public ActionHandlerConsistencyCheck(DynamicActionService dynamicActionService) {
+        this.dynamicActionService = dynamicActionService;
+    }
+
+    @EventListener(ApplicationReadyEvent.class)
+    public void check() {
+        try {
+            List<MenuAction> missing = dynamicActionService.findActionsWithoutHandler();
+
+            if (missing.isEmpty()) {
+                log.info("[ACTION] 모든 활성 Menu Action에 Handler가 있습니다.");
+                return;
+            }
+
+            log.warn("[ACTION] Handler가 없는 활성 Menu Action {}건 (호출 시 501): {}",
+                    missing.size(),
+                    missing.stream()
+                            .map(a -> a.getMenuId() + "/" + a.getActionCode() + "=" + a.getHandlerId())
+                            .collect(Collectors.joining(", ")));
+        } catch (RuntimeException e) {
+            log.warn("[ACTION] Handler 정합성 검사 실패: {}", e.getMessage());
+        }
+    }
+}
