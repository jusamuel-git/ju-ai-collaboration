+package com.asdp.juprovider.core.action.contract;
+
+import java.math.BigDecimal;
+import java.time.LocalDateTime;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * 계약 검증을 통과한 입력. 값은 선언된 형으로 변환되어 있다.
+ *
+ * STRING/CODE → String, INTEGER → Long, DECIMAL → BigDecimal, BOOLEAN → Boolean,
+ * DATETIME → LocalDateTime, OBJECT → ActionInput, LIST → List (원소도 같은 규칙)
+ * 입력하지 않은(또는 null) 선택 필드는 포함되지 않는다.
+ */
+public final class ActionInput {
+
+    private final Map<String, Object> values;
+
+    public ActionInput(Map<String, Object> values) {
+        this.values = values == null
+                ? Collections.emptyMap()
+                : Collections.unmodifiableMap(new LinkedHashMap<>(values));
+    }
+
+    public static ActionInput empty() {
+        return new ActionInput(null);
+    }
+
+    public boolean has(String name) {
+        return values.containsKey(name);
+    }
+
+    public Map<String, Object> asMap() {
+        return values;
+    }
+
+    public String getString(String name) {
+        Object value = values.get(name);
+        return value == null ? null : value.toString();
+    }
+
+    public Long getLong(String name) {
+        return (Long) values.get(name);
+    }
+
+    public Integer getInteger(String name) {
+        Long value = getLong(name);
+        return value == null ? null : Math.toIntExact(value);
+    }
+
+    public BigDecimal getDecimal(String name) {
+        return (BigDecimal) values.get(name);
+    }
+
+    public Boolean getBoolean(String name) {
+        return (Boolean) values.get(name);
+    }
+
+    public LocalDateTime getDateTime(String name) {
+        return (LocalDateTime) values.get(name);
+    }
+
+    public ActionInput getObject(String name) {
+        return (ActionInput) values.get(name);
+    }
+
+    @SuppressWarnings("unchecked")
+    public List<ActionInput> getObjectList(String name) {
+        Object value = values.get(name);
+        return value == null ? null : (List<ActionInput>) value;
+    }
+
+    @SuppressWarnings("unchecked")
+    public <T> List<T> getList(String name) {
+        Object value = values.get(name);
+        return value == null ? null : (List<T>) value;
+    }
+}
diff --git a/juprovider.core/src/main/java/com/asdp/juprovider/core/action/contract/ActionInputValidator.java b/juprovider.core/src/main/java/com/asdp/juprovider/core/action/contract/ActionInputValidator.java
new file mode 100644
index 0000000..d03f5ff
--- /dev/null
+++ b/juprovider.core/src/main/java/com/asdp/juprovider/core/action/contract/ActionInputValidator.java
@@ -0,0 +1,259 @@
+package com.asdp.juprovider.core.action.contract;
+
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.time.LocalDateTime;
+import java.time.OffsetDateTime;
+import java.time.format.DateTimeParseException;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.Function;
+
+import com.asdp.juprovider.core.action.exception.ActionValidationException;
+
+/**
+ * Action Input 계약 검증 (결정 AC3·AC12)
+ *
+ * - 필수 누락            REQUIRED
+ * - 형 불일치            TYPE_MISMATCH (문자열 숫자 "10"은 INTEGER로 받지 않는다)
+ * - 길이 초과            MAX_LENGTH
+ * - 공통코드 외 값       INVALID_CODE
+ * - 선언되지 않은 필드   UNKNOWN_FIELD (중첩 object·list 원소 포함)
+ *
+ * 오류는 모두 모아서 한 번에 400 VALIDATION으로 던진다.
+ */
+public class ActionInputValidator {
+
+    /** 공통코드 그룹 → 사용 중인 코드 목록 */
+    private final Function<String, Set<String>> activeCodes;
+
+    public ActionInputValidator(Function<String, Set<String>> activeCodes) {
+        this.activeCodes = activeCodes;
+    }
+
+    public ActionInput validate(
+            ActionContract contract,
+            Map<String, Object> parameters) {
+        List<ActionFieldError> errors = new ArrayList<>();
+        Map<String, Set<String>> codeCache = new HashMap<>();
+
+        ActionInput input = validateObject(
+                contract.input(),
+                parameters == null ? Map.of() : parameters,
+                "",
+                errors,
+                codeCache);
+
+        if (!errors.isEmpty()) {
+            throw new ActionValidationException(errors);
+        }
+
+        return input;
+    }
+
+    private ActionInput validateObject(
+            List<FieldSpec> specs,
+            Map<?, ?> values,
+            String prefix,
+            List<ActionFieldError> errors,
+            Map<String, Set<String>> codeCache) {
+        Map<String, FieldSpec> declared = new LinkedHashMap<>();
+        for (FieldSpec spec : specs) {
+            declared.put(spec.name(), spec);
+        }
+
+        for (Object key : values.keySet()) {
+            String name = String.valueOf(key);
+            if (!declared.containsKey(name)) {
+                errors.add(new ActionFieldError(
+                        path(prefix, name),
+                        ActionFieldError.UNKNOWN_FIELD,
+                        "정의되지 않은 입력 항목입니다."));
+            }
+        }
+
+        Map<String, Object> result = new LinkedHashMap<>();
+        for (FieldSpec spec : specs) {
+            String field = path(prefix, spec.name());
+            Object raw = values.get(spec.name());
+
+            if (isMissing(raw)) {
+                if (spec.required()) {
+                    errors.add(new ActionFieldError(
+                            field,
+                            ActionFieldError.REQUIRED,
+                            "필수 입력 항목입니다."));
+                }
+                continue;
+            }
+
+            Object converted = convert(spec, raw, field, errors, codeCache);
+            if (converted != null) {
+                result.put(spec.name(), converted);
+            }
+        }
+
+        return new ActionInput(result);
+    }
+
+    private Object convert(
+            FieldSpec spec,
+            Object raw,
+            String field,
+            List<ActionFieldError> errors,
+            Map<String, Set<String>> codeCache) {
+        switch (spec.type()) {
+            case STRING -> {
+                if (!(raw instanceof String text)) {
+                    return mismatch(field, "문자열", errors);
+                }
+                return checkLength(spec, text, field, errors);
+            }
+            case CODE -> {
+                if (!(raw instanceof String text)) {
+                    return mismatch(field, "코드 문자열", errors);
+                }
+                if (checkLength(spec, text, field, errors) == null) {
+                    return null;
+                }
+                Set<String> codes = codeCache.computeIfAbsent(spec.codeGroup(), activeCodes);
+                if (codes == null || !codes.contains(text)) {
+                    errors.add(new ActionFieldError(
+                            field,
+                            ActionFieldError.INVALID_CODE,
+                            "사용할 수 없는 코드입니다. (" + spec.codeGroup() + ")"));
+                    return null;
+                }
+                return text;
+            }
+            case INTEGER -> {
+                Long value = toLong(raw);
+                return value == null ? mismatch(field, "정수", errors) : value;
+            }
+            case DECIMAL -> {
+                if (!(raw instanceof Number number)) {
+                    return mismatch(field, "숫자", errors);
+                }
+                return new BigDecimal(number.toString());
+            }
+            case BOOLEAN -> {
+                if (!(raw instanceof Boolean value)) {
+                    return mismatch(field, "true/false", errors);
+                }
+                return value;
+            }
+            case DATETIME -> {
+                if (!(raw instanceof String text)) {
+                    return mismatch(field, "일시 문자열(ISO-8601)", errors);
+                }
+                LocalDateTime value = toDateTime(text);
+                return value == null ? mismatch(field, "일시 문자열(ISO-8601)", errors) : value;
+            }
+            case OBJECT -> {
+                if (!(raw instanceof Map<?, ?> map)) {
+                    return mismatch(field, "객체", errors);
+                }
+                return validateObject(spec.fields(), map, field, errors, codeCache);
+            }
+            case LIST -> {
+                if (!(raw instanceof List<?> list)) {
+                    return mismatch(field, "목록", errors);
+                }
+                List<Object> items = new ArrayList<>();
+                for (int i = 0; i < list.size(); i++) {
+                    String itemField = field + "[" + i + "]";
+                    Object item = list.get(i);
+                    if (isMissing(item)) {
+                        errors.add(new ActionFieldError(
+                                itemField,
+                                ActionFieldError.REQUIRED,
+                                "목록 항목이 비어 있습니다."));
+                        continue;
+                    }
+                    Object converted = convert(spec.element(), item, itemField, errors, codeCache);
+                    if (converted != null) {
+                        items.add(converted);
+                    }
+                }
+                return items;
+            }
+            default -> {
+                return mismatch(field, spec.type().name(), errors);
+            }
+        }
+    }
+
+    private static String checkLength(
+            FieldSpec spec,
+            String text,
+            String field,
+            List<ActionFieldError> errors) {
+        if (spec.maxLength() != null && text.length() > spec.maxLength()) {
+            errors.add(new ActionFieldError(
+                    field,
+                    ActionFieldError.MAX_LENGTH,
+                    "최대 " + spec.maxLength() + "자까지 입력할 수 있습니다."));
+            return null;
+        }
+        return text;
+    }
+
+    private static Object mismatch(
+            String field,
+            String expected,
+            List<ActionFieldError> errors) {
+        errors.add(new ActionFieldError(
+                field,
+                ActionFieldError.TYPE_MISMATCH,
+                expected + " 형식이어야 합니다."));
+        return null;
+    }
+
+    private static boolean isMissing(Object raw) {
+        return raw == null
+                || (raw instanceof String text && text.isBlank());
+    }
+
+    private static Long toLong(Object raw) {
+        if (raw instanceof Integer || raw instanceof Long || raw instanceof Short || raw instanceof Byte) {
+            return ((Number) raw).longValue();
+        }
+        if (raw instanceof BigInteger big) {
+            return big.bitLength() < 64 ? big.longValue() : null;
+        }
+        if (raw instanceof BigDecimal decimal) {
+            try {
+                return decimal.longValueExact();
+            } catch (ArithmeticException e) {
+                return null;
+            }
+        }
+        if (raw instanceof Double || raw instanceof Float) {
+            double value = ((Number) raw).doubleValue();
+            if (value == Math.rint(value) && !Double.isInfinite(value) && Math.abs(value) < 9.0E15) {
+                return (long) value;
+            }
+        }
+        return null;
+    }
+
+    private static LocalDateTime toDateTime(String text) {
+        try {
+            return LocalDateTime.parse(text);
+        } catch (DateTimeParseException e) {
+            try {
+                return OffsetDateTime.parse(text).toLocalDateTime();
+            } catch (DateTimeParseException ignored) {
+                return null;
+            }
+        }
+    }
+
+    private static String path(String prefix, String name) {
+        return prefix.isEmpty() ? name : prefix + "." + name;
+    }
+}
