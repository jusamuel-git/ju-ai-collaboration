+package com.asdp.juprovider.core.action.contract;
+
+/**
+ * 필드 오류 1건 (응답 errors[] 원소)
+ *
+ * field : 경로 (예: packets[2].direction)
+ * code  : REQUIRED / TYPE_MISMATCH / MAX_LENGTH / INVALID_CODE / UNKNOWN_FIELD / CONTRACT_VERSION_MISMATCH ...
+ */
+public record ActionFieldError(
+        String field,
+        String code,
+        String message) {
+
+    public static final String REQUIRED = "REQUIRED";
+    public static final String TYPE_MISMATCH = "TYPE_MISMATCH";
+    public static final String MAX_LENGTH = "MAX_LENGTH";
+    public static final String INVALID_CODE = "INVALID_CODE";
+    public static final String UNKNOWN_FIELD = "UNKNOWN_FIELD";
+    public static final String CONTRACT_VERSION_MISMATCH = "CONTRACT_VERSION_MISMATCH";
+}
