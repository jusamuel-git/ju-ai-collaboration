@@ -0,0 +1,40 @@
+package com.asdp.juprovider.core.action.contract;
+
+import java.util.List;
+
+/**
+ * Action 계약 (결정 AC3·AC4·AC11)
+ *
+ * contractVersion : 같은 업무 계약의 버전. 파괴적 변경(이름·형·필수·kind)은 version 증가,
+ *                   업무 의미가 바뀔 때만 새 ACT_CD. 비파괴 변경(선택 입력·출력 필드 추가)은 유지.
+ * outputKind      : LIST / RECORD / KEY / NONE
+ * input           : 입력 필드 선언 (선언되지 않은 필드는 400 UNKNOWN_FIELD, 결정 AC12)
+ * output          : 출력 필드 선언 (Designer 계약 조회용. 실행 시에는 kind 모양만 확인)
+ *
+ * 실제 Publish·version 관리는 Designer 단계 (결정 AC13).
+ */
+public record ActionContract(
+        int contractVersion,
+        OutputKind outputKind,
+        List<FieldSpec> input,
+        List<FieldSpec> output) {
+
+    public ActionContract {
+        if (contractVersion < 1) {
+            throw new IllegalArgumentException("contractVersion은 1 이상이어야 합니다.");
+        }
+        if (outputKind == null) {
+            throw new IllegalArgumentException("outputKind가 필요합니다.");
+        }
+        input = input == null ? List.of() : List.copyOf(input);
+        output = output == null ? List.of() : List.copyOf(output);
+    }
+
+    public static ActionContract of(
+            int contractVersion,
+            OutputKind outputKind,
+            List<FieldSpec> input,
+            List<FieldSpec> output) {
+        return new ActionContract(contractVersion, outputKind, input, output);
+    }
+}
