@@ -0,0 +1,85 @@
+package com.asdp.juprovider.core.action.contract;
+
+import java.util.List;
+
+/**
+ * Action 계약의 필드 선언 (결정 AC3)
+ *
+ * name      : camelCase (컬럼 약어 기준, 예: ptlGrpCd)
+ * type      : FieldType 8종
+ * required  : 필수 여부 (null·빈 문자열은 누락으로 본다)
+ * maxLength : STRING/CODE 최대 길이
+ * codeGroup : CODE 형의 공통코드 그룹 (ju_com_code 사용 중 값만 허용)
+ * fields    : OBJECT 형의 하위 필드 / LIST 원소가 OBJECT일 때 원소의 필드
+ * element   : LIST 원소의 형 선언
+ */
+public record FieldSpec(
+        String name,
+        FieldType type,
+        boolean required,
+        Integer maxLength,
+        String codeGroup,
+        List<FieldSpec> fields,
+        FieldSpec element) {
+
+    public FieldSpec {
+        if (name == null || name.isBlank()) {
+            throw new IllegalArgumentException("FieldSpec name이 필요합니다.");
+        }
+        if (type == null) {
+            throw new IllegalArgumentException("FieldSpec type이 필요합니다: " + name);
+        }
+        if (type == FieldType.CODE && (codeGroup == null || codeGroup.isBlank())) {
+            throw new IllegalArgumentException("CODE 형에는 codeGroup이 필요합니다: " + name);
+        }
+        if (type == FieldType.LIST && element == null) {
+            throw new IllegalArgumentException("LIST 형에는 element가 필요합니다: " + name);
+        }
+        fields = fields == null ? List.of() : List.copyOf(fields);
+    }
+
+    public static FieldSpec string(String name, boolean required, int maxLength) {
+        return new FieldSpec(name, FieldType.STRING, required, maxLength, null, null, null);
+    }
+
+    public static FieldSpec integer(String name, boolean required) {
+        return new FieldSpec(name, FieldType.INTEGER, required, null, null, null, null);
+    }
+
+    public static FieldSpec decimal(String name, boolean required) {
+        return new FieldSpec(name, FieldType.DECIMAL, required, null, null, null, null);
+    }
+
+    public static FieldSpec bool(String name, boolean required) {
+        return new FieldSpec(name, FieldType.BOOLEAN, required, null, null, null, null);
+    }
+
+    public static FieldSpec datetime(String name, boolean required) {
+        return new FieldSpec(name, FieldType.DATETIME, required, null, null, null, null);
+    }
+
+    public static FieldSpec code(String name, boolean required, String codeGroup) {
+        return new FieldSpec(name, FieldType.CODE, required, 8, codeGroup, null, null);
+    }
+
+    public static FieldSpec object(String name, boolean required, List<FieldSpec> fields) {
+        return new FieldSpec(name, FieldType.OBJECT, required, null, null, fields, null);
+    }
+
+    /** 원소가 객체인 목록 */
+    public static FieldSpec listOf(String name, boolean required, List<FieldSpec> elementFields) {
+        return new FieldSpec(
+                name,
+                FieldType.LIST,
+                required,
+                null,
+                null,
+                null,
+                new FieldSpec("item", FieldType.OBJECT, true, null, null, elementFields, null));
+    }
+
+    /** 원소가 단일 값인 목록 */
+    public static FieldSpec listOf(String name, boolean required, FieldSpec element) {
+        return new FieldSpec(name, FieldType.LIST, required, null, null, null, element);
+    }
+}
