@@ -213,4 +213,52 @@
 
     </select>
 
+    <!-- JU Action 계약 (결정 AC1·AC7): 소문자 테이블명 -->
+    <select id="selectMenuByCode" resultMap="menuResultMap">
+        SELECT m.MNU_ID,
+               m.MNU_CD,
+               m.UP_MNU_ID,
+               m.MNU_KIND,
+               m.MNU_LV,
+               m.MNU_URL,
+               m.USE_YN,
+               m.ENABLED_YN,
+               m.SORT_ORD,
+               COALESCE(ml.RES_VAL, d.MNU_NM, m.MNU_CD) AS MNU_NM,
+               COALESCE(md.RES_VAL, d.MNU_DESC) AS MNU_DESC
+          FROM ju_menu m
+          LEFT JOIN ju_menu_detail d
+            ON d.MNU_ID = m.MNU_ID
+          LEFT JOIN ju_multi_lang ml
+            ON ml.LANG_CD = #{langCd}
+           AND ml.RES_KEY = d.MNU_NM_KEY
+          LEFT JOIN ju_multi_lang md
+            ON md.LANG_CD = #{langCd}
+           AND md.RES_KEY = d.MNU_DESC_KEY
+         WHERE m.MNU_CD = #{menuCode}
+           AND m.USE_YN = 'YENO0001'
+           AND m.ENABLED_YN = 'YENO0001'
+    </select>
+
+    <select id="selectActiveActionHandlers" resultMap="menuActionResultMap">
+        SELECT a.ACT_ID,
+               a.MNU_ID,
+               a.ACT_CD,
+               a.ACT_KIND,
+               a.HANDLER_ID,
+               a.USE_YN,
+               a.ENABLED_YN,
+               a.SORT_ORD,
+               a.ACT_CD AS ACT_NM,
+               NULL AS ACT_DESC
+          FROM ju_menu_action a
+          JOIN ju_menu m
+            ON m.MNU_ID = a.MNU_ID
+           AND m.USE_YN = 'YENO0001'
+           AND m.ENABLED_YN = 'YENO0001'
+         WHERE a.USE_YN = 'YENO0001'
+           AND a.ENABLED_YN = 'YENO0001'
+         ORDER BY a.MNU_ID, a.SORT_ORD, a.ACT_ID
+    </select>
+
 </mapper>
