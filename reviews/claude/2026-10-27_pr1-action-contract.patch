+package com.asdp.juprovider.core.action.contract;
+
+import java.util.List;
+
+/**
+ * OutputKind.LIST 의 고정 모양: { "items": [...], "total": n }
+ * 페이징 입력이 나중에 추가되어도 모양은 바뀌지 않는다.
+ */
+public record ListOutput<T>(
+        List<T> items,
+        long total) {
+
+    public ListOutput {
+        items = items == null ? List.of() : List.copyOf(items);
+    }
+
+    public static <T> ListOutput<T> of(List<T> items) {
+        List<T> list = items == null ? List.of() : items;
+        return new ListOutput<>(list, list.size());
+    }
+}
