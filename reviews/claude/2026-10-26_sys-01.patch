--- /dev/null
+++ b/backend/src/JuProject.Api/Infrastructure/HttpCurrentUser.cs
@@ -0,0 +1,17 @@
+using JuProject.Application.Common;
+using Microsoft.IdentityModel.JsonWebTokens;
+
+namespace JuProject.Api.Infrastructure;
+
+// JWT의 sub 클레임에서 현재 사용자 ID를 읽는다. 로그인하지 않은 요청이면 null.
+public class HttpCurrentUser(IHttpContextAccessor httpContextAccessor) : ICurrentUser
+{
+    public long? UserId
+    {
+        get
+        {
+            var sub = httpContextAccessor.HttpContext?.User.FindFirst(JwtRegisteredClaimNames.Sub)?.Value;
+            return long.TryParse(sub, out var userId) ? userId : null;
+        }
+    }
+}
