@@ -0,0 +1,22 @@
+using JuProject.Domain.Entities;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Metadata.Builders;
+
+namespace JuProject.Infrastructure.Persistence.Configurations;
+
+internal class AuthorityConfiguration : IEntityTypeConfiguration<Authority>
+{
+    public void Configure(EntityTypeBuilder<Authority> builder)
+    {
+        builder.ToTable("sys_auth");
+        builder.HasKey(e => e.AuthId);
+
+        builder.Property(e => e.AuthId).HasColumnName("auth_id");
+        builder.Property(e => e.AuthCode).HasColumnName("auth_code").HasMaxLength(30).IsRequired();
+        builder.Property(e => e.AuthName).HasColumnName("auth_name").HasMaxLength(100).IsRequired();
+        builder.Property(e => e.SortOrder).HasColumnName("sort_order");
+        builder.ConfigureBase();
+
+        builder.HasIndex(e => e.AuthCode).IsUnique().HasDatabaseName("uk_auth_code");
+    }
+}
