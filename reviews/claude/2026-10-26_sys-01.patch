@@ -0,0 +1,33 @@
+using JuProject.Domain.Entities;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Metadata.Builders;
+
+namespace JuProject.Infrastructure.Persistence.Configurations;
+
+internal class AuthorityMenuConfiguration : IEntityTypeConfiguration<AuthorityMenu>
+{
+    public void Configure(EntityTypeBuilder<AuthorityMenu> builder)
+    {
+        builder.ToTable("sys_auth_menu");
+        builder.HasKey(e => e.AuthMenuId);
+
+        builder.Property(e => e.AuthMenuId).HasColumnName("auth_menu_id");
+        builder.Property(e => e.AuthId).HasColumnName("auth_id");
+        builder.Property(e => e.MenuId).HasColumnName("menu_id");
+        builder.ConfigureBase();
+
+        builder.HasOne(e => e.Authority)
+            .WithMany(a => a.AuthorityMenus)
+            .HasForeignKey(e => e.AuthId)
+            .HasConstraintName("fk_auth_menu_auth")
+            .OnDelete(DeleteBehavior.Restrict);
+
+        builder.HasOne(e => e.Menu)
+            .WithMany()
+            .HasForeignKey(e => e.MenuId)
+            .HasConstraintName("fk_auth_menu_menu")
+            .OnDelete(DeleteBehavior.Restrict);
+
+        builder.HasIndex(e => new { e.AuthId, e.MenuId }).IsUnique().HasDatabaseName("uk_auth_menu");
+    }
+}
